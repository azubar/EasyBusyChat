#Область ПрограммныйИнтерфейс

// Показывать ли всплывающие оповещения веб-плагина.
//
// Клиентскому коду настройки иначе не достать: EBC_НастройкиПовтИсп серверный.
// Значение на стороне сервера кэшируется на сеанс, поэтому вызов дешёвый, но
// клиенту его всё равно стоит спрашивать один раз - см. EBC_ВебПлагин.
//
Функция ПоказыватьОповещения() Экспорт

	Настройки = EBC_НастройкиПовтИсп.ТекущиеНастройки();

	Значение = Истина;
	Если Настройки.Свойство("ПоказыватьОповещенияВебПлагина", Значение) Тогда
		Возврат Значение = Истина;
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция УстановитьТокенДоступа(Знач ТокенДоступа) Экспорт

	Если Не РольДоступна("EBC_Оператор")
		И Не РольДоступна("EBC_Администратор") Тогда
		Возврат Новый Структура(
			"Успех,Ошибка",
			Ложь,
			НСтр(
				"ru = 'Недостаточно прав для изменения токена доступа.';
				|uk = 'Недостатньо прав для зміни токена доступу.'"));
	КонецЕсли;

	Попытка
		EBC_НастройкиСервер.УстановитьТокенДоступа(ТокенДоступа);
	Исключение
		Возврат Новый Структура(
			"Успех,Ошибка",
			Ложь,
			НСтр(
				"ru = 'Не удалось сохранить токен доступа.';
				|uk = 'Не вдалося зберегти токен доступу.'"));
	КонецПопытки;

	Возврат Новый Структура(
		"Успех,Ошибка",
		Истина,
		"");

КонецФункции

#КонецОбласти
