// Расширение EasyBusyChat.
//
// Подключает подменю "Easy-Busy Chat" к формам объектов, настроенных для
// привязки чатов. Вся логика - в EBC_ПодключаемыеКоманды, здесь только вызовы.
//
// Обе процедуры вызываются для КАЖДОЙ формы объекта конфигурации, поэтому
// исключение в них сломало бы типовой интерфейс целиком. Ловушки стоят внутри
// EBC_ПодключаемыеКоманды.

&После("ПриОпределенииВидовПодключаемыхКоманд")
Процедура EBC_ПриОпределенииВидовПодключаемыхКоманд(ВидыПодключаемыхКоманд)

	EBC_ПодключаемыеКоманды.ДобавитьВидКоманд(ВидыПодключаемыхКоманд);

КонецПроцедуры

&После("ПриОпределенииКомандПодключенныхКОбъекту")
Процедура EBC_ПриОпределенииКомандПодключенныхКОбъекту(
		НастройкиФормы,
		Источники,
		ПодключенныеОтчетыИОбработки,
		Команды)

	EBC_ПодключаемыеКоманды.ДобавитьКоманды(НастройкиФормы, Источники, Команды);

КонецПроцедуры
