// Модуль EBC_НастройкиСервер
//
// Настройки хранятся в регистре сведений EBC_Настройки с единственным измерением
// ПользовательИБ. Запись с незаполненным ПользовательИБ - общая: она действует
// для всех пользователей, у которых нет персональной записи.

#Область ПрограммныйИнтерфейс

Функция ПолучитьТокенДоступа() Экспорт

	НаборНастроек = ПолучитьДействующийНаборНастроек();
	Если НаборНастроек.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат НаборНастроек[0].ТокенДоступа;

КонецФункции

Процедура УстановитьТокенДоступа(Знач ТокенДоступа) Экспорт

	НачатьТранзакцию();
	Попытка
		// Регистр блокируется целиком: выбор записи зависит от того, есть ли
		// персональная настройка, и этот выбор должен быть сделан под блокировкой.
		ЗаблокироватьНастройки();

		// Токен записывается в ту же запись, из которой он читается:
		// в персональную, если она есть, иначе в общую.
		ПользовательИБ = ТекущийПользовательИБ();
		НаборНастроек = ПолучитьНаборНастроек(ПользовательИБ);
		Если НаборНастроек.Количество() = 0 Тогда
			ПользовательИБ = Справочники.Пользователи.ПустаяСсылка();
			НаборНастроек = ПолучитьНаборНастроек(ПользовательИБ);
		КонецЕсли;

		Если НаборНастроек.Количество() = 0 Тогда
			ЗаписьНастроек = НаборНастроек.Добавить();
			ЗаписьНастроек.ПользовательИБ = ПользовательИБ;
			ЗаписьНастроек.Пользователь = ПолучитьТекущегоПользователяEBC();
			ЗаполнитьНастройкиПоУмолчанию(ЗаписьНастроек);
		Иначе
			ЗаписьНастроек = НаборНастроек[0];
		КонецЕсли;

		ЗаписьНастроек.ТокенДоступа = ТокенДоступа;
		НаборНастроек.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	// Настройки кэшируются на время сеанса, поэтому кэш сбрасывается сразу
	// после записи - иначе клиент API продолжит работать со старыми значениями.
	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Одноразово включает новые переключатели во всех записях, созданных до
// появления разделения технического журнала и аудита пользователей.
Процедура ОбеспечитьМиграциюНастроекЛогирования() Экспорт

	НаборНастроек = РегистрыСведений.EBC_Настройки.СоздатьНаборЗаписей();
	НаборНастроек.Прочитать();
	ТребуетсяМиграция = Ложь;
	Для Каждого ЗаписьНастроек Из НаборНастроек Цикл
		Если Не ЗаписьНастроек.НастройкиЛогированияМигрированы Тогда
			ТребуетсяМиграция = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Не ТребуетсяМиграция Тогда Возврат; КонецЕсли;

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьНастройки();
		НаборНастроек.Прочитать();
		Для Каждого ЗаписьНастроек Из НаборНастроек Цикл
			Если ЗаписьНастроек.НастройкиЛогированияМигрированы Тогда Продолжить; КонецЕсли;
			ЗаписьНастроек.ЛогироватьТехническиеСобытия = Истина;
			ЗаписьНастроек.ЛогироватьДействияПользователей = Истина;
			ЗаписьНастроек.НастройкиЛогированияМигрированы = Истина;
		КонецЦикла;
		НаборНастроек.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Возвращает набор записей настроек, действующих для текущего пользователя:
// персональную запись, если она есть, иначе общую.
// Пустой набор означает, что настроек нет вовсе.
//
Функция ПолучитьДействующийНаборНастроек() Экспорт

	НаборНастроек = ПолучитьНаборНастроек(ТекущийПользовательИБ());
	Если НаборНастроек.Количество() > 0 Тогда
		Возврат НаборНастроек;
	КонецЕсли;

	Возврат ПолучитьНаборНастроек(
		Справочники.Пользователи.ПустаяСсылка());

КонецФункции

Функция ПолучитьТекущегоПользователяEBC() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 2
		| ПользователиEBC.Ссылка КАК Ссылка
		|ИЗ
		| Справочник.EBC_Пользователи КАК ПользователиEBC
		|ГДЕ
		| ПользователиEBC.Пользователь = &Пользователь
		| И НЕ ПользователиEBC.ПометкаУдаления";
	Запрос.УстановитьПараметр(
		"Пользователь",
		ТекущийПользовательИБ());

	РезультатЗапроса = Запрос.Выполнить();
	ПользователиEBC = РезультатЗапроса.Выгрузить();
	Если ПользователиEBC.Количество() = 0 Тогда
		Возврат Справочники.EBC_Пользователи.ПустаяСсылка();
	КонецЕсли;
	Если ПользователиEBC.Количество() > 1 Тогда
		ВызватьИсключение "Неоднозначное сопоставление текущего пользователя Easy Busy Chat.";
	КонецЕсли;

	Возврат ПользователиEBC[0].Ссылка;

КонецФункции

Функция ТекущийПользовательИБ() Экспорт

	Попытка
		Возврат ПараметрыСеанса.ТекущийПользователь;
	Исключение
		Возврат Справочники.Пользователи.ПустаяСсылка();
	КонецПопытки;

КонецФункции

// Адрес сервиса Easy-Busy Chat, если он не задан в настройках.
//
// Вынесен в функцию по той же причине, что и масштаб картинки: значение нужно
// при создании записи настроек, при открытии формы с пустым полем и при чтении
// настроек. Один адрес в трёх местах разъехался бы при первом же переезде
// сервиса.
//
Функция БазовыйАдресАпиПоУмолчанию() Экспорт
	Возврат "https://api.easy-busy.cloud";
КонецФункции

// Срок хранения технического лога, если он не задан в общих настройках.
Функция ГлубинаХраненияЛоговПоУмолчанию() Экспорт
	Возврат 90;
КонецФункции

// Масштаб картинки печатной формы в процентах, если он не задан в настройках.
//
// Вынесен в функцию, а не записан числом в двух местах: значение нужно и при
// создании записи настроек, и при чтении незаполненного поля, и разъехавшиеся
// умолчания дали бы разный масштаб в зависимости от того, как настройки завели.
//
// 100 % даёт нечитаемую на телефоне картинку, а получатель здесь всегда
// мессенджер.
//
Функция МасштабКартинкиПечатнойФормыПоУмолчанию() Экспорт
	Возврат 150;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьНаборНастроек(Знач ПользовательИБ)

	НаборНастроек =
		РегистрыСведений.EBC_Настройки.СоздатьНаборЗаписей();
	НаборНастроек.Отбор.ПользовательИБ.Установить(ПользовательИБ);
	НаборНастроек.Прочитать();

	Возврат НаборНастроек;

КонецФункции

Процедура ЗаблокироватьНастройки()

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить(
		"РегистрСведений.EBC_Настройки");
	ЭлементБлокировки.Режим =
		РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();

КонецПроцедуры

Процедура ЗаполнитьНастройкиПоУмолчанию(ЗаписьНастроек)

	ЗаписьНастроек.БазовыйАдресАпи = БазовыйАдресАпиПоУмолчанию();
	ЗаписьНастроек.Активен = Ложь;
	ЗаписьНастроек.ЛогироватьТехническиеСобытия = Истина;
	ЗаписьНастроек.ЛогироватьДействияПользователей = Истина;
	ЗаписьНастроек.НастройкиЛогированияМигрированы = Истина;
	ЗаписьНастроек.ПоказыватьОповещенияВебПлагина = Истина;
	ЗаписьНастроек.ХранитьЛогДней = ГлубинаХраненияЛоговПоУмолчанию();
	ЗаписьНастроек.УровеньЛогирования =
		Перечисления.EBC_УровниЖурнала.Информация;
	ЗаписьНастроек.ТаймаутСоединенияСек = 30;
	ЗаписьНастроек.КоличествоПовторов = 3;
	ЗаписьНастроек.МаксимальныйРазмерФайлаМБ = 20;
	ЗаписьНастроек.МасштабКартинкиПечатнойФормы =
		МасштабКартинкиПечатнойФормыПоУмолчанию();

КонецПроцедуры

#КонецОбласти
