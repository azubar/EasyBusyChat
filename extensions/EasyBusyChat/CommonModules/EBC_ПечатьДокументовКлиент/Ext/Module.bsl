// Модуль EBC_ПечатьДокументовКлиент
//
// Клиентская часть команд отправки печатной формы в чат Easy-Busy Chat.
// См. описание механизма в модуле EBC_ПечатьДокументов.

#Область ПрограммныйИнтерфейс

// Вызывается из УправлениеПечатьюКлиентПереопределяемый.ПечатьДокументовВыполнитьКоманду.
//
// Готовит вложение одним серверным вызовом и открывает форму отправки
// сообщения. На сервер общей формы печати выполнение не передаётся: серверный
// обработчик БСП ничего не возвращает клиенту, а форму нужно открыть именно
// после того, как файл готов.
//
// Табличный документ отправляется на сервер как есть: пользователь мог включить
// подпись и печать или поправить форму, и отправлять надо то, что он видит.
//
// Параметры:
//  Форма                         - ФормаКлиентскогоПриложения - ОбщаяФорма.ПечатьДокументов.
//  Команда                       - КомандаФормы - выполняемая команда.
//  ПродолжитьВыполнениеНаСервере - Булево - см. описание в БСП.
//  ДополнительныеПараметры       - Произвольный - параметры для серверной части.
//
Процедура ВыполнитьКоманду(
		Форма,
		Команда,
		ПродолжитьВыполнениеНаСервере,
		ДополнительныеПараметры) Экспорт

	Формат = ФорматОтправки(Команда.Имя);
	Если ПустаяСтрока(Формат) Тогда
		Возврат;
	КонецЕсли;

	НастройкаПечатнойФормы = УправлениеПечатьюКлиент.НастройкаТекущейПечатнойФормы(Форма);
	Если НастройкаПечатнойФормы = Неопределено
		Или Форма.ТекущаяПечатнаяФорма.ВысотаТаблицы = 0 Тогда
		ПоказатьПредупреждение(
			,
			НСтр(
				"ru = 'Печатная форма не сформирована.';
				|uk = 'Друковану форму не сформовано.'"));
		Возврат;
	КонецЕсли;

	// Номер строки под курсором нужен, чтобы на сервере определить, к какому из
	// напечатанных документов относится текущая область. Для одного документа
	// он не используется.
	НомерСтроки = 0;
	ТекущаяОбласть = Форма.Элементы.ТекущаяПечатнаяФорма.ТекущаяОбласть;
	Если ТекущаяОбласть <> Неопределено Тогда
		НомерСтроки = ТекущаяОбласть.Верх;
	КонецЕсли;

	Вложение = EBC_ПечатьДокументовВызовСервера.ПодготовитьВложение(
		Форма[НастройкаПечатнойФормы.ИмяРеквизита],
		Форма.ОбъектыПечати,
		НомерСтроки,
		НастройкаПечатнойФормы.Название,
		Формат,
		Форма.УникальныйИдентификатор);

	Если Не Вложение.Успех Тогда
		ПоказатьПредупреждение(, Вложение.Ошибка);
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Объект", Вложение.Документ);
	ПараметрыФормы.Вставить("АдресВложения", Вложение.Адрес);
	ПараметрыФормы.Вставить("ИмяВложения", Вложение.ИмяФайла);
	ПараметрыФормы.Вставить("ТипСодержимогоВложения", Вложение.ТипСодержимого);

	// Режим окна задан свойством самой формы отправки - БлокироватьОкноВладельца.
	ОткрытьФорму(
		"Обработка.EBC_КонтактЦентр.Форма.ФормаОтправкиСообщения",
		ПараметрыФормы,
		Форма);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Формат отправки по имени команды формы.
//
// Возвращаемое значение:
//  Строка - "PDF", "Картинка" либо пустая строка, если команда чужая.
//           Обработчик срабатывает на любую команду формы печати, а не только
//           на наши две.
//
Функция ФорматОтправки(Знач ИмяКоманды)

	// Имена задаются в EBC_ПечатьДокументов, но сверять их серверным вызовом
	// на каждое нажатие чужой команды было бы расточительно.
	Если ИмяКоманды = "ОтправитьEasyBusyChatPDF" Тогда
		Возврат "PDF";
	ИначеЕсли ИмяКоманды = "ОтправитьEasyBusyChatКартинка" Тогда
		Возврат "Картинка";
	КонецЕсли;

	Возврат "";

КонецФункции

#КонецОбласти
