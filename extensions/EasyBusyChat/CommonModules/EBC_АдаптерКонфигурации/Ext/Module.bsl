// Публичный интерфейс конфигурационно-зависимых операций EasyBusyChat.
// Целевая конфигурация текущей реализации: BASSmallCompany.
//
// Клиентская часть открывает только стандартные формы основной конфигурации.
// Серверная часть изолирует запросы и работу с менеджерами метаданных.
// Контактная информация записывается в табличную часть контрагента штатными средствами БСП.
// Печать выполняется штатными механизмами БСП основной конфигурации.

#Если Клиент Тогда

Процедура ОткрытьФормуВыбораКонтрагента(ВладелецФормы = Неопределено, ОбработчикЗавершения = Неопределено) Экспорт

	ПараметрыФормы = Новый Структура("РежимВыбора", Истина);
	ОткрытьФорму(
		"Справочник.Контрагенты.ФормаВыбора",
		ПараметрыФормы,
		ВладелецФормы,
		,
		,
		,
		ОбработчикЗавершения);

КонецПроцедуры

Процедура ОткрытьФормуНовогоКонтрагента(Знач ДанныеЧата, ВладелецФормы = Неопределено, ОбработчикЗавершения = Неопределено) Экспорт

	ИмяКонтрагента = ПолучитьЗначениеДанныхЧата(ДанныеЧата, "Имя");
	Если ПустаяСтрока(ИмяКонтрагента) Тогда
		ИмяКонтрагента = ПолучитьЗначениеДанныхЧата(ДанныеЧата, "ИмяПользователя");
	КонецЕсли;
	Если ПустаяСтрока(ИмяКонтрагента) Тогда
		ИмяКонтрагента = НСтр("ru = 'Новый контрагент из Easy Busy Chat'; uk = 'Новий контрагент з Easy Busy Chat'");
	КонецЕсли;

	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("Наименование", ИмяКонтрагента);
	ЗначенияЗаполнения.Вставить("НаименованиеПолное", ИмяКонтрагента);
	ЗначенияЗаполнения.Вставить("Покупатель", Истина);

	// Телефон намеренно не передаётся через ЗначенияЗаполнения: ОбработкаЗаполнения
	// справочника Контрагенты превращает реквизит НомерТелефона в строку
	// контактной информации, и вместе с КонтактКакСвязаться телефон попадал
	// в карточку дважды. Он передаётся одним каналом - см.
	// ДобавитьОсновнойКонтактВПараметрыФормы.

	ПараметрыФормы = Новый Структура;
	// РежимВыбора нужен, чтобы форма вернула ссылку созданного контрагента
	// в обработчик оповещения: по ней чат связывается с контрагентом.
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	ДобавитьОсновнойКонтактВПараметрыФормы(
		ПараметрыФормы,
		ДанныеЧата,
		ИмяКонтрагента);

	ОткрытьФорму(
		"Справочник.Контрагенты.ФормаОбъекта",
		ПараметрыФормы,
		ВладелецФормы,
		,
		,
		,
		ОбработчикЗавершения);

КонецПроцедуры

// Открывает форму нового документа заданного вида.
//
// Параметры:
//  ВидОперации - Строка - полное имя документа, например "Документ.ЗаказПокупателя".
//                Список видов задаёт администратор в настройках расширения,
//                поэтому имя формы собирается из него, а не выбирается
//                ветвлением по известным документам.
//
Процедура СоздатьДокумент(Знач ВидОперации, Знач Основание, Знач ДанныеЧата, ВладелецФормы = Неопределено, ОбработчикЗавершения = Неопределено) Экспорт

	Если ПустаяСтрока(ВидОперации) Тогда
		ВызватьИсключение НСтр(
			"ru = 'Не указан вид документа';
			|uk = 'Не вказано вид документа'");
	КонецЕсли;

	ИмяФормы = СокрЛП(ВидОперации) + ".ФормаОбъекта";

	ЗначенияЗаполнения = Новый Структура;
	Если ЗначениеЗаполнено(Основание)
		И ТипЗнч(Основание) = Тип("СправочникСсылка.Контрагенты") Тогда
		// Проверить на клиенте, есть ли у документа реквизит "Контрагент",
		// нельзя - метаданные там недоступны. Документ без такого реквизита
		// значение заполнения просто не примет, а сама форма откроется.
		ЗначенияЗаполнения.Вставить("Контрагент", Основание);
	КонецЕсли;

	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
	ОткрытьФорму(
		ИмяФормы,
		ПараметрыФормы,
		ВладелецФормы,
		,
		,
		,
		ОбработчикЗавершения);

КонецПроцедуры

Процедура ОткрытьОбъект(Знач СсылкаНаОбъект, ВладелецФормы = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Возврат;
	КонецЕсли;

	// В основной конфигурации запрещены модальные вызовы (ModalityUseMode=DontUse),
	// поэтому значение открывается неблокирующим методом платформы.
	ПоказатьЗначение(Неопределено, СсылкаНаОбъект);

КонецПроцедуры

Функция ПолучитьЗначениеДанныхЧата(Знач ДанныеЧата, Знач ИмяСвойства)

	ЗначениеСвойства = "";
	Если ДанныеЧата = Неопределено Тогда
		Возврат ЗначениеСвойства;
	КонецЕсли;

	Попытка
		Если ДанныеЧата.Свойство(ИмяСвойства, ЗначениеСвойства) Тогда
			Возврат СокрЛП(Строка(ЗначениеСвойства));
		КонецЕсли;
	Исключение
		Возврат "";
	КонецПопытки;

	Возврат "";

КонецФункции

Функция НормализоватьЭлПочтуНаКлиенте(Знач ЭлПочта)

	Результат = НРег(СокрЛП(ЭлПочта));
	ПозицияСобаки = Найти(Результат, "@");
	Если ПозицияСобаки <= 1 Или ПозицияСобаки = СтрДлина(Результат) Тогда
		Возврат "";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Приводит телефон к виду +380XXXXXXXXX.
//
// Пустая строка означает, что номер не соответствует формату 380XXXXXXXXX
// и заполнять его в карточке контрагента не нужно: в чатах вместо телефона
// нередко приходит идентификатор мессенджера или номер другой страны.
//
Функция НормализоватьТелефонНаКлиенте(Знач Телефон)

	ИсходнаяСтрока = СокрЛП(Строка(Телефон));

	Цифры = "";
	Для Позиция = 1 По СтрДлина(ИсходнаяСтрока) Цикл
		Символ = Сред(ИсходнаяСтрока, Позиция, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		КонецЕсли;
	КонецЦикла;

	Если СтрДлина(Цифры) <> 12 Или Лев(Цифры, 3) <> "380" Тогда
		Возврат "";
	КонецЕсли;

	Возврат "+" + Цифры;

КонецФункции

Процедура ДобавитьОсновнойКонтактВПараметрыФормы(
		ПараметрыФормы,
		ДанныеЧата,
		Знач ИмяКонтрагента)

	ЭлПочта = НормализоватьЭлПочтуНаКлиенте(
		ПолучитьЗначениеДанныхЧата(ДанныеЧата, "ЭлПочта"));
	Телефон = НормализоватьТелефонНаКлиенте(
		ПолучитьЗначениеДанныхЧата(ДанныеЧата, "Телефон"));

	КакСвязаться = "";
	ТипКонтактнойИнформации = Неопределено;
	Если Не ПустаяСтрока(ЭлПочта) Тогда
		КакСвязаться = ЭлПочта;
		ТипКонтактнойИнформации = ПредопределенноеЗначение(
			"Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты");
	ИначеЕсли Не ПустаяСтрока(Телефон) Тогда
		КакСвязаться = Телефон;
		ТипКонтактнойИнформации = ПредопределенноеЗначение(
			"Перечисление.ТипыКонтактнойИнформации.Телефон");
	КонецЕсли;

	Если ПустаяСтрока(КакСвязаться) Тогда
		Возврат;
	КонецЕсли;

	КонтактКакСвязаться = Новый Структура;
	КонтактКакСвязаться.Вставить("ВидКонтакта", "Контрагент");
	// Форма элемента контрагента безусловно переписывает Наименование и
	// НаименованиеПолное значением этого свойства. С Неопределено она затирала
	// имя, переданное в ЗначенияЗаполнения, поэтому здесь то же самое имя.
	КонтактКакСвязаться.Вставить("Контакт", ИмяКонтрагента);
	КонтактКакСвязаться.Вставить("КакСвязаться", КакСвязаться);
	КонтактКакСвязаться.Вставить("ТипКИ", ТипКонтактнойИнформации);
	ПараметрыФормы.Вставить("КонтактКакСвязаться", КонтактКакСвязаться);

КонецПроцедуры

#КонецЕсли

#Если Сервер Тогда

// Возвращает имя часового пояса области данных основной конфигурации.
// Пустая строка означает, что конфигурация пояс не задаёт и его нужно
// определить средствами платформы.
//
Функция ЧасовойПоясОбластиДанных() Экспорт

	Попытка
		Возврат СокрЛП(Строка(Константы.ЧасовойПоясОбластиДанных.Получить()));
	Исключение
		// Константы нет в конфигурации либо нет прав на чтение.
		Возврат "";
	КонецПопытки;

КонецФункции

Функция ПолучитьТелефоныКонтрагентаСКонтактнымиЛицами(Знач Контрагент) Экспорт

	Результат = ТаблицаТелефоновКонтрагента();
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		| 0 КАК ПорядокГруппы,
		| 0 КАК ПорядокКонтакта,
		| КонтактнаяИнформация.НомерСтроки КАК ПорядокТелефона,
		| КонтактнаяИнформация.Ссылка КАК Источник,
		| КонтактнаяИнформация.Вид КАК Вид,
		| """" КАК НаименованиеКонтакта,
		| """" КАК Должность,
		| КонтактнаяИнформация.Представление КАК Представление,
		| КонтактнаяИнформация.НомерТелефона КАК НомерТелефона,
		| КонтактнаяИнформация.Значение КАК Значение,
		| КонтактнаяИнформация.ЗначенияПолей КАК ЗначенияПолей
		|ИЗ
		| Справочник.Контрагенты.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		| КонтактнаяИнформация.Ссылка = &Контрагент
		| И КонтактнаяИнформация.Тип =
		|  ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		| 1,
		| СвязиКонтрагентКонтакт.Порядок,
		| КонтактнаяИнформация.НомерСтроки,
		| КонтактнаяИнформация.Ссылка,
		| КонтактнаяИнформация.Вид,
		| КонтактнаяИнформация.Ссылка.Наименование,
		| СвязиКонтрагентКонтакт.Должность,
		| КонтактнаяИнформация.Представление,
		| КонтактнаяИнформация.НомерТелефона,
		| КонтактнаяИнформация.Значение,
		| КонтактнаяИнформация.ЗначенияПолей
		|ИЗ
		| РегистрСведений.СвязиКонтрагентКонтакт.СрезПоследних(
		|  , Контрагент = &Контрагент) КАК СвязиКонтрагентКонтакт
		|  ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|   Справочник.КонтактныеЛица.КонтактнаяИнформация КАК КонтактнаяИнформация
		|  ПО СвязиКонтрагентКонтакт.Контакт = КонтактнаяИнформация.Ссылка
		|ГДЕ
		| СвязиКонтрагентКонтакт.СвязьНедействительна = ЛОЖЬ
		| И НЕ КонтактнаяИнформация.Ссылка.ПометкаУдаления
		| И НЕ КонтактнаяИнформация.Ссылка.ЭтоГруппа
		| И НЕ КонтактнаяИнформация.Ссылка.Недействителен
		| И КонтактнаяИнформация.Тип =
		|  ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
		|
		|УПОРЯДОЧИТЬ ПО
		| ПорядокГруппы,
		| ПорядокКонтакта,
		| НаименованиеКонтакта,
		| ПорядокТелефона";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат Результат;
	КонецПопытки;

	Пока Выборка.Следующий() Цикл
		ИсходныйТелефон = Выборка.НомерТелефона;
		Если ПустаяСтрока(ИсходныйТелефон) Тогда
			ИсходныйТелефон = Выборка.Представление;
		КонецЕсли;

		НормализованныйТелефон = EBC_Ядро.НормализоватьТелефон(ИсходныйТелефон);
		Если СтрДлина(НормализованныйТелефон) <> 12
			Или Лев(НормализованныйТелефон, 3) <> "380" Тогда
			Продолжить;
		КонецЕсли;

		ЗначениеКИ = Выборка.Значение;
		Если ПустаяСтрока(ЗначениеКИ) Тогда
			ЗначениеКИ = Выборка.ЗначенияПолей;
		КонецЕсли;

		Попытка
			Комментарий = УправлениеКонтактнойИнформацией.
				КомментарийКонтактнойИнформации(ЗначениеКИ);
		Исключение
			Комментарий = "";
		КонецПопытки;

		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Контакт = ПредставлениеТелефона(Выборка, Комментарий);
		НоваяСтрока.Телефон = НормализованныйТелефон;
		НоваяСтрока.НомерТелефона = НормализованныйТелефон;
		НоваяСтрока.Источник = Выборка.Источник;
		НоваяСтрока.ПорядокГруппы = Выборка.ПорядокГруппы;
		НоваяСтрока.ПорядокКонтакта = Выборка.ПорядокКонтакта;
		НоваяСтрока.ПорядокТелефона = Выборка.ПорядокТелефона;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ТаблицаТелефоновКонтрагента()

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Контакт");
	Результат.Колонки.Добавить("Телефон");
	Результат.Колонки.Добавить("НомерТелефона");
	Результат.Колонки.Добавить("Источник");
	Результат.Колонки.Добавить("ПорядокГруппы");
	Результат.Колонки.Добавить("ПорядокКонтакта");
	Результат.Колонки.Добавить("ПорядокТелефона");
	Возврат Результат;

КонецФункции

Функция ПредставлениеТелефона(Знач ДанныеТелефона, Знач Комментарий)

	Если ДанныеТелефона.ПорядокГруппы = 0 Тогда
		Результат = СокрЛП(Строка(ДанныеТелефона.Вид));
	Иначе
		Результат = СокрЛП(ДанныеТелефона.НаименованиеКонтакта);
		Должность = СокрЛП(ДанныеТелефона.Должность);
		Если Не ПустаяСтрока(Должность) Тогда
			Результат = Результат
				+ ?(ПустаяСтрока(Результат), "", " · ")
				+ Должность;
		КонецЕсли;
	КонецЕсли;

	Комментарий = СокрЛП(Комментарий);
	Если Не ПустаяСтрока(Комментарий) Тогда
		Результат = Результат
			+ ?(ПустаяСтрока(Результат), "", " — ")
			+ Комментарий;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция НайтиКонтрагентовПоКонтактам(Знач Телефон, Знач ЭлПочта) Экспорт

	ИсходныйТелефон = СокрЛП(Телефон);
	ИсходнаяЭлПочта = СокрЛП(ЭлПочта);
	ТелефонДляПоиска = EBC_Ядро.НормализоватьТелефон(ИсходныйТелефон);
	ЭлПочтаДляПоиска = EBC_Ядро.НормализоватьЭлПочту(ИсходнаяЭлПочта);

	Результат = Новый Массив;
	Если ПустаяСтрока(ТелефонДляПоиска) И ПустаяСтрока(ЭлПочтаДляПоиска) Тогда
		Возврат Результат;
	КонецЕсли;

	Если СтрДлина(ТелефонДляПоиска) > 10 Тогда
		ТелефонДляПоиска = Прав(ТелефонДляПоиска, 10);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		| КонтактнаяИнформация.Ссылка КАК Ссылка,
		| КонтактнаяИнформация.Ссылка.Наименование КАК Представление,
		| КонтактнаяИнформация.Тип КАК ТипКонтактнойИнформации,
		| КонтактнаяИнформация.Представление КАК Контакт,
		| КонтактнаяИнформация.НомерТелефона КАК НомерТелефона
		|ИЗ
		| Справочник.Контрагенты.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		| НЕ КонтактнаяИнформация.Ссылка.ПометкаУдаления
		| И НЕ КонтактнаяИнформация.Ссылка.ЭтоГруппа
		| И (
		|  (&ИскатьПоТелефону
		|   И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
		|   И КонтактнаяИнформация.НомерТелефона ПОДОБНО &Телефон)
		|  ИЛИ
		|  (&ИскатьПоЭлПочте
		|   И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
		|   И НРег(КонтактнаяИнформация.Представление) = &ЭлПочта)
		| )";
	Запрос.УстановитьПараметр("ИскатьПоТелефону", Не ПустаяСтрока(ТелефонДляПоиска));
	Запрос.УстановитьПараметр("ИскатьПоЭлПочте", Не ПустаяСтрока(ЭлПочтаДляПоиска));
	Запрос.УстановитьПараметр("Телефон", "%" + ТелефонДляПоиска);
	Запрос.УстановитьПараметр("ЭлПочта", ЭлПочтаДляПоиска);

	КандидатыПоСсылке = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		КлючСсылки = Строка(Выборка.Ссылка.УникальныйИдентификатор());
		Кандидат = КандидатыПоСсылке.Получить(КлючСсылки);
		Если Кандидат = Неопределено Тогда
			Кандидат = Новый Структура;
			Кандидат.Вставить("Ссылка", Выборка.Ссылка);
			Кандидат.Вставить("Имя", Выборка.Представление);
			Кандидат.Вставить("Тип", "Справочник.Контрагенты");
			Кандидат.Вставить("Телефон", "");
			Кандидат.Вставить("ЭлПочта", "");
			Кандидат.Вставить("ИсходныйТелефон", ИсходныйТелефон);
			Кандидат.Вставить("ИсходнаяЭлПочта", ИсходнаяЭлПочта);
			Кандидат.Вставить("СовпадениеПоТелефону", Ложь);
			Кандидат.Вставить("СовпадениеПоЭлПочте", Ложь);
			КандидатыПоСсылке.Вставить(КлючСсылки, Кандидат);
			Результат.Добавить(Кандидат);
		КонецЕсли;

		Если Выборка.ТипКонтактнойИнформации = Перечисления.ТипыКонтактнойИнформации.Телефон Тогда
			Кандидат.Телефон = Выборка.Контакт;
			Кандидат.СовпадениеПоТелефону = Истина;
		ИначеЕсли Выборка.ТипКонтактнойИнформации = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты Тогда
			Кандидат.ЭлПочта = Выборка.Контакт;
			Кандидат.СовпадениеПоЭлПочте = Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Формирует текст сообщения о документе для отправки в чат.
// Шаблон: "<Вид документа> №<Номер>  Сумма: <Сумма> <Валюта>".
// Для видов документов вне списка поддерживаемых используется синоним метаданных.
//
Функция ТекстСообщенияПоДокументу(Знач СсылкаНаДокумент) Экспорт

	Если Не ЗначениеЗаполнено(СсылкаНаДокумент) Тогда
		Возврат "";
	КонецЕсли;

	ТипДокумента = ТипЗнч(СсылкаНаДокумент);
	Если ТипДокумента = Тип("ДокументСсылка.СчетНаОплату") Тогда
		ВидДокумента = НСтр("ru = 'Счет'; uk = 'Рахунок'");
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		ВидДокумента = НСтр("ru = 'Заказ'; uk = 'Замовлення'");
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.РасходнаяНакладная") Тогда
		ВидДокумента = НСтр("ru = 'Накладная'; uk = 'Накладна'");
	Иначе
		ВидДокумента = СсылкаНаДокумент.Метаданные().Синоним;
	КонецЕсли;

	МетаданныеДокумента = СсылкаНаДокумент.Метаданные();
	Если МетаданныеДокумента.Реквизиты.Найти("СуммаДокумента") = Неопределено
		Или МетаданныеДокумента.Реквизиты.Найти("ВалютаДокумента") = Неопределено Тогда
		// Документ без суммы описывается только видом и номером.
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаДокумент, "Номер");
		Возврат СтрШаблон("%1 №%2", ВидДокумента, СокрЛП(Реквизиты.Номер));
	КонецЕсли;

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		СсылкаНаДокумент,
		"Номер,СуммаДокумента,ВалютаДокумента");

	Возврат СтрШаблон(
		НСтр("ru = '%1 №%2  Сумма: %3 %4'; uk = '%1 №%2  Сума: %3 %4'"),
		ВидДокумента,
		СокрЛП(Реквизиты.Номер),
		Формат(Реквизиты.СуммаДокумента, "ЧДЦ=2; ЧН=0; ЧРГ=' '"),
		СокрЛП(Строка(Реквизиты.ВалютаДокумента)));

КонецФункции

Функция ПолучитьДокументыОбъекта(Знач СсылкаНаОбъект) Экспорт

	Результат = Новый Массив;
	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(СсылкаНаОбъект) <> Тип("СправочникСсылка.Контрагенты") Тогда
		Возврат Результат;
	КонецЕсли;

	Если Не ПравоДоступа("Просмотр", СсылкаНаОбъект.Метаданные()) Тогда
		Возврат Результат;
	КонецЕсли;

	// Помеченные на удаление документы не отбрасываются: их состояние
	// показывается оператору отдельной пиктограммой.
	//
	// Статус - деловое состояние документа, у каждого вида документа своё:
	// у заказа покупателя это состояние заказа, у расходной накладной - вид
	// операции, у счёта на оплату такого реквизита нет и статус остаётся пустым.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		| ЗаказПокупателя.Ссылка КАК Ссылка,
		| ЗаказПокупателя.Дата КАК Дата,
		| ЗаказПокупателя.Номер КАК Номер,
		| ЗаказПокупателя.Контрагент КАК Контрагент,
		| ЗаказПокупателя.СуммаДокумента КАК Сумма,
		| ЗаказПокупателя.Проведен КАК Проведен,
		| ЗаказПокупателя.ПометкаУдаления КАК ПометкаУдаления,
		| ЗаказПокупателя.Комментарий КАК Комментарий,
		| ЗаказПокупателя.СостояниеЗаказа КАК Статус,
		| ""ЗаказПокупателя"" КАК ВидОперации
		|ИЗ
		| Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|ГДЕ
		| ЗаказПокупателя.Контрагент = &Контрагент
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		| РасходнаяНакладная.Ссылка,
		| РасходнаяНакладная.Дата,
		| РасходнаяНакладная.Номер,
		| РасходнаяНакладная.Контрагент,
		| РасходнаяНакладная.СуммаДокумента,
		| РасходнаяНакладная.Проведен,
		| РасходнаяНакладная.ПометкаУдаления,
		| РасходнаяНакладная.Комментарий,
		| РасходнаяНакладная.ВидОперации,
		| ""РасходнаяНакладная""
		|ИЗ
		| Документ.РасходнаяНакладная КАК РасходнаяНакладная
		|ГДЕ
		| РасходнаяНакладная.Контрагент = &Контрагент
		|
		|УПОРЯДОЧИТЬ ПО
		| Дата УБЫВ";
	Запрос.УстановитьПараметр("Контрагент", СсылкаНаОбъект);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Документ = Новый Структура;
		Документ.Вставить("Ссылка", Выборка.Ссылка);
		Документ.Вставить("Дата", Выборка.Дата);
		Документ.Вставить("Номер", Выборка.Номер);
		Документ.Вставить("Контрагент", Выборка.Контрагент);
		Документ.Вставить("Сумма", Выборка.Сумма);
		Документ.Вставить("Проведен", Выборка.Проведен);
		Документ.Вставить("ПометкаУдаления", Выборка.ПометкаУдаления);
		Документ.Вставить("Комментарий", Выборка.Комментарий);
		Документ.Вставить("Статус", ПредставлениеСтатусаДокумента(Выборка.Статус));
		Документ.Вставить("ВидОперации", Выборка.ВидОперации);
		Документ.Вставить("Представление", Строка(Выборка.Ссылка));
		Результат.Добавить(Документ);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Представление делового статуса документа для списка связанных документов.
// Незаполненное состояние показывается пустой строкой, а не «<Не указано>».
//
Функция ПредставлениеСтатусаДокумента(Знач СостояниеДокумента)

	Если Не ЗначениеЗаполнено(СостояниеДокумента) Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(Строка(СостояниеДокумента));

КонецФункции

// Виды документов, которые оператор может создать из контакт-центра.
//
// Список строится из настроенных типов объектов привязки, а не из перечисления
// в коде: администратор задаёт состав документов в настройках расширения, и
// заводить второй список тех же документов здесь незачем.
//
// Параметры:
//  Основание - ссылка - объект, на основании которого создаётся документ.
//              Сейчас на состав не влияет, но остаётся в сигнатуре: отбор
//              видов по основанию - естественное развитие.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Имя           - Строка - полное имя документа, например "Документ.ЗаказПокупателя";
//   * Представление - Строка - синоним документа.
//
Функция ПолучитьДоступныеОперацииСоздания(Знач Основание = Неопределено) Экспорт

	Результат = Новый Массив;

	Настроенные = РегистрыСведений.EBC_ТипыОбъектовПривязки.НастроенныеТипы(Истина);
	Для Каждого Строка Из Настроенные Цикл
		Если Строка.Вид <> "Документ" Или Не Строка.Существует Тогда
			Продолжить;
		КонецЕсли;

		МетаданныеДокумента = Метаданные.НайтиПоПолномуИмени(Строка.ПолноеИмя);
		Если МетаданныеДокумента = Неопределено
			Или Не ПравоДоступа("Добавление", МетаданныеДокумента) Тогда
			Продолжить;
		КонецЕсли;

		Результат.Добавить(Новый Структура(
			"Имя,Представление",
			Строка.ПолноеИмя,
			?(ПустаяСтрока(Строка.Представление),
				МетаданныеДокумента.Имя,
				Строка.Представление)));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Создаёт новый документ заданного вида.
//
// Параметры:
//  ВидОперации - Строка - полное имя документа, например "Документ.ЗаказПокупателя".
//  Основание   - ссылка - если у документа есть реквизит "Контрагент" и
//                основание ему подходит по типу, реквизит заполняется.
//  ДанныеЧата  - Структура - зарезервировано под заполнение из данных чата.
//
// Возвращаемое значение:
//  ДокументОбъект - незаписанный документ.
//
Функция СоздатьОбъектДокумента(Знач ВидОперации, Знач Основание, Знач ДанныеЧата) Экспорт

	МетаданныеДокумента = Метаданные.НайтиПоПолномуИмени(ВидОперации);
	Если МетаданныеДокумента = Неопределено
		Или Не Метаданные.Документы.Содержит(МетаданныеДокумента) Тогда
		ВызватьИсключение НСтр(
			"ru = 'Неподдерживаемый вид документа';
			|uk = 'Непідтримуваний вид документа'");
	КонецЕсли;

	Если Не ПравоДоступа("Добавление", МетаданныеДокумента) Тогда
		ВызватьИсключение НСтр(
			"ru = 'Недостаточно прав для создания документа';
			|uk = 'Недостатньо прав для створення документа'");
	КонецЕсли;

	// Менеджер по полному имени вместо ветвления по имени вида: список видов
	// задаёт администратор, и перечислять их в коде расширению нельзя.
	МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ВидОперации);

	НовыйДокумент = МенеджерДокумента.СоздатьДокумент();

	РеквизитКонтрагент = МетаданныеДокумента.Реквизиты.Найти("Контрагент");
	Если ЗначениеЗаполнено(Основание)
		И РеквизитКонтрагент <> Неопределено
		И РеквизитКонтрагент.Тип.СодержитТип(ТипЗнч(Основание)) Тогда
		НовыйДокумент.Контрагент = Основание;
	КонецЕсли;

	Возврат НовыйДокумент;

КонецФункции

Функция ПолучитьДоступныеПечатныеФормы(Знач СсылкаНаДокумент) Экспорт

	Результат = Новый Массив;
	ПараметрыПечати = ПолучитьПараметрыПечатиДокумента(СсылкаНаДокумент);
	Если ПараметрыПечати = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	КомандыПечати = УправлениеПечатью.КомандыПечатиФормы(ПараметрыПечати.ИмяФормы);
	Для Каждого КомандаПечати Из КомандыПечати Цикл

		Если КомандаПечати.СкрытаФункциональнымиОпциями Тогда
			Продолжить;
		КонецЕсли;

		Если Не ПечатьДокументовУНФ.КомандаПечатаетсяВСерверномКонтексте(КомандаПечати) Тогда
			Продолжить;
		КонецЕсли;

		Если ТипЗнч(КомандаПечати.ДополнительныеПараметры) = Тип("Структура")
			И КомандаПечати.ДополнительныеПараметры.Свойство("ВариантЗапуска") Тогда
			Если КомандаПечати.ДополнительныеПараметры.ВариантЗапуска
				<> Перечисления.СпособыВызоваДополнительныхОбработок.ВызовСерверногоМетода
				Или Не ЗначениеЗаполнено(КомандаПечати.ДополнительныеПараметры.Ссылка) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Результат.Добавить(Новый Структура(
			"Имя,Синоним,Идентификатор,Представление",
			КомандаПечати.Идентификатор,
			КомандаПечати.Представление,
			КомандаПечати.Идентификатор,
			КомандаПечати.Представление));

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СформироватьPDFПечатнойФормы(Знач СсылкаНаДокумент, Знач ИмяПечатнойФормы) Экспорт

	ПараметрыПечати = ПолучитьПараметрыПечатиДокумента(СсылкаНаДокумент);
	Если ПараметрыПечати = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Документ не поддерживает печать или недоступен пользователю'; uk = 'Документ не підтримує друк або недоступний користувачу'");
	КонецЕсли;

	ПечатнаяФорма = НайтиДоступнуюПечатнуюФорму(СсылкаНаДокумент, ИмяПечатнойФормы);
	Если ПечатнаяФорма = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Печатная форма недоступна'; uk = 'Друкована форма недоступна'");
	КонецЕсли;

	ОбъектыПечати = Новый Массив;
	ОбъектыПечати.Добавить(СсылкаНаДокумент);
	ПечатныеФормы = УправлениеПечатьюВызовСервера.СформироватьПечатныеФормыДляБыстройПечати(
		ПараметрыПечати.ИмяМенеджераПечати,
		ПечатнаяФорма.Идентификатор,
		ОбъектыПечати,
		Новый Структура);

	Если ПечатныеФормы.Отказ Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав для формирования печатной формы'; uk = 'Недостатньо прав для формування друкованої форми'");
	КонецЕсли;
	Если ПечатныеФормы.ТабличныеДокументы.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Печатная форма не была сформирована'; uk = 'Друковану форму не було сформовано'");
	КонецЕсли;

	ПечататьКомплектами = ПечатныеФормы.ТабличныеДокументы.Количество() > 1;
	ПакетДокументов = УправлениеПечатьюВызовСервера.ПакетДокументов(
		ПечатныеФормы.ТабличныеДокументы,
		ПечатныеФормы.ОбъектыПечати,
		ПечататьКомплектами,
		1);

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("pdf");
	Попытка
		ПакетДокументов.Записать(ИмяВременногоФайла, ТипФайлаПакетаОтображаемыхДокументов.PDF);
		ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Попытка
			УдалитьФайлы(ИмяВременногоФайла);
		Исключение
		КонецПопытки;
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;

	Возврат ДвоичныеДанные;

КонецФункции

Функция СформироватьJPEGПечатнойФормы(Знач СсылкаНаДокумент, Знач ИмяПечатнойФормы) Экспорт

	ПараметрыПечати = ПолучитьПараметрыПечатиДокумента(СсылкаНаДокумент);
	Если ПараметрыПечати = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Документ не поддерживает печать или недоступен пользователю'; uk = 'Документ не підтримує друк або недоступний користувачу'");
	КонецЕсли;

	ПечатнаяФорма = НайтиДоступнуюПечатнуюФорму(СсылкаНаДокумент, ИмяПечатнойФормы);
	Если ПечатнаяФорма = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Печатная форма недоступна'; uk = 'Друкована форма недоступна'");
	КонецЕсли;

	ОбъектыПечати = Новый Массив;
	ОбъектыПечати.Добавить(СсылкаНаДокумент);
	ПечатныеФормы = УправлениеПечатьюВызовСервера.СформироватьПечатныеФормыДляБыстройПечати(
		ПараметрыПечати.ИмяМенеджераПечати,
		ПечатнаяФорма.Идентификатор,
		ОбъектыПечати,
		Новый Структура);

	Если ПечатныеФормы.Отказ Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав для формирования печатной формы'; uk = 'Недостатньо прав для формування друкованої форми'");
	КонецЕсли;
	Если ПечатныеФормы.ТабличныеДокументы.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Печатная форма не была сформирована'; uk = 'Друковану форму не було сформовано'");
	КонецЕсли;

	РезультирующийТабличныйДокумент = Новый ТабличныйДокумент;
	Для Каждого ЭлементТабличногоДокумента Из ПечатныеФормы.ТабличныеДокументы Цикл
		РезультирующийТабличныйДокумент.Вывести(ЭлементТабличногоДокумента.Значение);
	КонецЦикла;

	Возврат КартинкаТабличногоДокумента(РезультирующийТабличныйДокумент);

КонецФункции

// Преобразует табличный документ в JPEG внешней компонентой SpreadSheet.
//
// Вынесено из СформироватьJPEGПечатнойФормы: то же преобразование нужно форме
// печати, где картинка делается из уже показанного пользователю табличного
// документа, а не из заново сформированной печатной формы.
//
// Масштаб берётся из настроек: 100 % дают нечитаемую на телефоне картинку,
// а получатель здесь всегда мессенджер.
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент
//
// Возвращаемое значение:
//  ДвоичныеДанные - JPEG.
//
Функция КартинкаТабличногоДокумента(Знач ТабличныйДокумент) Экспорт

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("mxl");
	Попытка
		ТабличныйДокумент.Записать(
			ИмяВременногоФайла,
			ТипФайлаТабличногоДокумента.MXL);

		Если Не ПодключитьВнешнююКомпоненту(
			"ОбщийМакет.EBC_SpreadSheet",
			"SS",
			ТипВнешнейКомпоненты.Native) Тогда
			ВызватьИсключение НСтр(
				"ru = 'Не удалось подключить компоненту SpreadSheet';
				|uk = 'Не вдалося підключити компоненту SpreadSheet'");
		КонецЕсли;

		Компонента = Новый("AddIn.SS.SpreadSheet");
		Компонента.Качество = 85;
		// Номер страницы намеренно не задаётся: с НомерСтраницы = 0 компонента
		// отдавала только первую страницу, а печатная форма бывает длиннее.
		Компонента.Масштаб = МасштабКартинкиПечатнойФормы();
		ДвоичныеДанные = Компонента.ПолучитьКартинку(ИмяВременногоФайла, "JPEG");

		Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
			ВызватьИсключение НСтр(
				"ru = 'Компонента SpreadSheet вернула данные неподдерживаемого типа';
				|uk = 'Компонента SpreadSheet повернула дані непідтримуваного типу'");
		КонецЕсли;
		Если ДвоичныеДанные.Размер() = 0 Тогда
			ВызватьИсключение НСтр(
				"ru = 'Компонента SpreadSheet вернула пустое изображение';
				|uk = 'Компонента SpreadSheet повернула порожнє зображення'");
		КонецЕсли;

		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Попытка
			УдалитьФайлы(ИмяВременногоФайла);
		Исключение
		КонецПопытки;
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;

	Возврат ДвоичныеДанные;

КонецФункции

// Масштаб картинки печатной формы в процентах из настроек расширения.
//
// Незаполненное или нулевое значение чтение настроек само заменяет
// умолчанием, здесь остаётся только страховка от отрицательного.
//
Функция МасштабКартинкиПечатнойФормы()

	Настройки = EBC_НастройкиПовтИсп.ОбщиеНастройки();

	Масштаб = 0;
	Если Настройки.Свойство("МасштабКартинкиПечатнойФормы", Масштаб)
		И Масштаб > 0 Тогда
		Возврат Масштаб;
	КонецЕсли;

	Возврат EBC_НастройкиСервер.МасштабКартинкиПечатнойФормыПоУмолчанию();

КонецФункции

Функция ПолучитьСсылкуОбъекта(Знач ТипОбъекта, Знач ИдентификаторОбъекта) Экспорт

	Если ПустаяСтрока(ТипОбъекта) Или Не ЗначениеЗаполнено(ИдентификаторОбъекта) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЧастиИмени = СтрРазделить(ТипОбъекта, ".");
	Если ЧастиИмени.Количество() <> 2 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ЧастиИмени[0] = "Справочник" Тогда
		МенеджерОбъекта = Справочники[ЧастиИмени[1]];
	ИначеЕсли ЧастиИмени[0] = "Документ" Тогда
		МенеджерОбъекта = Документы[ЧастиИмени[1]];
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		СсылкаНаОбъект = МенеджерОбъекта.ПолучитьСсылку(ИдентификаторОбъекта);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если Не ПравоДоступа("Просмотр", СсылкаНаОбъект.Метаданные()) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат СсылкаНаОбъект;

КонецФункции

Функция ПолучитьДанныеИдентификацииОбъекта(Знач СсылкаНаОбъект) Экспорт

	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Возврат Неопределено;
	КонецЕсли;

	МетаданныеОбъекта = СсылкаНаОбъект.Метаданные();
	Если Не ПравоДоступа("Просмотр", МетаданныеОбъекта) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура(
		"ТипОбъекта,ИдентификаторОбъекта,ПредставлениеОбъекта,НавигационнаяСсылка",
		Строка(МетаданныеОбъекта.ПолноеИмя()),
		СсылкаНаОбъект.УникальныйИдентификатор(),
		Строка(СсылкаНаОбъект),
		ПолучитьНавигационнуюСсылкуОбъекта(СсылкаНаОбъект));

КонецФункции

Функция ПолучитьНавигационнуюСсылкуОбъекта(Знач СсылкаНаОбъект)
	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Возврат "";
	КонецЕсли;
	Если Не ПравоДоступа("Просмотр", СсылкаНаОбъект.Метаданные()) Тогда
		Возврат "";
	КонецЕсли;

	Возврат ПолучитьНавигационнуюСсылку(СсылкаНаОбъект);

КонецФункции

Функция ПолучитьПараметрыПечатиДокумента(Знач СсылкаНаДокумент)

	Если Не ЗначениеЗаполнено(СсылкаНаДокумент) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(СсылкаНаДокумент) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		МетаданныеДокумента = Метаданные.Документы.ЗаказПокупателя;
		ИмяМенеджераПечати = "Документ.ЗаказПокупателя";
		ИмяФормы = "Документ.ЗаказПокупателя.Форма.ФормаДокумента";
	ИначеЕсли ТипЗнч(СсылкаНаДокумент) = Тип("ДокументСсылка.РасходнаяНакладная") Тогда
		МетаданныеДокумента = Метаданные.Документы.РасходнаяНакладная;
		ИмяМенеджераПечати = "Документ.РасходнаяНакладная";
		ИмяФормы = "Документ.РасходнаяНакладная.Форма.ФормаДокумента";
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	Если Не ПравоДоступа("Просмотр", МетаданныеДокумента) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура(
		"ИмяМенеджераПечати,ИмяФормы",
		ИмяМенеджераПечати,
		ИмяФормы);

КонецФункции

Функция НайтиДоступнуюПечатнуюФорму(Знач СсылкаНаДокумент, Знач ИмяПечатнойФормы)

	МассивПечатныхФорм = ПолучитьДоступныеПечатныеФормы(СсылкаНаДокумент);
	Для Каждого ПечатнаяФорма Из МассивПечатныхФорм Цикл
		Если ПечатнаяФорма.Идентификатор = ИмяПечатнойФормы
			Или ПечатнаяФорма.Имя = ИмяПечатнойФормы Тогда
			Возврат ПечатнаяФорма;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ТелефоныСовпадают(Знач ПервыйТелефон, Знач ВторойТелефон)

	ПервыйНормализованный = EBC_Ядро.НормализоватьТелефон(ПервыйТелефон);
	ВторойНормализованный = EBC_Ядро.НормализоватьТелефон(ВторойТелефон);
	Если ПустаяСтрока(ПервыйНормализованный) Или ПустаяСтрока(ВторойНормализованный) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если СтрДлина(ПервыйНормализованный) > 10 Тогда
		ПервыйНормализованный = Прав(ПервыйНормализованный, 10);
	КонецЕсли;
	Если СтрДлина(ВторойНормализованный) > 10 Тогда
		ВторойНормализованный = Прав(ВторойНормализованный, 10);
	КонецЕсли;

	Возврат ПервыйНормализованный = ВторойНормализованный;

КонецФункции

#КонецЕсли
