// Модуль EBC_ПечатьДокументов
//
// Команда отправки текущей печатной формы в чат Easy-Busy Chat из общей формы
// ПечатьДокументов.
//
// Общая форма не заимствуется. БСП предусмотрел для добавления собственных
// команд в форму печати три точки расширения, и расширение подключается только
// к ним:
//   УправлениеПечатьюПереопределяемый.ПечатьДокументовПриСозданииНаСервере
//     - размещение команды и кнопки;
//   УправлениеПечатьюКлиентПереопределяемый.ПечатьДокументовВыполнитьКоманду
//     - клиентская часть, готовит параметры;
//   УправлениеПечатьюПереопределяемый.ПечатьДокументовПриВыполненииКоманды
//     - серверная часть, форма доступна по контексту.
//
// Такой способ переживает обновление типовой конфигурации: изменения формы
// расширение не касаются, пока БСП сохраняет эти процедуры.

#Область ПрограммныйИнтерфейс

// Имена команд формы. Клиентская часть сверяет с ними Команда.Имя -
// см. EBC_ПечатьДокументовКлиент.ВыполнитьКоманду.
//
Функция ИмяКомандыОтправкиPDF() Экспорт
	Возврат "ОтправитьEasyBusyChatPDF";
КонецФункции

Функция ИмяКомандыОтправкиКартинки() Экспорт
	Возврат "ОтправитьEasyBusyChatКартинка";
КонецФункции

Функция ИмяПодменюОтправки() Экспорт
	Возврат "EBC_ПодменюОтправки";
КонецФункции

// Размещает подменю отправки в печатной форме сразу за кнопкой "Отправить".
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - ОбщаяФорма.ПечатьДокументов.
//
Процедура ДобавитьКомандуОтправки(Форма) Экспорт

	// Форма печати открывается любым пользователем, в том числе без ролей
	// расширения. Ошибка здесь сломала бы типовую печать, поэтому размещение
	// команды не должно приводить к исключению ни при каких условиях.
	Попытка
		РазместитьКоманду(Форма);
	Исключение
		ЗаписатьОшибку(
			"EBC_ПечатьДокументов.РазмещениеКоманды",
			ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

// Готовит вложение для формы отправки сообщения.
//
// Печатная форма берётся такой, какой её видит пользователь: он мог включить
// подпись и печать или поправить документ перед отправкой.
//
// Параметры:
//  ТабличныйДокумент     - ТабличныйДокумент - текущая печатная форма.
//  ОбъектыПечати         - СписокЗначений - реквизит формы печати.
//  НомерСтроки           - Число - строка под курсором; по ней определяется,
//                          к какому из напечатанных документов относится область.
//  НазваниеПечатнойФормы - Строка - уточнение в имени файла.
//  Формат                - Строка - "PDF" либо "Картинка".
//  ИдентификаторФормы    - УникальныйИдентификатор - владелец временного хранилища.
//
// Возвращаемое значение:
//  Структура:
//   * Успех          - Булево;
//   * Ошибка         - Строка - текст для пользователя;
//   * Документ       - ссылка на документ печатной формы;
//   * Адрес          - Строка - адрес двоичных данных во временном хранилище;
//   * ИмяФайла       - Строка;
//   * ТипСодержимого - Строка - MIME-тип.
//
Функция ПодготовитьВложение(
		Знач ТабличныйДокумент,
		Знач ОбъектыПечати,
		Знач НомерСтроки,
		Знач НазваниеПечатнойФормы,
		Знач Формат,
		Знач ИдентификаторФормы) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("Документ", Неопределено);
	Результат.Вставить("Адрес", "");
	Результат.Вставить("ИмяФайла", "");
	Результат.Вставить("ТипСодержимого", "");

	Документ = ДокументОбластиПечати(ОбъектыПечати, ТабличныйДокумент, НомерСтроки);
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Результат.Ошибка = НСтр(
			"ru = 'Не удалось определить документ печатной формы. Установите курсор в нужный документ.';
			|uk = 'Не вдалося визначити документ друкованої форми. Встановіть курсор у потрібний документ.'");
		Возврат Результат;
	КонецЕсли;
	Результат.Документ = Документ;

	ЭтоКартинка = (ВРег(Строка(Формат)) = ВРег("Картинка"));

	Попытка
		Если ЭтоКартинка Тогда
			ДвоичныеДанные = EBC_АдаптерКонфигурации.КартинкаТабличногоДокумента(
				ТабличныйДокумент);
		Иначе
			ДвоичныеДанные = PDFПечатнойФормы(ТабличныйДокумент);
		КонецЕсли;
	Исключение
		ЗаписатьОшибку("EBC_ПечатьДокументов.ПодготовитьВложение", ИнформацияОбОшибке());
		Результат.Ошибка = ?(
			ЭтоКартинка,
			НСтр(
				"ru = 'Не удалось получить картинку печатной формы.';
				|uk = 'Не вдалося отримати картинку друкованої форми.'"),
			НСтр(
				"ru = 'Не удалось сохранить печатную форму в PDF.';
				|uk = 'Не вдалося зберегти друковану форму в PDF.'"));
		Возврат Результат;
	КонецПопытки;

	Результат.ИмяФайла = ИмяФайлаПечатнойФормы(
		Строка(Документ),
		НазваниеПечатнойФормы,
		?(ЭтоКартинка, "jpg", "pdf"));
	Результат.ТипСодержимого = ?(ЭтоКартинка, "image/jpeg", "application/pdf");
	Результат.Адрес = ПоместитьВоВременноеХранилище(ДвоичныеДанные, ИдентификаторФормы);
	Результат.Успех = Истина;

	Возврат Результат;

КонецФункции

// Собирает имя файла печатной формы, пригодное и для файловой системы,
// и для передачи файла в чат.
//
// Экспортная потому, что тем же именем пользуется контакт-центр, отправляющий
// печатную форму из своей формы: две реализации разошлись бы, и одна из них
// снова осталась бы без очистки символов.
//
// Параметры:
//  ПредставлениеДокумента - Строка - представление ссылки на документ.
//  НазваниеПечатнойФормы  - Строка - уточнение в имени файла, можно не указывать.
//  Расширение             - Строка - расширение файла без точки.
//
// Возвращаемое значение:
//  Строка - имя файла.
//
Функция ИмяФайлаПечатнойФормы(
		Знач ПредставлениеДокумента,
		Знач НазваниеПечатнойФормы = "",
		Знач Расширение = "pdf") Экспорт

	ИмяФайла = СокрЛП(Строка(НазваниеПечатнойФормы));
	Если Не ПустаяСтрока(ИмяФайла) Тогда
		ИмяФайла = Строка(ПредставлениеДокумента) + " - " + ИмяФайла;
	Иначе
		ИмяФайла = Строка(ПредставлениеДокумента);
	КонецЕсли;

	// Представление документа содержит время ("... от 05.08.2026 12:34:56"),
	// то есть двоеточия, недопустимые в именах файлов, а номера вида "УТ-00/123"
	// добавляют слэши, которые превратили бы имя в путь.
	ЗапрещенныеСимволы = "\/:*?""<>|" + Символы.ПС + Символы.ВК + Символы.Таб;
	Для Позиция = 1 По СтрДлина(ЗапрещенныеСимволы) Цикл
		ИмяФайла = СтрЗаменить(ИмяФайла, Сред(ЗапрещенныеСимволы, Позиция, 1), " ");
	КонецЦикла;
	Пока СтрНайти(ИмяФайла, "  ") > 0 Цикл
		ИмяФайла = СтрЗаменить(ИмяФайла, "  ", " ");
	КонецЦикла;

	ИмяФайла = Лев(СокрЛП(ИмяФайла), 120);
	Если ПустаяСтрока(ИмяФайла) Тогда
		// Документ без представления не должен давать файл с именем ".pdf".
		ИмяФайла = НСтр(
			"ru = 'Печатная форма';
			|uk = 'Друкована форма'");
	КонецЕсли;

	Возврат ИмяФайла + "." + СокрЛП(Строка(Расширение));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура РазместитьКоманду(Форма)

	// Пользователь без ролей расширения не имеет доступа к настройкам, и
	// обращение к ним у него завершилось бы ошибкой. Отсутствие права -
	// достаточный признак того, что команда ему не нужна.
	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.EBC_Настройки)
		Или Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.EBC_СвязиОбъектов) Тогда
		Возврат;
	КонецЕсли;

	Если Не EBC_НастройкиПовтИсп.ТекущиеНастройки().Активен Тогда
		Возврат;
	КонецЕсли;

	Если Форма.Элементы.Найти(ИмяПодменюОтправки()) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Группа ищется по имени: если типовая форма изменится, команда просто
	// не появится, но печать продолжит работать.
	ГруппаКнопок = Форма.Элементы.Найти("ГруппаСохранитьОтправить");
	Если ГруппаКнопок = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Одна кнопка превратилась в подменю: форматов отправки стало два, а
	// спрашивать формат после нажатия - лишний шаг там, где пользователь уже
	// знает, что хочет отправить.
	Подменю = Форма.Элементы.Добавить(
		ИмяПодменюОтправки(),
		Тип("ГруппаФормы"),
		ГруппаКнопок);
	Подменю.Вид = ВидГруппыФормы.Подменю;
	Подменю.Картинка = БиблиотекаКартинок.EBC_EasyBusyChat16;
	Подменю.Отображение = ОтображениеКнопки.Картинка;
	Подменю.Заголовок = НСтр(
		"ru = 'Easy-Busy Chat';
		|uk = 'Easy-Busy Chat'");
	Подменю.Подсказка = НСтр(
		"ru = 'Отправить печатную форму в чат Easy-Busy Chat';
		|uk = 'Надіслати друковану форму в чат Easy-Busy Chat'");

	ДобавитьКомандуВПодменю(
		Форма,
		Подменю,
		ИмяКомандыОтправкиPDF(),
		НСтр(
			"ru = 'Отправить как PDF';
			|uk = 'Надіслати як PDF'"),
		НСтр(
			"ru = 'Отправить печатную форму в чат файлом PDF';
			|uk = 'Надіслати друковану форму в чат файлом PDF'"),
		БиблиотекаКартинок.EBC_ФайлPDF);

	ДобавитьКомандуВПодменю(
		Форма,
		Подменю,
		ИмяКомандыОтправкиКартинки(),
		НСтр(
			"ru = 'Отправить как картинку';
			|uk = 'Надіслати як картинку'"),
		НСтр(
			"ru = 'Отправить печатную форму в чат картинкой - её видно прямо в переписке';
			|uk = 'Надіслати друковану форму в чат картинкою - її видно прямо в листуванні'"),
		БиблиотекаКартинок.EBC_Изображение);

	РазместитьЗаКнопкойОтправить(Форма, Подменю, ГруппаКнопок);

КонецПроцедуры

Процедура ДобавитьКомандуВПодменю(
		Форма,
		Подменю,
		Знач ИмяКоманды,
		Знач Заголовок,
		Знач Подсказка,
		Знач Картинка)

	Команда = Форма.Команды.Добавить(ИмяКоманды);
	// Штатный диспетчер БСП: он вызовет
	// УправлениеПечатьюКлиентПереопределяемый.ПечатьДокументовВыполнитьКоманду,
	// где расширение перехватит свою команду по имени.
	Команда.Действие = "Подключаемый_ВыполнитьКоманду";
	Команда.Заголовок = Заголовок;
	Команда.Подсказка = Подсказка;
	Команда.Картинка = Картинка;

	Кнопка = Форма.Элементы.Добавить(
		"Кнопка" + ИмяКоманды,
		Тип("КнопкаФормы"),
		Подменю);
	Кнопка.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
	Кнопка.ИмяКоманды = Команда.Имя;

КонецПроцедуры

Процедура РазместитьЗаКнопкойОтправить(Форма, Элемент, ГруппаКнопок)

	КнопкаОтправить = Форма.Элементы.Найти("КнопкаОтправить");
	Если КнопкаОтправить = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПодчиненныеЭлементы = ГруппаКнопок.ПодчиненныеЭлементы;
	ИндексСледующего = ПодчиненныеЭлементы.Индекс(КнопкаОтправить) + 1;
	Если ИндексСледующего >= ПодчиненныеЭлементы.Количество() Тогда
		// Элемент добавлен последним и уже стоит за "Отправить".
		Возврат;
	КонецЕсли;

	СледующийЭлемент = ПодчиненныеЭлементы[ИндексСледующего];
	Если СледующийЭлемент = Элемент Тогда
		Возврат;
	КонецЕсли;

	Форма.Элементы.Переместить(Элемент, ГруппаКнопок, СледующийЭлемент);

КонецПроцедуры

// Определяет документ, к которому относится текущая область печатной формы.
//
// В одной печатной форме может быть напечатано несколько документов: каждому
// соответствует именованная область, имя которой лежит в представлении
// элемента списка ОбъектыПечати.
//
Функция ДокументОбластиПечати(Знач ОбъектыПечати, Знач ТабличныйДокумент, Знач НомерСтроки)

	Если ОбъектыПечати.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ОбъектыПечати.Количество() = 1 Тогда
		Возврат ОбъектыПечати[0].Значение;
	КонецЕсли;

	Для Каждого ОбъектПечати Из ОбъектыПечати Цикл
		Область = ТабличныйДокумент.Области.Найти(ОбъектПечати.Представление);
		Если Область = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если НомерСтроки >= Область.Верх И НомерСтроки <= Область.Низ Тогда
			Возврат ОбъектПечати.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Сохраняется именно текущий табличный документ формы, а не заново
// сформированная печатная форма: пользователь мог включить подпись и печать
// или отредактировать её перед отправкой.
//
Функция PDFПечатнойФормы(Знач ТабличныйДокумент)

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("pdf");

	Попытка
		ТабличныйДокумент.Записать(
			ИмяВременногоФайла,
			ТипФайлаТабличногоДокумента.PDF);
		ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
	Исключение
		УдалитьВременныйФайл(ИмяВременногоФайла);
		ВызватьИсключение;
	КонецПопытки;

	УдалитьВременныйФайл(ИмяВременногоФайла);

	Возврат ДвоичныеДанные;

КонецФункции

Процедура УдалитьВременныйФайл(Знач ИмяФайла)

	Попытка
		УдалитьФайлы(ИмяФайла);
	Исключение
		// Временный файл удалит уборка каталога: терять из-за него результат
		// отправки незачем.
	КонецПопытки;

КонецПроцедуры

Процедура ЗаписатьОшибку(Знач Событие, Знач ИнформацияОбОшибке)

	ЗаписьЖурналаРегистрации(
		Событие,
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));

КонецПроцедуры

#КонецОбласти
