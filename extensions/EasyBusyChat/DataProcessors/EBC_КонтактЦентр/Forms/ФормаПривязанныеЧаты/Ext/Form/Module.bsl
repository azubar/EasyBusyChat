// Форма "Привязанные чаты".
//
// Одна форма на два сценария: привязать к объекту новый чат и посмотреть или
// изменить уже привязанные. Режимы переключаются тумблером, в подписи второго
// видно количество связей - понятно, есть ли что смотреть, не переключаясь.
//
// Параметры формы:
//  Объект        - ссылка на объект учётной системы, для которого открыта форма.
//                  Обязательный: без него форме нечего показывать.
//  РежимОткрытия - Строка - "Привязанные", чтобы открыться сразу во втором
//                  режиме. Любое другое значение либо отсутствие параметра -
//                  режим привязки.
//  РежимВыбора   - Булево - форма открыта, чтобы выбрать чат, а не изменить
//                  связи. Выбор строки возвращает чат вызывающей форме,
//                  кнопки привязки и отвязки скрыты. Так форма отправки
//                  сообщения даёт выбрать чат, не привязывая его заранее.
//
// Открывать форму следует в режиме БлокироватьОкноВладельца: она работает как
// диалог над формой объекта.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Параметры.Свойство("Объект", ОбъектСсылка);
	Параметры.Свойство("РежимВыбора", РежимВыбора);

	// Объект обязателен везде, кроме режима выбора: там форма только показывает
	// список чатов и связи объекта, если он передан, для неё не нужны.
	Если Не ЗначениеЗаполнено(ОбъектСсылка) И Не РежимВыбора Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	// Права проверяются до чтения: у формы нет своего способа объяснить отказ,
	// поэтому она просто не открывается.
	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.EBC_СвязиОбъектов)
		Или Не ПравоДоступа("Чтение", Метаданные.Справочники.EBC_Чаты) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ОбъектСсылка) Тогда
		ПредставлениеОбъекта = Строка(ОбъектСсылка);

		// Отбор по контрагенту есть не у всякого объекта: у справочника
		// контрагентов отбирать не по чему, у документа - есть.
		Контрагент = EBC_Ядро.КонтрагентОбъекта(ОбъектСсылка);
		ЕстьРеквизитКонтрагент = РегистрыСведений.EBC_ТипыОбъектовПривязки.ЕстьРеквизитКонтрагент(
			ОбъектСсылка.Метаданные());
	КонецЕсли;

	РежимОткрытия = "";
	Параметры.Свойство("РежимОткрытия", РежимОткрытия);
	РежимСписка = ?(ВРег(Строка(РежимОткрытия)) = ВРег("Привязанные"), 1, 0);

	// В режиме выбора форма ничего не меняет: связи не трогаются, чат просто
	// возвращается вызвавшей форме. Командные панели скрываются целиком -
	// разметка формы при этом не меняется.
	Если РежимВыбора Тогда
		Элементы.ПанельЧатов.Видимость = Ложь;
		Элементы.ПанельПривязанных.Видимость = Ложь;
		Заголовок = НСтр("ru = 'Выбор чата'; uk = 'Вибір чату'");

		// Отбор по контрагенту здесь не нужен и вреден: форму открыли именно
		// затем, чтобы выбрать чат из всех. С отбором в списке оставались одни
		// привязанные чаты контрагента, а кнопки "Все чаты", которой отбор
		// снимают, в этом режиме нет.
		Контрагент = Неопределено;
	КонецЕсли;

	ОбновитьДоступностьОтбораПоКонтрагенту();

	УстановитьУсловноеОформление();

	ЗаполнитьТаблицуПривязанных();
	ЗаполнитьТаблицуЧатов();
	ПрименитьРежим();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура РежимСпискаПриИзменении(Элемент)

	ПрименитьРежимНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОтборПоУчетнойЗаписиПриИзменении(Элемент)

	ЗаполнитьТаблицуЧатовНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СтрокаПоискаПриИзменении(Элемент)

	ЗаполнитьТаблицуЧатовНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЧатовВыбор(Элемент, Строка, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Если ЗавершитьВыбор(Элементы.ТаблицаЧатов) Тогда
		Возврат;
	КонецЕсли;

	ПривязатьИОткрытьЧатНажатие(Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПривязанныхВыбор(Элемент, Строка, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Если ЗавершитьВыбор(Элементы.ТаблицаПривязанных) Тогда
		Возврат;
	КонецЕсли;

	ОткрытьЧатНажатие(Неопределено);

КонецПроцедуры

// В режиме выбора двойной клик возвращает чат вызвавшей форме и закрывает эту.
//
// Возвращаемое значение:
//  Булево - Истина, если выбор обработан и делать больше нечего.
//
&НаКлиенте
Функция ЗавершитьВыбор(Знач ЭлементТаблицы)

	Если Не РежимВыбора Тогда
		Возврат Ложь;
	КонецЕсли;

	ТекущиеДанные = ЭлементТаблицы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	ОповеститьОВыборе(ТекущиеДанные.Ссылка);

	Возврат Истина;

КонецФункции

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьНажатие(Команда)

	// Загрузка идёт в том же вызове: пользователь нажал кнопку и ждёт
	// результата, а фоновое задание здесь означало бы список, который
	// обновится когда-нибудь потом.
	Состояние(
		НСтр(
			"ru = 'Загрузка чатов из Easy-Busy Chat…';
			|uk = 'Завантаження чатів з Easy-Busy Chat…'"));

	Результат = ОбновитьЧатыНаСервере();
	Состояние();

	Если Не ПустаяСтрока(Результат.Ошибка) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.Ошибка);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СнятьОтборПоКонтрагентуНажатие(Команда)

	СнятьОтборПоКонтрагентуНаСервере();

КонецПроцедуры

// Обычная и основная привязка - две отдельные кнопки, как в контакт-центре,
// а не кнопка с флажком: флажок в командной панели пришлось бы держать полем
// данных, а полей данных в командных панелях платформа не переваривает.
&НаКлиенте
Процедура ПривязатьНажатие(Команда)

	Чат = ТекущийЧатСписка(Элементы.ТаблицаЧатов, ТаблицаЧатов);
	Если Чат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПривязатьНаСервере(Чат, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ПривязатьОсновнымНажатие(Команда)

	Чат = ТекущийЧатСписка(Элементы.ТаблицаЧатов, ТаблицаЧатов);
	Если Чат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПривязатьНаСервере(Чат, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПривязатьИОткрытьЧатНажатие(Команда)

	Чат = ТекущийЧатСписка(Элементы.ТаблицаЧатов, ТаблицаЧатов);
	Если Чат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Связь устанавливается независимо от того, откроется ли окно чата:
	// пользователь нажал в том числе "привязать".
	ПривязатьНаСервере(Чат, Ложь);
	ОткрытьЧатВПлагине(Чат);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЧатНажатие(Команда)

	Чат = ТекущийЧатСписка(Элементы.ТаблицаПривязанных, ТаблицаПривязанных);
	Если Чат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОткрытьЧатВПлагине(Чат);

КонецПроцедуры

&НаКлиенте
Процедура СделатьОсновнымНажатие(Команда)

	Чат = ТекущийЧатСписка(Элементы.ТаблицаПривязанных, ТаблицаПривязанных);
	Если Чат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СделатьОсновнымНаСервере(Чат);

КонецПроцедуры

&НаКлиенте
Процедура ОтвязатьНажатие(Команда)

	Чат = ТекущийЧатСписка(Элементы.ТаблицаПривязанных, ТаблицаПривязанных);
	Если Чат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Отвязка необратима одним нажатием, поэтому спрашиваем подтверждение.
	Оповещение = Новый ОписаниеОповещения("ОтвязатьЗавершение", ЭтотОбъект, Чат);
	ПоказатьВопрос(
		Оповещение,
		СтрШаблон(
			НСтр(
				"ru = 'Отвязать чат ""%1"" от объекта?';
				|uk = 'Відв''язати чат ""%1"" від об''єкта?'"),
			Чат),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ОтвязатьЗавершение(Ответ, Чат) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ОтвязатьНаСервере(Чат);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Текущий чат таблицы либо Неопределено с объяснением пользователю.
&НаКлиенте
Функция ТекущийЧатСписка(Знач ЭлементТаблицы, Знач Таблица)

	ТекущиеДанные = ЭлементТаблицы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(
			,
			НСтр(
				"ru = 'Выберите чат в списке.';
				|uk = 'Виберіть чат у списку.'"));
		Возврат Неопределено;
	КонецЕсли;

	Возврат ТекущиеДанные.Ссылка;

КонецФункции

&НаКлиенте
Процедура ОткрытьЧатВПлагине(Знач Чат)

	// Проверяется до серверного вызова: в веб-клиенте открывать нечего.
	Если Не EBC_ВебПлагин.ПроверитьПоддержкуКлиента() Тогда
		Возврат;
	КонецЕсли;

	ДанныеОткрытия = ДанныеОткрытияЧата(Чат);
	Если Не ДанныеОткрытия.Успех Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(ДанныеОткрытия.Ошибка);
		Возврат;
	КонецЕсли;

	Попытка
		// Если окно чата уже открыто, компонента не переинициализируется.
		Результат = EBC_ВебПлагин.ПодготовитьКомпоненту(
			глКомпонентаEBC,
			ДанныеОткрытия.КомпанияEBC,
			ДанныеОткрытия.ИдентификаторАккаунта,
			ДанныеОткрытия.Провайдер);

		Если Результат.Успех Тогда
			Результат = EBC_ВебПлагин.ОткрытьЧат(
				глКомпонентаEBC,
				ДанныеОткрытия.ИдентификаторАккаунта,
				ДанныеОткрытия.Провайдер,
				ДанныеОткрытия.ЧатID,
				ДанныеОткрытия.КомпанияEBC);
		КонецЕсли;

		Если Не Результат.Успех Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.Ошибка);
		КонецЕсли;
	Исключение
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр(
				"ru = 'Не удалось открыть чат.';
				|uk = 'Не вдалося відкрити чат.'"));
	КонецПопытки;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ДанныеОткрытияЧата(Знач Чат)

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("ИдентификаторАккаунта", "");
	Результат.Вставить("ЧатID", "");
	Результат.Вставить("Провайдер", "");
	Результат.Вставить("КомпанияEBC", Справочники.EBC_Компании.ПустаяСсылка());

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Чаты.ИдентификаторEBC КАК ЧатID,
		|	Чаты.Владелец.ИдентификаторEBC КАК ИдентификаторАккаунта,
		|	Чаты.Владелец.Провайдер КАК Провайдер,
		|	Чаты.Владелец.Владелец КАК КомпанияEBC
		|ИЗ
		|	Справочник.EBC_Чаты КАК Чаты
		|ГДЕ
		|	Чаты.Ссылка = &Чат";
	Запрос.УстановитьПараметр("Чат", Чат);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Результат.Ошибка = НСтр(
			"ru = 'Чат не найден.';
			|uk = 'Чат не знайдено.'");
		Возврат Результат;
	КонецЕсли;

	Результат.ИдентификаторАккаунта = Выборка.ИдентификаторАккаунта;
	Результат.ЧатID = Выборка.ЧатID;
	Результат.Провайдер = XMLСтрока(Выборка.Провайдер);
	Результат.КомпанияEBC = Выборка.КомпанияEBC;
	Результат.Успех = Истина;

	Возврат Результат;

КонецФункции

&НаСервере
Процедура ПривязатьНаСервере(Знач Чат, Знач ЭтоОсновная)

	EBC_Ядро.ПривязатьЧат(Чат, ОбъектСсылка, ЭтоОсновная);

	ЗаполнитьТаблицуПривязанных();
	ЗаполнитьТаблицуЧатов();
	ОбновитьЗаголовокРежима();

КонецПроцедуры

&НаСервере
Процедура ОтвязатьНаСервере(Знач Чат)

	EBC_Ядро.ОтвязатьЧат(Чат, ОбъектСсылка);

	ЗаполнитьТаблицуПривязанных();
	ЗаполнитьТаблицуЧатов();
	ОбновитьЗаголовокРежима();

КонецПроцедуры

&НаСервере
Процедура СделатьОсновнымНаСервере(Знач Чат)

	// Отдельного метода "сделать основным" нет: повторная привязка с признаком
	// основной связи снимает признак с прежней и ставит на эту - ровно то,
	// что нужно, и без второго способа сделать то же самое.
	EBC_Ядро.ПривязатьЧат(Чат, ОбъектСсылка, Истина);

	ЗаполнитьТаблицуПривязанных();

КонецПроцедуры

// Подтягивает свежие чаты из Easy-Busy Chat и перечитывает списки.
//
// Берётся быстрая синхронизация EBC_Ядро.ЗагрузитьИзмененияЧатов: она
// читает по учётной записи ограниченное число страниц выдачи, а выдача
// отсортирована по убыванию времени последнего сообщения - то есть
// приходят именно свежие чаты, а не случайные.
//
// Возвращаемое значение:
//  Структура - Ошибка (Строка): текст для пользователя либо пустая строка.
//
&НаСервере
Функция ОбновитьЧатыНаСервере()

	Результат = Новый Структура("Ошибка", "");

	Если EBC_НастройкиПовтИсп.ТекущиеНастройки().Активен Тогда
		Попытка
			Загрузка = EBC_Ядро.ЗагрузитьИзмененияЧатов();
			Если Не Загрузка.Успех Тогда
				Результат.Ошибка = Загрузка.Ошибка;
			КонецЕсли;
		Исключение
			// Сервис недоступен - список всё равно надо перечитать: в базе
			// могли появиться чаты от регламентного задания.
			ЗаписьЖурналаРегистрации(
				"EBC_ПривязанныеЧаты.Обновить",
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Результат.Ошибка = НСтр(
				"ru = 'Не удалось загрузить чаты из Easy-Busy Chat.';
				|uk = 'Не вдалося завантажити чати з Easy-Busy Chat.'");
		КонецПопытки;
	КонецЕсли;

	ЗаполнитьТаблицуПривязанных();
	ЗаполнитьТаблицуЧатов();
	ОбновитьЗаголовокРежима();

	Возврат Результат;

КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуЧатовНаСервере()

	ЗаполнитьТаблицуЧатов();

КонецПроцедуры

&НаСервере
Процедура СнятьОтборПоКонтрагентуНаСервере()

	Контрагент = Неопределено;
	ОбновитьДоступностьОтбораПоКонтрагенту();
	ЗаполнитьТаблицуЧатов();

КонецПроцедуры

// Поле контрагента только для чтения, а снимается отбор кнопкой.
//
// Поле имеет тип ЛюбаяСсылка - иначе расширение не было бы универсальным.
// Редактируемое поле такого типа заставляет платформу строить список выбора
// из всех ссылочных типов конфигурации, а их здесь больше тысячи. Выбирать
// произвольного контрагента тут и не нужно: он приходит из объекта, а
// единственное осмысленное действие - снять отбор.
//
&НаСервере
Процедура ОбновитьДоступностьОтбораПоКонтрагенту()

	ЕстьОтбор = ЗначениеЗаполнено(Контрагент);

	Элементы.Контрагент.Видимость = ЕстьРеквизитКонтрагент И ЕстьОтбор;
	Элементы.КнопкаСнятьОтборПоКонтрагенту.Видимость = ЕстьОтбор;

КонецПроцедуры

// Основная связь выделяется жирным - как в таблице связанных чатов
// контакт-центра.
//
// Оформление строится кодом, а не хранится в Form.xml: компилятор форм
// (/form-compile) кодирует параметр "Шрифт" условного оформления как
// локализованную строку вместо v8ui:Font. Форма с таким блоком загружается
// в конфигурацию, но клиент при её открытии аварийно завершается.
//
&НаСервере
Процедура УстановитьУсловноеОформление()

	Элемент = УсловноеОформление.Элементы.Добавить();

	ОтборОформления = Элемент.Отбор.Элементы.Добавить(
		Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборОформления.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(
		"ТаблицаПривязанных.ОсновнаяСвязь");
	ОтборОформления.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборОформления.ПравоеЗначение = Истина;

	Элемент.Оформление.УстановитьЗначениеПараметра(
		"Шрифт",
		Новый Шрифт(, , Истина));

	ИменаПолей = Новый Массив;
	ИменаПолей.Добавить("ТаблицаПривязанныхСсылка");
	ИменаПолей.Добавить("ТаблицаПривязанныхПредставлениеУчетнойЗаписи");

	Для Каждого ИмяПоля Из ИменаПолей Цикл
		ПолеОформления = Элемент.Поля.Элементы.Добавить();
		ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		ПолеОформления.Использование = Истина;
	КонецЦикла;

	// В списке всех чатов жирным выделены те, что уже привязаны к
	// контрагенту объекта: обычно именно среди них и выбирают.
	ЭлементЧатов = УсловноеОформление.Элементы.Добавить();

	ОтборЧатов = ЭлементЧатов.Отбор.Элементы.Добавить(
		Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЧатов.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(
		"ТаблицаЧатов.ЧатКонтрагента");
	ОтборЧатов.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЧатов.ПравоеЗначение = Истина;

	ЭлементЧатов.Оформление.УстановитьЗначениеПараметра(
		"Шрифт",
		Новый Шрифт(, , Истина));

	ИменаПолейЧатов = Новый Массив;
	ИменаПолейЧатов.Добавить("ТаблицаЧатовСсылка");
	ИменаПолейЧатов.Добавить("ТаблицаЧатовПредставлениеУчетнойЗаписи");

	Для Каждого ИмяПоля Из ИменаПолейЧатов Цикл
		ПолеОформления = ЭлементЧатов.Поля.Элементы.Добавить();
		ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		ПолеОформления.Использование = Истина;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПрименитьРежимНаСервере()

	ПрименитьРежим();

КонецПроцедуры

&НаСервере
Процедура ПрименитьРежим()

	Элементы.СтраницыСписков.ТекущаяСтраница = ?(
		РежимСписка = 1,
		Элементы.СтраницаПривязанных,
		Элементы.СтраницаЧатов);

	ОбновитьЗаголовокРежима();

КонецПроцедуры

// Количество связей выводится прямо в подписи режима: пользователь видит,
// есть ли что смотреть, не переключаясь.
&НаСервере
Процедура ОбновитьЗаголовокРежима()

	КоличествоПривязанных = ТаблицаПривязанных.Количество();

	СписокВыбора = Элементы.РежимСписка.СписокВыбора;
	Если СписокВыбора.Количество() < 2 Тогда
		Возврат;
	КонецЕсли;

	СписокВыбора[1].Представление = СтрШаблон(
		НСтр(
			"ru = 'Привязанные чаты (%1)';
			|uk = 'Прив''язані чати (%1)'"),
		Формат(КоличествоПривязанных, "ЧН=0; ЧГ="));

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуПривязанных()

	// В режиме выбора объект может быть не задан - связей тогда нет по определению.
	Если Не ЗначениеЗаполнено(ОбъектСсылка) Тогда
		ТаблицаПривязанных.Очистить();
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Связи.Чат КАК Ссылка,
		|	Связи.Чат.Наименование КАК Наименование,
		|	Связи.Чат.Телефон КАК Телефон,
		|	Связи.Чат.ДатаПоследнегоСообщения КАК ДатаПоследнегоСообщения,
		|	Связи.Чат.ТекстПоследнегоСообщения КАК ТекстПоследнегоСообщения,
		|	Связи.Чат.Владелец КАК УчетнаяЗапись,
		|	Связи.Чат.Владелец.Наименование КАК НаименованиеУчетнойЗаписи,
		|	Связи.Чат.Владелец.Идентификатор КАК ИдентификаторУчетнойЗаписи,
		|	Связи.Чат.Владелец.Провайдер КАК Провайдер,
		|	Связи.ОсновнаяСвязь КАК ОсновнаяСвязь,
		|	Связи.ДатаУстановки КАК ДатаУстановки
		|ИЗ
		|	РегистрСведений.EBC_СвязиОбъектов КАК Связи
		|ГДЕ
		|	Связи.ТипОбъекта = &ТипОбъекта
		|	И Связи.ИдентификаторОбъекта = &ИдентификаторОбъекта
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаПоследнегоСообщения УБЫВ";
	Запрос.УстановитьПараметр("ТипОбъекта", EBC_Ядро.ИмяТаблицыПоСсылке(ОбъектСсылка));
	Запрос.УстановитьПараметр(
		"ИдентификаторОбъекта",
		ОбъектСсылка.УникальныйИдентификатор());

	ЗаполнитьТаблицуЧатовПоВыборке(ТаблицаПривязанных, Запрос.Выполнить().Выбрать());

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуЧатов()

	// Отбор по контрагенту - это отбор по чатам, привязанным к контрагенту:
	// именно из них выбирают, когда привязывают чат к его накладной.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Чаты.Ссылка КАК Ссылка,
		|	Чаты.Наименование КАК Наименование,
		|	Чаты.Телефон КАК Телефон,
		|	Чаты.ДатаПоследнегоСообщения КАК ДатаПоследнегоСообщения,
		|	Чаты.ТекстПоследнегоСообщения КАК ТекстПоследнегоСообщения,
		|	Чаты.Владелец КАК УчетнаяЗапись,
		|	Чаты.Владелец.Наименование КАК НаименованиеУчетнойЗаписи,
		|	Чаты.Владелец.Идентификатор КАК ИдентификаторУчетнойЗаписи,
		|	Чаты.Владелец.Провайдер КАК Провайдер
		|ИЗ
		|	Справочник.EBC_Чаты КАК Чаты
		|ГДЕ
		|	НЕ Чаты.ПометкаУдаления
		|	И (&ВсеУчетныеЗаписи
		|			ИЛИ Чаты.Владелец = &УчетнаяЗапись)
		|	И (&БезПоиска
		|			ИЛИ НРЕГ(Чаты.Наименование) ПОДОБНО &СтрокаПоиска
		|			ИЛИ НРЕГ(Чаты.Телефон) ПОДОБНО &СтрокаПоиска
		|			ИЛИ НРЕГ(Чаты.ТекстПоследнегоСообщения) ПОДОБНО &СтрокаПоиска)
		|	И (&БезКонтрагента
		|			ИЛИ Чаты.Ссылка В
		|				(ВЫБРАТЬ Связи.Чат
		|				ИЗ РегистрСведений.EBC_СвязиОбъектов КАК Связи
		|				ГДЕ Связи.ТипОбъекта = &ТипКонтрагента
		|					И Связи.ИдентификаторОбъекта = &ИдентификаторКонтрагента))
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаПоследнегоСообщения УБЫВ";

	СтрокаОтбора = НРег(СокрЛП(СтрокаПоиска));
	Запрос.УстановитьПараметр("БезПоиска", ПустаяСтрока(СтрокаОтбора));
	Запрос.УстановитьПараметр("СтрокаПоиска", "%" + СтрокаОтбора + "%");
	Запрос.УстановитьПараметр("ВсеУчетныеЗаписи", Не ЗначениеЗаполнено(ОтборПоУчетнойЗаписи));
	Запрос.УстановитьПараметр("УчетнаяЗапись", ОтборПоУчетнойЗаписи);

	ЕстьКонтрагент = ЗначениеЗаполнено(Контрагент);
	Запрос.УстановитьПараметр("БезКонтрагента", Не ЕстьКонтрагент);
	Запрос.УстановитьПараметр(
		"ТипКонтрагента",
		?(ЕстьКонтрагент, EBC_Ядро.ИмяТаблицыПоСсылке(Контрагент), ""));
	Запрос.УстановитьПараметр(
		"ИдентификаторКонтрагента",
		?(ЕстьКонтрагент,
			Контрагент.УникальныйИдентификатор(),
			Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000")));

	ЗаполнитьТаблицуЧатовПоВыборке(ТаблицаЧатов, Запрос.Выполнить().Выбрать());

	ОтметитьЧатыКонтрагента();

КонецПроцедуры

// Помечает чаты, привязанные к контрагенту объекта, - условное оформление
// выводит такие строки жирным.
//
// Если контрагента у объекта нет (например, форма открыта из справочника
// контрагентов), берутся связи самого объекта: смысл пометки тот же -
// "этот чат уже относится к тому, с кем вы работаете".
//
&НаСервере
Процедура ОтметитьЧатыКонтрагента()

	ВладелецСвязей = ?(Контрагент = Неопределено, ОбъектСсылка, Контрагент);
	Если Не ЗначениеЗаполнено(ВладелецСвязей) Тогда
		Возврат;
	КонецЕсли;

	ЧатыВладельца = Новый Соответствие;
	Для Каждого Чат Из EBC_Ядро.ЧатыОбъекта(ВладелецСвязей) Цикл
		ЧатыВладельца.Вставить(Чат, Истина);
	КонецЦикла;

	Для Каждого Строка Из ТаблицаЧатов Цикл
		Строка.ЧатКонтрагента = (ЧатыВладельца.Получить(Строка.Ссылка) <> Неопределено);
	КонецЦикла;

КонецПроцедуры

// Общее заполнение для обеих таблиц: колонки у них совпадают, и расходиться
// представление учётной записи и картинка провайдера не должны.
&НаСервере
Процедура ЗаполнитьТаблицуЧатовПоВыборке(Таблица, Выборка)

	Таблица.Очистить();

	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.КартинкаПровайдера = EBC_Ядро.ИндексКартинкиПровайдера(
			Выборка.Провайдер);
		НоваяСтрока.ПредставлениеУчетнойЗаписи = ПредставлениеУчетнойЗаписи(
			Выборка.НаименованиеУчетнойЗаписи,
			Выборка.ИдентификаторУчетнойЗаписи);
	КонецЦикла;

КонецПроцедуры

// "Наименование · телефон". У ботов и веб-чата телефона нет - остаётся
// одно наименование.
&НаСервереБезКонтекста
Функция ПредставлениеУчетнойЗаписи(Знач Наименование, Знач Идентификатор)

	Наименование = СокрЛП(Строка(Наименование));
	Идентификатор = СокрЛП(Строка(Идентификатор));

	Если ПустаяСтрока(Идентификатор) Или Идентификатор = Наименование Тогда
		Возврат Наименование;
	КонецЕсли;

	Возврат Наименование + " · " + Идентификатор;

КонецФункции

#КонецОбласти
