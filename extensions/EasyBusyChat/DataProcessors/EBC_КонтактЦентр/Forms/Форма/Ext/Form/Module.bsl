&НаКлиенте
Процедура ПослеВыбораПечатнойФормыДляКартинки(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОтправитьПечатнуюФормуКартинкойВЧат(ВыбранныйЭлемент.Значение);

КонецПроцедуры

// Формирует выбранную печатную форму в JPEG и отправляет файл
// в основной чат выбранного контрагента.
//
&НаКлиенте
Процедура ОтправитьПечатнуюФормуКартинкойВЧат(Знач ИдентификаторПечатнойФормы)

	ЧатОтправки = ЧатДляОтправкиКлиент();
	Если Не ЗначениеЗаполнено(ЧатОтправки) Тогда
		ПоказатьПредупреждение(, ТекстНетЧатаДляОтправки());
		Возврат;
	КонецЕсли;

	РезультатОтправки = ОтправитьПечатнуюФормуКартинкойВЧатНаСервере(
		ЧатОтправки,
		ТекущийДокумент,
		ИдентификаторПечатнойФормы);

	Если Не РезультатОтправки.Успех Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатОтправки.ТекстОшибки);
		Возврат;
	КонецЕсли;

	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Отправка файла'; uk = 'Відправка файлу'"),
		,
		РезультатОтправки.ТекстРезультата);

КонецПроцедуры

// Формирует выбранную печатную форму в PDF и отправляет файл
// в основной чат выбранного контрагента.
//
&НаКлиенте
Процедура ОтправитьПечатнуюФормуВЧат(Знач ИдентификаторПечатнойФормы)

	ЧатОтправки = ЧатДляОтправкиКлиент();
	Если Не ЗначениеЗаполнено(ЧатОтправки) Тогда
		ПоказатьПредупреждение(, ТекстНетЧатаДляОтправки());
		Возврат;
	КонецЕсли;

	РезультатОтправки = ОтправитьПечатнуюФормуВЧатНаСервере(
		ЧатОтправки,
		ТекущийДокумент,
		ИдентификаторПечатнойФормы);

	Если Не РезультатОтправки.Успех Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатОтправки.ТекстОшибки);
		Возврат;
	КонецЕсли;

	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Отправка файла'; uk = 'Відправка файлу'"),
		,
		РезультатОтправки.ТекстРезультата);

КонецПроцедуры

// Определяет чат-адресат для отправки по текущему документу.
//
// Порядок выбора:
//  1) основной чат, привязанный к самому документу;
//  2) основной чат контрагента;
//  3) чат, выбранный оператором в списке чатов (прежнее поведение).
//
&НаКлиенте
Функция ЧатДляОтправкиКлиент()

	Чат = ЧатДляОтправкиНаСервере(ТекущийДокумент, ТекущийКонтрагент);
	Если ЗначениеЗаполнено(Чат) Тогда
		Возврат Чат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ТекущийЧат) Тогда
		Возврат ТекущийЧат;
	КонецЕсли;

	Возврат ВыбранныйЧат;

КонецФункции

&НаСервереБезКонтекста
Функция ЧатДляОтправкиНаСервере(Знач СсылкаНаДокумент, Знач Контрагент)

	Если ЗначениеЗаполнено(СсылкаНаДокумент) Тогда
		ЧатДокумента = EBC_Ядро.ОсновнойЧатОбъекта(СсылкаНаДокумент);
		Если ЗначениеЗаполнено(ЧатДокумента) Тогда
			Возврат ЧатДокумента;
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(Контрагент) Тогда
		Возврат EBC_Ядро.ОсновнойЧатОбъекта(Контрагент);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ТекстНетЧатаДляОтправки()

	Возврат НСтр(
		"ru = 'Не найден чат для отправки. Свяжите документ или контрагента с чатом либо выберите чат в списке.';
		|uk = 'Не знайдено чат для надсилання. Зв''яжіть документ або контрагента з чатом чи оберіть чат у списку.'");

КонецФункции


// Возвращает список доступных пользователю печатных форм документа.
// Состав определяет механизм печати БСП через EBC_АдаптерКонфигурации.
//
&НаСервереБезКонтекста
Функция ДоступныеПечатныеФормыНаСервере(Знач СсылкаНаДокумент)

	Результат = Новый СписокЗначений;
	Если Не ЗначениеЗаполнено(СсылкаНаДокумент) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		ПечатныеФормы = EBC_АдаптерКонфигурации.ПолучитьДоступныеПечатныеФормы(СсылкаНаДокумент);
	Исключение
		ЗаписьЖурналаРегистрации(
			"EBC_КонтактЦентр.ПолучитьПечатныеФормы",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	Для Каждого ПечатнаяФорма Из ПечатныеФормы Цикл
		Результат.Добавить(
			ПечатнаяФорма.Идентификатор,
			ПечатнаяФорма.Представление);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ОтправитьПечатнуюФормуВЧатНаСервере(
		Знач Чат,
		Знач СсылкаНаДокумент,
		Знач ИдентификаторПечатнойФормы)

	Результат = Новый Структура(
		"Успех,ТекстОшибки",
		Ложь,
		НСтр(
			"ru = 'Easy Busy Chat не принял печатную форму.';
			|uk = 'Easy Busy Chat не прийняв друковану форму.'"));

	Попытка
		ДвоичныеДанные = EBC_АдаптерКонфигурации.СформироватьPDFПечатнойФормы(
			СсылкаНаДокумент,
			ИдентификаторПечатнойФормы);
	Исключение
		ЗаписьЖурналаРегистрации(
			"EBC_КонтактЦентр.СформироватьПечатнуюФорму",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ОписаниеОшибки());
		Результат.ТекстОшибки = НСтр(
			"ru = 'Не удалось сформировать печатную форму документа.';
			|uk = 'Не вдалося сформувати друковану форму документа.'");
		Возврат Результат;
	КонецПопытки;

	ПредставлениеДокумента = Строка(СсылкаНаДокумент);

	// Имя собирается общей функцией: представление документа содержит время,
	// а с двоеточиями файл не примет ни файловая система, ни сервис.
	ИмяФайла = EBC_ПечатьДокументов.ИмяФайлаПечатнойФормы(
		ПредставлениеДокумента);

	Попытка
		РезультатОтправки = EBC_Ядро.ОтправитьФайлВЧат(
			Чат,
			ДвоичныеДанные,
			ИмяФайла,
			ПредставлениеДокумента);
	Исключение
		ЗаписьЖурналаРегистрации(
			"EBC_КонтактЦентр.ОтправитьПечатнуюФорму",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ОписаниеОшибки());
		Результат.ТекстОшибки = НСтр(
			"ru = 'Не удалось отправить печатную форму в чат.';
			|uk = 'Не вдалося надіслати друковану форму в чат.'");
		Возврат Результат;
	КонецПопытки;

	Результат.Успех = РезультатОтправки.Успех;
	Результат.Вставить("ТекстРезультата", "");
	Если Результат.Успех Тогда Результат.ТекстРезультата = РезультатОтправки.ТекстРезультата; КонецЕсли;
	Если Не Результат.Успех
		И РезультатОтправки.Свойство("Ошибка")
		И Не ПустаяСтрока(РезультатОтправки.Ошибка) Тогда
		Результат.ТекстОшибки = РезультатОтправки.Ошибка;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ОтправитьПечатнуюФормуКартинкойВЧатНаСервере(
		Знач Чат,
		Знач СсылкаНаДокумент,
		Знач ИдентификаторПечатнойФормы)

	Результат = Новый Структура(
		"Успех,ТекстОшибки",
		Ложь,
		НСтр(
			"ru = 'Easy Busy Chat не принял изображение печатной формы.';
			|uk = 'Easy Busy Chat не прийняв зображення друкованої форми.'"));

	Попытка
		ДвоичныеДанные = EBC_АдаптерКонфигурации.СформироватьJPEGПечатнойФормы(
			СсылкаНаДокумент,
			ИдентификаторПечатнойФормы);
	Исключение
		ЗаписьЖурналаРегистрации(
			"EBC_КонтактЦентр.СформироватьПечатнуюФормуКартинкой",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ОписаниеОшибки());
		Результат.ТекстОшибки = НСтр(
			"ru = 'Не удалось сформировать изображение печатной формы документа.';
			|uk = 'Не вдалося сформувати зображення друкованої форми документа.'");
		Возврат Результат;
	КонецПопытки;

	ПредставлениеДокумента = Строка(СсылкаНаДокумент);
	ИмяФайла = EBC_ПечатьДокументов.ИмяФайлаПечатнойФормы(
		ПредставлениеДокумента,
		,
		"jpg");

	Попытка
		РезультатОтправки = EBC_Ядро.ОтправитьФайлВЧат(
			Чат,
			ДвоичныеДанные,
			ИмяФайла,
			ПредставлениеДокумента,
			"Photo",
			"image/jpeg",
			"jpg");
	Исключение
		ЗаписьЖурналаРегистрации(
			"EBC_КонтактЦентр.ОтправитьПечатнуюФормуКартинкой",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ОписаниеОшибки());
		Результат.ТекстОшибки = НСтр(
			"ru = 'Не удалось отправить изображение печатной формы в чат.';
			|uk = 'Не вдалося надіслати зображення друкованої форми в чат.'");
		Возврат Результат;
	КонецПопытки;

	Результат.Успех = РезультатОтправки.Успех;
	Результат.Вставить("ТекстРезультата", "");
	Если Результат.Успех Тогда Результат.ТекстРезультата = РезультатОтправки.ТекстРезультата; КонецЕсли;
	Если Не Результат.Успех
		И РезультатОтправки.Свойство("Ошибка")
		И Не ПустаяСтрока(РезультатОтправки.Ошибка) Тогда
		Результат.ТекстОшибки = РезультатОтправки.Ошибка;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Открывает в веб-плагине чат текущего контрагента.
//
// Порядок выбора: основной чат контрагента, при его отсутствии - последний
// привязанный к контрагенту.
//
&НаКлиенте
Процедура ОткрытьЧатПоКонтрагенту(Команда)

	Если Не ЗначениеЗаполнено(ТекущийКонтрагент) Тогда
		ПоказатьПредупреждение(
			,
			НСтр(
				"ru = 'Выберите контрагента в списке.';
				|uk = 'Оберіть контрагента у списку.'"));
		Возврат;
	КонецЕсли;

	Чат = ЧатДляОткрытияНаСервере(ТекущийКонтрагент);
	Если Не ЗначениеЗаполнено(Чат) Тогда
		ПоказатьПредупреждение(
			,
			НСтр(
				"ru = 'К выбранному контрагенту не привязан ни один чат.';
				|uk = 'До обраного контрагента не прив''язано жодного чату.'"));
		Возврат;
	КонецЕсли;

	ОткрытьОкноЧатаКлиент(Чат);

КонецПроцедуры

// Открывает форму отправки сообщения с заготовкой текста по текущему документу.
//
&НаКлиенте
Процедура ОтправитьСообщение(Команда)

	Если Не ЗначениеЗаполнено(ТекущийКонтрагент) Тогда
		ПоказатьПредупреждение(
			,
			НСтр(
				"ru = 'Выберите контрагента для отправки сообщения.';
				|uk = 'Оберіть контрагента для надсилання повідомлення.'"));
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущийДокумент) Тогда
		ПоказатьПредупреждение(
			,
			НСтр(
				"ru = 'Выберите документ для отправки сообщения!';
				|uk = 'Оберіть документ для надсилання повідомлення!'"));
		Возврат;
	КонецЕсли;

	ЧатОтправки = ЧатДляОтправкиКлиент();
	Если Не ЗначениеЗаполнено(ЧатОтправки) Тогда
		ПоказатьПредупреждение(, ТекстНетЧатаДляОтправки());
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Чат", ЧатОтправки);
	ПараметрыФормы.Вставить("Документ", ТекущийДокумент);

	ОткрытьФорму(
		"Обработка.EBC_КонтактЦентр.Форма.ФормаОтправкиСообщения",
		ПараметрыФормы,
		ЭтотОбъект,
		,
		,
		,
		,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура СвязанныеДокументыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	ТекущиеДанные = Элементы.СвязанныеДокументы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено
		Или Не ЗначениеЗаполнено(ТекущиеДанные.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	ТекущийДокумент = ТекущиеДанные.Ссылка;
	ОткрытьДокументКлиент(ТекущийДокумент);

КонецПроцедуры

// Открывает в веб-плагине чат текущего документа списка связанных документов.
//
// Порядок выбора:
//  1) чат самого документа: основной, при его отсутствии - последний привязанный;
//  2) чат контрагента этого документа по тому же правилу.
//
&НаКлиенте
Процедура ОткрытьЧатПоДокументу(Команда)

	ТекущиеДанные = Элементы.СвязанныеДокументы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено
		Или Не ЗначениеЗаполнено(ТекущиеДанные.Ссылка) Тогда
		ПоказатьПредупреждение(
			,
			НСтр(
				"ru = 'Выберите документ в списке.';
				|uk = 'Оберіть документ у списку.'"));
		Возврат;
	КонецЕсли;

	// Контрагент берется из строки документа: список может быть заполнен
	// документами, у которых он отличается от выбранного в списке контрагентов.
	КонтрагентДокумента = ТекущиеДанные.Контрагент;
	Если Не ЗначениеЗаполнено(КонтрагентДокумента) Тогда
		КонтрагентДокумента = ТекущийКонтрагент;
	КонецЕсли;

	Чат = ЧатДокументаДляОткрытияНаСервере(
		ТекущиеДанные.Ссылка,
		КонтрагентДокумента);

	Если Не ЗначениеЗаполнено(Чат) Тогда
		ПоказатьПредупреждение(
			,
			НСтр(
				"ru = 'Нет чатов, привязанных к документу или к его контрагенту.';
				|uk = 'Немає чатів, прив''язаних до документа або до його контрагента.'"));
		Возврат;
	КонецЕсли;

	ОткрытьОкноЧатаКлиент(Чат);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЧатДляОткрытияНаСервере(Знач Объект)

	Если Не ЗначениеЗаполнено(Объект) Тогда
		Возврат Справочники.EBC_Чаты.ПустаяСсылка();
	КонецЕсли;

	Возврат EBC_Ядро.ЧатОбъектаДляОткрытия(Объект);

КонецФункции

&НаСервереБезКонтекста
Функция ЧатДокументаДляОткрытияНаСервере(Знач СсылкаНаДокумент, Знач Контрагент)

	Если ЗначениеЗаполнено(СсылкаНаДокумент) Тогда
		ЧатДокумента = EBC_Ядро.ЧатОбъектаДляОткрытия(СсылкаНаДокумент);
		Если ЗначениеЗаполнено(ЧатДокумента) Тогда
			Возврат ЧатДокумента;
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(Контрагент) Тогда
		Возврат EBC_Ядро.ЧатОбъектаДляОткрытия(Контрагент);
	КонецЕсли;

	Возврат Справочники.EBC_Чаты.ПустаяСсылка();

КонецФункции

// Включает и выключает отбор списка контрагентов по телефону текущего чата.
//
// Режим держится на пометке кнопки: пока она стоит, список показывает только тех
// контрагентов, у кого записан телефон выбранного чата, и переключается на новый
// номер при смене чата. Пустой телефон отбор снимает, но режим не выключает.
//
// Штатную строку поиска списка (КонтрагентыСтрокаПоиска) заполнить из кода
// нельзя: это дополнение элемента формы, доступное только на чтение, и ищет
// оно по полям самого списка, а телефона среди них нет - он хранится в
// контактной информации контрагента. Поэтому телефон ищется запросом, а список
// ограничивается отбором по найденным контрагентам.
//
&НаКлиенте
Процедура НайтиКонтрагентаПоНомеруТелефона(Команда)

	// Состав списка меняет отбор, поэтому перечитывать его вручную не нужно.
	ПереключитьОтборКонтрагентовПоТелефонуНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПереключитьОтборКонтрагентовПоТелефонуНаСервере()

	ОтборКонтрагентовПоТелефонуВключен = Не ОтборКонтрагентовПоТелефонуВключен;
	Элементы.НайтиКонтрагентаПоНомеруТелефона.Пометка =
		ОтборКонтрагентовПоТелефонуВключен;

	// И при выключении, и при включении начинаем с чистого состояния: прежний
	// отбор снят, запомненный номер сброшен - тогда включение применит текущий
	// телефон заново, даже если чат с прошлого раза не менялся.
	СнятьОтборКонтрагентовПоТелефону();
	ТелефонОтбораКонтрагентов = "";

	ПрименитьОтборКонтрагентовПоТелефонуЧата();

КонецПроцедуры

// Приводит отбор списка контрагентов в соответствие с телефоном текущего чата.
//
// Вызывается при каждом обновлении зависимых данных, то есть и после смены чата.
//
&НаСервере
Процедура ПрименитьОтборКонтрагентовПоТелефонуЧата()

	Если Не ОтборКонтрагентовПоТелефонуВключен Тогда
		Возврат;
	КонецЕсли;

	ТелефонЧата = СокрЛП(Строка(КарточкаЧатаТелефон));

	// Повторно применять тот же номер нельзя: смена настроек заставляет список
	// перечитаться, перечитывание двигает текущую строку, активизация строки
	// снова приводит сюда - и так по кругу.
	Если ТелефонЧата = ТелефонОтбораКонтрагентов Тогда
		Возврат;
	КонецЕсли;

	ТелефонОтбораКонтрагентов = ТелефонЧата;

	Если ПустаяСтрока(ТелефонЧата) Тогда
		СнятьОтборКонтрагентовПоТелефону();
		Возврат;
	КонецЕсли;

	// Пустой массив - тоже результат: список окажется пустым, и это честно
	// показывает, что контрагента с таким телефоном в базе нет.
	УстановитьОтборКонтрагентовПоТелефону(
		КонтрагентыПоТелефону(ТелефонЧата));

КонецПроцедуры

// Поиск ведется по последним 10 цифрам, поэтому формат записи номера
// у контрагента значения не имеет.
//
&НаСервереБезКонтекста
Функция КонтрагентыПоТелефону(Знач Телефон)

	Результат = Новый Массив;

	Кандидаты = EBC_АдаптерКонфигурации.НайтиКонтрагентовПоКонтактам(
		Телефон,
		"");
	Для Каждого Кандидат Из Кандидаты Цикл
		Результат.Добавить(Кандидат.Ссылка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Процедура УстановитьОтборКонтрагентовПоТелефону(Знач Контрагенты)

	// Отбор ставится в фиксированные настройки (режим отображения по умолчанию -
	// Недоступный): состоянием управляет пометка кнопки, и снятие отбора вручную
	// через настройки списка рассогласовало бы их. Заодно такой отбор не попадает
	// в пользовательские настройки и не остается в списке после закрытия формы.
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		СписокКонтрагентов,
		"Ссылка",
		Контрагенты,
		ВидСравненияКомпоновкиДанных.ВСписке,
		ПредставлениеОтбораПоТелефону(),
		Истина);

КонецПроцедуры

&НаСервере
Процедура СнятьОтборКонтрагентовПоТелефону()

	// Удаление именно по представлению: по имени поля снялись бы и отборы
	// по ссылке, установленные пользователем.
	ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(
		СписокКонтрагентов,
		,
		ПредставлениеОтбораПоТелефону());

КонецПроцедуры

// Представление служит и подписью отбора, и признаком "отбор поставлен кнопкой".
//
&НаСервереБезКонтекста
Функция ПредставлениеОтбораПоТелефону()

	Возврат НСтр(
		"ru = 'Поиск по телефону чата';
		|uk = 'Пошук за телефоном чату'");

КонецФункции

// Переключает режим просмотра списка контрагентов.
//
// По умолчанию список плоский: оператор ищет контрагента по имени или телефону,
// и группы ему при этом только мешают. Отображение списком задано у таблицы в
// форме, поэтому при открытии формы дополнительная настройка не нужна.
//
// Пометка на кнопке включает иерархию по группам и снимается повторным нажатием.
//
&НаКлиенте
Процедура ИерархическийПросмотрСпискаКонтрагентов(Команда)

	Кнопка = Элементы.ФормаИерархическийПросмотрСпискаКонтрагентов;
	Кнопка.Пометка = Не Кнопка.Пометка;

	Если Кнопка.Пометка Тогда
		Элементы.СписокКонтрагентов.Отображение =
			ОтображениеТаблицы.ИерархическийСписок;
	Иначе
		Элементы.СписокКонтрагентов.Отображение =
			ОтображениеТаблицы.Список;
	КонецЕсли;

	// Смена режима перестраивает список, поэтому текущая строка возвращается явно:
	// иначе выбранный контрагент и все зависимые от него данные разъезжаются.
	Если ЗначениеЗаполнено(ТекущийКонтрагент) Тогда
		Элементы.СписокКонтрагентов.ТекущаяСтрока = ТекущийКонтрагент;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

