Процедура ОтправитьКартинкойНажатие(Команда)

	Если Не ЗначениеЗаполнено(ТекущийКонтрагент) Тогда
		ПоказатьПредупреждение(
			,
			НСтр(
				"ru = 'Выберите контрагента для отправки файла.';
				|uk = 'Оберіть контрагента для надсилання файлу.'"));
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущийДокумент) Тогда
		ПоказатьПредупреждение(
			,
			НСтр("ru = 'Выберите документ для отправки!'; uk = 'Оберіть документ для відправки!'"));
		Возврат;
	КонецЕсли;

	ПечатныеФормы = ДоступныеПечатныеФормыНаСервере(ТекущийДокумент);
	Если ПечатныеФормы.Количество() = 0 Тогда
		ПоказатьПредупреждение(
