
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	РежимВыбора = Ложь;
	Параметры.Свойство("РежимВыбора", РежимВыбора);
	КомпанияEBC = Неопределено;
	Если Параметры.Свойство("КомпанияEBC", КомпанияEBC)
		И ЗначениеЗаполнено(КомпанияEBC) Тогда
		Объект.КомпанияEBC = КомпанияEBC;
	КонецЕсли;
	Если Параметры.Свойство("ЧатId") Тогда
		ТекущийЧатId = Параметры.ЧатId;
	КонецЕсли;

	ЗаполнитьКомпаниюEBCНаСервере();
	ЗаполнитьЧатыНаСервере();
	ОчиститьКарточкуЧатаНаСервере();
	УстановитьКонтрагентаДляСпискаТелефоновНаСервере(Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Веб-плагин при открытии формы не подключается и окно чата не открывается:
	// это делают команды открытия чата по явному действию пользователя.

	Если Не ПустаяСтрока(ТекущийЧатId) Тогда
		УстановитьВыбранныйЧатПоИдентификаторуНаСервере(ТекущийЧатId);
	КонецЕсли;

	ОбновитьСписокКонтрагентов();

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	EBC_ВебПлагин.ЗакрытьКомпоненту(глКомпонентаEBC);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "EBC_ПозиционироватьКонтактЦентр" Тогда
		ТекущийЧатId = СокрЛП(Строка(Параметр));
		Если ПустаяСтрока(ТекущийЧатId) Тогда
			Возврат;
		КонецЕсли;

		УстановитьВыбранныйЧатПоИдентификаторуНаСервере(
			ТекущийЧатId);
		ТекущийЧат = ВыбранныйЧат;
		ВосстановитьТекущуюСтрокуЧата();
		// Состав списка контрагентов от выбранного чата не зависит,
		// поэтому перечитывается только то, что зависит от чата.
		ОбновитьЗависимыеДанные();

	ИначеЕсли ИмяСобытия = "EBC_ПолученоУведомлениеЧата" Тогда
		ОбновленныйЧат = EBC_ЧатВызовСервера.ОбновитьЧатПоУведомлению(
			Параметр);
		Если Не ЗначениеЗаполнено(ОбновленныйЧат) Тогда
			Возврат;
		КонецЕсли;

		// После обновления список перечитывается и сортируется по дате,
		// при этом выбранный оператором чат остается активным.
		ЗаполнитьЧатыНаСервере();
		ВосстановитьТекущуюСтрокуЧата();
		Если ОбновленныйЧат = ВыбранныйЧат Тогда
			ОбновитьЗависимыеДанные();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыбранныйЧатПриИзменении(Элемент)
	ТекущийЧат = ВыбранныйЧат;
	ОбновитьЗависимыеДанные();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЧатовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ТаблицаЧатов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗапомнитьТекущийЧат();
	// Выбор строки - явное действие пользователя, данные читаются сразу.
	ОбновитьЗависимыеДанные();

	Если Не ЗначениеЗаполнено(ВыбранныйЧат) Тогда
		Возврат;
	КонецЕсли;

	ОткрытьОкноЧатаКлиент();

КонецПроцедуры

// Активизация строки только запоминает текущий чат и планирует обновление
// зависимых данных. Окно веб-плагина при этом не открывается.
//
&НаКлиенте
Процедура ТаблицаЧатовПриАктивизацииСтроки(Элемент)

	Если Не ЗапомнитьТекущийЧат() Тогда
		Возврат;
	КонецЕсли;

	ОтложитьОбновлениеЗависимыхДанных();

КонецПроцедуры

&НаКлиенте
Процедура СписокКонтрагентовПриАктивизацииСтроки(Элемент)

	Если Не ЗапомнитьТекущегоКонтрагента() Тогда
		Возврат;
	КонецЕсли;

	ОтложитьОбновлениеЗависимыхДанных();

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСвязанныхЧатовПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.ТаблицаСвязанныхЧатов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		НовыйСвязанныйЧат = Неопределено;
	Иначе
		НовыйСвязанныйЧат = ТекущиеДанные.Ссылка;
	КонецЕсли;

	Если ТекущийСвязанныйЧат = НовыйСвязанныйЧат Тогда
		Возврат;
	КонецЕсли;

	ТекущийСвязанныйЧат = НовыйСвязанныйЧат;
	ПодключитьОбработчикОжидания(
		"Подключаемый_ОбновитьКарточкуСвязанногоЧата",
		0.3,
		Истина);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКарточкуСвязанногоЧата()
	ОтключитьОбработчикОжидания("Подключаемый_ОбновитьКарточкуСвязанногоЧата");
	ЗаполнитьКарточкуСвязанногоЧатаНаСервере();
КонецПроцедуры

// Двойной клик по связанному чату открывает его в веб-плагине.
//
&НаКлиенте
Процедура ТаблицаСвязанныхЧатовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	ТекущиеДанные = Элементы.ТаблицаСвязанныхЧатов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено
		Или Не ЗначениеЗаполнено(ТекущиеДанные.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	Если ТекущийСвязанныйЧат <> ТекущиеДанные.Ссылка Тогда
		ТекущийСвязанныйЧат = ТекущиеДанные.Ссылка;
	КонецЕсли;

	ОтключитьОбработчикОжидания("Подключаемый_ОбновитьКарточкуСвязанногоЧата");
	ЗаполнитьКарточкуСвязанногоЧатаНаСервере();

	ОткрытьОкноЧатаКлиент(ТекущийСвязанныйЧат);

КонецПроцедуры

&НаКлиенте
Процедура СвязанныеДокументыПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.СвязанныеДокументы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		НовыйТекущийДокумент = Неопределено;
	Иначе
		НовыйТекущийДокумент = ТекущиеДанные.Ссылка;
	КонецЕсли;

	Если НовыйТекущийДокумент = ТекущийДокумент Тогда
		Возврат;
	КонецЕсли;

	ТекущийДокумент = НовыйТекущийДокумент;

КонецПроцедуры

#КонецОбласти

#Область Инициализация

&НаСервере
Процедура УстановитьКонтрагентаДляСпискаТелефоновНаСервере(Знач Контрагент)

	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;

	ТаблицаТелефонов = EBC_АдаптерКонфигурации.
		ПолучитьТелефоныКонтрагентаСКонтактнымиЛицами(Контрагент);
	ЗначениеВРеквизитФормы(ТаблицаТелефонов, "ТаблицаКонтактов");

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКомпаниюEBCНаСервере()

	Если ЗначениеЗаполнено(Объект.КомпанияEBC) Тогда
		Возврат;
	КонецЕсли;

	Если Не ПустаяСтрока(ТекущийЧатId) Тогда
		Объект.КомпанияEBC = ПолучитьКомпаниюЧатаНаСервере(ТекущийЧатId);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.КомпанияEBC) Тогда
		Объект.КомпанияEBC = ПолучитьКомпаниюПоУмолчаниюНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКомпаниюЧатаНаСервере(Знач ИдентификаторЧата)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 2
		| Чаты.Владелец.Владелец КАК Компания
		|ИЗ
		| Справочник.EBC_Чаты КАК Чаты
		|ГДЕ
		| Чаты.ИдентификаторEBC = &ИдентификаторЧата
		| И НЕ Чаты.ПометкаУдаления";
	Запрос.УстановитьПараметр(
		"ИдентификаторЧата",
		СокрЛП(ИдентификаторЧата));

	РезультатЗапроса = Запрос.Выполнить();
	КомпанииЧата = РезультатЗапроса.Выгрузить();
	Если КомпанииЧата.Количество() = 1
		И ЗначениеЗаполнено(КомпанииЧата[0].Компания) Тогда
		Возврат КомпанииЧата[0].Компания;
	КонецЕсли;

	Возврат Справочники.EBC_Компании.ПустаяСсылка();

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьКомпаниюПоУмолчаниюНаСервере()

	Настройки = EBC_НастройкиПовтИсп.ТекущиеНастройки();
	КомпанияНастроек = Настройки.КомпанияEBC;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 2
		| Компании.Ссылка КАК Ссылка
		|ИЗ
		| Справочник.EBC_Компании КАК Компании
		|ГДЕ
		| НЕ Компании.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		| ВЫБОР
		|  КОГДА Компании.Ссылка = &КомпанияНастроек
		|   ТОГДА 0
		|  ИНАЧЕ 1
		| КОНЕЦ";
	Запрос.УстановитьПараметр("КомпанияНастроек", КомпанияНастроек);

	РезультатЗапроса = Запрос.Выполнить();
	АктивныеКомпании = РезультатЗапроса.Выгрузить();
	Если АктивныеКомпании.Количество() = 0 Тогда
		Возврат Справочники.EBC_Компании.ПустаяСсылка();
	КонецЕсли;

	Если ЗначениеЗаполнено(КомпанияНастроек)
		И АктивныеКомпании[0].Ссылка = КомпанияНастроек Тогда
		Возврат КомпанияНастроек;
	КонецЕсли;

	Если АктивныеКомпании.Количество() = 1 Тогда
		Возврат АктивныеКомпании[0].Ссылка;
	КонецЕсли;

	Возврат Справочники.EBC_Компании.ПустаяСсылка();

КонецФункции

#КонецОбласти

#Область Чаты

&НаСервере
Процедура ЗаполнитьЧатыНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 100
		|	Чаты.Ссылка КАК Ссылка,
		|	Чаты.Наименование КАК Наименование,
		|	Чаты.Телефон КАК Телефон,
		|	Чаты.ДатаПоследнегоСообщения КАК ДатаПоследнегоСообщения,
		|	Чаты.ЕстьНепрочитанные КАК ЕстьНепрочитанные,
		|	Чаты.Владелец КАК УчетнаяЗапись,
		|	Чаты.Владелец.Провайдер КАК Провайдер
		|ИЗ
		|	Справочник.EBC_Чаты КАК Чаты
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			СвязиОбъектов.Чат КАК Чат
		|		ИЗ
		|			РегистрСведений.EBC_СвязиОбъектов КАК СвязиОбъектов) КАК СвязанныеЧаты
		|		ПО Чаты.Ссылка = СвязанныеЧаты.Чат
		|ГДЕ
		|	НЕ Чаты.ПометкаУдаления
		|	И НЕ Чаты.Владелец.Игнорировать
		|	И (&ВсеКомпании
		|			ИЛИ Чаты.Владелец.Владелец = &Компания)
		|	И (&БезПоиска
		|			ИЛИ НРЕГ(Чаты.Наименование) ПОДОБНО &СтрокаПоиска
		|			ИЛИ НРЕГ(Чаты.ИмяПользователя) ПОДОБНО &СтрокаПоиска
		|			ИЛИ НРЕГ(Чаты.Телефон) ПОДОБНО &СтрокаПоиска
		|			ИЛИ НРЕГ(Чаты.ТекстПоследнегоСообщения) ПОДОБНО &СтрокаПоиска)
		|	И (&НеТолькоНепрочитанные
		|			ИЛИ Чаты.ЕстьНепрочитанные = ИСТИНА)
		|	И (&НеТолькоБезСвязи
		|			ИЛИ СвязанныеЧаты.Чат ЕСТЬ NULL)
		|	И (&ВсеУчетныеЗаписи
		|			ИЛИ Чаты.Владелец = &УчетнаяЗапись)
		|	И (&ВсеПровайдеры
		|			ИЛИ Чаты.Владелец.Провайдер = &Провайдер)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Чаты.ДатаПоследнегоСообщения УБЫВ,
		|	Чаты.ДатаСинхронизации УБЫВ";

	СтрокаПоиска = НРег(СокрЛП(СтрокаПоискаЧатов));
	Запрос.УстановитьПараметр("ВсеКомпании", Не ЗначениеЗаполнено(Объект.КомпанияEBC));
	Запрос.УстановитьПараметр("Компания", Объект.КомпанияEBC);
	Запрос.УстановитьПараметр("БезПоиска", ПустаяСтрока(СтрокаПоиска));
	Запрос.УстановитьПараметр("СтрокаПоиска", "%" + СтрокаПоиска + "%");
	Запрос.УстановитьПараметр("НеТолькоНепрочитанные", Не ТолькоНепрочитанные);
	Запрос.УстановитьПараметр("НеТолькоБезСвязи", Не ТолькоБезСвязи);
	Запрос.УстановитьПараметр("ВсеУчетныеЗаписи", Не ЗначениеЗаполнено(ОтборПоУчетнойЗаписи));
	Запрос.УстановитьПараметр("УчетнаяЗапись", ОтборПоУчетнойЗаписи);
	Запрос.УстановитьПараметр("ВсеПровайдеры", Не ЗначениеЗаполнено(ОтборПоПровайдеру));
	Запрос.УстановитьПараметр("Провайдер", ОтборПоПровайдеру);

	НовыеЧаты = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НовыеЧаты.Добавить(Новый Структура(
			"Ссылка,Наименование,Телефон,ДатаПоследнегоСообщения,ЕстьНепрочитанные,УчетнаяЗапись,Провайдер",
			Выборка.Ссылка,
			Выборка.Наименование,
			Выборка.Телефон,
			Выборка.ДатаПоследнегоСообщения,
			Выборка.ЕстьНепрочитанные,
			Выборка.УчетнаяЗапись,
			Выборка.Провайдер));
	КонецЦикла;

	ТаблицаЧатов.Очистить();
	Для Каждого ДанныеЧата Из НовыеЧаты Цикл
		НоваяСтрока = ТаблицаЧатов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеЧата);
		НоваяСтрока.КартинкаПровайдера = ИндексКартинкиПровайдера(
			НоваяСтрока.Провайдер);
	КонецЦикла;

	// Порядок гарантируется явно: свежие чаты сверху независимо от того,
	// каким способом список был заполнен.
	ТаблицаЧатов.Сортировать("ДатаПоследнегоСообщения Убыв");

	ОтметитьОсновнойЧатКонтрагента();

КонецПроцедуры

// Помечает в списке чатов тот, что связан с текущим контрагентом основной
// связью: условное оформление формы выводит такую строку жирным шрифтом.
//
// Список чатов не зависит от контрагента и при его смене не перечитывается,
// поэтому пометка расставляется отдельно - и после заполнения списка,
// и при смене контрагента.
//
// Возвращаемое значение:
//  Булево - Истина, если пометки в таблице изменились.
//
// Значения переписываются только при фактическом изменении. Безусловная запись
// в каждую строку помечала данные формы изменёнными на каждом обновлении,
// таблица чатов перерисовывалась, теряла текущую строку, активизация строки
// планировала следующее обновление - и обновления зацикливались.
//
&НаСервере
Функция ОтметитьОсновнойЧатКонтрагента()

	ОсновнойЧат = Справочники.EBC_Чаты.ПустаяСсылка();

	Если ЗначениеЗаполнено(ТекущийКонтрагент) Тогда
		Объекты = Новый Массив;
		Объекты.Добавить(ТекущийКонтрагент);
		НайденныйЧат = EBC_Ядро.ОсновныеЧатыОбъектов(Объекты).Получить(
			ТекущийКонтрагент);
		Если НайденныйЧат <> Неопределено Тогда
			ОсновнойЧат = НайденныйЧат;
		КонецЕсли;
	КонецЕсли;

	ЕстьИзменения = Ложь;
	ОсновнойЧатНайден = ЗначениеЗаполнено(ОсновнойЧат);

	Для Каждого СтрокаЧата Из ТаблицаЧатов Цикл
		НовоеЗначение = ОсновнойЧатНайден И СтрокаЧата.Ссылка = ОсновнойЧат;
		Если СтрокаЧата.ОсновнойЧат <> НовоеЗначение Тогда
			СтрокаЧата.ОсновнойЧат = НовоеЗначение;
			ЕстьИзменения = Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат ЕстьИзменения;

КонецФункции

&НаКлиенте
Процедура ФильтрыЧатовПриИзменении(Элемент)

	Попытка
		ЗаполнитьЧатыНаСервере();
		ВосстановитьТекущуюСтрокуЧата();
	Исключение
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр(
				"ru = 'Не удалось применить фильтры чатов.';
				|uk = 'Не вдалося застосувати фільтри чатів.'"));
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура СброситьФильтрыЧатовНаСервере()

	СтрокаПоискаЧатов = "";
	ТолькоНепрочитанные = Ложь;
	ТолькоБезСвязи = Ложь;
	ОтборПоУчетнойЗаписи = Справочники.EBC_УчетныеЗаписи.ПустаяСсылка();
	ОтборПоПровайдеру = Перечисления.EBC_Провайдеры.ПустаяСсылка();

КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьТекущуюСтрокуЧата()

	Если Не ЗначениеЗаполнено(ВыбранныйЧат) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаЧата Из ТаблицаЧатов Цикл
		Если СтрокаЧата.Ссылка = ВыбранныйЧат Тогда
			Элементы.ТаблицаЧатов.ТекущаяСтрока = СтрокаЧата.ПолучитьИдентификатор();
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Подгружает по API чаты за последние сутки и обновляет список.
//
&НаКлиенте
Процедура ОбновитьСписокЧатовНажатие(Команда)

	Состояние(
		НСтр(
			"ru = 'Загрузка чатов за последние сутки...';
			|uk = 'Завантаження чатів за останню добу...'"));

	Результат = ОбновитьСписокЧатовНаСервере();
	ВосстановитьТекущуюСтрокуЧата();

	Если Не Результат.Успех Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ТекстОшибки);
		Возврат;
	КонецЕсли;

	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Обновление чатов'; uk = 'Оновлення чатів'"),
		,
		СтрШаблон(
			НСтр(
				"ru = 'Загружено или обновлено чатов: %1';
				|uk = 'Завантажено або оновлено чатів: %1'"),
			Результат.Количество));

КонецПроцедуры

&НаСервере
Функция ОбновитьСписокЧатовНаСервере()

	Результат = Новый Структура(
		"Успех,Количество,ТекстОшибки",
		Ложь,
		0,
		НСтр(
			"ru = 'Не удалось загрузить чаты за последние сутки.';
			|uk = 'Не вдалося завантажити чати за останню добу.'"));

	Попытка
		// Период задаётся в днях, граница отсчитывается от текущей даты сеанса,
		// поэтому одни сутки — это ровно последние 24 часа.
		РезультатЗагрузки = EBC_Ядро.ЗагрузитьЧатыЗаПериод(1);
		Результат.Успех = РезультатЗагрузки.Успех;
		Результат.Количество = РезультатЗагрузки.Количество;
		Если Результат.Успех Тогда
			Результат.ТекстОшибки = "";
		ИначеЕсли Не ПустаяСтрока(РезультатЗагрузки.Ошибка) Тогда
			Результат.ТекстОшибки = РезультатЗагрузки.Ошибка;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации(
			"EBC_КонтактЦентр.ОбновитьСписокЧатов",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ОписаниеОшибки());
	КонецПопытки;

	// Список перечитывается в любом случае: часть чатов могла быть записана
	// до возникновения ошибки, и показать их нужно.
	ЗаполнитьЧатыНаСервере();

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура СинхронизироватьЧатыНажатие(Команда)

	РезультатСинхронизации = СинхронизироватьЧатыНаСервере();
	Если Не РезультатСинхронизации.Успех Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатСинхронизации.ТекстОшибки);
		Возврат;
	КонецЕсли;

	Попытка
		ЗаполнитьЧатыНаСервере();
		ВосстановитьТекущуюСтрокуЧата();
	Исключение
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр(
				"ru = 'Чаты синхронизированы, но список не удалось обновить.';
				|uk = 'Чати синхронізовано, але список не вдалося оновити.'"));
		Возврат;
	КонецПопытки;

	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Синхронизация чатов'; uk = 'Синхронізація чатів'"),
		,
		СтрШаблон(
			НСтр("ru = 'Доступно чатов: %1'; uk = 'Доступно чатів: %1'"),
			РезультатСинхронизации.КоличествоЧатов));

КонецПроцедуры

&НаСервере
Функция СинхронизироватьЧатыНаСервере()

	Результат = Новый Структура(
		"Успех,КоличествоЧатов,ТекстОшибки",
		Ложь,
		0,
		НСтр(
			"ru = 'Не удалось синхронизировать чаты.';
			|uk = 'Не вдалося синхронізувати чати.'"));

	Если Не ЗначениеЗаполнено(Объект.КомпанияEBC) Тогда
		Результат.ТекстОшибки = НСтр(
			"ru = 'Для синхронизации выберите компанию Easy Busy.';
			|uk = 'Для синхронізації виберіть компанію Easy Busy.'");
		Возврат Результат;
	КонецЕсли;

	Попытка
		Результат.Успех = EBC_Ядро.СинхронизироватьЧаты(Объект.КомпанияEBC);
		Если Результат.Успех Тогда
			Результат.КоличествоЧатов = КоличествоЧатовКомпанииНаСервере(Объект.КомпанияEBC);
			Результат.ТекстОшибки = "";
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации(
			"EBC_КонтактЦентр.СинхронизацияЧатов",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			ОписаниеОшибки());
	КонецПопытки;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция КоличествоЧатовКомпанииНаСервере(Знач Компания)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Чаты.Ссылка) КАК КоличествоЧатов
		|ИЗ
		| Справочник.EBC_Чаты КАК Чаты
		|ГДЕ
		| Чаты.Владелец.Владелец = &Компания
		| И НЕ Чаты.ПометкаУдаления";
	Запрос.УстановитьПараметр("Компания", Компания);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.КоличествоЧатов;
	КонецЕсли;

	Возврат 0;

КонецФункции

&НаСервере
Процедура УстановитьВыбранныйЧатПоИдентификаторуНаСервере(Знач ИдентификаторЧата)

	Если ПустаяСтрока(СокрЛП(ИдентификаторЧата)) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| Чаты.Ссылка КАК Ссылка
		|ИЗ
		| Справочник.EBC_Чаты КАК Чаты
		|ГДЕ
		| Чаты.ИдентификаторEBC = &ИдентификаторЧата
		| И НЕ Чаты.ПометкаУдаления
		| И (&ВсеКомпании ИЛИ Чаты.Владелец.Владелец = &Компания)";
	Запрос.УстановитьПараметр("ИдентификаторЧата", СокрЛП(ИдентификаторЧата));
	Запрос.УстановитьПараметр("ВсеКомпании", Не ЗначениеЗаполнено(Объект.КомпанияEBC));
	Запрос.УстановитьПараметр("Компания", Объект.КомпанияEBC);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ВыбранныйЧат = Выборка.Ссылка;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКарточкуЧатаНаСервере()

	Если Не ЗначениеЗаполнено(ВыбранныйЧат) Тогда
		ОчиститьКарточкуЧатаНаСервере();
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| Чаты.Наименование КАК Наименование,
		| Чаты.ИмяПользователя КАК ИмяПользователя,
		| Чаты.Телефон КАК Телефон,
		| Чаты.Владелец КАК УчетнаяЗапись,
		| Чаты.Владелец.Провайдер КАК Провайдер,
		| Чаты.ЕстьНепрочитанные КАК ЕстьНепрочитанные,
		| Чаты.ДатаПоследнегоСообщения КАК ДатаПоследнегоСообщения,
		| Чаты.ТекстПоследнегоСообщения КАК ТекстПоследнегоСообщения
		|ИЗ
		| Справочник.EBC_Чаты КАК Чаты
		|ГДЕ
		| Чаты.Ссылка = &Чат
		| И НЕ Чаты.ПометкаУдаления";
	Запрос.УстановитьПараметр("Чат", ВыбранныйЧат);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ОчиститьКарточкуЧатаНаСервере();
		Возврат;
	КонецЕсли;

	КарточкаЧатаНаименование = Выборка.Наименование;
	КарточкаЧатаИмяПользователя = Выборка.ИмяПользователя;
	КарточкаЧатаТелефон = Выборка.Телефон;
	КарточкаЧатаУчетнаяЗапись = Выборка.УчетнаяЗапись;
	КарточкаЧатаПровайдер = Выборка.Провайдер;
	КарточкаЧатаЕстьНепрочитанные = Выборка.ЕстьНепрочитанные;
	КарточкаЧатаДатаПоследнегоСообщения = Выборка.ДатаПоследнегоСообщения;
	КарточкаЧатаТекстПоследнегоСообщения = Выборка.ТекстПоследнегоСообщения;

	Элементы.ДеталиЧатаСводка.Заголовок = СводкаКаналаЧата(
		Выборка.УчетнаяЗапись,
		Выборка.Телефон,
		Выборка.Провайдер);

КонецПроцедуры

&НаСервере
Процедура ОчиститьКарточкуЧатаНаСервере()

	КарточкаЧатаНаименование = "";
	КарточкаЧатаИмяПользователя = "";
	КарточкаЧатаТелефон = "";
	КарточкаЧатаУчетнаяЗапись = Справочники.EBC_УчетныеЗаписи.ПустаяСсылка();
	КарточкаЧатаПровайдер = Перечисления.EBC_Провайдеры.ПустаяСсылка();
	КарточкаЧатаЕстьНепрочитанные = Ложь;
	КарточкаЧатаДатаПоследнегоСообщения = Дата(1, 1, 1);
	КарточкаЧатаТекстПоследнегоСообщения = "";

	Элементы.ДеталиЧатаСводка.Заголовок = "";

КонецПроцедуры

// Собирает строку канала чата для надписи в деталях:
// «учётная запись / телефон / провайдер». Пустые составляющие пропускаются.
//
&НаКлиентеНаСервереБезКонтекста
Функция СводкаКаналаЧата(Знач УчетнаяЗапись, Знач Телефон, Знач Провайдер)

	Части = Новый Массив;

	Если ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		Части.Добавить(СокрЛП(Строка(УчетнаяЗапись)));
	КонецЕсли;
	Если Не ПустаяСтрока(Телефон) Тогда
		Части.Добавить(СокрЛП(Строка(Телефон)));
	КонецЕсли;
	Если ЗначениеЗаполнено(Провайдер) Тогда
		Части.Добавить(СокрЛП(Строка(Провайдер)));
	КонецЕсли;

	Возврат СтрСоединить(Части, "  /  ");

КонецФункции

// Перечитывает чаты, привязанные к текущему контрагенту.
// Если привязок нет, список остаётся пустым.
//
&НаСервере
Процедура ЗаполнитьСвязанныеЧатыНаСервере()

	ТаблицаСвязанныхЧатов.Очистить();
	ТекущийСвязанныйЧат = Неопределено;
	ОчиститьКарточкуСвязанногоЧатаНаСервере();

	Если Не ЗначениеЗаполнено(ТекущийКонтрагент) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| Чаты.Ссылка КАК Ссылка,
		| Чаты.Наименование КАК Наименование,
		| Чаты.Телефон КАК Телефон,
		| Чаты.ДатаПоследнегоСообщения КАК ДатаПоследнегоСообщения,
		| Чаты.ЕстьНепрочитанные КАК ЕстьНепрочитанные,
		| Чаты.Владелец КАК УчетнаяЗапись,
		| Чаты.Владелец.Провайдер КАК Провайдер,
		| Связи.ОсновнаяСвязь КАК ОсновнаяСвязь
		|ИЗ
		| РегистрСведений.EBC_СвязиОбъектов КАК Связи
		|  ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.EBC_Чаты КАК Чаты
		|  ПО Связи.Чат = Чаты.Ссылка
		|ГДЕ
		| Связи.ТипОбъекта = &ТипОбъекта
		| И Связи.ИдентификаторОбъекта = &ИдентификаторОбъекта
		| И НЕ Чаты.ПометкаУдаления
		| И НЕ Чаты.Владелец.Игнорировать
		|УПОРЯДОЧИТЬ ПО
		| ОсновнаяСвязь УБЫВ,
		| ДатаПоследнегоСообщения УБЫВ";
	Запрос.УстановитьПараметр(
		"ТипОбъекта",
		EBC_Ядро.ИмяТаблицыПоСсылке(ТекущийКонтрагент));
	Запрос.УстановитьПараметр(
		"ИдентификаторОбъекта",
		ТекущийКонтрагент.УникальныйИдентификатор());

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаСвязанныхЧатов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.КартинкаПровайдера = ИндексКартинкиПровайдера(
			НоваяСтрока.Провайдер);
		// Основную связь выводит жирным условное оформление формы.
		НоваяСтрока.ОсновнойЧат = Выборка.ОсновнаяСвязь;
	КонецЦикла;

	Если ТаблицаСвязанныхЧатов.Количество() > 0 Тогда
		ТекущийСвязанныйЧат = ТаблицаСвязанныхЧатов[0].Ссылка;
		ЗаполнитьКарточкуСвязанногоЧатаНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКарточкуСвязанногоЧатаНаСервере()

	Если Не ЗначениеЗаполнено(ТекущийСвязанныйЧат) Тогда
		ОчиститьКарточкуСвязанногоЧатаНаСервере();
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| Чаты.Телефон КАК Телефон,
		| Чаты.Владелец КАК УчетнаяЗапись,
		| Чаты.Владелец.Провайдер КАК Провайдер,
		| Чаты.ТекстПоследнегоСообщения КАК ТекстПоследнегоСообщения
		|ИЗ
		| Справочник.EBC_Чаты КАК Чаты
		|ГДЕ
		| Чаты.Ссылка = &Чат";
	Запрос.УстановитьПараметр("Чат", ТекущийСвязанныйЧат);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ОчиститьКарточкуСвязанногоЧатаНаСервере();
		Возврат;
	КонецЕсли;

	КарточкаСвязанногоЧатаТелефон = Выборка.Телефон;
	КарточкаСвязанногоЧатаУчетнаяЗапись = Выборка.УчетнаяЗапись;
	КарточкаСвязанногоЧатаПровайдер = Выборка.Провайдер;
	КарточкаСвязанногоЧатаТекстПоследнегоСообщения = Выборка.ТекстПоследнегоСообщения;

	Элементы.ДеталиСвязанногоЧатаСводка.Заголовок = СводкаКаналаЧата(
		Выборка.УчетнаяЗапись,
		Выборка.Телефон,
		Выборка.Провайдер);

КонецПроцедуры

&НаСервере
Процедура ОчиститьКарточкуСвязанногоЧатаНаСервере()

	КарточкаСвязанногоЧатаТелефон = "";
	КарточкаСвязанногоЧатаУчетнаяЗапись = Справочники.EBC_УчетныеЗаписи.ПустаяСсылка();
	КарточкаСвязанногоЧатаПровайдер = Перечисления.EBC_Провайдеры.ПустаяСсылка();
	КарточкаСвязанногоЧатаТекстПоследнегоСообщения = "";

	Элементы.ДеталиСвязанногоЧатаСводка.Заголовок = "";

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЧатПлагина(Команда)
	ОткрытьОкноЧатаКлиент();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьViberПоТелефону(Команда)
	ОткрытьЧатПоТелефонуКлиент("Viber");
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьTelegramПоТелефону(Команда)
	ОткрытьЧатПоТелефонуКлиент("Telegram");
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЧатПоТелефонуКлиент(Знач ТипКанала)

	// Проверяется в начале: иначе пользователь пройдёт выбор учётной записи
	// и серверные вызовы ради предупреждения в самом конце.
	Если Не EBC_ВебПлагин.ПроверитьПоддержкуКлиента() Тогда
		Возврат;
	КонецЕсли;

	ТекущиеДанные = Элементы.ТаблицаКонтактов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(
			,
			НСтр(
				"ru = 'Выберите номер телефона.';
				|uk = 'Оберіть номер телефону.'"));
		Возврат;
	КонецЕсли;

	НомерТелефона = СокрЛП(ТекущиеДанные.НомерТелефона);

	Если Не ЗначениеЗаполнено(Объект.КомпанияEBC) Тогда
		ПоказатьПредупреждение(
			,
			НСтр(
				"ru = 'Не выбрана компания Easy Busy Chat.';
				|uk = 'Не вибрано компанію Easy Busy Chat.'"));
		Возврат;
	КонецЕсли;

	ДанныеОткрытия = ПолучитьДанныеОткрытияЧатаПоТелефонуНаСервере(
		НомерТелефона,
		ТипКанала,
		ТекущиеДанные.Источник);
	Если ПустаяСтрока(ДанныеОткрытия.Телефон) Тогда
		ПоказатьПредупреждение(
			,
			НСтр(
				"ru = 'У выбранного контакта некорректный номер телефона.';
				|uk = 'У вибраного контакту некоректний номер телефону.'"));
		Возврат;
	КонецЕсли;

	Если ДанныеОткрытия.ЧатНайден Тогда
		ОткрытьЧатПоРеквизитамКлиент(
			ДанныеОткрытия.ИдентификаторАккаунта,
			ДанныеОткрытия.Провайдер,
			ДанныеОткрытия.ЧатID,
			"",
			"");
		Возврат;
	КонецЕсли;

	Если ДанныеОткрытия.УчетныеЗаписи.Количество() = 0 Тогда
		ПоказатьПредупреждение(
			,
			НСтр(
				"ru = 'Нет активных учетных записей, через которые можно создать чат.';
				|uk = 'Немає активних облікових записів, через які можна створити чат.'"));
		Возврат;
	КонецЕсли;

	МенюУчетныхЗаписей = Новый СписокЗначений;
	Для Каждого УчетнаяЗапись Из ДанныеОткрытия.УчетныеЗаписи Цикл
		МенюУчетныхЗаписей.Добавить(
			УчетнаяЗапись,
			УчетнаяЗапись.Представление);
	КонецЦикла;

	ДополнительныеПараметры = Новый Структура(
		"Телефон,ИмяКонтакта",
		ДанныеОткрытия.Телефон,
		ДанныеОткрытия.ИмяКонтакта);
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПослеВыбораУчетнойЗаписиДляЧата",
		ЭтотОбъект,
		ДополнительныеПараметры);
	ПоказатьВыборИзМеню(
		ОписаниеОповещения,
		МенюУчетныхЗаписей,
		Элементы.ТаблицаКонтактов);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораУчетнойЗаписиДляЧата(
		ВыбранныйЭлемент,
		ДополнительныеПараметры) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеУчетнойЗаписи = ВыбранныйЭлемент;
	Если ТипЗнч(ВыбранныйЭлемент) = Тип("ЭлементСпискаЗначений") Тогда
		ДанныеУчетнойЗаписи = ВыбранныйЭлемент.Значение;
	КонецЕсли;

	ОткрытьЧатПоРеквизитамКлиент(
		ДанныеУчетнойЗаписи.ИдентификаторАккаунта,
		ДанныеУчетнойЗаписи.Провайдер,
		"",
		ДополнительныеПараметры.Телефон,
		ДополнительныеПараметры.ИмяКонтакта);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЧатПоРеквизитамКлиент(
		Знач ИдентификаторАккаунта,
		Знач Провайдер,
		Знач ЧатID,
		Знач Телефон,
		Знач ИмяКонтакта = "")

	Если Не EBC_ВебПлагин.ПроверитьПоддержкуКлиента() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		// Если окно чата уже открыто, компонента не переинициализируется:
		// не будет ни серверного вызова за токеном, ни повторного Открыть().
		РезультатОткрытия = EBC_ВебПлагин.ПодготовитьКомпоненту(
			глКомпонентаEBC,
			Объект.КомпанияEBC,
			ИдентификаторАккаунта,
			Провайдер);
		Если РезультатОткрытия.Успех Тогда
			Если ПустаяСтрока(Телефон) Тогда
				РезультатОткрытия = EBC_ВебПлагин.ОткрытьЧат(
					глКомпонентаEBC,
					ИдентификаторАккаунта,
					Провайдер,
					ЧатID,
					Объект.КомпанияEBC);
			Иначе
				РезультатОткрытия = EBC_ВебПлагин.НачатьОткрытиеЧатаПоКонтакту(
					глКомпонентаEBC,
					ИдентификаторАккаунта,
					Провайдер,
					Телефон,
					ИмяКонтакта,
					0,
					Объект.КомпанияEBC);
			КонецЕсли;
		КонецЕсли;

		Если Не РезультатОткрытия.Успех Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатОткрытия.Ошибка);
		КонецЕсли;
	Исключение
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр(
				"ru = 'Не удалось открыть чат по номеру телефона.';
				|uk = 'Не вдалося відкрити чат за номером телефону.'"));
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеОткрытияЧатаПоТелефонуНаСервере(
		Знач Телефон,
		Знач ТипКанала,
		Знач Источник)

	Возврат ПолучитьДанныеОткрытияЧатаПоТелефону(
		Телефон,
		ТипКанала,
		Объект.КомпанияEBC,
		Источник);

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДанныеОткрытияЧатаПоТелефону(
		Знач Телефон,
		Знач ТипКанала,
		Знач Компания,
		Знач Источник)

	Результат = Новый Структура(
		"Телефон,ИмяКонтакта,ЧатНайден,ИдентификаторАккаунта,Провайдер,ЧатID,УчетныеЗаписи",
		"",
		"",
		Ложь,
		"",
		"",
		"",
		Новый Массив);
	Если ЗначениеЗаполнено(Источник) Тогда
		Результат.ИмяКонтакта = СокрЛП(Строка(Источник));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Компания) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Телефон = EBC_Ядро.НормализоватьТелефон(СокрЛП(Строка(Телефон)));
	Если СтрДлина(Результат.Телефон) < 7 Тогда
		Результат.Телефон = "";
		Возврат Результат;
	КонецЕсли;

	Провайдеры = ПровайдерыКанала(ТипКанала);
	Если Провайдеры.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| Чаты.ИдентификаторEBC КАК ЧатID,
		| Чаты.Владелец.ИдентификаторEBC КАК ИдентификаторАккаунта,
		| Чаты.Владелец.Провайдер КАК Провайдер
		|ИЗ
		| Справочник.EBC_Чаты КАК Чаты
		|ГДЕ
		| НЕ Чаты.ПометкаУдаления
		| И НЕ Чаты.Владелец.Игнорировать
		| И Чаты.Владелец.Владелец = &Компания
		| И Чаты.Владелец.Провайдер В (&Провайдеры)
		| И Чаты.Телефон = &Телефон
		|УПОРЯДОЧИТЬ ПО
		| Чаты.ДатаПоследнегоСообщения УБЫВ,
		| Чаты.Ссылка";
	Запрос.УстановитьПараметр("Компания", Компания);
	Запрос.УстановитьПараметр("Провайдеры", Провайдеры);
	Запрос.УстановитьПараметр("Телефон", Результат.Телефон);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.ЧатНайден = Истина;
		Результат.ИдентификаторАккаунта = Выборка.ИдентификаторАккаунта;
		Результат.Провайдер = XMLСтрока(Выборка.Провайдер);
		Результат.ЧатID = Выборка.ЧатID;
		Возврат Результат;
	КонецЕсли;

	Запрос.Текст =
		"ВЫБРАТЬ
		| УчетныеЗаписи.ИдентификаторEBC КАК ИдентификаторАккаунта,
		| УчетныеЗаписи.Наименование КАК Наименование,
		| УчетныеЗаписи.Провайдер КАК Провайдер
		|ИЗ
		| Справочник.EBC_УчетныеЗаписи КАК УчетныеЗаписи
		|ГДЕ
		| НЕ УчетныеЗаписи.ПометкаУдаления
		| И НЕ УчетныеЗаписи.Игнорировать
		| И УчетныеЗаписи.Владелец = &Компания
		| И УчетныеЗаписи.Провайдер В (&Провайдеры)
		| И УчетныеЗаписи.Активна
		| И УчетныеЗаписи.МожноСоздаватьЧат
		|УПОРЯДОЧИТЬ ПО
		| УчетныеЗаписи.Наименование,
		| УчетныеЗаписи.Ссылка";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ИдентификаторАккаунта = СокрЛП(Выборка.ИдентификаторАккаунта);
		Если ПустаяСтрока(ИдентификаторАккаунта) Тогда
			Продолжить;
		КонецЕсли;

		ПредставлениеУчетнойЗаписи = СокрЛП(Выборка.Наименование);
		Если ПустаяСтрока(ПредставлениеУчетнойЗаписи) Тогда
			ПредставлениеУчетнойЗаписи = ИдентификаторАккаунта;
		КонецЕсли;
		ПредставлениеУчетнойЗаписи = ПредставлениеУчетнойЗаписи
			+ " (" + Строка(Выборка.Провайдер) + ")";

		Результат.УчетныеЗаписи.Добавить(
			Новый Структура(
				"ИдентификаторАккаунта,Провайдер,Представление",
				ИдентификаторАккаунта,
				XMLСтрока(Выборка.Провайдер),
				ПредставлениеУчетнойЗаписи));
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ПровайдерыКанала(Знач ТипКанала)

	Провайдеры = Новый Массив;
	Если ТипКанала = "Viber" Тогда
		Провайдеры.Добавить(Перечисления.EBC_Провайдеры.ViberBot);
		Провайдеры.Добавить(Перечисления.EBC_Провайдеры.ViberPersonal);
		Провайдеры.Добавить(Перечисления.EBC_Провайдеры.EchatViber);
		Провайдеры.Добавить(Перечисления.EBC_Провайдеры.ViberBusiness);
	ИначеЕсли ТипКанала = "Telegram" Тогда
		Провайдеры.Добавить(Перечисления.EBC_Провайдеры.Telegram);
		Провайдеры.Добавить(Перечисления.EBC_Провайдеры.TelegramBot);
	КонецЕсли;

	Возврат Провайдеры;

КонецФункции

// Подключает веб-плагин и открывает в нём текущий чат.
// Вызывается только по явному действию пользователя: при открытии формы
// компонента не подключается.
//
&НаКлиенте
Процедура ОткрытьОкноЧатаКлиент(Знач ЧатДляОткрытия = Неопределено)

	Чат = ЧатДляОткрытия;
	Если Не ЗначениеЗаполнено(Чат) Тогда
		Чат = ТекущийЧат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Чат) Тогда
		Чат = ВыбранныйЧат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Чат) Тогда
		ПоказатьПредупреждение(
			,
			НСтр(
				"ru = 'Выберите чат в списке.';
				|uk = 'Оберіть чат у списку.'"));
		Возврат;
	КонецЕсли;

	Если Не EBC_ВебПлагин.ПроверитьПоддержкуКлиента() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		// Если окно чата уже открыто, компонента не переинициализируется:
		// не будет ни серверного вызова за токеном, ни повторного Открыть().
		ДанныеЧата = ПолучитьДанныеОткрытияЧатаНаСервере(Чат);
		РезультатОткрытия = EBC_ВебПлагин.ПодготовитьКомпоненту(
			глКомпонентаEBC,
			ДанныеЧата.КомпанияEBC,
			ДанныеЧата.ИдентификаторАккаунта,
			ДанныеЧата.Провайдер);
		Если РезультатОткрытия.Успех Тогда
			РезультатОткрытия = EBC_ВебПлагин.ОткрытьЧат(
				глКомпонентаEBC,
				ДанныеЧата.ИдентификаторАккаунта,
				ДанныеЧата.Провайдер,
				ДанныеЧата.ЧатID,
				ДанныеЧата.КомпанияEBC);
		КонецЕсли;

		Если Не РезультатОткрытия.Успех Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатОткрытия.Ошибка);
		КонецЕсли;
	Исключение
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Не удалось открыть выбранный чат.'; uk = 'Не вдалося відкрити вибраний чат.'"));
	КонецПопытки;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеОткрытияЧатаНаСервере(Знач Чат)

	Результат = Новый Структура(
		"ИдентификаторАккаунта,ЧатID,Провайдер,КомпанияEBC",
		"",
		"",
		"",
		Справочники.EBC_Компании.ПустаяСсылка());
	Если Не ЗначениеЗаполнено(Чат) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| Чаты.ИдентификаторEBC КАК ЧатID,
		| Чаты.Владелец.ИдентификаторEBC КАК ИдентификаторАккаунта,
		| Чаты.Владелец.Провайдер КАК Провайдер,
		| Чаты.Владелец.Владелец КАК КомпанияEBC
		|ИЗ
		| Справочник.EBC_Чаты КАК Чаты
		|ГДЕ
		| Чаты.Ссылка = &Чат";
	Запрос.УстановитьПараметр("Чат", Чат);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.ИдентификаторАккаунта = Выборка.ИдентификаторАккаунта;
		Результат.ЧатID = Выборка.ЧатID;
		Результат.Провайдер = XMLСтрока(Выборка.Провайдер);
		Результат.КомпанияEBC = Выборка.КомпанияEBC;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Клиенты

&НаКлиенте
Процедура ОбновитьСписокКонтрагентовНажатие(Команда)
	Элементы.СписокКонтрагентов.Обновить();
	АктивизироватьКонтрагента(ТекущийКонтрагент);
КонецПроцедуры

// Полное обновление списка контрагентов с позиционированием на нужной строке.
//
// Вызывается только по явным действиям: открытие формы, привязка и отвязка
// контрагента, уведомление о новом сообщении. При перемещении по спискам
// список не перечитывается - иначе теряется текущая строка.
//
&НаКлиенте
Процедура ОбновитьСписокКонтрагентов(Знач ПредпочтительнаяСсылка = Неопределено)

	// Список контрагентов - динамический список, поэтому обновляется
	// перечитыванием данных, а не заполнением строк.
	Попытка
		Элементы.СписокКонтрагентов.Обновить();
	Исключение
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр(
				"ru = 'Не удалось получить список контрагентов.';
				|uk = 'Не вдалося отримати список контрагентів.'"));
		Возврат;
	КонецПопытки;

	АктивизироватьКонтрагента(ПредпочтительнаяСсылка);

КонецПроцедуры

&НаСервере
Функция ПолучитьКонтактыВыбранногоЧатаНаСервере()

	Результат = Новый Структура("Телефон", "");
	Если Не ЗначениеЗаполнено(ВыбранныйЧат) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| Чаты.Телефон КАК Телефон
		|ИЗ
		| Справочник.EBC_Чаты КАК Чаты
		|ГДЕ
		| Чаты.Ссылка = &Чат";
	Запрос.УстановитьПараметр("Чат", ВыбранныйЧат);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Телефон = Выборка.Телефон;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура АктивизироватьКонтрагента(Знач ПредпочтительнаяСсылка = Неопределено)

	// Идентификатор строки динамического списка - ссылка на элемент справочника.
	Если ЗначениеЗаполнено(ПредпочтительнаяСсылка) Тогда
		Элементы.СписокКонтрагентов.ТекущаяСтрока = ПредпочтительнаяСсылка;
	КонецЕсли;

	ЗапомнитьТекущегоКонтрагента();
	ОбновитьЗависимыеДанные();

КонецПроцедуры

// Запоминает контрагента текущей строки списка.
//
// Возвращаемое значение:
//  Булево - Истина, если контрагент изменился и зависимые данные надо перечитать.
//
// Отсутствие текущей строки изменением не считается: динамический список
// временно остаётся без текущей строки при каждом перечитывании данных,
// и сброс контрагента в этот момент очищал бы все зависимые списки.
//
&НаКлиенте
Функция ЗапомнитьТекущегоКонтрагента()

	ТекущиеДанные = Элементы.СписокКонтрагентов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено
		Или Не ЗначениеЗаполнено(ТекущиеДанные.Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТекущийКонтрагент = ТекущиеДанные.Ссылка Тогда
		Возврат Ложь;
	КонецЕсли;

	ТекущийКонтрагент = ТекущиеДанные.Ссылка;

	Возврат Истина;

КонецФункции

// Запоминает чат текущей строки списка чатов.
// Возвращает Истина, если чат изменился.
//
&НаКлиенте
Функция ЗапомнитьТекущийЧат()

	ТекущиеДанные = Элементы.ТаблицаЧатов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ВыбранныйЧат = ТекущиеДанные.Ссылка Тогда
		Возврат Ложь;
	КонецЕсли;

	ТекущийЧат = ТекущиеДанные.Ссылка;
	ВыбранныйЧат = ТекущиеДанные.Ссылка;

	Возврат Истина;

КонецФункции

// Планирует обновление зависимых данных.
//
// Активизация строки срабатывает на каждое перемещение по списку, в том числе
// при прокрутке с клавиатуры и при перечитывании динамического списка. Прямой
// серверный вызов из обработчика активизации заставлял список перечитываться,
// текущая строка терялась, и зависимые таблицы очищались. Поэтому обновление
// откладывается, а повторная активизация перезапускает ожидание.
//
&НаКлиенте
Процедура ОтложитьОбновлениеЗависимыхДанных()
	ПодключитьОбработчикОжидания(
		"Подключаемый_ОбновитьЗависимыеДанные",
		0.3,
		Истина);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьЗависимыеДанные()
	ОтключитьОбработчикОжидания("Подключаемый_ОбновитьЗависимыеДанные");
	ОбновитьЗависимыеДанные();
КонецПроцедуры

// Перечитывает всё, что зависит от текущего чата и текущего контрагента,
// одним серверным вызовом.
//
&НаКлиенте
Процедура ОбновитьЗависимыеДанные()

	ОтключитьОбработчикОжидания("Подключаемый_ОбновитьЗависимыеДанные");

	Результат = ЗаполнитьЗависимыеДанныеНаСервере();

	// Перерисовка таблицы после смены пометок сбрасывает текущую строку,
	// а вместе с ней и выбранный чат. Строка возвращается на место сразу,
	// до того как сработает активизация.
	Если Результат.ПометкиЧатовИзменены Тогда
		ВосстановитьТекущуюСтрокуЧата();
	КонецЕсли;

	Если Не ПустаяСтрока(Результат.ТекстОшибки) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ТекстОшибки);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЗаполнитьЗависимыеДанныеНаСервере()

	ТекстОшибки = "";

	Попытка
		ЗаполнитьКарточкуЧатаНаСервере();
	Исключение
		ТекстОшибки = НСтр(
			"ru = 'Не удалось обновить карточку выбранного чата.';
			|uk = 'Не вдалося оновити картку вибраного чату.'");
	КонецПопытки;

	// Телефон карточки уже обновлен, поэтому отбор по нему переставляется здесь:
	// смена чата сразу перенастраивает список контрагентов.
	ПрименитьОтборКонтрагентовПоТелефонуЧата();

	ТекстОшибкиДокументов = ЗаполнитьДокументыНаСервере();
	Если ПустаяСтрока(ТекстОшибки) Тогда
		ТекстОшибки = ТекстОшибкиДокументов;
	КонецЕсли;

	УстановитьКонтрагентаДляСпискаТелефоновНаСервере(ТекущийКонтрагент);
	ЗаполнитьСвязанныеЧатыНаСервере();

	Возврат Новый Структура(
		"ТекстОшибки, ПометкиЧатовИзменены",
		ТекстОшибки,
		ОтметитьОсновнойЧатКонтрагента());

КонецФункции

#КонецОбласти

#Область Документы

&НаКлиенте
Процедура ОбновитьДокументыТекущегоКонтрагента()

	ТекстОшибки = ЗаполнитьДокументыНаСервере();
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
	КонецЕсли;

КонецПроцедуры

// Перечитывает документы и возвращает курсор на тот же документ.
// Нужно после изменения связей: в колонке Чат показывается основной чат
// документа, и без перечитывания она осталась бы со старым значением.
//
&НаКлиенте
Процедура ОбновитьДокументыСохранивПозицию()

	ДокументДоОбновления = ТекущийДокумент;
	ОбновитьДокументыТекущегоКонтрагента();

	Если Не ЗначениеЗаполнено(ДокументДоОбновления) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаДокумента Из СвязанныеДокументы Цикл
		Если СтрокаДокумента.Ссылка = ДокументДоОбновления Тогда
			Элементы.СвязанныеДокументы.ТекущаяСтрока =
				СтрокаДокумента.ПолучитьИдентификатор();
			ТекущийДокумент = ДокументДоОбновления;
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Перечитывает документы текущего контрагента.
// Возвращает текст ошибки для показа пользователю либо пустую строку.
//
&НаСервере
Функция ЗаполнитьДокументыНаСервере()

	СвязанныеДокументы.Очистить();
	ТекущийДокумент = Неопределено;

	// Документы показываются только для выбранного элемента справочника.
	// Для группы и при отсутствии выбора список остаётся пустым.
	Если Не ЗначениеЗаполнено(ТекущийКонтрагент) Тогда
		Возврат "";
	КонецЕсли;

	// Имя ДокументыКонтрагента, а не Документы: последнее занято глобальным
	// менеджером документов, присваивание в него недопустимо.
	ДокументыКонтрагента = Новый Массив;
	Попытка
		ДокументыКонтрагента = EBC_АдаптерКонфигурации.ПолучитьДокументыОбъекта(
			ТекущийКонтрагент);
		ЗаполнитьЧатыДокументов(ДокументыКонтрагента);
	Исключение
		ИнформацияОшибки = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации(
			"EBC_КонтактЦентр.ПолучитьДокументы",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ПодробноеПредставлениеОшибки(ИнформацияОшибки));
		// Причина показывается оператору: без неё сообщение неотличимо
		// от любой другой неудачи и не помогает разобраться.
		Возврат СтрШаблон(
			НСтр(
				"ru = 'Не удалось получить документы выбранного контрагента. %1';
				|uk = 'Не вдалося отримати документи вибраного контрагента. %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОшибки));
	КонецПопытки;

	Для Каждого ДокументКлиента Из ДокументыКонтрагента Цикл
		НоваяСтрока 					= СвязанныеДокументы.Добавить();
		НоваяСтрока.Дата 				= ДокументКлиента.Дата;
		НоваяСтрока.Номер 				= ДокументКлиента.Номер;
		НоваяСтрока.Ссылка 				= ДокументКлиента.Ссылка;
		НоваяСтрока.Контрагент 			= ДокументКлиента.Контрагент;
		НоваяСтрока.Сумма 				= ДокументКлиента.Сумма;
		НоваяСтрока.Комментарий 		= ДокументКлиента.Комментарий;
		НоваяСтрока.Чат 				= ДокументКлиента.Чат;
		НоваяСтрока.Статус 				= ДокументКлиента.Статус;
		НоваяСтрока.КартинкаСостояния 	= ИндексКартинкиСостоянияДокумента(ДокументКлиента);
	КонецЦикла;

	Возврат "";

КонецФункции

// Дополняет описания документов основным чатом, привязанным к каждому из них.
// Связи читаются одним запросом на всю выборку, а не по документу.
//
&НаСервереБезКонтекста
Процедура ЗаполнитьЧатыДокументов(Документы)

	СсылкиДокументов = Новый Массив;
	Для Каждого ДокументКлиента Из Документы Цикл
		СсылкиДокументов.Добавить(ДокументКлиента.Ссылка);
	КонецЦикла;

	ЧатыДокументов = EBC_Ядро.ОсновныеЧатыОбъектов(СсылкиДокументов);

	Для Каждого ДокументКлиента Из Документы Цикл
		Чат = ЧатыДокументов.Получить(ДокументКлиента.Ссылка);
		ДокументКлиента.Вставить(
			"Чат",
			?(Чат = Неопределено, Справочники.EBC_Чаты.ПустаяСсылка(), Чат));
	КонецЦикла;

КонецПроцедуры

// Номер кадра общей картинки СостоянияДокумента для строки таблицы документов.
// Порядок кадров задан платформой: 0 - проведён, 1 - помечен на удаление,
// 2 - не проведён.
//
&НаКлиентеНаСервереБезКонтекста
Функция ИндексКартинкиСостоянияДокумента(Знач ДокументКлиента)

	Если ДокументКлиента.Проведен Тогда
		Возврат 0;
	ИначеЕсли ДокументКлиента.ПометкаУдаления Тогда
		Возврат 1;
	КонецЕсли;

	Возврат 2;

КонецФункции

// Номер кадра общей картинки EBC_ПровайдерыЧатов для строки таблицы чатов.
//
// Кадры идут в порядке: 0 - пусто, 1 - Telegram, 2 - Telegram Bot, 3 - Viber,
// 4 - WhatsApp, 5 - Instagram, 6 - Facebook, 7 - веб-чат. Провайдеров в
// перечислении больше, чем картинок: варианты одного мессенджера показываются
// одной пиктограммой.
//
&НаСервереБезКонтекста
// Соответствие "провайдер - кадр общей картинки" переехало в EBC_Ядро:
// тот же список нужен форме привязанных чатов, и две копии разошлись бы.
Функция ИндексКартинкиПровайдера(Знач Провайдер)

	Возврат EBC_Ядро.ИндексКартинкиПровайдера(Провайдер);

КонецФункции

#КонецОбласти

#Область КомандыКлиентов

&НаКлиенте
Процедура ОткрытьКонтрагентаНажатие(Команда)

	Если Не ЗначениеЗаполнено(ТекущийКонтрагент) Тогда
		ПоказатьПредупреждение(
			,
			НСтр("ru = 'Выберите контрагента.'; uk = 'Оберіть контрагента.'"));
		Возврат;
	КонецЕсли;

	Попытка
		EBC_АдаптерКонфигурации.ОткрытьОбъект(ТекущийКонтрагент, ЭтотОбъект);
	Исключение
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Не удалось открыть контрагента.'; uk = 'Не вдалося відкрити контрагента.'"));
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура СвязатьКонтрагентаНажатие(Команда)
	
	Если Не ЗначениеЗаполнено(ТекущийЧат) Тогда
		ПоказатьПредупреждение(
			,
			НСтр("ru = 'Выберите чат.'; uk = 'Оберіть чат.'"));
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекущийКонтрагент) Тогда
		ПоказатьПредупреждение(
			,
			НСтр("ru = 'Выберите доступного контрагента.'; uk = 'Оберіть доступного контрагента.'"));
		Возврат;
	КонецЕсли;

	// Ручная привязка всегда делается основной: прежняя основная связь
	// контрагента с другими чатами при этом снимается.
	СвязатьЧатНаСервере(ТекущийЧат, ТекущийКонтрагент, Истина);
	ОбновитьСписокКонтрагентов(ТекущийКонтрагент);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура СвязатьЧатНаСервере(Знач Чат, Знач СсылкаНаОбъект, Знач ОсновнаяСвязь)
	EBC_Ядро.ПривязатьЧат(Чат, СсылкаНаОбъект, ОсновнаяСвязь);
КонецПроцедуры

&НаКлиенте
Процедура СделатьОсновнымНажатие(Команда)

	Если Не ЗначениеЗаполнено(ТекущийЧат)
		Или Не ЗначениеЗаполнено(ТекущийКонтрагент) Тогда
		ПоказатьПредупреждение(
			,
			НСтр(
				"ru = 'Выберите чат и контрагента.';
				|uk = 'Оберіть чат і контрагента.'"));
		Возврат;
	КонецЕсли;

	СвязатьЧатНаСервере(ТекущийЧат, ТекущийКонтрагент, Истина);
	ОбновитьСписокКонтрагентов(ТекущийКонтрагент);

КонецПроцедуры

&НаКлиенте
Процедура ОтвязатьКонтрагентаНажатие(Команда)

	Если Не ЗначениеЗаполнено(ТекущийКонтрагент) Тогда
		ПоказатьПредупреждение(
			,
			НСтр("ru = 'Выберите контрагента.'; uk = 'Оберіть контрагента.'"));
		Возврат;
	КонецЕсли;

	Если Не УдалитьСвязьНаСервере(ТекущийКонтрагент) Тогда
		ПоказатьПредупреждение(
			,
			НСтр(
				"ru = 'У выбранного контрагента нет основной привязки к чату.';
				|uk = 'У вибраного контрагента немає основної прив''язки до чату.'"));
		Возврат;
	КонецЕсли;

	ОбновитьСписокКонтрагентов(ТекущийКонтрагент);

КонецПроцедуры

// Удаляет основную связь контрагента независимо от того, какой чат сейчас
// выбран в списке чатов: в списке контрагентов показывается именно она.
//
&НаСервереБезКонтекста
Функция УдалитьСвязьНаСервере(Знач СсылкаНаОбъект)

	ОсновнойЧат = EBC_Ядро.ОсновнойЧатОбъекта(СсылкаНаОбъект);
	Если Не ЗначениеЗаполнено(ОсновнойЧат) Тогда
		Возврат Ложь;
	КонецЕсли;

	EBC_Ядро.ОтвязатьЧат(ОсновнойЧат, СсылкаНаОбъект);

	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура ПодобратьКонтрагентаНажатие(Команда)

	Если Не ЗначениеЗаполнено(ВыбранныйЧат) Тогда
		ПоказатьПредупреждение(
			,
			НСтр("ru = 'Выберите чат.'; uk = 'Оберіть чат.'"));
		Возврат;
	КонецЕсли;

	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПослеПодбораКонтрагента",
		ЭтотОбъект);
	EBC_АдаптерКонфигурации.ОткрытьФормуВыбораКонтрагента(
		ЭтотОбъект,
		ОписаниеОповещения);

КонецПроцедуры

&НаКлиенте
Процедура ПослеПодбораКонтрагента(Результат, ДополнительныеПараметры) Экспорт

	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;

	// Динамический список содержит всех контрагентов, поэтому подобранный
	// элемент не добавляется, а только делается текущим.
	// Связь с чатом устанавливается отдельной командой.
	АктивизироватьКонтрагента(Результат);

КонецПроцедуры

&НаКлиенте
Процедура СоздатьКонтрагентаНажатие(Команда)

	Если Не ЗначениеЗаполнено(ТекущийЧат) Тогда
		ПоказатьПредупреждение(
			,
			НСтр(
				"ru = 'Выберите чат для создания контрагента!';
				|uk = 'Оберіть чат для створення контрагента!'"));
		Возврат;
	КонецЕсли;

	ДанныеЧата = ПолучитьДанныеСозданияКонтрагентаНаСервере(ТекущийЧат);
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПослеСозданияКонтрагента",
		ЭтотОбъект);
	EBC_АдаптерКонфигурации.ОткрытьФормуНовогоКонтрагента(
		ДанныеЧата,
		ЭтотОбъект,
		ОписаниеОповещения);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеСозданияКонтрагентаНаСервере(Знач Чат)

	Результат = Новый Структура("Имя,ИмяПользователя,Телефон", "", "", "");
	Если Не ЗначениеЗаполнено(Чат) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| Чаты.Наименование КАК Имя,
		| Чаты.ИмяПользователя КАК ИмяПользователя,
		| Чаты.Телефон КАК Телефон
		|ИЗ
		| Справочник.EBC_Чаты КАК Чаты
		|ГДЕ
		| Чаты.Ссылка = &Чат";
	Запрос.УстановитьПараметр("Чат", Чат);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Имя = Выборка.Имя;
		Результат.ИмяПользователя = Выборка.ИмяПользователя;
		Результат.Телефон = Выборка.Телефон;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ПослеСозданияКонтрагента(Результат, ДополнительныеПараметры) Экспорт

	// Созданный контрагент сразу привязывается к чату основной связью.
	Если ЗначениеЗаполнено(Результат)
		И ЗначениеЗаполнено(ТекущийЧат) Тогда
		СвязатьЧатНаСервере(ТекущийЧат, Результат, Истина);
		ОбновитьСписокКонтрагентов(Результат);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область КомандыДокументов

&НаКлиенте
Процедура ОткрытьДокументНажатие(Команда)

	Если Не ЗначениеЗаполнено(ТекущийДокумент) Тогда
		ПоказатьПредупреждение(
			,
			НСтр("ru = 'Выберите документ.'; uk = 'Оберіть документ.'"));
		Возврат;
	КонецЕсли;

	ОткрытьДокументКлиент(ТекущийДокумент);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДокументКлиент(Знач СсылкаНаДокумент)

	Попытка
		EBC_АдаптерКонфигурации.ОткрытьОбъект(СсылкаНаДокумент, ЭтотОбъект);
	Исключение
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Не удалось открыть документ.'; uk = 'Не вдалося відкрити документ.'"));
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДокументыНажатие(Команда)
	ОбновитьДокументыТекущегоКонтрагента();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументНажатие(Команда)

	Если Не ЗначениеЗаполнено(ТекущийКонтрагент) Тогда
		ПоказатьПредупреждение(
			,
			НСтр("ru = 'Выберите контрагента.'; uk = 'Оберіть контрагента.'"));
		Возврат;
	КонецЕсли;

	Операции = ПолучитьДоступныеОперацииСозданияНаСервере(ТекущийКонтрагент);
	Если Операции.Количество() = 0 Тогда
		ПоказатьПредупреждение(
			,
			НСтр(
				"ru = 'Нет доступных видов документов для создания.';
				|uk = 'Немає доступних видів документів для створення.'"));
		Возврат;
	КонецЕсли;

	Если Операции.Количество() = 1 Тогда
		ОткрытьФормуСозданияДокумента(Операции[0].Имя, ТекущийКонтрагент);
		Возврат;
	КонецЕсли;

	МенюОпераций = Новый СписокЗначений;
	Для Каждого ДоступнаяОперация Из Операции Цикл
		МенюОпераций.Добавить(ДоступнаяОперация.Имя, ДоступнаяОперация.Представление);
	КонецЦикла;

	ДополнительныеПараметры = Новый Структура("Основание", ТекущийКонтрагент);
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПослеВыбораВидаДокумента",
		ЭтотОбъект,
		ДополнительныеПараметры);
	ПоказатьВыборИзМеню(
		ОписаниеОповещения,
		МенюОпераций,
		Элементы.СвязанныеДокументы);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДоступныеОперацииСозданияНаСервере(Знач Основание)
	Возврат EBC_АдаптерКонфигурации.ПолучитьДоступныеОперацииСоздания(Основание);
КонецФункции

&НаКлиенте
Процедура ПослеВыбораВидаДокумента(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ВидОперации = ВыбранноеЗначение;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("ЭлементСпискаЗначений") Тогда
		ВидОперации = ВыбранноеЗначение.Значение;
	КонецЕсли;

	ОткрытьФормуСозданияДокумента(
		Строка(ВидОперации),
		ДополнительныеПараметры.Основание);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуСозданияДокумента(Знач ВидОперации, Знач Основание)

	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПослеСозданияДокумента",
		ЭтотОбъект);
	EBC_АдаптерКонфигурации.СоздатьДокумент(
		ВидОперации,
		Основание,
		Новый Структура,
		ЭтотОбъект,
		ОписаниеОповещения);

КонецПроцедуры

&НаКлиенте
Процедура ПослеСозданияДокумента(Результат, ДополнительныеПараметры) Экспорт
	ОбновитьДокументыТекущегоКонтрагента();
КонецПроцедуры

// Привязывает текущий документ к текущему чату и делает связь основной:
// прежняя основная связь документа с другими чатами при этом снимается.
//
&НаКлиенте
Процедура ПривязатьДокументОсновнымНажатие(Команда)
	ПривязатьТекущийДокументКлиент(Истина);
КонецПроцедуры

// Привязывает текущий документ к текущему чату. Если это первая связь
// документа, ядро делает её основной автоматически.
//
&НаКлиенте
Процедура ПривязатьДокументНажатие(Команда)
	ПривязатьТекущийДокументКлиент(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ПривязатьТекущийДокументКлиент(Знач ОсновнаяСвязь)

	Если Не ЗначениеЗаполнено(ТекущийЧат) Тогда
		ПоказатьПредупреждение(
			,
			НСтр("ru = 'Выберите чат.'; uk = 'Оберіть чат.'"));
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущийДокумент) Тогда
		ПоказатьПредупреждение(
			,
			НСтр("ru = 'Выберите документ.'; uk = 'Оберіть документ.'"));
		Возврат;
	КонецЕсли;

	СвязатьЧатНаСервере(ТекущийЧат, ТекущийДокумент, ОсновнаяСвязь);
	ОбновитьДокументыСохранивПозицию();

	Если ОсновнаяСвязь Тогда
		ТекстОповещения = НСтр(
			"ru = 'Документ привязан к чату основной связью';
			|uk = 'Документ прив''язано до чату основним зв''язком'");
	Иначе
		ТекстОповещения = НСтр(
			"ru = 'Документ привязан к чату';
			|uk = 'Документ прив''язано до чату'");
	КонецЕсли;

	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Связь документа'; uk = 'Зв''язок документа'"),
		,
		ТекстОповещения);

КонецПроцедуры

// Снимает все связи текущего документа с чатами.
//
&НаКлиенте
Процедура ОтвязатьДокументНажатие(Команда)

	Если Не ЗначениеЗаполнено(ТекущийДокумент) Тогда
		ПоказатьПредупреждение(
			,
			НСтр("ru = 'Выберите документ.'; uk = 'Оберіть документ.'"));
		Возврат;
	КонецЕсли;

	КоличествоСвязей = ОтвязатьДокументОтВсехЧатовНаСервере(ТекущийДокумент);
	ОбновитьДокументыСохранивПозицию();

	Если КоличествоСвязей = 0 Тогда
		ПоказатьПредупреждение(
			,
			НСтр(
				"ru = 'У выбранного документа нет связей с чатами.';
				|uk = 'У вибраного документа немає зв''язків із чатами.'"));
		Возврат;
	КонецЕсли;

	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Связь документа'; uk = 'Зв''язок документа'"),
		,
		СтрШаблон(
			НСтр("ru = 'Снято связей с чатами: %1'; uk = 'Знято зв''язків із чатами: %1'"),
			КоличествоСвязей));

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтвязатьДокументОтВсехЧатовНаСервере(Знач СсылкаНаДокумент)

	ЧатыДокумента = EBC_Ядро.ЧатыОбъекта(СсылкаНаДокумент);
	Для Каждого Чат Из ЧатыДокумента Цикл
		EBC_Ядро.ОтвязатьЧат(Чат, СсылкаНаДокумент);
	КонецЦикла;

	Возврат ЧатыДокумента.Количество();

КонецФункции

&НаКлиенте
Процедура ОтправитьПечатнуюФормуНажатие(Команда)

	Если Не ЗначениеЗаполнено(ТекущийКонтрагент) Тогда
		ПоказатьПредупреждение(
			,
			НСтр(
				"ru = 'Выберите контрагента для отправки файла.';
				|uk = 'Оберіть контрагента для надсилання файлу.'"));
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущийДокумент) Тогда
		ПоказатьПредупреждение(
			,
			НСтр("ru = 'Выберите документ для отправки!'; uk = 'Оберіть документ для відправки!'"));
		Возврат;
	КонецЕсли;

	ПечатныеФормы = ДоступныеПечатныеФормыНаСервере(ТекущийДокумент);
	Если ПечатныеФормы.Количество() = 0 Тогда
		ПоказатьПредупреждение(
			,
			НСтр(
				"ru = 'Для документа нет доступных печатных форм.';
				|uk = 'Для документа немає доступних друкованих форм.'"));
		Возврат;
	КонецЕсли;

	Если ПечатныеФормы.Количество() = 1 Тогда
		ОтправитьПечатнуюФормуВЧат(ПечатныеФормы[0].Значение);
		Возврат;
	КонецЕсли;

	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПослеВыбораПечатнойФормы",
		ЭтотОбъект);
	ПоказатьВыборИзМеню(
		ОписаниеОповещения,
		ПечатныеФормы,
		Элементы.СвязанныеДокументы);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПечатнойФормы(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОтправитьПечатнуюФормуВЧат(ВыбранныйЭлемент.Значение);

КонецПроцедуры

