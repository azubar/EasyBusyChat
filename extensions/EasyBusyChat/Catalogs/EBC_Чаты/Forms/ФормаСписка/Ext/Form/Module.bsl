#Область ОбработчикиСобытийФормы

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьСписок(Команда)

	Результат = ЗагрузитьСписокНаСервере();
	Если Результат.Успех Тогда
		ПоказатьОповещениеПользователя(
			НСтр(
				"ru = 'Синхронизация чатов Easy Busy Chat';
				|uk = 'Синхронізація чатів Easy Busy Chat'"),
			,
			СтрШаблон(
				НСтр(
					"ru = 'Загружено или обновлено чатов: %1';
					|uk = 'Завантажено або оновлено чатів: %1'"),
				Результат.Количество));
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			СтрШаблон(
				НСтр(
					"ru = 'Чаты загружены с ошибками. Обработано: %1. %2';
					|uk = 'Чати завантажено з помилками. Оброблено: %1. %2'"),
				Результат.Количество,
				Результат.Ошибка));
	КонецЕсли;

	Элементы.Список.Обновить();

КонецПроцедуры

&НаКлиенте
Процедура УдалитьВыбранныеЧаты(Команда)

	ВыбранныеЧаты = ПолучитьВыбранныеЧаты();
	Если ВыбранныеЧаты.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр(
				"ru = 'Выберите чаты для удаления.';
				|uk = 'Виберіть чати для видалення.'"));
		Возврат;
	КонецЕсли;

	ТекстВопроса = СтрШаблон(
		НСтр(
			"ru = 'Действительно вы хотите удалить выбранные чаты (количество чатов: %1)?';
			|uk = 'Ви дійсно хочете видалити вибрані чати (кількість чатів: %1)?'"),
		ВыбранныеЧаты.Количество());
	Обработчик = Новый ОписаниеОповещения(
		"УдалитьВыбранныеЧатыЗавершение",
		ЭтотОбъект,
		ВыбранныеЧаты);
	ПоказатьВопрос(
		Обработчик,
		ТекстВопроса,
		РежимДиалогаВопрос.ДаНет,
		,
		КодВозвратаДиалога.Нет);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

&НаКлиенте
Процедура УдалитьВыбранныеЧатыЗавершение(Ответ, ВыбранныеЧаты) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Результат = УдалитьВыбранныеЧатыНаСервере(ВыбранныеЧаты);
	Если Результат.Успех Тогда
		Элементы.Список.Обновить();
		ПоказатьОповещениеПользователя(
			НСтр(
				"ru = 'Удаление чатов Easy Busy Chat';
				|uk = 'Видалення чатів Easy Busy Chat'"),
			,
			СтрШаблон(
				НСтр(
					"ru = 'Удалено чатов: %1';
					|uk = 'Видалено чатів: %1'"),
				Результат.Количество));
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			СтрШаблон(
				НСтр(
					"ru = 'Не удалось удалить выбранные чаты. %1';
					|uk = 'Не вдалося видалити вибрані чати. %1'"),
				Результат.Ошибка));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗагрузитьСписокНаСервере()
	Возврат EBC_Ядро.ЗагрузитьЧатыЗаПериод(60);
КонецФункции

&НаКлиенте
Функция ПолучитьВыбранныеЧаты()

	Результат = Новый Массив;
	Для Каждого Чат Из Элементы.Список.ВыделенныеСтроки Цикл
		Если ТипЗнч(Чат) = Тип("СправочникСсылка.EBC_Чаты")
			И ЗначениеЗаполнено(Чат) Тогда
			Результат.Добавить(Чат);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция УдалитьВыбранныеЧатыНаСервере(Знач ВыбранныеЧаты)

	Результат = Новый Структура("Успех,Количество,Ошибка", Ложь, 0, "");
	Если ТипЗнч(ВыбранныеЧаты) <> Тип("Массив")
		Или ВыбранныеЧаты.Количество() = 0 Тогда
		Результат.Ошибка = НСтр(
			"ru = 'Не передан список чатов для удаления.';
			|uk = 'Не передано список чатів для видалення.'");
		Возврат Результат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Для Каждого Чат Из ВыбранныеЧаты Цикл
			Если ТипЗнч(Чат) <> Тип("СправочникСсылка.EBC_Чаты")
				Или Не ЗначениеЗаполнено(Чат) Тогда
				Продолжить;
			КонецЕсли;

			СвязиЧата = РегистрыСведений.EBC_СвязиОбъектов.СоздатьНаборЗаписей();
			СвязиЧата.Отбор.Чат.Установить(Чат);
			СвязиЧата.Записать();
			Чат.ПолучитьОбъект().Удалить();
			Результат.Количество = Результат.Количество + 1;
		КонецЦикла;

		Если Результат.Количество = 0 Тогда
			ВызватьИсключение НСтр(
				"ru = 'Не найдено чатов, доступных для удаления.';
				|uk = 'Не знайдено чатів, доступних для видалення.'");
		КонецЕсли;

		ЗафиксироватьТранзакцию();
		Результат.Успех = Истина;
	Исключение
		ОтменитьТранзакцию();
		Результат.Количество = 0;
		Результат.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти
