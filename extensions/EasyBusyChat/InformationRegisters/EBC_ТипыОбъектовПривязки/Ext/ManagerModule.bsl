// Модуль менеджера регистра EBC_ТипыОбъектовПривязки.
//
// Хранит список типов объектов учётной системы, с которыми можно связывать чаты.
// Тип хранится строкой полного имени метаданных - так же, как измерение
// EBC_СвязиОбъектов.ТипОбъекта. Благодаря этому расширение не зависит от состава
// объектов конкретной конфигурации: список задаёт администратор после подключения.

#Область ПрограммныйИнтерфейс

// Добавляет тип объекта в список доступных для привязки.
//
// Повторное добавление того же типа не создаёт вторую запись: полное имя -
// измерение, набор записей отбирается по нему. При этом порядок и признак
// использования у уже настроенного типа сохраняются: повторный вызов не должен
// ни сдвигать тип в конец списка, ни молча включать выключенный администратором.
// Представление и признак реквизита "Контрагент" перечитываются всегда - объект
// в конфигурации мог измениться после обновления.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта метаданных, например "Справочник.Контрагенты".
//  Порядок   - Число  - порядок в списках расширения; 0 - сохранить текущий,
//                       а для нового типа поставить в конец.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Ошибка (Строка).
//
Функция ДобавитьТип(Знач ПолноеИмя, Знач Порядок = 0) Экспорт

	ПолноеИмя = СокрЛП(Строка(ПолноеИмя));
	Если ПустаяСтрока(ПолноеИмя) Тогда
		Возврат Результат(Ложь, НСтр(
			"ru = 'Не указано полное имя объекта метаданных.';
			|uk = 'Не вказано повне ім''я об''єкта метаданих.'"));
	КонецЕсли;

	МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если МетаданныеОбъекта = Неопределено Тогда
		Возврат Результат(Ложь, СтрШаблон(НСтр(
			"ru = 'Объект метаданных ""%1"" не найден в этой конфигурации.';
			|uk = 'Об''єкт метаданих ""%1"" не знайдено в цій конфігурації.'"), ПолноеИмя));
	КонецЕсли;

	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ПолноеИмя.Установить(ПолноеИмя);
	НаборЗаписей.Прочитать();

	Использовать = Истина;
	Если НаборЗаписей.Количество() > 0 Тогда
		Существующая = НаборЗаписей[0];
		Использовать = Существующая.Использовать;
		Если Порядок = 0 Тогда
			Порядок = Существующая.Порядок;
		КонецЕсли;
	КонецЕсли;

	Если Порядок = 0 Тогда
		Порядок = СледующийПорядок();
	КонецЕсли;

	НаборЗаписей.Очистить();

	Запись = НаборЗаписей.Добавить();
	Запись.ПолноеИмя = ПолноеИмя;
	Запись.Использовать = Использовать;
	Запись.Порядок = Порядок;
	Запись.Представление = ПредставлениеОбъекта(МетаданныеОбъекта);
	Запись.ЕстьРеквизитКонтрагент = ЕстьРеквизитКонтрагент(МетаданныеОбъекта);

	НаборЗаписей.Записать();

	Возврат Результат(Истина, "");

КонецФункции

// Включает или выключает уже настроенный тип, не трогая остальные его свойства.
//
// Параметры:
//  ПолноеИмя    - Строка;
//  Использовать - Булево.
//
Процедура УстановитьИспользование(Знач ПолноеИмя, Знач Использовать) Экспорт

	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ПолноеИмя.Установить(СокрЛП(Строка(ПолноеИмя)));
	НаборЗаписей.Прочитать();

	Если НаборЗаписей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	НаборЗаписей[0].Использовать = Использовать;
	НаборЗаписей.Записать();

КонецПроцедуры

// Удаляет тип объекта из списка.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта метаданных.
//
Процедура УдалитьТип(Знач ПолноеИмя) Экспорт

	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ПолноеИмя.Установить(СокрЛП(Строка(ПолноеИмя)));
	НаборЗаписей.Записать();

КонецПроцедуры

// Возвращает настроенные типы объектов.
//
// Параметры:
//  ТолькоИспользуемые - Булево - не возвращать типы с выключенным флажком.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки:
//   * ПолноеИмя              - Строка;
//   * Использовать           - Булево;
//   * Порядок                - Число;
//   * Представление          - Строка - синоним на момент настройки;
//   * ЕстьРеквизитКонтрагент - Булево;
//   * Существует             - Булево - объект найден в текущей конфигурации;
//   * ЕстьПраво              - Булево - у текущего пользователя есть право чтения;
//   * Вид                    - Строка - "Справочник", "Документ" или иное.
//  Строки упорядочены по Порядок, затем по Представление.
//
Функция НастроенныеТипы(Знач ТолькоИспользуемые = Ложь) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| Типы.ПолноеИмя КАК ПолноеИмя,
		| Типы.Использовать КАК Использовать,
		| Типы.Порядок КАК Порядок,
		| Типы.Представление КАК Представление,
		| Типы.ЕстьРеквизитКонтрагент КАК ЕстьРеквизитКонтрагент
		|ИЗ
		| РегистрСведений.EBC_ТипыОбъектовПривязки КАК Типы
		|ГДЕ
		| &УсловиеИспользования
		|УПОРЯДОЧИТЬ ПО
		| Порядок,
		| Представление";
	Запрос.Текст = СтрЗаменить(
		Запрос.Текст,
		"&УсловиеИспользования",
		?(ТолькоИспользуемые, "Типы.Использовать", "ИСТИНА"));

	Результат = Запрос.Выполнить().Выгрузить();
	Результат.Колонки.Добавить("Существует", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("ЕстьПраво", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить(
		"Вид",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));

	Для Каждого Строка Из Результат Цикл
		МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(Строка.ПолноеИмя);
		Строка.Существует = МетаданныеОбъекта <> Неопределено;
		// Право проверяется отдельно: объект может быть, а доступа к нему - нет.
		Строка.ЕстьПраво = Строка.Существует
			И ПравоДоступа("Чтение", МетаданныеОбъекта);
		Строка.Вид = ВидОбъекта(Строка.ПолноеИмя);
		Если Строка.Существует И ПустаяСтрока(Строка.Представление) Тогда
			Строка.Представление = ПредставлениеОбъекта(МетаданныеОбъекта);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Заполняет список типов значением по умолчанию, если он пуст.
//
// Справочник контрагентов есть практически в любой конфигурации, но его наличие
// всё равно проверяется. Документы по умолчанию не добавляются: их состав слишком
// разный, чтобы угадывать.
//
// Возвращаемое значение:
//  Булево - Истина, если что-то было добавлено.
//
Функция ЗаполнитьПоУмолчанию() Экспорт

	Если Не ПустойСписок() Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ДобавитьТип(ПолноеИмяКонтрагентовПоУмолчанию(), 1).Успех;

КонецФункции

// Добавляет недостающие типовые документы BAS Малый бизнес.
//
// Уже настроенные типы не изменяются: сохраняются их порядок и признак
// использования. Отсутствующие в основной конфигурации документы пропускаются.
//
// Возвращаемое значение:
//  Число - количество добавленных типов.
//
Функция ДобавитьРекомендуемыеТипы() Экспорт

	Добавлено = 0;

	Для Каждого Рекомендуемый Из РекомендуемыеТипы() Цикл
		Если Рекомендуемый.Настроен Тогда
			Продолжить;
		КонецЕсли;

		Если ДобавитьТип(Рекомендуемый.ПолноеИмя, Рекомендуемый.Порядок).Успех Тогда
			Добавлено = Добавлено + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Добавлено;

КонецФункции

// Возвращает существующие в основной конфигурации рекомендуемые документы.
//
// Состав намеренно ограничен объектами BAS Малый бизнес. Справочник Партнеры
// и альтернативные документы других конфигураций в это расширение не входят.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * ПолноеИмя     - Строка;
//   * Представление - Строка;
//   * Порядок       - Число;
//   * Роль          - Строка;
//   * Настроен      - Булево.
//
Функция РекомендуемыеТипы() Экспорт

	Кандидаты = Новый Массив;
	Кандидаты.Добавить(Новый Структура(
		"Порядок,Роль,ПолноеИмя",
		10, "Заказ", "Документ.ЗаказПокупателя"));
	Кандидаты.Добавить(Новый Структура(
		"Порядок,Роль,ПолноеИмя",
		20, "Счет", "Документ.СчетНаОплату"));
	Кандидаты.Добавить(Новый Структура(
		"Порядок,Роль,ПолноеИмя",
		30, "Реализация", "Документ.РасходнаяНакладная"));

	Настроенные = НастроенныеТипы();
	Результат = Новый Массив;

	Для Каждого Кандидат Из Кандидаты Цикл
		МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(Кандидат.ПолноеИмя);
		Если МетаданныеОбъекта = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Элемент = Новый Структура;
		Элемент.Вставить("ПолноеИмя", Кандидат.ПолноеИмя);
		Элемент.Вставить("Представление", ПредставлениеОбъекта(МетаданныеОбъекта));
		Элемент.Вставить("Порядок", Кандидат.Порядок);
		Элемент.Вставить("Роль", Кандидат.Роль);
		Элемент.Вставить(
			"Настроен",
			Настроенные.Найти(Кандидат.ПолноеИмя, "ПолноеИмя") <> Неопределено);
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Проверяет, есть ли у объекта метаданных реквизит с именем "Контрагент".
//
// Отбор по контрагенту в форме привязки работает только для таких объектов.
// В конфигурациях, где реквизит называется иначе (Партнер в УТ и ERP), отбор
// просто не появится - форма останется работоспособной.
//
// Параметры:
//  МетаданныеОбъекта - ОбъектМетаданных - или Строка с полным именем.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьРеквизитКонтрагент(Знач МетаданныеОбъекта) Экспорт

	Если ТипЗнч(МетаданныеОбъекта) = Тип("Строка") Тогда
		МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(МетаданныеОбъекта);
	КонецЕсли;

	Если МетаданныеОбъекта = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Возврат МетаданныеОбъекта.Реквизиты.Найти("Контрагент") <> Неопределено;
	Исключение
		// У объекта может не быть коллекции реквизитов вовсе.
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Полное имя справочника контрагентов, предлагаемое по умолчанию.
//
Функция ПолноеИмяКонтрагентовПоУмолчанию() Экспорт

	Возврат "Справочник.Контрагенты";

КонецФункции

// Вид объекта по полному имени: "Справочник", "Документ" и так далее.
//
// Параметры:
//  ПолноеИмя - Строка.
//
// Возвращаемое значение:
//  Строка - пустая, если имя не разобрано.
//
Функция ВидОбъекта(Знач ПолноеИмя) Экспорт

	Части = СтрРазделить(СокрЛП(Строка(ПолноеИмя)), ".", Ложь);
	Возврат ?(Части.Количество() = 0, "", Части[0]);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Признак того, что список типов ещё не заполнен.
//
Функция ПустойСписок()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| 1 КАК Поле
		|ИЗ
		| РегистрСведений.EBC_ТипыОбъектовПривязки КАК Типы";

	Возврат Запрос.Выполнить().Пустой();

КонецФункции

// Следующий свободный порядок - на единицу больше максимального.
//
Функция СледующийПорядок()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| МАКСИМУМ(Типы.Порядок) КАК Порядок
		|ИЗ
		| РегистрСведений.EBC_ТипыОбъектовПривязки КАК Типы";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Или Выборка.Порядок = Null Тогда
		Возврат 1;
	КонецЕсли;

	Возврат Выборка.Порядок + 1;

КонецФункции

// Представление объекта метаданных: синоним, а при его отсутствии - имя.
//
Функция ПредставлениеОбъекта(Знач МетаданныеОбъекта)

	Представление = СокрЛП(МетаданныеОбъекта.Синоним);
	Если ПустаяСтрока(Представление) Тогда
		Представление = МетаданныеОбъекта.Имя;
	КонецЕсли;

	Возврат Лев(Представление, 150);

КонецФункции

Функция Результат(Знач Успех, Знач Ошибка)

	Возврат Новый Структура("Успех, Ошибка", Успех, Ошибка);

КонецФункции

#КонецОбласти
