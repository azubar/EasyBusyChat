#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Список типов заполняется значением по умолчанию при первом открытии
	// настроек: подключили расширение - контрагенты уже доступны для привязки.
	РегистрыСведений.EBC_ТипыОбъектовПривязки.ЗаполнитьПоУмолчанию();

	ЗаполнитьТипыОбъектов();

	// Ресурс масштаба добавлен позже остальных, поэтому в записях, заведённых
	// до обновления расширения, он лежит нулём. Чтение настроек нуль всё равно
	// заменяет умолчанием, но форма показывала бы 0 - то есть значение, которое
	// нигде не применяется. Подставляем то же умолчание, что использует чтение.
	//
	// Именно здесь, а не в ПриЧтенииНаСервере: у формы записи регистра правка
	// параметра ТекущийОбъект в реквизит Запись не переносится - проверено в
	// базе, поле продолжало показывать ноль. К моменту ПриСозданииНаСервере
	// запись уже прочитана, и присваивание в Запись работает и для существующей
	// записи, и для новой.
	Если Запись.МасштабКартинкиПечатнойФормы <= 0 Тогда
		Запись.МасштабКартинкиПечатнойФормы =
			EBC_НастройкиСервер.МасштабКартинкиПечатнойФормыПоУмолчанию();
	КонецЕсли;

	// Адрес сервиса подставляется по той же причине и в том же месте: запись
	// настроек заводится через эту форму, а не кодом, и до первого сохранения
	// умолчание из ЗаполнитьНастройкиПоУмолчанию до неё не доходит. Пустое
	// поле означало бы, что администратор должен знать адрес наизусть.
	Если ПустаяСтрока(Запись.БазовыйАдресАпи) Тогда
		Запись.БазовыйАдресАпи =
			EBC_НастройкиСервер.БазовыйАдресАпиПоУмолчанию();
	КонецЕсли;

	Если Не Запись.НастройкиЛогированияМигрированы Тогда
		Запись.ЛогироватьТехническиеСобытия = Истина;
		Запись.ЛогироватьДействияПользователей = Истина;
		Запись.НастройкиЛогированияМигрированы = Истина;
	КонецЕсли;
	Элементы.ЛогироватьТехническиеСобытия.Доступность = Не ЗначениеЗаполнено(Запись.ПользовательИБ);
	Элементы.ЛогироватьДействияПользователей.Доступность = Не ЗначениеЗаполнено(Запись.ПользовательИБ);

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ЗаполнитьСведенияОСистеме();

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	ЗаписатьТипыОбъектов();

	// Настройки кэшируются на время сеанса, поэтому без сброса кэша новые
	// значения (адрес API, таймаут, уровень логирования, состав типов объектов)
	// не применились бы до перезапуска сеанса.
	ОбновитьПовторноИспользуемыеЗначения();

	ЗаполнитьТипыОбъектов();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ИнформацияОКомпонентеОбработкаНавигационнойСсылки(
		Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Адрес = СокрЛП(Строка(НавигационнаяСсылкаФорматированнойСтроки));
	Если Не ПустаяСтрока(Адрес) Тогда
		ОбщегоНазначенияКлиент.ОткрытьНавигационнуюСсылку(Адрес);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТипыСправочниковПередНачаломДобавления(
		Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	// Строка добавляется только через выбор объекта метаданных: вручную
	// ввести полное имя нельзя, иначе в настройках появится мусор.
	Отказ = Истина;
	ВыбратьОбъектМетаданных("Справочник");

КонецПроцедуры

&НаКлиенте
Процедура ТипыДокументовПередНачаломДобавления(
		Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	Отказ = Истина;
	ВыбратьОбъектМетаданных("Документ");

КонецПроцедуры

&НаКлиенте
Процедура ТипыСправочниковПередУдалением(Элемент, Отказ)

	Отказ = Истина;
	УдалитьВыбранныйТип(Элементы.ТипыСправочников, ТипыСправочников);

КонецПроцедуры

&НаКлиенте
Процедура ТипыДокументовПередУдалением(Элемент, Отказ)

	Отказ = Истина;
	УдалитьВыбранныйТип(Элементы.ТипыДокументов, ТипыДокументов);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьПервоначальныеДанные(Команда)

	Если Не ЗначениеЗаполнено(Запись.ТокенДоступа) Тогда
		ПоказатьПредупреждение(
			,
			НСтр(
				"ru = 'Укажите токен доступа Easy Busy Chat и повторите заполнение.';
				|uk = 'Вкажіть токен доступу Easy Busy Chat і повторіть заповнення.'"));
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения(
		"ЗаполнитьПервоначальныеДанныеЗавершение",
		ЭтотОбъект);
	ПоказатьВопрос(
		Оповещение,
		НСтр(
			"ru = 'Будут загружены компании, учетные записи и пользователи Easy Busy Chat. Операция может занять несколько минут. Продолжить?';
			|uk = 'Будуть завантажені компанії, облікові записи та користувачі Easy Busy Chat. Операція може зайняти кілька хвилин. Продовжити?'"),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

// Предлагает добавить отсутствующие типовые документы BAS Малый бизнес.
&НаКлиенте
Процедура ДобавитьРекомендуемыеТипы(Команда)

	Недостающие = НедостающиеРекомендуемыеТипы();

	Если Недостающие.Количество() = 0 Тогда
		ПоказатьПредупреждение(
			,
			НСтр(
				"ru = 'Все рекомендуемые типы уже настроены или отсутствуют в конфигурации.';
				|uk = 'Усі рекомендовані типи вже налаштовано або вони відсутні в конфігурації.'"));
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения(
		"ДобавитьРекомендуемыеТипыЗавершение",
		ЭтотОбъект);
	ПоказатьВопрос(
		Оповещение,
		СтрШаблон(
			НСтр(
				"ru = 'Будут добавлены типы:%1%2%1Продолжить?';
				|uk = 'Будуть додані типи:%1%2%1Продовжити?'"),
			Символы.ПС,
			СтрСоединить(Недостающие, Символы.ПС)),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

&НаКлиенте
Процедура ДобавитьРекомендуемыеТипыЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Добавлено = ДобавитьРекомендуемыеТипыНаСервере();

	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Easy Busy Chat'; uk = 'Easy Busy Chat'"),
		,
		СтрШаблон(
			НСтр("ru = 'Добавлено типов: %1'; uk = 'Додано типів: %1'"),
			Добавлено));

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПервоначальныеДанныеЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	// Клиент API читает токен из регистра, а не из данных формы,
	// поэтому запись настроек обязательна до обращения к сервису.
	Если Модифицированность Тогда
		Если Не Записать() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	СостояниеОперации = НСтр(
		"ru = 'Загрузка данных Easy Busy Chat...';
		|uk = 'Завантаження даних Easy Busy Chat...'");
	Состояние(СостояниеОперации);

	Результат = ЗаполнитьПервоначальныеДанныеНаСервере();

	Если Результат.Успех Тогда
		ПоказатьОповещениеПользователя(
			НСтр(
				"ru = 'Easy Busy Chat';
				|uk = 'Easy Busy Chat'"),
			,
			Результат.Сообщение);
	Иначе
		ПоказатьПредупреждение(, Результат.Сообщение);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область СистемаИТребования

// Минимальная версия платформы, на которой работает внешняя компонента.
&НаКлиентеНаСервереБезКонтекста
Функция МинимальнаяВерсияПлатформы()
	Возврат "8.3.19.1529";
КонецФункции

// Минимальный режим совместимости конфигурации.
&НаКлиентеНаСервереБезКонтекста
Функция МинимальныйРежимСовместимости()
	Возврат "8.3.14";
КонецФункции

// Минимальная версия библиотеки стандартных подсистем.
&НаКлиентеНаСервереБезКонтекста
Функция МинимальнаяВерсияБСП()
	Возврат "3.1";
КонецФункции

// Сведения о среде, которые видны только на сервере.
//
// Версия платформы берётся отдельно на клиенте: внешняя компонента исполняется
// именно там, и разрядность клиентского приложения может не совпадать с
// серверной.
//
// Возвращаемое значение:
//  Структура:
//   * ВерсияРасширения      - Строка;
//   * ИмяКонфигурации       - Строка - синоним конфигурации;
//   * ВерсияКонфигурации    - Строка;
//   * РежимСовместимости    - Строка - "8.3.14" и подобные;
//   * ВерсияБСП             - Строка - пустая, если библиотеки нет.
//
&НаСервереБезКонтекста
Функция СведенияОСредеСервера()

	Результат = Новый Структура;
	Результат.Вставить("ВерсияРасширения", "");
	Результат.Вставить("ИмяКонфигурации", СокрЛП(Метаданные.Синоним));
	Результат.Вставить("ВерсияКонфигурации", СокрЛП(Метаданные.Версия));
	Результат.Вставить("РежимСовместимости", РежимСовместимостиСтрокой());
	Результат.Вставить("ВерсияБСП", ВерсияБСП());

	Если ПустаяСтрока(Результат.ИмяКонфигурации) Тогда
		Результат.ИмяКонфигурации = Метаданные.Имя;
	КонецЕсли;

	// Расширение ищет само себя по имени: свойства собственного расширения
	// изнутри доступны только через список подключённых.
	Попытка
		Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
			Если Расширение.Имя = "EasyBusyChat" Тогда
				Результат.ВерсияРасширения = СокрЛП(Строка(Расширение.Версия));
				Прервать;
			КонецЕсли;
		КонецЦикла;
	Исключение
		// Нет права на чтение списка расширений: версия просто не показывается.
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Режим совместимости конфигурации в виде "8.3.14".
//
// Платформа отдаёт его перечислением с именами вида "Версия8_3_14", поэтому
// значение приводится к привычной записи разбором строки, без перечисления
// всех известных вариантов.
//
&НаСервереБезКонтекста
Функция РежимСовместимостиСтрокой()

	Попытка
		// Строка, а не XMLСтрока: для системных перечислений платформы
		// XML-сериализация не определена и выбрасывает исключение - на этом
		// уже споткнулся ТипПлатформы. Локализация представления разбору ниже
		// не мешает: из строки берутся только цифры.
		Представление = Строка(Метаданные.РежимСовместимости);
	Исключение
		Возврат "";
	КонецПопытки;

	Возврат НомерВерсииИзТекста(Представление);

КонецФункции

// Вынимает номер версии из произвольного представления.
//
// Берётся самая длинная группа из цифр и разделителей. Просто "оставить одни
// цифры" нельзя: представление вроде "1С:Предприятие 8.3.14" склеилось бы в
// "18.3.14". Слова разбор не смущают - "НеИспользовать" и "DontUse" цифр не
// содержат вовсе, и результат окажется пустым.
//
&НаКлиентеНаСервереБезКонтекста
Функция НомерВерсииИзТекста(Знач Текст)

	Лучший = "";
	Текущий = "";

	// Лишний проход по длине +1 закрывает группу, которая упирается в конец строки.
	Для Позиция = 1 По СтрДлина(Текст) + 1 Цикл
		Символ = ?(Позиция > СтрДлина(Текст), " ", Сред(Текст, Позиция, 1));

		Если Символ >= "0" И Символ <= "9" Тогда
			Текущий = Текущий + Символ;
		ИначеЕсли (Символ = "." Или Символ = "_") И Не ПустаяСтрока(Текущий) Тогда
			Текущий = Текущий + ".";
		Иначе
			// Группа кончилась: хвостовой разделитель к версии не относится.
			Пока СтрЗаканчиваетсяНа(Текущий, ".") Цикл
				Текущий = Лев(Текущий, СтрДлина(Текущий) - 1);
			КонецЦикла;

			Если СтрДлина(Текущий) > СтрДлина(Лучший) Тогда
				Лучший = Текущий;
			КонецЕсли;
			Текущий = "";
		КонецЕсли;
	КонецЦикла;

	Возврат ?(ЭтоНомерВерсии(Лучший), Лучший, "");

КонецФункции

// Версия БСП или пустая строка, если библиотеки в конфигурации нет.
&НаСервереБезКонтекста
Функция ВерсияБСП()

	Если Метаданные.ОбщиеМодули.Найти("СтандартныеПодсистемыСервер") = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Модуль = ОбщегоНазначения.ОбщийМодуль("СтандартныеПодсистемыСервер");
		Возврат СокрЛП(Строка(Модуль.ВерсияБиблиотеки()));
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Строка похожа на номер версии: непустая и состоит только из цифр и точек.
//
// Своя проверка, а не СтроковыеФункцииКлиентСервер: блок сведений о системе
// должен рисоваться даже там, где что-то не так с библиотекой - иначе
// администратор не увидит именно того сообщения, ради которого сюда зашёл.
//
&НаКлиентеНаСервереБезКонтекста
Функция ЭтоНомерВерсии(Знач Значение)

	Значение = СокрЛП(Значение);
	Если ПустаяСтрока(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;

	ЕстьЦифра = Ложь;
	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Позиция, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			ЕстьЦифра = Истина;
		ИначеЕсли Символ <> "." Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат ЕстьЦифра;

КонецФункции

// Сравнивает номера версий вида "8.3.19.1529".
//
// Возвращаемое значение:
//  Число - -1, 0 или 1; отсутствующие части считаются нулями, поэтому
//          "3.1" и "3.1.0.0" равны.
//
&НаКлиентеНаСервереБезКонтекста
Функция СравнитьВерсии(Знач Версия1, Знач Версия2)

	Части1 = СтрРазделить(СокрЛП(Версия1), ".", Ложь);
	Части2 = СтрРазделить(СокрЛП(Версия2), ".", Ложь);

	Всего = Макс(Части1.Количество(), Части2.Количество());
	Для Индекс = 0 По Всего - 1 Цикл
		Число1 = ?(Индекс < Части1.Количество(), ЧислоИзСтроки(Части1[Индекс]), 0);
		Число2 = ?(Индекс < Части2.Количество(), ЧислоИзСтроки(Части2[Индекс]), 0);

		Если Число1 > Число2 Тогда
			Возврат 1;
		ИначеЕсли Число1 < Число2 Тогда
			Возврат -1;
		КонецЕсли;
	КонецЦикла;

	Возврат 0;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЧислоИзСтроки(Знач Значение)

	Попытка
		Возврат Число(СокрЛП(Значение));
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

// Заполняет блок сведений о системе и проверку требований.
&НаКлиенте
Процедура ЗаполнитьСведенияОСистеме()

	Сведения = СведенияОСредеСервера();

	СистемнаяИнформацияКлиента = Новый СистемнаяИнформация;
	ВерсияПлатформы = СокрЛП(СистемнаяИнформацияКлиента.ВерсияПриложения);
	Разрядность64 = Разрядность64(СистемнаяИнформацияКлиента);

	Элементы.ИнформацияОСреде.Заголовок = ТекстСведенийИТребований(
		Сведения,
		ВерсияПлатформы,
		Разрядность64);
	Элементы.ИнформацияОКомпоненте.Заголовок = ТекстОКомпоненте(Разрядность64);

КонецПроцедуры

// Разрядность клиентского приложения.
//
// Важна именно клиентская: внешняя компонента Native API грузится в процесс
// клиента, и распространяемый пакет Visual C++ нужен той же разрядности.
//
&НаКлиенте
Функция Разрядность64(Знач СистемнаяИнформацияКлиента)

	// Сравнение с конкретными значениями, а не разбор представления:
	// XMLСтрока для ТипПлатформы не определена и выбрасывает исключение,
	// а Строка() локализуется. Так же это делает БСП в ВнешниеКомпонентыСлужебныйКлиент.
	//
	// Сомнение трактуется в пользу x64: сегодня это подавляющее большинство
	// клиентов, и ошибиться в подсказке лучше в сторону распространённого.
	Попытка
		ТипПлатформыКлиента = СистемнаяИнформацияКлиента.ТипПлатформы;

		Возврат ТипПлатформыКлиента = ТипПлатформы.Windows_x86_64
			Или ТипПлатформыКлиента = ТипПлатформы.Linux_x86_64
			Или ТипПлатформыКлиента = ТипПлатформы.MacOS_x86_64;
	Исключение
		Возврат Истина;
	КонецПопытки;

КонецФункции

// Единый блок: что за система и подходит ли она расширению.
//
// Сведения и проверка требований намеренно объединены в один список. Раздельно
// это читалось как две таблицы про одно и то же: сначала "платформа такая-то",
// затем "требуется такая-то" - и глазами приходилось сопоставлять строки
// вручную. Здесь каждая строка сразу отвечает на вопрос "у меня подходит?".
//
// Строки без требований (конфигурация, версия расширения) отметки не получают:
// им нечему соответствовать, это просто справка.
//
&НаКлиентеНаСервереБезКонтекста
Функция ТекстСведенийИТребований(Знач Сведения, Знач ВерсияПлатформы, Знач Разрядность64)

	Строки = Новый Массив;


	ДобавитьСтрокуСведений(
		Строки,
		НСтр("ru = 'Конфигурация:'; uk = 'Конфігурація:'"),
		СтрШаблон(
			НСтр("ru = '%1, версия %2'; uk = '%1 %2'"),
			СтрЗаменить(СтрЗаменить(Сведения.ИмяКонфигурации,"Business automation software","BAS"), "Business Automation Software","BAS"),
			?(ПустаяСтрока(Сведения.ВерсияКонфигурации), "-", Сведения.ВерсияКонфигурации)));

	ДобавитьСтрокуСведений(
		Строки,
		НСтр("ru = 'Расширение Easy-Busy Chat:'; uk = 'Розширення Easy-Busy Chat:'"),
		?(ПустаяСтрока(Сведения.ВерсияРасширения),
			НСтр("ru = 'версия неизвестна'; uk = 'версія невідома'"),
			Сведения.ВерсияРасширения)+Символы.ПС);

	ДобавитьСтрокуСведений(
		Строки,
		НСтр("ru = 'Платформа:'; uk = 'Платформа:'"),
		СтрШаблон("%1 (%2)", ВерсияПлатформы, ?(Разрядность64, "x64", "x86")),
		СравнитьВерсии(ВерсияПлатформы, МинимальнаяВерсияПлатформы()) >= 0,
		МинимальнаяВерсияПлатформы());

	// Пустой режим совместимости означает "текущая версия платформы": она
	// заведомо не ниже минимальной, требование выполнено.
	РежимПодходит = ПустаяСтрока(Сведения.РежимСовместимости)
		Или СравнитьВерсии(Сведения.РежимСовместимости, МинимальныйРежимСовместимости()) >= 0;
	ДобавитьСтрокуСведений(
		Строки,
		НСтр("ru = 'Режим совместимости:'; uk = 'Режим сумісності:'"),
		?(ПустаяСтрока(Сведения.РежимСовместимости),
			НСтр("ru = 'текущая версия платформы'; uk = 'поточна версія платформи'"),
			Сведения.РежимСовместимости),
		РежимПодходит,
		МинимальныйРежимСовместимости());

	БСППодходит = Не ПустаяСтрока(Сведения.ВерсияБСП)
		И СравнитьВерсии(Сведения.ВерсияБСП, МинимальнаяВерсияБСП()) >= 0;
	ДобавитьСтрокуСведений(
		Строки,
		НСтр("ru = 'Библиотека стандартных подсистем:'; uk = 'Бібліотека стандартних підсистем:'"),
		?(ПустаяСтрока(Сведения.ВерсияБСП),
			НСтр("ru = 'не обнаружена'; uk = 'не виявлено'"),
			Сведения.ВерсияБСП),
		БСППодходит,
		МинимальнаяВерсияБСП());

	Возврат Новый ФорматированнаяСтрока(Строки);

КонецФункции

// Добавляет строку "метка: значение" с необязательной отметкой соответствия.
//
// Параметры:
//  Строки           - Массив - куда добавляется;
//  Метка            - Строка - название показателя, выделяется жирным;
//  Значение         - Строка - что установлено у пользователя;
//  Выполнено        - Булево - Неопределено, если требования к показателю нет;
//  МинимальнаяВерсия - Строка - что требуется; попадает в текст ошибки.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьСтрокуСведений(
		Строки,
		Знач Метка,
		Знач Значение,
		Знач Выполнено = Неопределено,
		Знач МинимальнаяВерсия = "")

	// Отступ строкой пробелов: в надписи формы нет отступов списка, а без
	// сдвига показатели сливаются с заголовком блока.
	Строки.Добавить(" ");
	Строки.Добавить(Новый ФорматированнаяСтрока(Метка, Новый Шрифт(, , , Истина)));
	Строки.Добавить(" " + Значение);

	Если Выполнено = Истина Тогда
		Строки.Добавить(Новый ФорматированнаяСтрока(
			НСтр("ru = ' — ОК'; uk = ' — ОК'"),
			Новый Шрифт(, , , Истина),
			ЦветВыполненногоТребования()));
	ИначеЕсли Выполнено = Ложь Тогда
		Строки.Добавить(Новый ФорматированнаяСтрока(
			СтрШаблон(
				НСтр("ru = ' — нужно %1 и выше'; uk = ' — потрібно %1 і вище'"),
				МинимальнаяВерсия),
			Новый Шрифт(, , , Истина),
			ЦветНевыполненногоТребования()));
	КонецЕсли;

	Строки.Добавить(Символы.ПС);

КонецПроцедуры

// Цвет выполненного требования.
&НаКлиентеНаСервереБезКонтекста
Функция ЦветВыполненногоТребования()
	Возврат Новый Цвет(0, 128, 0);
КонецФункции

// Цвет невыполненного требования.
//
// Задаётся значением, а не элементом стиля: состав стилей у конфигураций
// разный, а расширение должно выглядеть одинаково в любой из них.
//
&НаКлиентеНаСервереБезКонтекста
Функция ЦветНевыполненногоТребования()
	Возврат Новый Цвет(176, 0, 32);
КонецФункции

// Текст о распространяемом пакете Visual C++, нужном внешней компоненте.
//
// Без vc_redist компонента не подключается, а окно чата просто не открывается,
// поэтому ссылка на нужную разрядность выделяется явно.
//
&НаКлиентеНаСервереБезКонтекста
Функция ТекстОКомпоненте(Знач Разрядность64)

	Строки = Новый Массив;
	Строки.Добавить(Новый ФорматированнаяСтрока(
		НСтр("ru = 'Компонента веб-плагина'; uk = 'Компонента веб-плагіна'"),
		Новый Шрифт(, , , Истина)));
	Строки.Добавить(Символы.ПС);

	Строки.Добавить(НСтр(
		"ru = 'Для работы окна чата нужен пакет Microsoft Visual C++ 14.';
		|uk = 'Для роботи вікна чату потрібен пакет Microsoft Visual C++ 14.'"));
	Строки.Добавить(Символы.ПС);
	Строки.Добавить(Символы.ПС);

	ДобавитьСсылкуНаПакет(Строки, "x64", "https://aka.ms/vc14/vc_redist.x64.exe", Разрядность64);
	ДобавитьСсылкуНаПакет(Строки, "x86", "https://aka.ms/vc14/vc_redist.x86.exe", Не Разрядность64);

	Возврат Новый ФорматированнаяСтрока(Строки);

КонецФункции

// Добавляет ссылку на пакет; нужная разрядность выделяется жирным.
&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьСсылкуНаПакет(Строки, Знач Разрядность, Знач Адрес, Знач Нужный)

	Если Нужный Тогда
		Строки.Добавить(Новый ФорматированнаяСтрока(
			СтрШаблон(
				НСтр("ru = 'Нужен для вашего клиента (%1): '; uk = 'Потрібен для вашого клієнта (%1): '")+Символы.ПС,
				Разрядность),
			Новый Шрифт(, , , Истина)));
		Строки.Добавить(Новый ФорматированнаяСтрока(
			Адрес,
			Новый Шрифт(, , , Истина),
			,
			,
			Адрес));
	Иначе
		Строки.Добавить(СтрШаблон(
			НСтр("ru = 'Для клиента %1: '; uk = 'Для клієнта %1: '")+Символы.ПС,
			Разрядность));
		Строки.Добавить(Новый ФорматированнаяСтрока(Адрес, , , , Адрес));
	КонецЕсли;

	Строки.Добавить(Символы.ПС);

КонецПроцедуры

#КонецОбласти

////////////////////////////////////////////////////////////////////////////////
// Объекты для привязки

// Представления рекомендуемых документов, которых ещё нет в настройках.
&НаСервереБезКонтекста
Функция НедостающиеРекомендуемыеТипы()

	Результат = Новый Массив;

	Для Каждого Рекомендуемый Из РегистрыСведений.EBC_ТипыОбъектовПривязки.РекомендуемыеТипы() Цикл
		Если Рекомендуемый.Настроен Тогда
			Продолжить;
		КонецЕсли;

		Результат.Добавить(СтрШаблон(
			"%1 (%2)",
			Рекомендуемый.Представление,
			Рекомендуемый.ПолноеИмя));
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ДобавитьРекомендуемыеТипыНаСервере()

	Добавлено = РегистрыСведений.EBC_ТипыОбъектовПривязки.ДобавитьРекомендуемыеТипы();
	ЗаполнитьТипыОбъектов();

	Возврат Добавлено;

КонецФункции

// Читает настроенные типы в таблицы формы.
//
// Строки, для которых объекта в конфигурации нет или нет права чтения,
// не пропадают: они попадают в таблицу с заполненной колонкой Состояние.
// Молча исчезнувшая настройка оставила бы администратора без объяснения,
// почему подменю не появляется.
//
&НаСервере
Процедура ЗаполнитьТипыОбъектов()

	ТипыСправочников.Очистить();
	ТипыДокументов.Очистить();

	Для Каждого Настроенный Из РегистрыСведений.EBC_ТипыОбъектовПривязки.НастроенныеТипы() Цикл

		Если Настроенный.Вид = "Справочник" Тогда
			НоваяСтрока = ТипыСправочников.Добавить();
		ИначеЕсли Настроенный.Вид = "Документ" Тогда
			НоваяСтрока = ТипыДокументов.Добавить();
		Иначе
			// Вид, который расширение не показывает: настройка сохраняется,
			// но управлять ею из этой формы нельзя.
			Продолжить;
		КонецЕсли;

		ЗаполнитьЗначенияСвойств(НоваяСтрока, Настроенный);
		НоваяСтрока.Доступен = Настроенный.Существует И Настроенный.ЕстьПраво;
		НоваяСтрока.Состояние = СостояниеТипа(Настроенный);

	КонецЦикла;

КонецПроцедуры

// Переносит содержимое таблиц формы в регистр.
//
// Удаление обрабатывается сравнением с текущим содержимым регистра: строки,
// которых в таблицах формы больше нет, из регистра убираются.
//
&НаСервере
Процедура ЗаписатьТипыОбъектов()

	Менеджер = РегистрыСведений.EBC_ТипыОбъектовПривязки;

	ОсталисьВФорме = Новый Соответствие;
	Порядок = 0;

	Для Каждого Таблица Из ТаблицыТипов() Цикл
		Для Каждого Строка Из Таблица Цикл
			Порядок = Порядок + 1;
			ОсталисьВФорме.Вставить(ВРег(Строка.ПолноеИмя), Истина);
			Менеджер.ДобавитьТип(Строка.ПолноеИмя, Порядок);
			Менеджер.УстановитьИспользование(Строка.ПолноеИмя, Строка.Использовать);
		КонецЦикла;
	КонецЦикла;

	Для Каждого Настроенный Из Менеджер.НастроенныеТипы() Цикл
		// Виды, которых в форме нет (не справочник и не документ), не трогаем:
		// удалять то, чем форма не управляет, было бы потерей настройки.
		Если Настроенный.Вид <> "Справочник" И Настроенный.Вид <> "Документ" Тогда
			Продолжить;
		КонецЕсли;
		Если ОсталисьВФорме.Получить(ВРег(Настроенный.ПолноеИмя)) = Неопределено Тогда
			Менеджер.УдалитьТип(Настроенный.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ТаблицыТипов()

	Результат = Новый Массив;
	Результат.Добавить(ТипыСправочников);
	Результат.Добавить(ТипыДокументов);

	Возврат Результат;

КонецФункции

// Текст колонки "Состояние": пусто, когда с типом всё в порядке.
//
&НаСервереБезКонтекста
Функция СостояниеТипа(Знач Настроенный)

	Если Не Настроенный.Существует Тогда
		Возврат НСтр(
			"ru = 'Объект не найден в конфигурации';
			|uk = 'Об''єкт не знайдено в конфігурації'");
	КонецЕсли;

	Если Не Настроенный.ЕстьПраво Тогда
		Возврат НСтр(
			"ru = 'Нет права чтения';
			|uk = 'Немає права читання'");
	КонецЕсли;

	Если Настроенный.ЕстьРеквизитКонтрагент Тогда
		Возврат НСтр(
			"ru = 'Отбор по контрагенту доступен';
			|uk = 'Відбір за контрагентом доступний'");
	КонецЕсли;

	Возврат "";

КонецФункции

// Открывает выбор объекта метаданных нужного вида.
//
// Параметры:
//  ВидОбъекта - Строка - "Справочник" либо "Документ".
//
&НаКлиенте
Процедура ВыбратьОбъектМетаданных(Знач ВидОбъекта)

	СписокВыбора = ДоступныеОбъектыМетаданных(ВидОбъекта);

	Если СписокВыбора.Количество() = 0 Тогда
		ПоказатьПредупреждение(
			,
			НСтр(
				"ru = 'Все доступные объекты этого вида уже добавлены.';
				|uk = 'Усі доступні об''єкти цього виду вже додано.'"));
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения(
		"ПослеВыбораОбъектаМетаданных",
		ЭтотОбъект,
		ВидОбъекта);

	// Третий параметр - элемент, около которого раскрыть список.
	// Четвёртый - начальное значение, а не заголовок, поэтому не задаётся.
	ЭлементТаблицы = ?(
		ВидОбъекта = "Справочник",
		Элементы.ТипыСправочников,
		Элементы.ТипыДокументов);

	ПоказатьВыборИзСписка(Оповещение, СписокВыбора, ЭлементТаблицы);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораОбъектаМетаданных(ВыбранныйЭлемент, ВидОбъекта) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДобавитьТипВТаблицу(ВыбранныйЭлемент.Значение, ВидОбъекта);
	Модифицированность = Истина;

КонецПроцедуры

// Объекты метаданных нужного вида, доступные для добавления.
//
// Отбрасываются объекты без права чтения и уже добавленные: предлагать то,
// что не заработает или уже есть, незачем.
//
&НаСервере
Функция ДоступныеОбъектыМетаданных(Знач ВидОбъекта)

	Если ВидОбъекта = "Справочник" Тогда
		Коллекция = Метаданные.Справочники;
		Таблица = ТипыСправочников;
	Иначе
		Коллекция = Метаданные.Документы;
		Таблица = ТипыДокументов;
	КонецЕсли;

	Добавленные = Новый Соответствие;
	Для Каждого Строка Из Таблица Цикл
		Добавленные.Вставить(ВРег(Строка.ПолноеИмя), Истина);
	КонецЦикла;

	Результат = Новый СписокЗначений;

	Для Каждого МетаданныеОбъекта Из Коллекция Цикл
		ПолноеИмя = МетаданныеОбъекта.ПолноеИмя();
		Если Добавленные.Получить(ВРег(ПолноеИмя)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Не ПравоДоступа("Чтение", МетаданныеОбъекта) Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(
			ПолноеИмя,
			ПредставлениеДляВыбора(МетаданныеОбъекта, ПолноеИмя));
	КонецЦикла;

	Результат.СортироватьПоПредставлению();

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеДляВыбора(Знач МетаданныеОбъекта, Знач ПолноеИмя)

	Синоним = СокрЛП(МетаданныеОбъекта.Синоним);
	Если ПустаяСтрока(Синоним) Или Синоним = МетаданныеОбъекта.Имя Тогда
		Возврат ПолноеИмя;
	КонецЕсли;

	Возврат Синоним + "  (" + ПолноеИмя + ")";

КонецФункции

&НаСервере
Процедура ДобавитьТипВТаблицу(Знач ПолноеИмя, Знач ВидОбъекта)

	Таблица = ?(ВидОбъекта = "Справочник", ТипыСправочников, ТипыДокументов);

	МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если МетаданныеОбъекта = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.ПолноеИмя = ПолноеИмя;
	НоваяСтрока.Представление = СокрЛП(МетаданныеОбъекта.Синоним);
	Если ПустаяСтрока(НоваяСтрока.Представление) Тогда
		НоваяСтрока.Представление = МетаданныеОбъекта.Имя;
	КонецЕсли;
	НоваяСтрока.Использовать = Истина;
	НоваяСтрока.Доступен = Истина;
	НоваяСтрока.ЕстьРеквизитКонтрагент =
		РегистрыСведений.EBC_ТипыОбъектовПривязки.ЕстьРеквизитКонтрагент(МетаданныеОбъекта);
	НоваяСтрока.Состояние = ?(
		НоваяСтрока.ЕстьРеквизитКонтрагент,
		НСтр(
			"ru = 'Отбор по контрагенту доступен';
			|uk = 'Відбір за контрагентом доступний'"),
		"");

КонецПроцедуры

&НаКлиенте
Процедура УдалитьВыбранныйТип(Знач ЭлементТаблицы, Таблица)

	ТекущиеДанные = ЭлементТаблицы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// ДанныеФормыКоллекция удаляет строку по индексу, а не по самой строке.
	Таблица.Удалить(Таблица.Индекс(ТекущиеДанные));
	Модифицированность = Истина;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Первоначальное заполнение справочников

// Выполняет первоначальное заполнение справочников Easy Busy Chat.
//
// Возвращаемое значение:
//  Структура - Успех, Сообщение, Компаний, УчетныхЗаписей, Пользователей.
//
&НаСервере
Функция ЗаполнитьПервоначальныеДанныеНаСервере()

	Результат = НовыйРезультатЗаполнения();

	ТокенДоступа = "";
	Попытка
		ТокенДоступа = EBC_НастройкиСервер.ПолучитьТокенДоступа();
	Исключение
		Результат.Сообщение = СтрШаблон(
			НСтр(
				"ru = 'Не удалось прочитать токен доступа из настроек. %1';
				|uk = 'Не вдалося прочитати токен доступу з налаштувань. %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Результат;
	КонецПопытки;

	Если ПустаяСтрока(ТокенДоступа) Тогда
		Результат.Сообщение = НСтр(
			"ru = 'Токен доступа не найден в настройках, которые использует клиент API. Проверьте, что запись настроек относится к текущему пользователю.';
			|uk = 'Токен доступу не знайдено в налаштуваннях, які використовує клієнт API. Перевірте, що запис налаштувань стосується поточного користувача.'");
		Возврат Результат;
	КонецЕсли;

	ЗагрузитьСправочникиПоТокену(Результат);

	Возврат Результат;

КонецФункции

// Загружает по токену доступа компании, учетные записи и пользователей Easy Busy Chat.
//
// Компании и учетные записи загружает EBC_Ядро.СинхронизироватьСтруктуруКомпаний.
// Он вызывается внутри EBC_Ядро.ЗагрузитьПользователей, поэтому достаточно
// одного вызова: отдельная синхронизация структуры выполнила бы ту же работу дважды
// и дважды захватила бы аренду синхронизации.
//
// Параметры:
//  Результат - Структура - заполняется количеством загруженного и текстом сообщения.
//
&НаСервере
Процедура ЗагрузитьСправочникиПоТокену(Результат)

	Попытка
		РезультатЗагрузки = EBC_Ядро.ЗагрузитьПользователей();
	Исключение
		ЗаполнитьКоличествоЗагруженного(Результат);
		Результат.Сообщение = СтрШаблон(
			НСтр(
				"ru = 'Заполнение прервано. %1';
				|uk = 'Заповнення перервано. %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	ЗаполнитьКоличествоЗагруженного(Результат);

	Если Не РезультатЗагрузки.Успех Тогда
		Результат.Сообщение = СтрШаблон(
			НСтр(
				"ru = 'Заполнение завершено с ошибками. %1 В базе: компаний %2, учетных записей %3, пользователей %4.';
				|uk = 'Заповнення завершено з помилками. %1 У базі: компаній %2, облікових записів %3, користувачів %4.'"),
			РезультатЗагрузки.Ошибка,
			Результат.Компаний,
			Результат.УчетныхЗаписей,
			Результат.Пользователей);
		Возврат;
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.Сообщение = СтрШаблон(
		НСтр(
			"ru = 'Загружено: компаний %1, учетных записей %2, пользователей %3.';
			|uk = 'Завантажено: компаній %1, облікових записів %2, користувачів %3.'"),
		Результат.Компаний,
		Результат.УчетныхЗаписей,
		Результат.Пользователей);

КонецПроцедуры

// Считает загруженные элементы справочников, не помеченные на удаление.
//
&НаСервере
Процедура ЗаполнитьКоличествоЗагруженного(Результат)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(Компании.Ссылка) КАК Количество
		|ИЗ
		|	Справочник.EBC_Компании КАК Компании
		|ГДЕ
		|	НЕ Компании.ПометкаУдаления
		|;
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(УчетныеЗаписи.Ссылка) КАК Количество
		|ИЗ
		|	Справочник.EBC_УчетныеЗаписи КАК УчетныеЗаписи
		|ГДЕ
		|	НЕ УчетныеЗаписи.ПометкаУдаления
		|;
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(ПользователиEBC.Ссылка) КАК Количество
		|ИЗ
		|	Справочник.EBC_Пользователи КАК ПользователиEBC
		|ГДЕ
		|	НЕ ПользователиEBC.ПометкаУдаления";

	Пакет = Запрос.ВыполнитьПакет();
	Результат.Компаний = КоличествоИзРезультатаЗапроса(Пакет[0]);
	Результат.УчетныхЗаписей = КоличествоИзРезультатаЗапроса(Пакет[1]);
	Результат.Пользователей = КоличествоИзРезультатаЗапроса(Пакет[2]);

КонецПроцедуры

&НаСервере
Функция КоличествоИзРезультатаЗапроса(Знач РезультатЗапроса)

	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;

	Возврат 0;

КонецФункции

&НаСервере
Функция НовыйРезультатЗаполнения()

	Возврат Новый Структура(
		"Успех,Сообщение,Компаний,УчетныхЗаписей,Пользователей",
		Ложь,
		"",
		0,
		0,
		0);

КонецФункции

#КонецОбласти
