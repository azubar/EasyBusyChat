#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьРеквизитыОбъектаСвязиНаСервере()
	ЗаполнитьРеквизитыОбъектаСвязи(Запись);
КонецПроцедуры

// Перезаполняет обе надписи внизу формы: слева - канал общения, справа -
// служебные реквизиты связи.
//
// Параметры:
//  ДанныеЗаписи - РегистрСведенийЗапись.EBC_СвязиОбъектов - записываемый объект;
//                 Неопределено - взять данные из реквизита формы Запись.
//
&НаСервере
Процедура ОбновитьСводкиНаСервере(ДанныеЗаписи = Неопределено)

	Данные = ?(ДанныеЗаписи = Неопределено, Запись, ДанныеЗаписи);

	Элементы.СводкаУчетнойЗаписи.Заголовок = ТекстСводкиУчетнойЗаписи(Данные.Чат);
	Элементы.СводкаСлужебная.Заголовок = ТекстСводкиСлужебной(Данные);

КонецПроцедуры

// Собирает описание канала общения: учётная запись, провайдер и её телефон.
//
// Телефон учётной записи хранится в реквизите Идентификатор: у телефонных
// провайдеров там номер, у ботов и веб-чата он пустой - поэтому часть
// необязательная.
//
// Параметры:
//  Чат - СправочникСсылка.EBC_Чаты.
//
// Возвращаемое значение:
//  Строка - пустая, если чат не задан.
//
&НаСервереБезКонтекста
Функция ТекстСводкиУчетнойЗаписи(Знач Чат)

	Если Не ЗначениеЗаполнено(Чат) Тогда
		Возврат "";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| Чаты.Владелец КАК УчетнаяЗапись,
		| Чаты.Владелец.Провайдер КАК Провайдер,
		| Чаты.Владелец.Идентификатор КАК Телефон
		|ИЗ
		| Справочник.EBC_Чаты КАК Чаты
		|ГДЕ
		| Чаты.Ссылка = &Чат";
	Запрос.УстановитьПараметр("Чат", Чат);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат "";
	КонецЕсли;

	Части = Новый Массив;
	Если ЗначениеЗаполнено(Выборка.УчетнаяЗапись) Тогда
		Части.Добавить(СокрЛП(Строка(Выборка.УчетнаяЗапись)));
	КонецЕсли;
	Если ЗначениеЗаполнено(Выборка.Провайдер) Тогда
		Части.Добавить(СокрЛП(Строка(Выборка.Провайдер)));
	КонецЕсли;
	// ЗначениеЗаполнено, а не ПустаяСтрока: у чата без владельца реквизит
	// приходит из запроса как NULL.
	Если ЗначениеЗаполнено(Выборка.Телефон) Тогда
		Части.Добавить(СокрЛП(Строка(Выборка.Телефон)));
	КонецЕсли;

	Возврат СтрСоединить(Части, "  /  ");

КонецФункции

// Собирает служебные реквизиты связи: источник, дата установки, автор.
//
// У ещё не записанной связи даты нет - в этом случае она пропускается, а
// источник и автор уже заполнены значениями по умолчанию.
//
// Параметры:
//  ДанныеЗаписи - реквизит формы Запись либо записанный ТекущийОбъект.
//
// Возвращаемое значение:
//  Строка.
//
// Контекстная: принимает и ДанныеФормыСтруктура реквизита Запись, и
// РегистрСведенийЗапись - такие значения через внеконтекстный вызов не проходят.
&НаСервере
Функция ТекстСводкиСлужебной(Знач ДанныеЗаписи)

	Части = Новый Массив;

	Если ЗначениеЗаполнено(ДанныеЗаписи.ИсточникСвязи) Тогда
		Части.Добавить(СокрЛП(Строка(ДанныеЗаписи.ИсточникСвязи)));
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеЗаписи.ДатаУстановки) Тогда
		Части.Добавить(Формат(ДанныеЗаписи.ДатаУстановки, "ДФ='dd.MM.yy HH:mm'"));
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеЗаписи.АвторИБ) Тогда
		Части.Добавить(СокрЛП(Строка(ДанныеЗаписи.АвторИБ)));
	КонецЕсли;

	Возврат СтрСоединить(Части, "  /  ");

КонецФункции

// Разбирает ОбъектСсылка в измерения записи и заполняет справочное описание
// объекта - те же реквизиты, что заполняет EBC_Ядро.ПривязатьЧат.
//
// Параметры:
//  ДанныеЗаписи - реквизит формы Запись либо записываемый ТекущийОбъект.
//
&НаСервере
Процедура ЗаполнитьРеквизитыОбъектаСвязи(ДанныеЗаписи)

	Если Не ЗначениеЗаполнено(ОбъектСсылка) Тогда
		Возврат;
	КонецЕсли;

	ИдентификаторОбъекта = ОбъектСсылка.УникальныйИдентификатор();
	ДанныеЗаписи.ТипОбъекта = EBC_Ядро.ИмяТаблицыПоСсылке(ОбъектСсылка);
	ДанныеЗаписи.ИдентификаторОбъекта = ИдентификаторОбъекта;
	ДанныеЗаписи.Идентификатор = СокрЛП(Строка(ИдентификаторОбъекта));

	Описание = EBC_Ядро.ОписаниеОбъектаСвязи(ОбъектСсылка);
	Если Описание.Определено Тогда
		ДанныеЗаписи.ПредставлениеОбъекта = Описание.ПредставлениеОбъекта;
		ДанныеЗаписи.НавигационнаяСсылка = Описание.НавигационнаяСсылка;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
