#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Если это новая запись, заполняем дефолтные значения
	Если Не ЗначениеЗаполнено(Запись.Чат) Тогда
		Если Параметры.Свойство("ЧатСсылка") Тогда
			Запись.Чат = Параметры.ЧатСсылка;
		КонецЕсли;
	КонецЕсли;
	
	// Дата установки намеренно не заполняется до записи: у новой связи её ещё нет,
	// и в сводке она не показывается. Проставляется в ПередЗаписьюНаСервере.
	Если Не ЗначениеЗаполнено(Запись.АвторИБ) Тогда
		Запись.АвторИБ = Пользователи.ТекущийПользователь();
		Запись.ИсточникСвязи = Перечисления.EBC_ИсточникиСвязи.Ручная;
	КонецЕсли;

	// Восстанавливаем ОбъектСсылка при создании, если открываем существующую запись
	Если ЗначениеЗаполнено(Запись.ТипОбъекта) И ЗначениеЗаполнено(Запись.ИдентификаторОбъекта) Тогда
		ОбъектСсылка = EBC_Ядро.ПолучитьСсылкуПоИдентификатору(Запись.ТипОбъекта, Запись.ИдентификаторОбъекта);
	КонецЕсли;

	ОбновитьСводкиНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// Восстанавливаем ОбъектСсылка при чтении существующей записи
	Если ЗначениеЗаполнено(Запись.ТипОбъекта) И ЗначениеЗаполнено(Запись.ИдентификаторОбъекта) Тогда
		ОбъектСсылка = EBC_Ядро.ПолучитьСсылкуПоИдентификатору(Запись.ТипОбъекта, Запись.ИдентификаторОбъекта);
	КонецЕсли;

	ОбновитьСводкиНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Если Не ЗначениеЗаполнено(ОбъектСсылка) Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Не заполнен объект для связи!'; uk = 'Не заповнений об''єкт для зв''язку!'"),
			,
			"ОбъектСсылка",
			,
			Отказ
		);
		Возврат;
	КонецЕсли;

	// Записывается ТекущийОбъект: данные формы перенесены в него до вызова
	// обработчика, поэтому присвоения в реквизит Запись сюда бы не попали.
	ЗаполнитьРеквизитыОбъектаСвязи(ТекущийОбъект);

	// Момент установки связи - это момент её записи, а не открытия формы.
	Если Не ЗначениеЗаполнено(ТекущийОбъект.ДатаУстановки) Тогда
		ТекущийОбъект.ДатаУстановки = ТекущаяДатаСеанса();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// После записи у связи появилась дата установки - сводку нужно перечитать.
	// Данные берутся из ТекущийОбъект, а не из реквизита Запись: так обработчик
	// не зависит от того, успел ли платформенный перенос данных в форму.
	ОбновитьСводкиНаСервере(ТекущийОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ОбъектСсылкаПриИзменении(Элемент)

	// Измерения записи заполняются сразу при выборе объекта, чтобы данные формы
	// и записываемый объект совпадали ещё до записи.
	ЗаполнитьРеквизитыОбъектаСвязиНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ЧатПриИзменении(Элемент)

	// Учётная запись показывается по чату, поэтому смена чата меняет и сводку.
	ОбновитьСводкиНаСервере();

КонецПроцедуры

