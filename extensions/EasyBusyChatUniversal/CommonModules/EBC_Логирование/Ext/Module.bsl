// Модуль EBC_Логирование
//
// Технический журнал расширения: регистр сведений EBC_Лог.
//
// Регистр периодический с периодичностью "День": ведущее поле ключа - день
// события, поэтому записи ложатся в конец индекса, а ротация удаляет сутки
// целиком одной операцией (см. EBC_Ядро.ВыполнитьРотациюЛогов).
//
// Уровень события хранится ссылкой на перечисление EBC_УровниЖурнала, а не
// строкой: сравнение уровней не требует нормализации регистра, а отбор в форме
// списка ложится на индекс.

#Область ПрограммныйИнтерфейс

// Конструктор описания события технического журнала.
//
// Параметры:
//  Уровень - ПеречислениеСсылка.EBC_УровниЖурнала - важность события.
//  Событие - Строка - имя операции, например "ЗапросAPI" или "РотацияЛогов".
//
// Возвращаемое значение:
//  Структура - описание события; заполняется вызывающим кодом и передается
//              в Записать или Добавить.
//
Функция НовоеСобытие(Знач Уровень, Знач Событие = "") Экспорт

	Описание = Новый Структура;
	Описание.Вставить("Уровень", Уровень);
	Описание.Вставить("Категория", Перечисления.EBC_КатегорииЖурнала.ТехническоеСобытие);
	Описание.Вставить("Событие", Лев(Строка(Событие), 100));
	Описание.Вставить("Метод", "");
	Описание.Вставить("Путь", "");
	Описание.Вставить("СтатусКод", 0);
	Описание.Вставить("КодОшибки", "");
	Описание.Вставить("ТекстОшибки", "");
	Описание.Вставить("Детали", "");
	Описание.Вставить("ДлительностьМс", 0);
	Описание.Вставить("КоличествоПопыток", 0);
	Описание.Вставить("РазмерЗапроса", 0);
	Описание.Вставить("РазмерОтвета", 0);
	Описание.Вставить("КорреляционныйИдентификатор", "");
	Описание.Вставить("Компания", Справочники.EBC_Компании.ПустаяСсылка());
	Описание.Вставить("РезультатДействия", "");
	Описание.Вставить("Чат", Справочники.EBC_Чаты.ПустаяСсылка());
	Описание.Вставить("ИдентификаторЧатаEBC", "");
	Описание.Вставить("ПредставлениеЧата", "");
	Описание.Вставить("ТипОбъекта", "");
	Описание.Вставить("ИдентификаторОбъекта", Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	Описание.Вставить("ПредставлениеОбъекта", "");
	Описание.Вставить("НавигационнаяСсылкаОбъекта", "");

	Возврат Описание;

КонецФункции

Функция НовоеСобытиеДействияПользователя(Знач Событие) Экспорт

	Описание = НовоеСобытие(Перечисления.EBC_УровниЖурнала.Информация, Событие);
	Описание.Категория = Перечисления.EBC_КатегорииЖурнала.ДействиеПользователя;
	Описание.КорреляционныйИдентификатор = Строка(Новый УникальныйИдентификатор());
	Возврат Описание;

КонецФункции

Процедура ЗаполнитьДанныеЧата(Событие, Знач Чат) Экспорт

	Если Не ЗначениеЗаполнено(Чат) Тогда Возврат; КонецЕсли;
	Событие.Чат = Чат;
	Событие.ПредставлениеЧата = Лев(Строка(Чат), 150);
	Попытка
		Событие.ИдентификаторЧатаEBC = Лев(Строка(Чат.ИдентификаторEBC), 100);
	Исключение
	КонецПопытки;

КонецПроцедуры

Процедура ЗаполнитьДанныеОбъекта(Событие, Знач ОписаниеОбъекта) Экспорт

	Если ОписаниеОбъекта = Неопределено Тогда Возврат; КонецЕсли;
	Значение = Неопределено;
	Если ОписаниеОбъекта.Свойство("ТипОбъекта", Значение) Тогда Событие.ТипОбъекта = Лев(Строка(Значение), 150); КонецЕсли;
	Если ОписаниеОбъекта.Свойство("ИдентификаторОбъекта", Значение) Тогда Событие.ИдентификаторОбъекта = Значение; КонецЕсли;
	Если ОписаниеОбъекта.Свойство("ПредставлениеОбъекта", Значение) Тогда Событие.ПредставлениеОбъекта = Лев(Строка(Значение), 250); КонецЕсли;
	Если ОписаниеОбъекта.Свойство("НавигационнаяСсылка", Значение) Тогда Событие.НавигационнаяСсылкаОбъекта = Лев(Строка(Значение), 500); КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьРезультатДействия(Событие, Знач РезультатОперации) Экспорт

	Значение = Неопределено;
	Если РезультатОперации.Успех Тогда
		Событие.РезультатДействия = "Успех";
		Если РезультатОперации.Свойство("ПринятоВОчередь", Значение) И Значение = Истина Тогда
			Событие.РезультатДействия = "ВОчереди";
		ИначеЕсли РезультатОперации.Свойство("СтатусОтправки", Значение) И Значение = "Accepted" Тогда
			Событие.РезультатДействия = "Принято";
		КонецЕсли;
		Событие.Уровень = Перечисления.EBC_УровниЖурнала.Информация;
	Иначе
		Событие.РезультатДействия = "Ошибка";
		Если РезультатОперации.Свойство("СтатусОтправки", Значение) И Значение = "Unknown" Тогда
			Событие.РезультатДействия = "НеПодтверждено";
		КонецЕсли;
		Событие.Уровень = Перечисления.EBC_УровниЖурнала.Ошибка;
		Если РезультатОперации.Свойство("Ошибка", Значение) Тогда Событие.ТекстОшибки = Лев(Строка(Значение), 1024); КонецЕсли;
		Если РезультатОперации.Свойство("КодОшибки", Значение) Тогда Событие.КодОшибки = Лев(Строка(Значение), 100); КонецЕсли;
	КонецЕсли;
	Если РезультатОперации.Свойство("СтатусКод", Значение) Тогда Событие.СтатусКод = Значение; КонецЕсли;
	Если РезультатОперации.Свойство("КорреляционныйИдентификатор", Значение) Тогда Событие.КорреляционныйИдентификатор = Лев(Строка(Значение), 64); КонецЕсли;

КонецПроцедуры

// Записывает одно событие технического журнала.
//
// События ниже настроенного уровня отбрасываются без обращения к базе.
//
// Сбой журналирования не должен прерывать операцию, ради которой оно ведётся:
// поэтому тело вынесено под обработчик исключения, как и в Добавить
// и ЗаписатьБуфер.
//
Процедура Записать(Знач Событие) Экспорт

	Попытка
		ЗаписатьСобытие(Событие);
	Исключение
		СообщитьОСбоеЗаписи(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

// Буфер для массовых операций: за один серверный вызов может логироваться
// несколько десятков событий, и писать каждое отдельным набором записей дорого.
//
// Общие модули не могут хранить состояние между вызовами, поэтому буфер
// передается явно:
//
//  Буфер = EBC_Логирование.НовыйБуфер();
//  ...
//  EBC_Логирование.Добавить(Буфер, Событие);
//  ...
//  EBC_Логирование.ЗаписатьБуфер(Буфер);
//
Функция НовыйБуфер() Экспорт
	Возврат Новый Массив;
КонецФункции

Процедура Добавить(Буфер, Знач Событие) Экспорт

	Попытка
		Если Не СобытиеРазрешено(Событие.Категория, Событие.Уровень) Тогда
			Возврат;
		КонецЕсли;

		Буфер.Добавить(Новый Структура(
			"Событие, Момент",
			Событие,
			EBC_Ядро.ТекущаяДатаДанных()));
	Исключение
		СообщитьОСбоеЗаписи(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

Процедура ЗаписатьБуфер(Буфер) Экспорт

	Если Буфер.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Записи одного дня пишутся одним набором: отбор набора записей
	// периодического регистра поддерживает только равенство периода.
	ПоДням = Новый Соответствие;
	Для Каждого ЭлементБуфера Из Буфер Цикл
		День = НачалоДня(ЭлементБуфера.Момент);
		СобытияДня = ПоДням.Получить(День);
		Если СобытияДня = Неопределено Тогда
			СобытияДня = Новый Массив;
			ПоДням.Вставить(День, СобытияДня);
		КонецЕсли;
		СобытияДня.Добавить(ЭлементБуфера);
	КонецЦикла;

	Для Каждого ЭлементДня Из ПоДням Цикл
		Попытка
			ЗаписатьСобытияДня(ЭлементДня.Ключ, ЭлементДня.Значение);
		Исключение
			СообщитьОСбоеЗаписи(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЦикла;

	Для Каждого ЭлементБуфера Из Буфер Цикл
		Попытка
			ПродублироватьОшибкуВЖурналеРегистрации(ЭлементБуфера.Событие);
		Исключение
			СообщитьОСбоеЗаписи(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЦикла;

	Буфер.Очистить();

КонецПроцедуры

// Проверяет, попадает ли уровень события в настроенный порог логирования.
Функция УровеньРазрешен(Знач Уровень) Экспорт

	Порог = EBC_НастройкиПовтИсп.ОбщиеНастройки().УровеньЛогирования;
	Если Не ЗначениеЗаполнено(Порог) Тогда
		Порог = УровеньПоУмолчанию();
	КонецЕсли;

	Возврат ПриоритетУровня(Уровень) >= ПриоритетУровня(Порог);

КонецФункции

Функция СобытиеРазрешено(Знач Категория, Знач Уровень) Экспорт

	ОбщиеНастройки = EBC_НастройкиПовтИсп.ОбщиеНастройки();
	Если Категория = Перечисления.EBC_КатегорииЖурнала.ДействиеПользователя Тогда
		Возврат ОбщиеНастройки.ЛогироватьДействияПользователей;
	КонецЕсли;
	Возврат ОбщиеНастройки.ЛогироватьТехническиеСобытия И УровеньРазрешен(Уровень);

КонецФункции

// Порядковый вес уровня: чем выше, тем важнее событие.
Функция ПриоритетУровня(Знач Уровень) Экспорт

	Уровни = Перечисления.EBC_УровниЖурнала;

	Если Уровень = Уровни.Трассировка Тогда
		Возврат 0;
	ИначеЕсли Уровень = Уровни.Отладка Тогда
		Возврат 1;
	ИначеЕсли Уровень = Уровни.Предупреждение Тогда
		Возврат 3;
	ИначеЕсли Уровень = Уровни.Ошибка Тогда
		Возврат 4;
	КонецЕсли;

	// Информация и незаполненное значение.
	Возврат 2;

КонецФункции

Функция УровеньПоУмолчанию() Экспорт
	Возврат Перечисления.EBC_УровниЖурнала.Информация;
КонецФункции

// Отбрасывает строку параметров запроса: в ней могут быть токены и телефоны.
Функция БезопасныйПуть(Знач Путь) Экспорт

	Результат = Строка(Путь);
	ПозицияПараметров = СтрНайти(Результат, "?");
	Если ПозицияПараметров > 0 Тогда
		Результат = Лев(Результат, ПозицияПараметров - 1);
	КонецЕсли;

	Возврат Лев(Результат, 500);

КонецФункции

// Разбирает "GET /chats/v1/..." на метод и путь.
Функция РазобратьМетодИПуть(Знач МетодИПуть) Экспорт

	Результат = Новый Структура("Метод, Путь", "", "");

	ЗначениеСтроки = СокрЛП(Строка(МетодИПуть));
	ПозицияРазделителя = СтрНайти(ЗначениеСтроки, " ");
	Если ПозицияРазделителя > 0 Тогда
		Результат.Метод = Лев(ЗначениеСтроки, ПозицияРазделителя - 1);
		Результат.Путь = БезопасныйПуть(
			Сред(ЗначениеСтроки, ПозицияРазделителя + 1));
	Иначе
		Результат.Путь = БезопасныйПуть(ЗначениеСтроки);
	КонецЕсли;

	Результат.Метод = Лев(Результат.Метод, 10);

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьСобытие(Знач Событие)

	Если Не СобытиеРазрешено(Событие.Категория, Событие.Уровень) Тогда
		Возврат;
	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений.EBC_Лог.СоздатьМенеджерЗаписи();
	ЗаполнитьЗаписьЛога(
		МенеджерЗаписи,
		Событие,
		EBC_Ядро.ТекущаяДатаДанных());
	МенеджерЗаписи.Записать();

	ПродублироватьОшибкуВЖурналеРегистрации(Событие);

КонецПроцедуры

Процедура ЗаполнитьЗаписьЛога(Запись, Знач Событие, Знач Момент)

	Запись.Период = НачалоДня(Момент);
	Запись.ИдентификаторЗаписи = Новый УникальныйИдентификатор();
	Запись.ДатаНачала = Момент;
	Запись.ПользовательИБ = ТекущийПользовательИБ();

	Запись.Уровень = Событие.Уровень;
	Запись.Категория = Событие.Категория;
	Запись.РезультатДействия = Лев(Строка(Событие.РезультатДействия), 20);
	Запись.Чат = Событие.Чат;
	Запись.ИдентификаторЧатаEBC = Лев(Строка(Событие.ИдентификаторЧатаEBC), 100);
	Запись.ПредставлениеЧата = Лев(Строка(Событие.ПредставлениеЧата), 150);
	Запись.ТипОбъекта = Лев(Строка(Событие.ТипОбъекта), 150);
	Запись.ИдентификаторОбъекта = Событие.ИдентификаторОбъекта;
	Запись.ПредставлениеОбъекта = Лев(Строка(Событие.ПредставлениеОбъекта), 250);
	Запись.НавигационнаяСсылкаОбъекта = Лев(Строка(Событие.НавигационнаяСсылкаОбъекта), 500);
	Запись.Событие = Лев(Строка(Событие.Событие), 100);
	Запись.Метод = Лев(Строка(Событие.Метод), 10);
	Запись.Путь = БезопасныйПуть(Событие.Путь);
	Запись.СтатусКод = Событие.СтатусКод;
	Запись.КодОшибки = Лев(Строка(Событие.КодОшибки), 100);
	Запись.ТекстОшибки = Лев(Строка(Событие.ТекстОшибки), 1024);
	Запись.Детали = Строка(Событие.Детали);
	Запись.ДлительностьМс = Событие.ДлительностьМс;
	Запись.КоличествоПопыток = Событие.КоличествоПопыток;
	Запись.РазмерЗапроса = Событие.РазмерЗапроса;
	Запись.РазмерОтвета = Событие.РазмерОтвета;
	Запись.КорреляционныйИдентификатор = Лев(
		Строка(Событие.КорреляционныйИдентификатор),
		64);
	Запись.Компания = Событие.Компания;

КонецПроцедуры

Процедура ЗаписатьСобытияДня(Знач День, Знач СобытияДня)

	НаборЗаписей = РегистрыСведений.EBC_Лог.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Период.Установить(День);

	Для Каждого ЭлементБуфера Из СобытияДня Цикл
		ЗаполнитьЗаписьЛога(
			НаборЗаписей.Добавить(),
			ЭлементБуфера.Событие,
			ЭлементБуфера.Момент);
	КонецЦикла;

	// Записи только добавляются: имеющиеся за этот день затирать нельзя.
	НаборЗаписей.Записать(Ложь);

КонецПроцедуры

Функция ТекущийПользовательИБ()

	Попытка
		Возврат ПараметрыСеанса.ТекущийПользователь;
	Исключение
		Возврат Справочники.Пользователи.ПустаяСсылка();
	КонецПопытки;

КонецФункции

// Ошибки дублируются в журнал регистрации: он пишется вне транзакции и
// переживает откат, а запись регистра - нет.
Процедура ПродублироватьОшибкуВЖурналеРегистрации(Знач Событие)

	Если Событие.Уровень <> Перечисления.EBC_УровниЖурнала.Ошибка Тогда
		Возврат;
	КонецЕсли;

	ТекстСобытия = СокрЛП(Строка(Событие.ТекстОшибки));
	Если ПустаяСтрока(ТекстСобытия) Тогда
		ТекстСобытия = СтрШаблон(
			"%1 %2, статус %3",
			Событие.Метод,
			Событие.Путь,
			Событие.СтатусКод);
	КонецЕсли;

	ЗаписьЖурналаРегистрации(
		"EBC." + ?(ПустаяСтрока(Событие.Событие), "Ошибка", Событие.Событие),
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		ТекстСобытия);

КонецПроцедуры

Процедура СообщитьОСбоеЗаписи(Знач ИнформацияОбОшибке)

	ЗаписьЖурналаРегистрации(
		"EBC.Логирование",
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		СтрШаблон(
			"Не удалось записать технический журнал EBC: %1",
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке)));

КонецПроцедуры

#КонецОбласти
