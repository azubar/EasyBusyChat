#Область ПрограммныйИнтерфейс

Процедура ВыполнитьРотациюЛогов() Экспорт

	Попытка
		EBC_Ядро.ВыполнитьРотациюЛогов();
	Исключение
		ЗаписьЖурналаРегистрации(
			"EBC_РегламентныеЗадания.РотацияЛогов",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Обновляет справочники EBC_Компании, EBC_УчетныеЗаписи и EBC_Пользователи.
//
// Все три справочника закрывает один вызов: EBC_Ядро.ЗагрузитьПользователей
// сначала синхронизирует структуру компаний с учетными записями, а затем
// загружает операторов каждой компании.
//
Процедура ВыполнитьСинхронизациюСправочников() Экспорт

	Результат = СинхронизироватьСправочники();
	Если Не Результат.Успех Тогда
		// Исключение нужно, чтобы платформа отметила задание как завершенное
		// с ошибкой, иначе неудачный запуск виден только в нашем логе.
		ВызватьИсключение Результат.Ошибка;
	КонецЕсли;

КонецПроцедуры

// Загружает новые чаты и последние сообщения в существующих чатах.
Процедура ВыполнитьСинхронизациюЧатов() Экспорт

	Результат = СинхронизироватьЧаты();
	Если Не Результат.Успех Тогда
		ВызватьИсключение Результат.Ошибка;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Синхронизация справочников с результатом для вызывающего кода.
//
// Отдельно от ВыполнитьСинхронизациюСправочников: заданию нужно исключение,
// а команде "выполнить сейчас" - текст для пользователя.
//
// Возвращаемое значение:
//  Структура:
//   * Успех      - Булево - работа завершена без ошибок.
//   * Ошибка     - Строка - причина неудачи или пустая строка.
//   * Количество - Число  - сколько пользователей загружено.
//
Функция СинхронизироватьСправочники() Экспорт

	Попытка
		РезультатЗагрузки = EBC_Ядро.ЗагрузитьПользователей();
	Исключение
		Возврат ЗавершитьСОшибкой(
			"СинхронизацияСправочников",
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат ЗавершитьЗагрузку(
		"СинхронизацияСправочников",
		РезультатЗагрузки,
		НСтр(
			"ru = 'Загружено пользователей: %1';
			|uk = 'Завантажено користувачів: %1'"));

КонецФункции

// Быстрая синхронизация чатов с результатом для вызывающего кода.
//
// Возвращаемое значение:
//  Структура:
//   * Успех      - Булево - работа завершена без ошибок.
//   * Ошибка     - Строка - причина неудачи или пустая строка.
//   * Количество - Число  - сколько чатов обновлено.
//
Функция СинхронизироватьЧаты() Экспорт

	Попытка
		РезультатЗагрузки = EBC_Ядро.ЗагрузитьИзмененияЧатов();
	Исключение
		Возврат ЗавершитьСОшибкой(
			"СинхронизацияЧатов",
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат ЗавершитьЗагрузку(
		"СинхронизацияЧатов",
		РезультатЗагрузки,
		НСтр(
			"ru = 'Обновлено чатов: %1';
			|uk = 'Оновлено чатів: %1'"));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Превращает результат массовой загрузки в результат синхронизации.
//
// Исходов три:
//  - все источники ответили - успех;
//  - часть источников ответила ошибкой, но что-то загрузить удалось - работа
//    считается выполненной, в журнал пишется предупреждение. Иначе одна
//    постоянно недоступная учётная запись держала бы задание сбойным всегда,
//    и настоящие отказы терялись бы в этом шуме;
//  - работать не удалось вовсе (нет настроек, нет источников, все источники
//    с ошибкой) - отказ, задание завершается с ошибкой.
//
Функция ЗавершитьЗагрузку(Знач Событие, Знач РезультатЗагрузки, Знач ШаблонИтога)

	Количество = РезультатЗагрузки.Количество;
	Итог = СтрШаблон(ШаблонИтога, Количество);

	Если РезультатЗагрузки.Успех Тогда
		ЗаписатьУспех(Событие, Итог);
		Возврат Новый Структура(
			"Успех, Ошибка, Количество",
			Истина,
			"",
			Количество);
	КонецЕсли;

	Источников = 0;
	РезультатЗагрузки.Свойство("КоличествоИсточников", Источников);
	Ошибок = 0;
	РезультатЗагрузки.Свойство("КоличествоОшибок", Ошибок);

	Если Источников > 0 И Ошибок < Источников Тогда
		ЗаписатьЧастичныйУспех(
			Событие,
			СтрШаблон(
				НСтр(
					"ru = '%1. Источников с ошибками: %2 из %3. %4';
					|uk = '%1. Джерел з помилками: %2 з %3. %4'"),
				Итог,
				Ошибок,
				Источников,
				РезультатЗагрузки.Ошибка));

		Возврат Новый Структура(
			"Успех, Ошибка, Количество",
			Истина,
			"",
			Количество);
	КонецЕсли;

	Возврат ЗавершитьСОшибкой(
		Событие,
		РезультатЗагрузки.Ошибка,
		РезультатЗагрузки.Ошибка);

КонецФункции

Функция ЗавершитьСОшибкой(Знач Событие, Знач ТекстОшибки, Знач Подробности)

	ЗаписьЖурналаРегистрации(
		"EBC_РегламентныеЗадания." + Событие,
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		Подробности);

	Попытка
		СобытиеЛога = EBC_Логирование.НовоеСобытие(
			Перечисления.EBC_УровниЖурнала.Ошибка,
			Событие);
		СобытиеЛога.ТекстОшибки = Подробности;
		EBC_Логирование.Записать(СобытиеЛога);
	Исключение
		// Лог расширения не должен мешать заданию завершиться штатно.
	КонецПопытки;

	Возврат Новый Структура(
		"Успех, Ошибка, Количество",
		Ложь,
		ТекстОшибки,
		0);

КонецФункции

Процедура ЗаписатьЧастичныйУспех(Знач Событие, Знач Комментарий)

	// Дублируется в журнал регистрации: администратор смотрит сбои заданий
	// именно там, а задание в этом случае завершается штатно.
	ЗаписьЖурналаРегистрации(
		"EBC_РегламентныеЗадания." + Событие,
		УровеньЖурналаРегистрации.Предупреждение,
		,
		,
		Комментарий);

	Попытка
		СобытиеЛога = EBC_Логирование.НовоеСобытие(
			Перечисления.EBC_УровниЖурнала.Предупреждение,
			Событие);
		СобытиеЛога.Детали = Комментарий;
		EBC_Логирование.Записать(СобытиеЛога);
	Исключение
		// Сбой логирования не повод завершать задание с ошибкой.
	КонецПопытки;

КонецПроцедуры

Процедура ЗаписатьУспех(Знач Событие, Знач Комментарий)

	Попытка
		СобытиеЛога = EBC_Логирование.НовоеСобытие(
			Перечисления.EBC_УровниЖурнала.Информация,
			Событие);
		СобытиеЛога.Детали = Комментарий;
		EBC_Логирование.Записать(СобытиеЛога);
	Исключение
		// То же: сбой логирования не повод завершать задание с ошибкой.
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
