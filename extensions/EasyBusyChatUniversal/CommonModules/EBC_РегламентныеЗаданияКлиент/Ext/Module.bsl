// Модуль EBC_РегламентныеЗаданияКлиент
//
// Клиентская часть команд подсистемы "Администрирование": показ диалога
// расписания и запуск синхронизации вручную.

#Область ПрограммныйИнтерфейс

// Открывает стандартный диалог расписания регламентного задания.
//
// Параметры:
//  ИмяЗадания - Строка - имя регламентного задания расширения.
//
Процедура НастроитьРасписание(Знач ИмяЗадания) Экспорт

	ДанныеРасписания = EBC_РегламентныеЗаданияВызовСервера.ДанныеРасписания(
		ИмяЗадания);
	Если Не ДанныеРасписания.Успех Тогда
		ПоказатьПредупреждение(, ДанныеРасписания.Ошибка);
		Возврат;
	КонецЕсли;

	Диалог = Новый ДиалогРасписанияРегламентногоЗадания(
		ОбщегоНазначенияКлиентСервер.СтруктураВРасписание(
			ДанныеРасписания.Расписание));

	Диалог.Показать(
		Новый ОписаниеОповещения(
			"ПослеИзмененияРасписания",
			EBC_РегламентныеЗаданияКлиент,
			ИмяЗадания));

КонецПроцедуры

// Обработчик закрытия диалога расписания.
//
// Параметры:
//  Расписание - РасписаниеРегламентногоЗадания - новое расписание;
//               Неопределено, если диалог закрыт без сохранения.
//  ИмяЗадания - Строка - имя регламентного задания расширения.
//
Процедура ПослеИзмененияРасписания(Расписание, ИмяЗадания) Экспорт

	Если Расписание = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Результат = EBC_РегламентныеЗаданияВызовСервера.УстановитьРасписание(
		ИмяЗадания,
		ОбщегоНазначенияКлиентСервер.РасписаниеВСтруктуру(Расписание));

	Если Не Результат.Успех Тогда
		ПоказатьПредупреждение(, Результат.Ошибка);
		Возврат;
	КонецЕсли;

	Если Результат.Использование Тогда
		Пояснение = НСтр(
			"ru = 'Новое расписание сохранено.';
			|uk = 'Новий розклад збережено.'");
	Иначе
		// Выключенное задание не запустится ни по какому расписанию,
		// и молчать об этом нельзя: настройка выглядела бы выполненной.
		Пояснение = НСтр(
			"ru = 'Расписание сохранено, но задание выключено и запускаться не будет.';
			|uk = 'Розклад збережено, але завдання вимкнено і запускатися не буде.'");
	КонецЕсли;

	ПоказатьОповещениеПользователя(
		ЗаголовокОповещения(),
		,
		Пояснение);

КонецПроцедуры

// Выполняет синхронизацию немедленно.
//
// Параметры:
//  ИмяЗадания - Строка - имя регламентного задания расширения.
//
Процедура ВыполнитьСинхронизацию(Знач ИмяЗадания) Экспорт

	Результат = EBC_РегламентныеЗаданияВызовСервера.ВыполнитьСинхронизацию(
		ИмяЗадания);

	Если Не Результат.Успех Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.Ошибка);
		Возврат;
	КонецЕсли;

	ПоказатьОповещениеПользователя(
		ЗаголовокОповещения(),
		,
		СтрШаблон(
			НСтр(
				"ru = 'Синхронизация завершена. Обработано объектов: %1';
				|uk = 'Синхронізацію завершено. Оброблено об''єктів: %1'"),
			Результат.Количество));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗаголовокОповещения()

	Возврат НСтр(
		"ru = 'Синхронизация Easy Busy Chat';
		|uk = 'Синхронізація Easy Busy Chat'");

КонецФункции

#КонецОбласти
