// Модуль EBC_ПодключаемыеКомандыКлиент
//
// Обработчики команд подменю "Easy-Busy Chat" - см. EBC_ПодключаемыеКоманды.
//
// БСП вызывает эти процедуры через ОписаниеОповещения, поэтому сигнатура у всех
// одинаковая и менять её нельзя:
//   ПараметрКоманды    - ссылка на объект формы (МножественныйВыбор = Ложь);
//   ПараметрыВыполнения - см. ПодключаемыеКомандыКлиент.ПараметрыВыполненияКоманды,
//                         из неё берётся форма-владелец.
//
// Данные с сервера читаются одним вызовом EBC_ЧатВызовСервера.ДанныеОбъектаДляКоманд:
// Перед открытием плагина активность учётки отдельно перечитывается на сервере.

#Область ПрограммныйИнтерфейс

// Открывает чат объекта в окне веб-плагина.
Процедура ОткрытьЧат(ПараметрКоманды, ПараметрыВыполнения) Экспорт

	// Проверяется до серверного вызова: в веб-клиенте открывать нечего.
	Если Не EBC_ВебПлагин.ПроверитьПоддержкуКлиента() Тогда
		Возврат;
	КонецЕсли;

	Данные = ДанныеОбъекта(ПараметрКоманды);
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не Данные.ЕстьЧат Тогда
		ПоказатьПредупреждение(
			,
			НСтр(
				"ru = 'К объекту не привязан ни один чат Easy-Busy Chat.';
				|uk = 'До об''єкта не прив''язано жодного чату Easy-Busy Chat.'"));
		Возврат;
	КонецЕсли;

	Попытка
		// Если окно чата уже открыто, компонента не переинициализируется.
		РезультатОткрытия = EBC_ВебПлагин.ПодготовитьКомпоненту(
			глКомпонентаEBC,
			Данные.КомпанияEBC,
			Данные.ИдентификаторАккаунта,
			Данные.Провайдер);

		Если РезультатОткрытия.Успех Тогда
			РезультатОткрытия = EBC_ВебПлагин.ОткрытьЧат(
				глКомпонентаEBC,
				Данные.ИдентификаторАккаунта,
				Данные.Провайдер,
				Данные.ЧатID,
				Данные.КомпанияEBC);
		КонецЕсли;

		Если Не РезультатОткрытия.Успех Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатОткрытия.Ошибка);
		КонецЕсли;
	Исключение
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр(
				"ru = 'Не удалось открыть чат объекта.';
				|uk = 'Не вдалося відкрити чат об''єкта.'"));
	КонецПопытки;

КонецПроцедуры

// Открывает форму привязки и просмотра чатов объекта.
//
// Если связи уже есть, форма открывается сразу на них: смотреть список всех
// чатов, когда привязанные есть, обычно не нужно.
//
Процедура ПривязанныеЧаты(ПараметрКоманды, ПараметрыВыполнения) Экспорт

	Данные = ДанныеОбъекта(ПараметрКоманды);
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Объект", ПараметрКоманды);
	ПараметрыФормы.Вставить(
		"РежимОткрытия",
		?(Данные.КоличествоСвязей > 0, "Привязанные", "Чаты"));

	// Режим окна не задаётся: форма открывается независимой. Блокировать форму
	// объекта незачем - привязка чата ничего в объекте не меняет, а работать с
	// накладной и списком чатов рядом удобнее.
	ОткрытьФорму(
		"Обработка.EBC_КонтактЦентр.Форма.ФормаПривязанныеЧаты",
		ПараметрыФормы,
		ПараметрыВыполнения.Форма);

КонецПроцедуры

// Открывает форму отправки сообщения в чат объекта.
Процедура ОтправитьСообщение(ПараметрКоманды, ПараметрыВыполнения) Экспорт

	Данные = ДанныеОбъекта(ПараметрКоманды);
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Незаполненный чат - не повод не открывать форму: в ней есть выбор чата
	// из всех, и отправить сообщение можно, ничего не привязывая заранее.
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Объект", ПараметрКоманды);
	Если Данные.ЕстьЧат Тогда
		ПараметрыФормы.Вставить("Чат", Данные.Чат);
	КонецЕсли;

	// Режим окна задан свойством самой формы - БлокироватьОкноВладельца.
	ОткрытьФорму(
		"Обработка.EBC_КонтактЦентр.Форма.ФормаОтправкиСообщения",
		ПараметрыФормы,
		ПараметрыВыполнения.Форма);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Читает данные объекта одним серверным вызовом.
//
// Возвращаемое значение:
//  Структура    - см. EBC_ЧатВызовСервера.ДанныеОбъектаДляКоманд;
//  Неопределено - работать не с чем, пользователю уже показано объяснение.
//
Функция ДанныеОбъекта(Знач Объект)

	Если Не ЗначениеЗаполнено(Объект) Тогда
		ПоказатьПредупреждение(
			,
			НСтр(
				"ru = 'Сначала запишите объект.';
				|uk = 'Спочатку запишіть об''єкт.'"));
		Возврат Неопределено;
	КонецЕсли;

	Данные = EBC_ЧатВызовСервера.ДанныеОбъектаДляКоманд(Объект);

	// Право на регистр связей могли отобрать после того, как форма построила
	// команды: список команд кэшируется, а права проверяются каждый раз.
	Если Не Данные.Доступен Тогда
		ПоказатьПредупреждение(
			,
			НСтр(
				"ru = 'Нет прав на данные Easy-Busy Chat.';
				|uk = 'Немає прав на дані Easy-Busy Chat.'"));
		Возврат Неопределено;
	КонецЕсли;

	Возврат Данные;

КонецФункции

#КонецОбласти
