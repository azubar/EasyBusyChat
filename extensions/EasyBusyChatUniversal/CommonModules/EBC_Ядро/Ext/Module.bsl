			Строка(ИдентификаторСеанса),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке)));

КонецПроцедуры

// Срок хранения технического лога берётся из общих настроек - записи регистра
// с незаполненным ПользовательИБ. Персональные настройки на ротацию не влияют:
// регламентное задание работает вне контекста пользователя.
//
Функция ГлобальнаяГлубинаХраненияЛогов()

	ГлубинаХранения = EBC_НастройкиПовтИсп.ОбщиеНастройки().ХранитьЛогДней;
	Если ГлубинаХранения > 0 Тогда
		Возврат ГлубинаХранения;
	КонецЕсли;

	Возврат EBC_НастройкиСервер.ГлубинаХраненияЛоговПоУмолчанию();

КонецФункции

// Верхний предел числа записей журнала. Одного срока хранения мало: при
// всплеске трафика 90 дней могут дать миллионы строк.
Функция МаксимальноеКоличествоЗаписейЛога()
	Возврат 500000;
КонецФункции

// Окно быстрой синхронизации чатов. Сутки перекрывают любой разумный интервал
// запуска задания с запасом на простой сервера.
Функция ГлубинаБыстройСинхронизацииЧатовДней()
	Возврат 1;
КонецФункции

// Сколько чатов писать в одной транзакции.
Функция РазмерПорцииЗаписиЧатов()
	Возврат 50;
КонецФункции

// Сколько страниц по 100 чатов читать у одной учётной записи за быстрый проход.
// Две страницы - это 200 самых свежих чатов: столько за сутки не меняется даже
// в нагруженной компании, а API-запросов остаётся мало.
Функция МаксимумСтраницБыстройСинхронизацииЧатов()
	Возврат 2;
КонецФункции

// Удаляет все сутки журнала, начинающиеся раньше границы.
// Возвращает количество удалённых записей.
Функция УдалитьУстаревшиеДниЛога(Знач ГраницаОчистки)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| Лог.Период КАК Период,
		| КОЛИЧЕСТВО(*) КАК Записей
		|ИЗ
		| РегистрСведений.EBC_Лог КАК Лог
		|ГДЕ
		| Лог.Период < &ГраницаОчистки
		|СГРУППИРОВАТЬ ПО
		| Лог.Период
		|УПОРЯДОЧИТЬ ПО
		| Период";
	Запрос.УстановитьПараметр("ГраницаОчистки", ГраницаОчистки);

	Возврат УдалитьДниЛога(Запрос.Выполнить().Выгрузить());

КонецФункции

// Удаляет самые старые сутки, пока в журнале больше записей, чем разрешено.
// Возвращает количество удалённых записей.
Функция ОбрезатьЛогПоКоличеству(Знач МаксимальноЗаписей)

	Если МаксимальноЗаписей <= 0 Тогда
		Возврат 0;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| Лог.Период КАК Период,
		| КОЛИЧЕСТВО(*) КАК Записей
		|ИЗ
		| РегистрСведений.EBC_Лог КАК Лог
		|СГРУППИРОВАТЬ ПО
		| Лог.Период
		|УПОРЯДОЧИТЬ ПО
		| Период";
	ДниЛога = Запрос.Выполнить().Выгрузить();

	ВсегоЗаписей = ДниЛога.Итог("Записей");
	Если ВсегоЗаписей <= МаксимальноЗаписей Тогда
		Возврат 0;
	КонецЕсли;

	// Последние сутки не удаляются даже при переполнении: иначе журнал
	// потеряет как раз те события, ради которых в него смотрят.
	ДниКУдалению = ДниЛога.СкопироватьКолонки();
	Излишек = ВсегоЗаписей - МаксимальноЗаписей;
	Для Индекс = 0 По ДниЛога.Количество() - 2 Цикл
		Если Излишек <= 0 Тогда
			Прервать;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ДниКУдалению.Добавить(), ДниЛога[Индекс]);
		Излишек = Излишек - ДниЛога[Индекс].Записей;
	КонецЦикла;

	Возврат УдалитьДниЛога(ДниКУдалению);

КонецФункции

Функция УдалитьДниЛога(Знач ДниЛога)

	КоличествоУдаленных = 0;

	Для Каждого ДеньЛога Из ДниЛога Цикл
		НаборЗаписей = РегистрыСведений.EBC_Лог.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Период.Установить(ДеньЛога.Период);
		// Пустой набор с установленным отбором удаляет все записи периода.
		НаборЗаписей.Записать();
		КоличествоУдаленных = КоличествоУдаленных + ДеньЛога.Записей;
	КонецЦикла;

	Возврат КоличествоУдаленных;

КонецФункции

#КонецОбласти
