#Область ПрограммныйИнтерфейс

// Устанавливает связь чата с объектом учётной системы.
//
// Параметры:
//  Чат               - СправочникСсылка.EBC_Чаты
//  Объект            - ссылка на объект учётной системы.
//  ЭтоОсновнаяСвязь  - Булево - сделать эту связь основной. Первая связь
//                      объекта становится основной независимо от параметра:
//                      объект с единственным чатом без основной связи вёл бы
//                      себя как объект без чата.
//
Процедура ПривязатьЧат(
		Знач Чат,
		Знач Объект,
		Знач ЭтоОсновнаяСвязь = Ложь) Экспорт

	ИмяТаблицы = ИмяТаблицыПоСсылке(Объект);
	Идентификатор = Объект.УникальныйИдентификатор();

	// Вся операция под одной транзакцией и одной блокировкой: решение "делать
	// ли связь основной" зависит от того, какие связи у объекта уже есть, и
	// принимать его вне блокировки нельзя.
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить(
			"РегистрСведений.EBC_СвязиОбъектов");
		ЭлементБлокировки.УстановитьЗначение("ТипОбъекта", ИмяТаблицы);
		ЭлементБлокировки.УстановитьЗначение(
			"ИдентификаторОбъекта",
			Идентификатор);
		Блокировка.Заблокировать();

		НаборСвязей = РегистрыСведений.EBC_СвязиОбъектов.СоздатьНаборЗаписей();
		НаборСвязей.Отбор.ТипОбъекта.Установить(ИмяТаблицы);
		НаборСвязей.Отбор.ИдентификаторОбъекта.Установить(Идентификатор);
		НаборСвязей.Прочитать();

		// Первая связь объекта - всегда основная. Раньше здесь проверялось
		// наличие записи по этому же чату, а не наличие связей у объекта:
		// вторая связь тоже считалась первой, признак основной ей проставлялся,
		// а с прежней основной не снимался. У объекта оказывалось две основные
		// связи, и динамический список контрагентов падал на дублировании
		// ключа "Ссылка".
		ЭтоОсновнаяСвязь = ЭтоОсновнаяСвязь
			Или НетДругихСвязей(НаборСвязей, Чат);

		Если ЭтоОсновнаяСвязь Тогда
			СнятьПризнакОсновнойСвязи(НаборСвязей, Чат, Объект);
		КонецЕсли;

		Запись = Неопределено;
		Для Каждого СуществующаяЗапись Из НаборСвязей Цикл
			Если СуществующаяЗапись.Чат = Чат Тогда
				Запись = СуществующаяЗапись;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Запись = Неопределено Тогда Запись = НаборСвязей.Добавить(); КонецЕсли;

		Запись.Чат                  = Чат;
		Запись.ТипОбъекта           = ИмяТаблицы;
		Запись.ИдентификаторОбъекта = Идентификатор;
		Запись.Идентификатор        = СокрЛП(Идентификатор);
		Запись.ОсновнаяСвязь        = ЭтоОсновнаяСвязь;

		Если Не ЗначениеЗаполнено(Запись.ДатаУстановки) Тогда
			Запись.ДатаУстановки = ТекущаяДатаСеанса();
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Запись.ИсточникСвязи) Тогда
			Запись.ИсточникСвязи = Перечисления.EBC_ИсточникиСвязи.Ручная;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Запись.АвторИБ) Тогда
			Попытка
				Запись.АвторИБ = ПараметрыСеанса.ТекущийПользователь;
			Исключение
				Запись.АвторИБ = Справочники.Пользователи.ПустаяСсылка();
			КонецПопытки;
		КонецЕсли;

		ЗаполнитьОписаниеОбъектаСвязи(Запись, Объект);
		НаборСвязей.Записать();

		ЗафиксироватьТранзакцию();
	Исключение
		ИнформацияОбОшибкеСвязи = ИнформацияОбОшибке();
		ОтменитьТранзакцию();
		ЗаписатьОшибкуИзмененияСвязи("ПривязкаЧатаНеУстановлена", Чат,
			ИмяТаблицы, Идентификатор, Объект, ИнформацияОбОшибкеСвязи);
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Возвращает справочное описание объекта для записи связи.
//
// Возвращаемое значение:
//  Структура - Определено (Булево), ПредставлениеОбъекта, НавигационнаяСсылка.
//  Определено = Ложь означает, что описание получить не удалось (объект не задан
//  либо нет прав на его просмотр). В этом случае ранее записанное описание
//  затирать не следует.
//
Функция ОписаниеОбъектаСвязи(Знач Объект) Экспорт

	Результат = Новый Структура(
		"Определено,ПредставлениеОбъекта,НавигационнаяСсылка",
		Ложь,
		"",
		"");

	ДанныеОбъекта = EBC_АдаптерКонфигурации.ПолучитьДанныеИдентификацииОбъекта(
		Объект);
	Если ДанныеОбъекта = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Определено = Истина;
	Результат.ПредставлениеОбъекта = Лев(
		СокрЛП(Строка(ДанныеОбъекта.ПредставлениеОбъекта)),
		МаксимальнаяДлинаПредставленияОбъекта());
	Результат.НавигационнаяСсылка = Лев(
		СокрЛП(Строка(ДанныеОбъекта.НавигационнаяСсылка)),
		МаксимальнаяДлинаНавигационнойСсылки());

	Возврат Результат;

КонецФункции

// Удаляет связь чата с объектом.
Процедура ОтвязатьЧат(Знач Чат, Знач Объект) Экспорт

	ИмяТаблицы = ИмяТаблицыПоСсылке(Объект);
	Идентификатор = Объект.УникальныйИдентификатор();

	Попытка
		НаборСвязей = РегистрыСведений.EBC_СвязиОбъектов.СоздатьНаборЗаписей();
		НаборСвязей.Отбор.Чат.Установить(Чат);
		НаборСвязей.Отбор.ТипОбъекта.Установить(ИмяТаблицы);
		НаборСвязей.Отбор.ИдентификаторОбъекта.Установить(Идентификатор);
		НаборСвязей.Записать();
	Исключение
		ИнформацияОбОшибкеСвязи = ИнформацияОбОшибке();
		ЗаписатьОшибкуИзмененияСвязи("ПривязкаЧатаНеУдалена", Чат,
			ИмяТаблицы, Идентификатор, Объект, ИнформацияОбОшибкеСвязи);
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Возвращает все чаты, привязанные к объекту.
Функция ЧатыОбъекта(Знач Объект) Экспорт

	РезультатЧаты = Новый Массив;
	ИмяТаблицы = ИмяТаблицыПоСсылке(Объект);
	Идентификатор = Объект.УникальныйИдентификатор();

	Если ПустаяСтрока(ИмяТаблицы) Тогда
		Возврат РезультатЧаты;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| Связи.Чат КАК Чат
		|ИЗ
		| РегистрСведений.EBC_СвязиОбъектов КАК Связи
		|ГДЕ
		| Связи.ТипОбъекта = &ТипОбъекта
		| И Связи.ИдентификаторОбъекта = &ИдентификаторОбъекта";
	Запрос.УстановитьПараметр("ТипОбъекта", ИмяТаблицы);
	Запрос.УстановитьПараметр(
		"ИдентификаторОбъекта",
		Идентификатор);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		РезультатЧаты.Добавить(Выборка.Чат);
	КонецЦикла;

	Возврат РезультатЧаты;

КонецФункции

// Возвращает основные чаты переданных объектов одним запросом.
//
// Параметры:
//  Объекты - Массив ссылок на объекты BAS.
//
// Возвращаемое значение:
//  Соответствие - ключ: ссылка на объект, значение: ссылка на основной чат.
//  Объекты без основной связи в соответствие не попадают.
//
Функция ОсновныеЧатыОбъектов(Знач Объекты) Экспорт

	Результат = Новый Соответствие;
	СсылкиПоКлючу = Новый Соответствие;
	Идентификаторы = Новый Массив;

	Для Каждого Объект Из Объекты Цикл
		ИмяТаблицы = ИмяТаблицыПоСсылке(Объект);
		Если ПустаяСтрока(ИмяТаблицы) Тогда
			Продолжить;
		КонецЕсли;

		Идентификатор = Объект.УникальныйИдентификатор();
		СсылкиПоКлючу.Вставить(
			КлючСвязиОбъекта(ИмяТаблицы, Идентификатор),
			Объект);
		Идентификаторы.Добавить(Идентификатор);
	КонецЦикла;

	Если Идентификаторы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	// Отбор только по идентификатору: измерение проиндексировано, а тип объекта
	// проверяется ниже по ключу. Сравнение строкового измерения с массивом
	// строк неограниченной длины платформа принимает не во всех режимах.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| Связи.ТипОбъекта КАК ТипОбъекта,
		| Связи.ИдентификаторОбъекта КАК ИдентификаторОбъекта,
		| Связи.Чат КАК Чат
		|ИЗ
		| РегистрСведений.EBC_СвязиОбъектов КАК Связи
		|ГДЕ
		| Связи.ОсновнаяСвязь
		| И Связи.ИдентификаторОбъекта В (&Идентификаторы)";
	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Объект = СсылкиПоКлючу.Получить(
			КлючСвязиОбъекта(
				Выборка.ТипОбъекта,
				Выборка.ИдентификаторОбъекта));
		Если Объект <> Неопределено Тогда
			Результат.Вставить(Объект, Выборка.Чат);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Ищет основной чат объекта.
Функция ОсновнойЧатОбъекта(Знач Объект) Экспорт

	ИмяТаблицы = ИмяТаблицыПоСсылке(Объект);
	Идентификатор = Объект.УникальныйИдентификатор();

	Если ПустаяСтрока(ИмяТаблицы) Тогда
		Возврат Справочники.EBC_Чаты.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| Связи.Чат КАК Чат
		|ИЗ
		| РегистрСведений.EBC_СвязиОбъектов КАК Связи
		|ГДЕ
		| Связи.ТипОбъекта = &ТипОбъекта
		| И Связи.ИдентификаторОбъекта = &ИдентификаторОбъекта
		| И Связи.ОсновнаяСвязь";
	Запрос.УстановитьПараметр("ТипОбъекта", ИмяТаблицы);
	Запрос.УстановитьПараметр(
		"ИдентификаторОбъекта",
		Идентификатор);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Чат;
	КонецЕсли;

	Чаты = ЧатыОбъекта(Объект);
	Если Чаты.Количество() = 1 Тогда
		Возврат Чаты[0];
	КонецЕсли;

	Возврат Справочники.EBC_Чаты.ПустаяСсылка();

КонецФункции

// Ищет чат объекта, который следует показать оператору.
//
// В отличие от ОсновнойЧатОбъекта возвращает чат и тогда, когда основная связь
// не задана: в этом случае берется последняя по времени установки связь.
//
// Параметры:
//  Объект - ссылка на объект BAS.
//
// Возвращаемое значение:
//  СправочникСсылка.EBC_Чаты - пустая ссылка, если связей нет.
//
Функция ЧатОбъектаДляОткрытия(Знач Объект) Экспорт

	ИмяТаблицы = ИмяТаблицыПоСсылке(Объект);
	Если ПустаяСтрока(ИмяТаблицы) Тогда
		Возврат Справочники.EBC_Чаты.ПустаяСсылка();
	КонецЕсли;

	// Основная связь всегда первая: Истина упорядочивается по убыванию раньше Ложь.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| Связи.Чат КАК Чат
		|ИЗ
		| РегистрСведений.EBC_СвязиОбъектов КАК Связи
		|ГДЕ
		| Связи.ТипОбъекта = &ТипОбъекта
		| И Связи.ИдентификаторОбъекта = &ИдентификаторОбъекта
		|
		|УПОРЯДОЧИТЬ ПО
		| Связи.ОсновнаяСвязь УБЫВ,
		| Связи.ДатаУстановки УБЫВ";
	Запрос.УстановитьПараметр("ТипОбъекта", ИмяТаблицы);
	Запрос.УстановитьПараметр(
		"ИдентификаторОбъекта",
		Объект.УникальныйИдентификатор());

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Чат;
	КонецЕсли;

	Возврат Справочники.EBC_Чаты.ПустаяСсылка();

КонецФункции

// Субъект контакта объекта - тот, с кем на самом деле ведётся переписка.
//
// В SmallBusiness это всегда контрагент. В УТ и КУП стороной взаимодействия
// служит партнёр, а контрагент - лишь юридическое лицо, на которое оформляют
// документы; чат логично относить к партнёру.
//
// Порядок:
//  1) объект сам партнёр - он и есть субъект;
//  2) объект сам контрагент - берём его партнёра, при отсутствии сам контрагент;
//  3) у документа есть заполненный реквизит "Партнер" подходящего типа - партнёр;
//  4) иначе реквизит "Контрагент";
//  5) там, где справочника "Партнеры" нет, работают только шаги про контрагента.
//
// Параметры:
//  Объект - ссылка на объект учётной системы.
//
// Возвращаемое значение:
//  ссылка       - субъект контакта;
//  Неопределено - подходящего реквизита нет, он пуст либо нет прав на чтение.
//
Функция СубъектКонтактаОбъекта(Знач Объект) Экспорт

	Пара = ПараКонтакта(Объект);
	Если Пара.Партнер <> Неопределено Тогда
		Возврат Пара.Партнер;
	КонецЕсли;

	Возврат Пара.Контрагент;

КонецФункции

// Разрешённая пара "партнёр - контрагент" по любому объекту-основанию.
//
// Одна функция на все сценарии: и открыть карточку контакта, и заполнить новый
// документ. Разница между сценариями в том, какое поле они берут -
// СвязанныйКонтакт (что именно привязано) или пару целиком.
//
// Контрагент по партнёру подбирается типовым ПартнерыИКонтрагенты, если он в
// конфигурации есть: типовой алгоритм учитывает иерархию партнёров и при
// нескольких кандидатах намеренно возвращает пустую ссылку, а не первого
// попавшегося. Собственный запрос - только запасной путь, и он обязан вести
// себя так же.
//
// Параметры:
//  Объект - ссылка на объект учётной системы.
//
// Возвращаемое значение:
//  Структура:
//   * СвязанныйКонтакт        - ссылка - объект, который непосредственно привязан;
//   * ТипСвязанногоКонтакта   - Строка - "Партнер", "Контрагент" либо "";
//   * Партнер                 - ссылка или Неопределено;
//   * Контрагент              - ссылка или Неопределено;
//   * НеоднозначныйКонтрагент - Булево - у партнёра несколько контрагентов,
//                                        выбор оставлен пользователю;
//   * Согласована             - Булево - Контрагент.Партнер совпадает с Партнер
//                                        либо одно из значений пусто.
//
Функция ПараКонтакта(Знач Объект) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("СвязанныйКонтакт", Неопределено);
	Результат.Вставить("ТипСвязанногоКонтакта", "");
	Результат.Вставить("Партнер", Неопределено);
	Результат.Вставить("Контрагент", Неопределено);
	Результат.Вставить("НеоднозначныйКонтрагент", Ложь);
	Результат.Вставить("Согласована", Истина);

	Если Не ЗначениеЗаполнено(Объект) Тогда
		Возврат Результат;
	КонецЕсли;

	Возможности = EBC_АдаптерКонфигурации.ВозможностиКонтактов();
	ИмяТаблицы = ИмяТаблицыПоСсылке(Объект);

	Если Возможности.ЕстьПартнеры И ИмяТаблицы = "Справочник.Партнеры" Тогда
		Результат.СвязанныйКонтакт = Объект;
		Результат.ТипСвязанногоКонтакта = "Партнер";
		Результат.Партнер = Объект;
		ДополнитьКонтрагентомПартнера(Результат, Возможности);
		Возврат Результат;
	КонецЕсли;

	Если Возможности.ЕстьКонтрагенты И ИмяТаблицы = "Справочник.Контрагенты" Тогда
		Результат.СвязанныйКонтакт = Объект;
		Результат.ТипСвязанногоКонтакта = "Контрагент";
		Результат.Контрагент = Объект;
		Результат.Партнер = ПартнерКонтрагента(Объект, Возможности);
		Возврат Результат;
	КонецЕсли;

	// Документ или иной объект: читаем его собственные реквизиты.
	Если Возможности.ЕстьПартнеры Тогда
		Результат.Партнер = РеквизитКонтакта(Объект, "Партнер", "Справочник.Партнеры");
	КонецЕсли;
	Если Возможности.ЕстьКонтрагенты Тогда
		Результат.Контрагент = РеквизитКонтакта(Объект, "Контрагент", "Справочник.Контрагенты");
	КонецЕсли;

	Если Результат.Партнер <> Неопределено И Результат.Контрагент = Неопределено Тогда
		ДополнитьКонтрагентомПартнера(Результат, Возможности);
	ИначеЕсли Результат.Контрагент <> Неопределено И Результат.Партнер = Неопределено Тогда
		Результат.Партнер = ПартнерКонтрагента(Результат.Контрагент, Возможности);
	КонецЕсли;

	// Прямой связью считается то, что реально заполнено у объекта; партнёр
	// приоритетнее только потому, что в УТ и КУП он общая сторона сделки.
	Если Результат.Партнер <> Неопределено Тогда
		Результат.СвязанныйКонтакт = Результат.Партнер;
		Результат.ТипСвязанногоКонтакта = "Партнер";
	ИначеЕсли Результат.Контрагент <> Неопределено Тогда
		Результат.СвязанныйКонтакт = Результат.Контрагент;
		Результат.ТипСвязанногоКонтакта = "Контрагент";
	КонецЕсли;

	ПроверитьСогласованностьПары(Результат, Возможности);

	Возврат Результат;

КонецФункции

// Контрагент объекта.
//
// Устарела: оставлена ради внешних обработок, которые могли на неё ссылаться.
// Новый код использует СубъектКонтактаОбъекта или ПараКонтакта.
//
// Параметры:
//  Объект - ссылка на объект учётной системы.
//
// Возвращаемое значение:
//  ссылка       - контрагент объекта;
//  Неопределено - реквизита нет, он не заполнен либо нет прав на чтение.
//
Функция КонтрагентОбъекта(Знач Объект) Экспорт

	Возврат ПараКонтакта(Объект).Контрагент;

КонецФункции

// Заполненное значение ссылочного реквизита, если он есть и подходит по типу.
//
// Тип проверяется до чтения: одноимённый реквизит в чужой конфигурации может
// вести совсем на другой справочник, и подставлять такое значение в документ
// нельзя.
//
Функция РеквизитКонтакта(Знач Объект, Знач ИмяРеквизита, Знач ПолноеИмяСправочника)

	Попытка
		ОбъектМетаданных = Объект.Метаданные();
		РеквизитМетаданных = ОбъектМетаданных.Реквизиты.Найти(ИмяРеквизита);
		Если РеквизитМетаданных = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;

		МетаданныеСправочника = Метаданные.НайтиПоПолномуИмени(ПолноеИмяСправочника);
		Если МетаданныеСправочника = Неопределено
			Или Не РеквизитМетаданных.Тип.СодержитТип(
				Тип(ТипСсылкиСправочника(МетаданныеСправочника.Имя))) Тогда
			Возврат Неопределено;
		КонецЕсли;

		// ВыбратьРазрешенные: RLS не должен прерывать команду расширения.
		Значения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект, ИмяРеквизита, Истина);
		Значение = Неопределено;
		Значения.Свойство(ИмяРеквизита, Значение);

		Возврат ?(ЗначениеЗаполнено(Значение), Значение, Неопределено);
	Исключение
		// Объект без коллекции реквизитов либо нет прав: возможность просто
		// недоступна, прерывать действие ошибкой незачем.
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Имя типа ссылки справочника строкой - для Тип() без статической зависимости.
Функция ТипСсылкиСправочника(Знач ИмяСправочника)
	Возврат "СправочникСсылка." + ИмяСправочника;
КонецФункции

// Партнёр контрагента, если такой реквизит в конфигурации есть.
Функция ПартнерКонтрагента(Знач Контрагент, Знач Возможности)

	Если Не Возможности.ЕстьПартнеры Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат РеквизитКонтакта(Контрагент, "Партнер", "Справочник.Партнеры");

КонецФункции

// Подбирает контрагента известного партнёра.
//
// Приоритет у типовой ПартнерыИКонтрагенты: она учитывает иерархию партнёров и
// сама возвращает пустую ссылку, когда однозначного ответа нет. Обращение
// динамическое - в SmallBusiness этого модуля не существует.
//
Процедура ДополнитьКонтрагентомПартнера(Результат, Знач Возможности)

	Если Не Возможности.ЕстьПартнеры
		Или Не Возможности.ЕстьКонтрагенты
		Или Результат.Партнер = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Возможности.ЕстьТиповойМодульПартнеров Тогда
		Попытка
			Модуль = ОбщегоНазначения.ОбщийМодуль("ПартнерыИКонтрагенты");
			Контрагент = Модуль.ПолучитьКонтрагентаПартнераПоУмолчанию(Результат.Партнер);
			Если ЗначениеЗаполнено(Контрагент) Тогда
				Результат.Контрагент = Контрагент;
				Возврат;
			КонецЕсли;
			// Пустой ответ типовой функции означает "однозначного нет".
			Результат.НеоднозначныйКонтрагент = НесколькоКонтрагентовПартнера(Результат.Партнер);
			Возврат;
		Исключение
			// Модуль есть, но сигнатура другая: уходим на запасной путь.
		КонецПопытки;
	КонецЕсли;

	КонтрагентыПартнера = КонтрагентыПартнера(Результат.Партнер);
	Если КонтрагентыПартнера.Количество() = 1 Тогда
		Результат.Контрагент = КонтрагентыПартнера[0];
	ИначеЕсли КонтрагентыПартнера.Количество() > 1 Тогда
		// Случайный контрагент хуже пустого поля: выбор оставляем пользователю.
		Результат.НеоднозначныйКонтрагент = Истина;
	КонецЕсли;

КонецПроцедуры

// Контрагенты партнёра, не более двух: больше для решения об однозначности
// не нужно.
Функция КонтрагентыПартнера(Знач Партнер)

	Результат = Новый Массив;

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 2
			|	Контрагенты.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|ГДЕ
			|	Контрагенты.Партнер = &Партнер
			|	И НЕ Контрагенты.ПометкаУдаления";
		Запрос.УстановитьПараметр("Партнер", Партнер);

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Добавить(Выборка.Ссылка);
		КонецЦикла;
	Исключение
		// Реквизита "Партнер" у контрагентов нет либо нет прав на чтение.
	КонецПопытки;

	Возврат Результат;

КонецФункции

Функция НесколькоКонтрагентовПартнера(Знач Партнер)
	Возврат КонтрагентыПартнера(Партнер).Количество() > 1;
КонецФункции

// Проверяет, что контрагент действительно принадлежит партнёру.
//
// Несогласованную пару в документ передавать нельзя: это данные о разных
// сторонах сделки. Приоритет у партнёра как у общей стороны взаимодействия.
//
Процедура ПроверитьСогласованностьПары(Результат, Знач Возможности)

	Если Не Возможности.ЕстьПартнеры
		Или Результат.Партнер = Неопределено
		Или Результат.Контрагент = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПартнерКонтрагента = ПартнерКонтрагента(Результат.Контрагент, Возможности);
	Если ПартнерКонтрагента <> Неопределено
		И ПартнерКонтрагента <> Результат.Партнер Тогда
		Результат.Согласована = Ложь;
	КонецЕсли;

КонецПроцедуры

// Чат, который следует показать оператору для объекта, с запасным путём
// через субъект контакта.
//
// Порядок ровно такой:
//  1) чат самого объекта - основная связь, при её отсутствии последняя
//     по времени установки;
//  2) чат субъекта контакта этого объекта по тому же правилу;
//  3) в конфигурациях с партнёрами, если у партнёра чата нет, - чат его
//     контрагента: переписку могли привязать к юридическому лицу.
//
// Накладную обычно не привязывают к чату отдельно: переписка идёт с партнёром
// или контрагентом, и открывать оператору нужно именно её. Правило живёт здесь
// в одном месте - им пользуются и подключаемые команды, и отправка печатной
// формы.
//
// Параметры:
//  Объект  - ссылка на объект учётной системы.
//  Субъект - выходной. Субъект контакта, чей чат вернули; иначе Неопределено.
//            Избавляет вызывающий код от повторного чтения.
//
// Возвращаемое значение:
//  СправочникСсылка.EBC_Чаты - пустая ссылка, если чатов нет ни у объекта,
//                              ни у его субъекта контакта.
//
Функция ЧатОбъектаИлиСубъекта(Знач Объект, Субъект = Неопределено) Экспорт

	Субъект = Неопределено;

	Чат = ЧатОбъектаДляОткрытия(Объект);
	Если ЗначениеЗаполнено(Чат) Тогда
		Возврат Чат;
	КонецЕсли;

	Пара = ПараКонтакта(Объект);

	// Кандидаты в порядке убывания близости к переписке.
	Кандидаты = Новый Массив;
	Если Пара.Партнер <> Неопределено Тогда
		Кандидаты.Добавить(Пара.Партнер);
	КонецЕсли;
	Если Пара.Контрагент <> Неопределено Тогда
		Кандидаты.Добавить(Пара.Контрагент);
	КонецЕсли;

	Для Каждого Кандидат Из Кандидаты Цикл
		Если Кандидат = Объект Тогда
			// Чат самого объекта уже проверен выше.
			Продолжить;
		КонецЕсли;

		ЧатКандидата = ЧатОбъектаДляОткрытия(Кандидат);
		Если ЗначениеЗаполнено(ЧатКандидата) Тогда
			Субъект = Кандидат;
			Возврат ЧатКандидата;
		КонецЕсли;
	КонецЦикла;

	Возврат Справочники.EBC_Чаты.ПустаяСсылка();

КонецФункции

// Чат объекта или его контрагента.
//
// Устарела: оставлена ради внешних обработок. Новый код использует
// ЧатОбъектаИлиСубъекта - оно же учитывает партнёра.
//
// Параметры:
//  Объект     - ссылка на объект учётной системы.
//  Контрагент - выходной. Субъект контакта, чей чат вернули.
//
// Возвращаемое значение:
//  СправочникСсылка.EBC_Чаты - пустая ссылка, если чатов нет.
//
Функция ЧатОбъектаИлиКонтрагента(Знач Объект, Контрагент = Неопределено) Экспорт

	Возврат ЧатОбъектаИлиСубъекта(Объект, Контрагент);

КонецФункции

// Индекс кадра провайдера в ОбщаяКартинка.EBC_ПровайдерыЧатов.
//
// Живёт здесь, а не в модуле формы: соответствие "провайдер - кадр" нужно
// каждой форме, которая показывает список чатов, а разъехавшиеся копии дали бы
// разные значки в разных формах.
//
// Параметры:
//  Провайдер - ПеречислениеСсылка.EBC_Провайдеры
//
// Возвращаемое значение:
//  Число - индекс кадра; 0 - пустой кадр для неизвестного провайдера.
//
Функция ИндексКартинкиПровайдера(Знач Провайдер) Экспорт

	Провайдеры = Перечисления.EBC_Провайдеры;

	Если Провайдер = Провайдеры.Telegram Тогда
		Возврат 1;
	ИначеЕсли Провайдер = Провайдеры.TelegramBot Тогда
		Возврат 2;
	ИначеЕсли Провайдер = Провайдеры.ViberBot
		Или Провайдер = Провайдеры.ViberPersonal
		Или Провайдер = Провайдеры.ViberBusiness
		Или Провайдер = Провайдеры.EchatViber Тогда
		Возврат 3;
	ИначеЕсли Провайдер = Провайдеры.WhatsApp
		Или Провайдер = Провайдеры.WhatsAppPersonal Тогда
		Возврат 4;
	ИначеЕсли Провайдер = Провайдеры.Instagram Тогда
		Возврат 5;
	ИначеЕсли Провайдер = Провайдеры.Facebook Тогда
		Возврат 6;
	ИначеЕсли Провайдер = Провайдеры.WebChat Тогда
		Возврат 7;
	КонецЕсли;

	// Undefined и незаполненное значение: пустой кадр.
	Возврат 0;

КонецФункции

// Чаты объекта в порядке, в котором их стоит предлагать оператору.
//
// Порядок ровно такой:
//  1) основная связь самого объекта;
//  2) остальные связи объекта, свежие по дате привязки первыми;
//  3) связи его партнёра - основная, затем свежие первыми;
//  4) связи его контрагента по тому же правилу.
//
// Первый элемент - это тот же чат, который вернула бы ЧатОбъектаИлиСубъекта:
// правило одно, просто здесь оно развёрнуто в список. Дубли отбрасываются -
// один и тот же чат может быть привязан и к документу, и к его партнёру.
//
// Параметры:
//  Объект - ссылка на объект учётной системы.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Чат            - СправочникСсылка.EBC_Чаты;
//   * ОсновнаяСвязь  - Булево;
//   * ЧатКонтрагента - Булево - связь принадлежит субъекту контакта, а не
//                               самому объекту. Имя поля сохранено ради
//                               совместимости с формами и внешними обработками.
//
Функция ЧатыОбъектаПоПриоритету(Знач Объект) Экспорт

	Результат = Новый Массив;
	Если Не ЗначениеЗаполнено(Объект) Тогда
		Возврат Результат;
	КонецЕсли;

	Отобранные = Новый Соответствие;
	ДобавитьЧатыСвязей(Результат, Отобранные, Объект, Ложь);

	Пара = ПараКонтакта(Объект);
	Для Каждого Субъект Из СубъектыКромеОбъекта(Пара, Объект) Цикл
		ДобавитьЧатыСвязей(Результат, Отобранные, Субъект, Истина);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Партнёр и контрагент пары, кроме самого объекта и пустых значений.
//
// Порядок фиксирован: партнёр как общая сторона взаимодействия, затем
// контрагент как юридическое лицо.
//
Функция СубъектыКромеОбъекта(Знач Пара, Знач Объект)

	Результат = Новый Массив;

	Если Пара.Партнер <> Неопределено И Пара.Партнер <> Объект Тогда
		Результат.Добавить(Пара.Партнер);
	КонецЕсли;
	Если Пара.Контрагент <> Неопределено И Пара.Контрагент <> Объект Тогда
		Результат.Добавить(Пара.Контрагент);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Предельная длина реквизита Справочник.EBC_Чаты.ТекстПоследнегоСообщения.
// Совпадает с объявленной длиной реквизита: занижать её незачем, а разница
// уходила в потерянные сообщения карточки чата.
Функция МаксимальнаяДлинаТекстаСообщений()
	Возврат 500;
КонецФункции

// Извлекает текст сообщения из значения, полученного от API.
//
// lastMessageText и text приходят не всегда строкой: для вложений и системных
// сообщений API отдаёт вложенный объект. Строка() от него давала в карточке
// чата слово "Структура" вместо текста.
//
// Параметры:
//  Значение - Произвольный - значение свойства ответа API после разбора JSON.
//
// Возвращаемое значение:
//  Строка - текст сообщения либо пустая строка, если текста в значении нет.
//
Функция ТекстСообщенияИзДанныхAPI(Знач Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Строка") Тогда
		Возврат СокрЛП(Значение);
	КонецЕсли;

	Если ТипЗначения = Тип("Число")
		Или ТипЗначения = Тип("Булево")
		Или ТипЗначения = Тип("Дата") Тогда
		Возврат СокрЛП(Строка(Значение));
	КонецЕсли;

	Если ТипЗначения = Тип("Структура")
		Или ТипЗначения = Тип("Соответствие") Тогда
		ТекстовыеПоля = ТекстовыеПоляСообщенияAPI();
		Для Каждого КлючИЗначение Из Значение Цикл
			Если ТекстовыеПоля.Найти(НРег(Строка(КлючИЗначение.Ключ))) = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Текст = ТекстСообщенияИзДанныхAPI(КлючИЗначение.Значение);
			Если Не ПустаяСтрока(Текст) Тогда
				Возврат Текст;
			КонецЕсли;
		КонецЦикла;

		Возврат "";
	КонецЕсли;

	Если ТипЗначения = Тип("Массив") Тогда
		Для Каждого ЭлементМассива Из Значение Цикл
			Текст = ТекстСообщенияИзДанныхAPI(ЭлементМассива);
			Если Не ПустаяСтрока(Текст) Тогда
				Возврат Текст;
			КонецЕсли;
		КонецЦикла;

		Возврат "";
	КонецЕсли;

	// Неизвестный тип: его представление в карточке чата бесполезно.
	Возврат "";

КонецФункции

// Имена полей, в которых API передаёт текст сообщения. Сравнение регистро-
// независимое: разбор JSON сохраняет исходное написание ключей.
Функция ТекстовыеПоляСообщенияAPI()

	Поля = Новый Массив;
	Поля.Добавить("text");
	Поля.Добавить("body");
	Поля.Добавить("caption");
	Поля.Добавить("message");
	Поля.Добавить("content");
	Поля.Добавить("value");
	Поля.Добавить("lastmessagetext");

	Возврат Поля;

КонецФункции

// Добавляет новое сообщение к тексту последних сообщений чата.
//
// Сообщения хранятся от нового к старому и разделяются переводом строки,
// поэтому в карточке чата видно несколько последних сообщений, пока их общая
// длина укладывается в лимит реквизита. Строки старых сообщений отбрасываются
// с конца, как только очередная перестаёт помещаться.
// Повторно пришедшее сообщение (та же строка в начале текста) не дублируется:
// синхронизация и push-уведомления отдают один и тот же lastMessageText.
//
Функция ДополнитьТекстПоследнихСообщений(
		Знач НакопленныйТекст,
		Знач НовоеСообщение) Экспорт

	Лимит = МаксимальнаяДлинаТекстаСообщений();
	ПредыдущийТекст = СокрЛП(Строка(НакопленныйТекст));
	НовоеСообщение = СокрЛП(Строка(НовоеСообщение));

	Если ПустаяСтрока(НовоеСообщение) Тогда
		Возврат Лев(ПредыдущийТекст, Лимит);
	КонецЕсли;

	Если ПредыдущийТекст = НовоеСообщение
		Или СтрНачинаетсяС(ПредыдущийТекст, НовоеСообщение + Символы.ПС) Тогда
		Возврат Лев(ПредыдущийТекст, Лимит);
	КонецЕсли;

	// Сообщение длиннее лимита вытесняет всю предыдущую историю.
	Если СтрДлина(НовоеСообщение) >= Лимит Тогда
		Возврат Лев(НовоеСообщение, Лимит);
	КонецЕсли;

	Результат = НовоеСообщение;
	СтарыеСтроки = СтрРазделить(ПредыдущийТекст, Символы.ПС, Ложь);
	Для Каждого СтараяСтрока Из СтарыеСтроки Цикл
		СтараяСтрока = СокрЛП(СтараяСтрока);
		Если ПустаяСтрока(СтараяСтрока) Тогда
			Продолжить;
		КонецЕсли;

		Кандидат = Результат + Символы.ПС + СтараяСтрока;
		Если СтрДлина(Кандидат) > Лимит Тогда
			Прервать;
		КонецЕсли;

		Результат = Кандидат;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Отправляет текстовое сообщение непосредственно в указанный чат.
Функция ОтправитьСообщениеВЧат(Знач Чат, Знач Текст) Экспорт

	СобытиеАудита = EBC_Логирование.НовоеСобытиеДействияПользователя("СообщениеОтправлено");
	EBC_Логирование.ЗаполнитьДанныеЧата(СобытиеАудита, Чат);
	СобытиеАудита.Детали = СтрШаблон("ДлинаТекста=%1", СтрДлина(Текст));
	Если Не ЗначениеЗаполнено(Чат) Тогда
		Результат = Новый Структура(
			"Успех,Ошибка",
			Ложь,
			НСтр(
				"ru = 'Не выбран чат для отправки сообщения.';
				|uk = 'Не вибрано чат для надсилання повідомлення.'"));
	Иначе
		Результат = EBC_КлиентАПИ.ОтправитьСообщениеВЧат(Чат, Текст);
	КонецЕсли;

	EBC_Логирование.ЗаполнитьРезультатДействия(СобытиеАудита, Результат);
	Если Не ЗначениеЗаполнено(Чат) Тогда
		СобытиеАудита.РезультатДействия = "Отклонено";
		СобытиеАудита.Уровень = Перечисления.EBC_УровниЖурнала.Предупреждение;
	КонецЕсли;
	Если Не Результат.Успех Тогда
		СобытиеАудита.Событие = "СообщениеНеОтправлено";
		Если Результат.Свойство("СтатусОтправки") И Результат.СтатусОтправки = "Unknown" Тогда
			СобытиеАудита.Событие = "ОтправкаНеПодтверждена";
		КонецЕсли;
	ИначеЕсли Результат.ПринятоВОчередь Тогда
		СобытиеАудита.Событие = "СообщениеВОчереди";
	Иначе
		СобытиеАудита.Событие = "СообщениеПринято";
	КонецЕсли;
	EBC_Логирование.Записать(СобытиеАудита);
	Возврат Результат;

КонецФункции

// Отправляет файл непосредственно в указанный чат.
Функция ОтправитьФайлВЧат(
		Знач Чат,
		Знач ДанныеФайла,
		Знач ИмяФайла,
		Знач Заголовок = "",
		Знач ТипФайла = "Document",
		Знач ТипСодержимого = "application/pdf",
		Знач РасширениеПоУмолчанию = "pdf") Экспорт

	ЭтоИзображение = ВРег(СокрЛП(ТипФайла)) = "IMAGE"
		Или ВРег(СокрЛП(ТипФайла)) = "PHOTO"
		Или Лев(НРег(СокрЛП(ТипСодержимого)), 6) = "image/";
	СобытиеАудита = EBC_Логирование.НовоеСобытиеДействияПользователя(
		?(ЭтоИзображение, "ИзображениеОтправлено", "ФайлОтправлен"));
	EBC_Логирование.ЗаполнитьДанныеЧата(СобытиеАудита, Чат);
	РазмерФайла = 0;
	Попытка РазмерФайла = ДанныеФайла.Размер(); Исключение КонецПопытки;
	СобытиеАудита.Детали = СтрШаблон("Имя=%1; MIME=%2; Размер=%3", Лев(ИмяФайла, 150), Лев(ТипСодержимого, 100), РазмерФайла);

	Если Не ЗначениеЗаполнено(Чат) Тогда
		Результат = Новый Структура(
			"Успех,Ошибка",
			Ложь,
			НСтр(
				"ru = 'Не выбран чат для отправки файла.';
				|uk = 'Не вибрано чат для надсилання файлу.'"));
	Иначе
		Результат = EBC_КлиентАПИ.ОтправитьФайлВЧат(
			Чат, ДанныеФайла, ИмяФайла, Заголовок, ТипФайла,
			ТипСодержимого, РасширениеПоУмолчанию);
	КонецЕсли;

	EBC_Логирование.ЗаполнитьРезультатДействия(СобытиеАудита, Результат);
	Если Не ЗначениеЗаполнено(Чат) Тогда
		СобытиеАудита.РезультатДействия = "Отклонено";
		СобытиеАудита.Уровень = Перечисления.EBC_УровниЖурнала.Предупреждение;
	КонецЕсли;
	Если Не Результат.Успех Тогда
		СобытиеАудита.Событие = ?(ЭтоИзображение, "ИзображениеНеОтправлено", "ФайлНеОтправлен");
		Если Результат.Свойство("СтатусОтправки") И Результат.СтатусОтправки = "Unknown" Тогда
			СобытиеАудита.Событие = "ОтправкаНеПодтверждена";
		КонецЕсли;
	ИначеЕсли Результат.ПринятоВОчередь Тогда
		СобытиеАудита.Событие = ?(ЭтоИзображение, "ИзображениеВОчереди", "ФайлВОчереди");
	Иначе
		СобытиеАудита.Событие = ?(ЭтоИзображение, "ИзображениеПринято", "ФайлПринят");
	КонецЕсли;
	EBC_Логирование.Записать(СобытиеАудита);
	Возврат Результат;

КонецФункции

// Загружает компании, провайдеров и учётные записи единым сценарием.
Функция СинхронизироватьСтруктуруКомпаний() Экспорт

	КомпанияБлокировки = Справочники.EBC_Компании.ПустаяСсылка();
	ВидОперации = "СтруктураКомпании";
	ИдентификаторСеанса = ЗахватитьБлокировкуСинхронизации(
		КомпанияБлокировки,
		ВидОперации);

	Если ИдентификаторСеанса = Неопределено Тогда
		Возврат РезультатСинхронизацииСОшибкой(
			НСтр(
				"ru = 'Синхронизация структуры компаний уже выполняется.';
				|uk = 'Синхронізація структури компаній уже виконується.'"));
	КонецЕсли;

	Результат = НовыйРезультатСинхронизации();
	Попытка
		Результат = ВыполнитьСинхронизациюСтруктурыКомпаний();
	Исключение
		Результат = РезультатСинхронизацииСОшибкой(
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Попытка
		ОсвободитьБлокировкуСинхронизации(
			КомпанияБлокировки,
			ВидОперации,
			ИдентификаторСеанса);
	Исключение
		ЗаписатьОшибкуОсвобожденияБлокировки(
			ВидОперации,
			ИдентификаторСеанса,
			ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Загружает всех операторов, доступных текущему токену Easy Busy Chat.
Функция ЗагрузитьПользователей() Экспорт

	РезультатСтруктуры = СинхронизироватьСтруктуруКомпаний();
	Если Не РезультатСтруктуры.Успех Тогда
		Возврат РезультатЗагрузки(
			Ложь,
			РезультатСтруктуры.Ошибка,
			0);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| Компании.Ссылка КАК Компания,
		| Компании.Наименование КАК НаименованиеКомпании
		|ИЗ
		| Справочник.EBC_Компании КАК Компании
		|ГДЕ
		| НЕ Компании.ПометкаУдаления
		| И Компании.ИдентификаторEBC <> """"";

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат РезультатЗагрузки(
			Ложь,
			НСтр(
				"ru = 'Нет компаний, доступных по токену Easy Busy Chat.';
				|uk = 'Немає компаній, доступних за токеном Easy Busy Chat.'"),
			0);
	КонецЕсли;

	ПользователиПоИдентификатору = Новый Соответствие;
	КоличествоОшибок = 0;
	КоличествоКомпаний = 0;
	ТекстОшибки = "";
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		КоличествоКомпаний = КоличествоКомпаний + 1;
		Ответ = EBC_КлиентАПИ.ПолучитьПользователей(
			Выборка.Компания);
		Если Не Ответ.Успех Тогда
			КоличествоОшибок = КоличествоОшибок + 1;
			ТекстОшибки = СтрШаблон(
				НСтр(
					"ru = 'Компания %1: %2';
					|uk = 'Компанія %1: %2'"),
				Выборка.НаименованиеКомпании,
				Ответ.Ошибка);
			ЗаписатьОшибкуЗагрузкиПользователей(
				Выборка.НаименованиеКомпании,
				Ответ.Ошибка);
			Продолжить;
		КонецЕсли;

		Если Ответ.Данные = Неопределено
			Или ТипЗнч(Ответ.Данные) <> Тип("Массив") Тогда
			КоличествоОшибок = КоличествоОшибок + 1;
			ТекстОшибки = СтрШаблон(
				НСтр(
					"ru = 'Компания %1: API вернул некорректный список пользователей.';
					|uk = 'Компанія %1: API повернув некоректний список користувачів.'"),
				Выборка.НаименованиеКомпании);
			ЗаписатьОшибкуЗагрузкиПользователей(
				Выборка.НаименованиеКомпании,
				ТекстОшибки);
			Продолжить;
		КонецЕсли;

		ДобавитьДанныеПользователей(
			ПользователиПоИдентификатору,
			Выборка.Компания,
			Ответ.Данные);
	КонецЦикла;

	Количество = ЗаписатьПользователей(
		ПользователиПоИдентификатору);
	Если КоличествоОшибок > 0 Тогда
		ТекстОшибки = СтрШаблон(
			НСтр(
				"ru = 'Ошибок загрузки: %1. %2';
				|uk = 'Помилок завантаження: %1. %2'"),
			КоличествоОшибок,
			ТекстОшибки);
	КонецЕсли;

	Возврат РезультатЗагрузки(
		КоличествоОшибок = 0,
		ТекстОшибки,
		Количество,
		КоличествоКомпаний,
		КоличествоОшибок);

КонецФункции

// Захватывает короткую аренду синхронизации в отдельной транзакции.
Функция ЗахватитьБлокировкуСинхронизации(Знач Компания, Знач ВидОперации) Экспорт

	МоментЗахвата = ТекущаяДатаСеанса();
	ИдентификаторСеанса = Новый УникальныйИдентификатор;
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьСостояниеСинхронизации(
			Компания,
			ВидОперации);

		ТекущееСостояние = ПолучитьСостояниеСинхронизации(
			Компания,
			ВидОперации);
		Если ТекущееСостояние <> Неопределено
			И ЗначениеЗаполнено(ТекущееСостояние.ИдентификаторСеанса)
			И ТекущееСостояние.Истекает > МоментЗахвата Тогда
			ОтменитьТранзакцию();
			Возврат Неопределено;
		КонецЕсли;

		МенеджерЗаписи =
			РегистрыСведений.EBC_СостояниеСинхронизации.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Компания = Компания;
		МенеджерЗаписи.ВидОперации = ВидОперации;
		МенеджерЗаписи.ИдентификаторСеанса = ИдентификаторСеанса;
		МенеджерЗаписи.Начало = МоментЗахвата;
		МенеджерЗаписи.Истекает = МоментЗахвата + 300;
		МенеджерЗаписи.Пользователь = ИмяТекущегоПользователяИБ();
		МенеджерЗаписи.Записать();

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат ИдентификаторСеанса;

КонецФункции

// Освобождает только собственную аренду синхронизации.
Процедура ОсвободитьБлокировкуСинхронизации(
		Знач Компания,
		Знач ВидОперации,
		Знач ИдентификаторСеанса) Экспорт

	Если ИдентификаторСеанса = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьСостояниеСинхронизации(
			Компания,
			ВидОперации);

		ТекущееСостояние = ПолучитьСостояниеСинхронизации(
			Компания,
			ВидОперации);
		Если ТекущееСостояние <> Неопределено
			И ТекущееСостояние.ИдентификаторСеанса =
				ИдентификаторСеанса Тогда
			МенеджерЗаписи =
				РегистрыСведений.EBC_СостояниеСинхронизации.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Компания = Компания;
			МенеджерЗаписи.ВидОперации = ВидОперации;
			МенеджерЗаписи.Удалить();
		КонецЕсли;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Синхронизирует список чатов с сервером.
Функция СинхронизироватьЧаты(Знач Компания) Экспорт

	Если Не ЗначениеЗаполнено(Компания) Тогда
		Возврат Ложь;
	КонецЕсли;

	Ответ = EBC_КлиентАПИ.ПолучитьЧаты(Компания);
	Если Не Ответ.Успех
		Или ТипЗнч(Ответ.Данные) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;

	ИдентификаторыНепрочитанных = ПолучитьИдентификаторыНепрочитанныхЧатов(
		Компания);
	СинхронизироватьДанныеЧатов(
		Компания,
		Ответ.Данные,
		Неопределено,
		ИдентификаторыНепрочитанных);

	Возврат Истина;

КонецФункции

// Лёгкая синхронизация чатов: только последние изменения.
//
// Предназначена для частого запуска по расписанию. Берёт узкое окно по дате
// последнего сообщения и ограниченное число страниц на учётную запись, поэтому
// отрабатывает быстро и подхватывает то, ради чего запускается: новые чаты и
// новые сообщения в старых чатах (EBC_Чаты.ТекстПоследнегоСообщения).
//
// Ограничение страниц исходит из того, что API отдаёт чаты от самых свежих.
// Если чатов за окно оказалось больше, остальные подберёт следующий запуск или
// полная загрузка из списка чатов.
//
// Сортировка выдачи в спецификации API не описана, но проверена на живом
// сервисе 06.08.2026: GET /chats/v1/{company}/chats и .../account/{id}/chats
// возвращают чаты по убыванию lastUpdated - и внутри страницы, и между
// страницами. Подтверждено на ViberPersonal (2 учётные записи), Telegram,
// TelegramBot, WhatsAppPersonal, Instagram.
//
// Проверка повторяема: скилл EasyBusyChat, каталог scripts,
//   python -m ebchat check-order <provider> <companyId> <accountId>
// и тест tests/test_live.py::test_chats_come_back_newest_first.
// Прогонять после обновлений API на стороне сервиса: если сортировка изменится,
// МаксимумСтраницБыстройСинхронизацииЧатов надо вернуть в 0 и полагаться только
// на окно по дате.
//
// Сообщения (GET .../chat/{id}/messages) ведут себя иначе, и это проверено по
// всем 7 подключённым провайдерам. Без параметра order выдача совпадает с
// order=Latest. У шести провайдеров Latest отдаёт сообщения по ВОЗРАСТАНИЮ
// времени (свежее последнее), а Oldest - пустой список; у Telegram наоборот:
// Latest пуст, Oldest отдаёт по УБЫВАНИЮ (свежее первое). Пагинация не
// работает: offset либо игнорируется, либо обнуляет выдачу, а take не даёт
// среза одной последовательности. Одна страница take=100 - это всё.
// Здесь эндпоинт не используется, но при появлении загрузки истории сообщений
// закладываться ни на order, ни на offset нельзя.
//
Функция ЗагрузитьИзмененияЧатов() Экспорт

	Возврат ЗагрузитьЧатыЗаПериод(
		ГлубинаБыстройСинхронизацииЧатовДней(),
		МаксимумСтраницБыстройСинхронизацииЧатов());

КонецФункции

// Загружает чаты всех учётных записей за указанное количество последних дней.
//
// Параметры:
//  КоличествоДней  - Число - окно по дате последнего сообщения.
//  МаксимумСтраниц - Число - сколько страниц читать у одной учётной записи;
//                    0 - читать все, пока API их отдаёт.
//
Функция ЗагрузитьЧатыЗаПериод(
		Знач КоличествоДней = 30,
		Знач МаксимумСтраниц = 0) Экспорт

	Если КоличествоДней <= 0 Тогда
		Возврат РезультатЗагрузки(
			Ложь,
			НСтр(
				"ru = 'Период загрузки должен быть больше нуля дней.';
				|uk = 'Період завантаження має бути більшим за нуль днів.'"),
			0);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| УчетныеЗаписи.Ссылка КАК УчетнаяЗапись,
		| УчетныеЗаписи.ИдентификаторEBC КАК ИдентификаторУчетнойЗаписи,
		| УчетныеЗаписи.Владелец КАК Компания,
		| Компании.Наименование КАК НаименованиеКомпании
		|ИЗ
		| Справочник.EBC_УчетныеЗаписи КАК УчетныеЗаписи
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.EBC_Компании КАК Компании
		| ПО УчетныеЗаписи.Владелец = Компании.Ссылка
		|ГДЕ
		| НЕ УчетныеЗаписи.ПометкаУдаления
		| И УчетныеЗаписи.Активна
		| И НЕ УчетныеЗаписи.Игнорировать
		| И НЕ Компании.ПометкаУдаления
		| И УчетныеЗаписи.ИдентификаторEBC <> """"";

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат РезультатЗагрузки(
			Ложь,
			НСтр(
				"ru = 'Нет активных учётных записей. Сначала загрузите список учётных записей.';
				|uk = 'Немає активних облікових записів. Спочатку завантажте список облікових записів.'"),
			0);
	КонецЕсли;

	// Граница считается в том же поясе, в котором хранятся даты чатов.
	ГраницаПериода = ТекущаяДатаДанных() - (КоличествоДней * 86400);
	Количество = 0;
	КоличествоОшибок = 0;
	КоличествоУчетныхЗаписей = 0;
	РазмерСтраницы = 100;
	НепрочитанныеПоКомпаниям = Новый Соответствие;
	Выборка = РезультатЗапроса.Выбрать();

	Пока Выборка.Следующий() Цикл
		КоличествоУчетныхЗаписей = КоличествоУчетныхЗаписей + 1;
		ДанныеНепрочитанных = НепрочитанныеПоКомпаниям.Получить(
			Выборка.Компания);
		Если ДанныеНепрочитанных = Неопределено Тогда
			ИдентификаторыНепрочитанных = ПолучитьИдентификаторыНепрочитанныхЧатов(
				Выборка.Компания);
			ДанныеНепрочитанных = Новый Структура(
				"Идентификаторы",
				ИдентификаторыНепрочитанных);
			НепрочитанныеПоКомпаниям.Вставить(
				Выборка.Компания,
				ДанныеНепрочитанных);
		КонецЕсли;

		Смещение = 0;
		ПрочитаноСтраниц = 0;
		Пока Истина Цикл
			ПараметрыФильтра = Новый Структура;
			ПараметрыФильтра.Вставить(
				"accountId",
				Выборка.ИдентификаторУчетнойЗаписи);
			ПараметрыФильтра.Вставить("Offset", Смещение);
			ПараметрыФильтра.Вставить("Take", РазмерСтраницы);

			Ответ = EBC_КлиентАПИ.ПолучитьЧаты(
				Выборка.Компания,
				ПараметрыФильтра);
			Если Не Ответ.Успех
				Или ТипЗнч(Ответ.Данные) <> Тип("Массив") Тогда
				КоличествоОшибок = КоличествоОшибок + 1;
				ЗаписатьОшибкуЗагрузкиЧатов(
					Выборка.НаименованиеКомпании,
					Выборка.ИдентификаторУчетнойЗаписи,
					Ответ.Ошибка);
				Прервать;
			КонецЕсли;

			Попытка
				Количество = Количество + СинхронизироватьДанныеЧатов(
					Выборка.Компания,
					Ответ.Данные,
					ГраницаПериода,
					ДанныеНепрочитанных.Идентификаторы);
			Исключение
				КоличествоОшибок = КоличествоОшибок + 1;
				ЗаписатьОшибкуЗагрузкиЧатов(
					Выборка.НаименованиеКомпании,
					Выборка.ИдентификаторУчетнойЗаписи,
					КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				Прервать;
			КонецПопытки;

			Если Ответ.Данные.Количество() < РазмерСтраницы Тогда
				Прервать;
			КонецЕсли;

			ПрочитаноСтраниц = ПрочитаноСтраниц + 1;
			Если МаксимумСтраниц > 0
				И ПрочитаноСтраниц >= МаксимумСтраниц Тогда
				Прервать;
			КонецЕсли;

			Смещение = Смещение + РазмерСтраницы;
		КонецЦикла;
	КонецЦикла;

	ТекстОшибки = "";
	Если КоличествоОшибок > 0 Тогда
		ТекстОшибки = СтрШаблон(
			НСтр(
				"ru = 'Ошибок загрузки: %1';
				|uk = 'Помилок завантаження: %1'"),
			КоличествоОшибок);
	КонецЕсли;

	Возврат РезультатЗагрузки(
		КоличествоОшибок = 0,
		ТекстОшибки,
		Количество,
		КоличествоУчетныхЗаписей,
		КоличествоОшибок);

КонецФункции

// Удаляет устаревшие записи технического журнала.
//
// Регистр EBC_Лог периодический с периодичностью "День", поэтому сутки
// удаляются одной операцией: отбор набора записей по периоду плюс запись
// пустого набора. Поштучное удаление записей не требуется.
//
Процедура ВыполнитьРотациюЛогов() Экспорт

	ГлубинаХранения = ГлобальнаяГлубинаХраненияЛогов();
	Если ГлубинаХранения <= 0 Тогда
		Возврат;
	КонецЕсли;

	НачалоРотации = ТекущаяДатаДанных();
	ГраницаОчистки = НачалоДня(НачалоРотации) - (ГлубинаХранения * 86400);

	УдаленоПоСроку = УдалитьУстаревшиеДниЛога(ГраницаОчистки);
	УдаленоПоОбъему = ОбрезатьЛогПоКоличеству(
		МаксимальноеКоличествоЗаписейЛога());

	ЗаписьЖурналаРегистрации(
		"EBC_Ядро.РотацияЛогов",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		СтрШаблон(
			"Удалено записей по сроку: %1, по объёму: %2."
				+ " Глубина хранения, дней: %3. Длительность, сек.: %4.",
			УдаленоПоСроку,
			УдаленоПоОбъему,
			ГлубинаХранения,
			ТекущаяДатаДанных() - НачалоРотации));

КонецПроцедуры

// Преобразует строковое имя метаданных и уникальный идентификатор в ссылку 1С.
Функция ПолучитьСсылкуПоИдентификатору(
		Знач ИмяТаблицы,
		Знач ГУИД) Экспорт

	ЧастиИмени = СтрРазделить(ИмяТаблицы, ".");
	Если ЧастиИмени.Количество() < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;

	КлассМетаданных = ЧастиИмени[0];
	ИмяОбъекта = ЧастиИмени[1];

	Если ВРег(КлассМетаданных) = "СПРАВОЧНИК" Тогда
		Менеджер = Справочники[ИмяОбъекта];
	ИначеЕсли ВРег(КлассМетаданных) = "ДОКУМЕНТ" Тогда
		Менеджер = Документы[ИмяОбъекта];
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(ГУИД) = Тип("Строка") Тогда
		Попытка
			УИД = Новый УникальныйИдентификатор(ГУИД);
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	Иначе
		УИД = ГУИД;
	КонецЕсли;

	Ссылка = Менеджер.ПолучитьСсылку(УИД);
	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ Ссылка ИЗ %1 ГДЕ Ссылка = &Ссылка",
		ИмяТаблицы);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Ссылка;

КонецФункции

// Возвращает полное имя метаданных таблицы по переданной ссылке.
Функция ИмяТаблицыПоСсылке(Знач Ссылка) Экспорт

	Если Ссылка = Неопределено Или Ссылка.Пустая() Тогда
		Возврат "";
	КонецЕсли;

	МетаданныеСсылки = Ссылка.Метаданные();
	Возврат МетаданныеСсылки.ПолноеИмя();

КонецФункции

// Возвращает часовой пояс, в котором расширение хранит даты чатов и сообщений.
//
// Приоритет: часовой пояс области данных основной конфигурации, затем часовой
// пояс сеанса. Единый источник нужен потому, что даты приходят двумя путями -
// из API (UTC) и из push-уведомлений (время сеанса), и обе шкалы должны совпасть.
//
Функция ЧасовойПоясДанных() Экспорт
	Возврат EBC_НастройкиПовтИсп.ЧасовойПоясДанных();
КонецФункции

// Текущий момент в часовом поясе данных.
// Используется вместо ТекущаяДатаСеанса() везде, где дата сопоставляется
// с датами чатов и сообщений.
//
Функция ТекущаяДатаДанных() Экспорт
	Возврат МестноеВремя(ТекущаяУниверсальнаяДата(), ЧасовойПоясДанных());
КонецФункции

Функция НормализоватьТелефон(Знач Телефон) Экспорт

	ТолькоЦифры = "";
	Для Индекс = 1 По СтрДлина(Телефон) Цикл
		Символ = Сред(Телефон, Индекс, 1);
		Если Найти("0123456789", Символ) > 0 Тогда
			ТолькоЦифры = ТолькоЦифры + Символ;
		КонецЕсли;
	КонецЦикла;

	Если СтрДлина(ТолькоЦифры) = 10 И Лев(ТолькоЦифры, 1) = "0" Тогда
		ТолькоЦифры = "38" + ТолькоЦифры;
	ИначеЕсли СтрДлина(ТолькоЦифры) = 11 И Лев(ТолькоЦифры, 1) = "8" Тогда
		ТолькоЦифры = "3" + ТолькоЦифры;
	КонецЕсли;

	Возврат ТолькоЦифры;

КонецФункции

Функция НормализоватьЭлПочту(Знач ЭлПочта) Экспорт

	Результат = НРег(СокрЛП(ЭлПочта));
	ПозицияСобаки = Найти(Результат, "@");
	Если ПозицияСобаки <= 1 Или ПозицияСобаки = СтрДлина(Результат) Тогда
		Возврат "";
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьОшибкуИзмененияСвязи(
		Знач ИмяСобытия, Знач Чат, Знач ТипОбъекта, Знач ИдентификаторОбъекта,
		Знач Объект, Знач ИнформацияОбОшибкеСвязи)

	Событие = EBC_Логирование.НовоеСобытиеДействияПользователя(ИмяСобытия);
	Событие.РезультатДействия = "Ошибка";
	Событие.Уровень = Перечисления.EBC_УровниЖурнала.Ошибка;
	Событие.ТекстОшибки = Лев(КраткоеПредставлениеОшибки(ИнформацияОбОшибкеСвязи), 1024);
	EBC_Логирование.ЗаполнитьДанныеЧата(Событие, Чат);
	Описание = ОписаниеОбъектаСвязи(Объект);
	ДанныеОбъекта = Новый Структура(
		"ТипОбъекта,ИдентификаторОбъекта,ПредставлениеОбъекта,НавигационнаяСсылка",
		ТипОбъекта, ИдентификаторОбъекта, Описание.ПредставлениеОбъекта,
		Описание.НавигационнаяСсылка);
	EBC_Логирование.ЗаполнитьДанныеОбъекта(Событие, ДанныеОбъекта);
	EBC_Логирование.Записать(Событие);

КонецПроцедуры

// Дописывает в результат чаты связей объекта: основная связь первой, дальше
// по убыванию даты привязки.
Процедура ДобавитьЧатыСвязей(Результат, Отобранные, Знач Объект, Знач ЧатКонтрагента)

	ИмяТаблицы = ИмяТаблицыПоСсылке(Объект);
	Если ПустаяСтрока(ИмяТаблицы) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Связи.Чат КАК Чат,
		|	Связи.ОсновнаяСвязь КАК ОсновнаяСвязь
		|ИЗ
		|	РегистрСведений.EBC_СвязиОбъектов КАК Связи
		|ГДЕ
		|	Связи.ТипОбъекта = &ТипОбъекта
		|	И Связи.ИдентификаторОбъекта = &ИдентификаторОбъекта
		|	И НЕ Связи.Чат.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Связи.ОсновнаяСвязь УБЫВ,
		|	Связи.ДатаУстановки УБЫВ";
	Запрос.УстановитьПараметр("ТипОбъекта", ИмяТаблицы);
	Запрос.УстановитьПараметр(
		"ИдентификаторОбъекта",
		Объект.УникальныйИдентификатор());

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// Один и тот же чат бывает привязан и к документу, и к его контрагенту.
		Если Отобранные.Получить(Выборка.Чат) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Отобранные.Вставить(Выборка.Чат, Истина);

		Результат.Добавить(Новый Структура(
			"Чат,ОсновнаяСвязь,ЧатКонтрагента",
			Выборка.Чат,
			Выборка.ОсновнаяСвязь,
			ЧатКонтрагента));
	КонецЦикла;

КонецПроцедуры

// Есть ли у объекта связи с другими чатами, кроме переданного.
Функция НетДругихСвязей(Знач СуществующиеСвязи, Знач Чат)

	Для Каждого Строка Из СуществующиеСвязи Цикл
		Если Строка.Чат <> Чат Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Снимает признак основной связи со всех связей объекта, кроме переданного чата.
Процедура СнятьПризнакОсновнойСвязи(
		НаборСвязей,
		Знач Чат,
		Знач Объект)

	Для Каждого Запись Из НаборСвязей Цикл
		Если Запись.Чат = Чат Или Не Запись.ОсновнаяСвязь Тогда
			Продолжить;
		КонецЕсли;

		Запись.ОсновнаяСвязь = Ложь;
		// Запись всё равно перезаписывается, поэтому заодно актуализируется
		// описание того же самого объекта.
		ЗаполнитьОписаниеОбъектаСвязи(Запись, Объект);
	КонецЦикла;

КонецПроцедуры

// Заполняет справочные реквизиты связи - представление объекта и навигационную
// ссылку на него. Они нужны потребителям, которые показывают связь, не обращаясь
// к самому объекту: список связей и меню действий чата в компоненте
// (EBC_ЧатВызовСервера.ДействиеПросмотраОбъекта).
//
// Если прав на просмотр объекта нет, ранее записанное описание не затирается,
// а сама связь всё равно записывается: она однозначно описывается парой
// ТипОбъекта + ИдентификаторОбъекта.
//
Процедура ЗаполнитьОписаниеОбъектаСвязи(Запись, Знач Объект)

	Описание = ОписаниеОбъектаСвязи(Объект);
	Если Не Описание.Определено Тогда
		Возврат;
	КонецЕсли;

	Запись.ПредставлениеОбъекта = Описание.ПредставлениеОбъекта;
	Запись.НавигационнаяСсылка = Описание.НавигационнаяСсылка;

КонецПроцедуры

// Ключ объекта связи для сопоставлений: тип метаданных плюс идентификатор.
Функция КлючСвязиОбъекта(Знач ТипОбъекта, Знач ИдентификаторОбъекта)
	Возврат СокрЛП(Строка(ТипОбъекта)) + "|" + СокрЛП(Строка(ИдентификаторОбъекта));
КонецФункции

// Предельная длина реквизита EBC_СвязиОбъектов.ПредставлениеОбъекта.
Функция МаксимальнаяДлинаПредставленияОбъекта()
	Возврат 250;
КонецФункции

// Предельная длина реквизита EBC_СвязиОбъектов.НавигационнаяСсылка.
Функция МаксимальнаяДлинаНавигационнойСсылки()
	Возврат 1000;
КонецФункции

Функция ПолучитьИдентификаторыНепрочитанныхЧатов(Знач Компания)

	ИдентификаторКомпании = СокрЛП(Строка(
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Компания, "ИдентификаторEBC")));
	Если ПустаяСтрока(ИдентификаторКомпании) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Соответствие;
	РазмерСтраницы = 100;
	Смещение = 0;
	Пока Истина Цикл
		ПараметрыФильтра = Новый Структура;
		ПараметрыФильтра.Вставить("Unread", Истина);
		ПараметрыФильтра.Вставить("Offset", Смещение);
		ПараметрыФильтра.Вставить("Take", РазмерСтраницы);
		Ответ = EBC_КлиентАПИ.ПолучитьЧаты(Компания, ПараметрыФильтра);
		Если Не Ответ.Успех Тогда
			ЗаписатьОшибкуЗагрузкиНепрочитанныхЧатов(
				Компания,
				Ответ);
			Возврат Неопределено;
		КонецЕсли;
		Если ТипЗнч(Ответ.Данные) <> Тип("Массив") Тогда
			ЗаписатьОшибкуЗагрузкиНепрочитанныхЧатов(
				Компания,
				Ответ,
				"Некорректный формат ответа: ожидался массив чатов.");
			Возврат Неопределено;
		КонецЕсли;

		Для Каждого ДанныеЧата Из Ответ.Данные Цикл
			Если ТипЗнч(ДанныеЧата) <> Тип("Структура") Тогда
				Продолжить;
			КонецЕсли;
			ИдентификаторУчетнойЗаписи = СокрЛП(Строка(
				ЗначениеСвойства(ДанныеЧата, "accountId", "")));
			ИдентификаторЧата = СокрЛП(Строка(ЗначениеСвойства(ДанныеЧата, "id", "")));
			Если ПустаяСтрока(ИдентификаторУчетнойЗаписи)
				Или ПустаяСтрока(ИдентификаторЧата) Тогда
				Продолжить;
			КонецЕсли;
			Результат.Вставить(
				СоставнойИдентификаторЧата(
					ИдентификаторКомпании,
					ИдентификаторУчетнойЗаписи,
					ИдентификаторЧата),
				Истина);
		КонецЦикла;

		Если Ответ.Данные.Количество() < РазмерСтраницы Тогда
			Прервать;
		КонецЕсли;
		Смещение = Смещение + РазмерСтраницы;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СоставнойИдентификаторЧата(
		Знач ИдентификаторКомпании,
		Знач ИдентификаторУчетнойЗаписи,
		Знач ИдентификаторЧата)

	Возврат СтрШаблон(
		"%1#%2#%3",
		СокрЛП(Строка(ИдентификаторКомпании)),
		СокрЛП(Строка(ИдентификаторУчетнойЗаписи)),
		СокрЛП(Строка(ИдентификаторЧата)));

КонецФункции

Функция СинхронизироватьДанныеЧатов(
		Знач Компания,
		Знач ДанныеЧатов,
		Знач ГраницаПериода = Неопределено,
		Знач ИдентификаторыНепрочитанных = Неопределено)

	ИдентификаторКомпании = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		Компания,
		"ИдентификаторEBC");
	Если ПустаяСтрока(ИдентификаторКомпании) Тогда
		Возврат 0;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| УчетныеЗаписи.Ссылка КАК Ссылка,
		| УчетныеЗаписи.ИдентификаторEBC КАК ИдентификаторEBC,
		| УчетныеЗаписи.Провайдер КАК Провайдер
		|ИЗ
		| Справочник.EBC_УчетныеЗаписи КАК УчетныеЗаписи
		|ГДЕ
		| УчетныеЗаписи.Владелец = &Компания
		| И УчетныеЗаписи.Активна
		| И НЕ УчетныеЗаписи.Игнорировать";
	Запрос.УстановитьПараметр("Компания", Компания);

	ДанныеУчетныхЗаписей = Новый Соответствие;
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ДанныеУчетныхЗаписей.Вставить(
			Выборка.ИдентификаторEBC,
			Новый Структура(
				"Ссылка,Провайдер",
				Выборка.Ссылка,
				Выборка.Провайдер));
	КонецЦикла;

	ДанныеПоИдентификатору = Новый Соответствие;
	СоставныеИдентификаторы = Новый Массив;
	МоментСинхронизации = ТекущаяДатаДанных();
	Для Каждого ДанныеЧата Из ДанныеЧатов Цикл
		Если ТипЗнч(ДанныеЧата) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		ИдентификаторУчетнойЗаписи = ЗначениеСвойства(
			ДанныеЧата,
			"accountId",
			"");
		ИдентификаторЧата = ЗначениеСвойства(
			ДанныеЧата,
			"id",
			"");
		Если ПустаяСтрока(Строка(ИдентификаторУчетнойЗаписи))
			Или ПустаяСтрока(Строка(ИдентификаторЧата)) Тогда
			Продолжить;
		КонецЕсли;

		ДатаОбновления = ДатаИзUnixМиллисекунд(
			ЗначениеСвойства(
				ДанныеЧата,
				"lastUpdated"));
		Если ГраницаПериода <> Неопределено
			И (ДатаОбновления = Неопределено
				Или ДатаОбновления < ГраницаПериода
				Или ДатаОбновления > МоментСинхронизации) Тогда
			Продолжить;
		КонецЕсли;

		ДанныеУчетнойЗаписи = ДанныеУчетныхЗаписей.Получить(
			ИдентификаторУчетнойЗаписи);
		Если ДанныеУчетнойЗаписи = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УчетнаяЗапись = ДанныеУчетнойЗаписи.Ссылка;

		ТипЧата = ТипЧатаИзAPI(
			ЗначениеСвойства(
				ДанныеЧата,
				"chatType"));
		Контакт = Неопределено;
		Если ТипЧата = Перечисления.EBC_ТипыЧатов.Личный Тогда
			Контакт = ПолучитьКонтактЛичногоЧата(
				ДанныеУчетнойЗаписи.Провайдер,
				ИдентификаторКомпании,
				ИдентификаторУчетнойЗаписи,
				ДанныеЧата);
		КонецЕсли;

		СоставнойИдентификатор = СоставнойИдентификаторЧата(
			ИдентификаторКомпании,
			ИдентификаторУчетнойЗаписи,
			ИдентификаторЧата);
		СоставныеИдентификаторы.Добавить(
			СоставнойИдентификатор);
		ДанныеПоИдентификатору.Вставить(
			СоставнойИдентификатор,
			Новый Структура(
				"ДанныеЧата,УчетнаяЗапись,Провайдер,ИдентификаторУчетнойЗаписи,ДатаОбновления,ТипЧата,Контакт",
				ДанныеЧата,
				УчетнаяЗапись,
				ДанныеУчетнойЗаписи.Провайдер,
				ИдентификаторУчетнойЗаписи,
				ДатаОбновления,
				ТипЧата,
				Контакт));
	КонецЦикла;

	Если СоставныеИдентификаторы.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Чаты = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| Чаты.Ссылка КАК Ссылка,
		| Чаты.СоставнойИдентификатор КАК СоставнойИдентификатор
		|ИЗ
		| Справочник.EBC_Чаты КАК Чаты
		|ГДЕ
		| Чаты.СоставнойИдентификатор В (&СоставныеИдентификаторы)";
	Запрос.УстановитьПараметр(
		"СоставныеИдентификаторы",
		СоставныеИдентификаторы);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Чаты.Вставить(
			Выборка.СоставнойИдентификатор,
			Выборка.Ссылка);
	КонецЦикла;

	Количество = 0;

	// Чаты пишутся порциями в транзакции: по одному это столько же транзакций,
	// сколько чатов на странице, а одной транзакцией на всю страницу платить
	// пришлось бы полным откатом из-за единственной проблемной записи.
	РазмерПорции = РазмерПорцииЗаписиЧатов();
	ЗаписаноВПорции = 0;
	ПорцияОткрыта = Ложь;

	Для Каждого КлючИЗначение Из ДанныеПоИдентификатору Цикл
		Если Не ПорцияОткрыта Тогда
			НачатьТранзакцию();
			ПорцияОткрыта = Истина;
			ЗаписаноВПорции = 0;
		КонецЕсли;

		СоставнойИдентификатор = КлючИЗначение.Ключ;
		ДанныеСинхронизации = КлючИЗначение.Значение;
		ДанныеЧата = ДанныеСинхронизации.ДанныеЧата;
		УчетнаяЗапись = ДанныеСинхронизации.УчетнаяЗапись;
		ЧатСсылка = Чаты.Получить(СоставнойИдентификатор);

		Если ЧатСсылка = Неопределено Тогда
			ЧатОбъект = Справочники.EBC_Чаты.СоздатьЭлемент();
		Иначе
			ЧатОбъект = ЧатСсылка.ПолучитьОбъект();
		КонецЕсли;

		ЧатОбъект.Владелец = УчетнаяЗапись;
		ЧатОбъект.СоставнойИдентификатор = СоставнойИдентификатор;
		ЧатОбъект.ДополнительныеСвойства.Вставить(
			"EBC_СоставнойКлючПодготовлен",
			Истина);
		ЧатОбъект.ИдентификаторEBC = Строка(
			ЗначениеСвойства(
				ДанныеЧата,
				"id",
				""));
		НаименованиеЧата = ТекстСообщенияИзДанныхAPI(
			ЗначениеСвойства(ДанныеЧата, "title", ""));
		Если ПустаяСтрока(НаименованиеЧата) Тогда
			НаименованиеЧата = "Чат " + ЧатОбъект.ИдентификаторEBC;
		КонецЕсли;
		ЧатОбъект.Наименование = Лев(НаименованиеЧата, 150);
		ТипЧата = ДанныеСинхронизации.ТипЧата;
		ЗаполнитьКонтактныеДанныеЧата(
			ЧатОбъект,
			ДанныеЧата,
			ДанныеСинхронизации.Контакт);
		ЗаполнитьИмяПользователяЧата(
			ЧатОбъект,
			ДанныеЧата,
			ДанныеСинхронизации.Контакт);
		ЧатОбъект.ТекстПоследнегоСообщения = ДополнитьТекстПоследнихСообщений(
			ЧатОбъект.ТекстПоследнегоСообщения,
			ТекстСообщенияИзДанныхAPI(
				ЗначениеСвойства(ДанныеЧата, "lastMessageText", "")));

		Если ДанныеСинхронизации.ДатаОбновления <> Неопределено Тогда
			ЧатОбъект.ДатаПоследнегоСообщения =
				ДанныеСинхронизации.ДатаОбновления;
		КонецЕсли;

		Если ЗначениеЗаполнено(ТипЧата) Тогда
			ЧатОбъект.ТипЧата = ТипЧата;
		КонецЕсли;

		НавигационнаяСсылка = СформироватьНавигационнуюСсылкуЧата(
			ИдентификаторКомпании,
			ДанныеСинхронизации.Провайдер,
			ДанныеСинхронизации.ИдентификаторУчетнойЗаписи,
			ЧатОбъект.ИдентификаторEBC);
		Если Не ПустаяСтрока(НавигационнаяСсылка) Тогда
			ЧатОбъект.НавигационнаяСсылка = Лев(НавигационнаяСсылка, 1000);
		КонецЕсли;
		Если ИдентификаторыНепрочитанных <> Неопределено Тогда
			ЧатОбъект.ЕстьНепрочитанные =
				ИдентификаторыНепрочитанных.Получить(СоставнойИдентификатор) = Истина;
		КонецЕсли;

		ЧатОбъект.Активен = Истина;
		ЧатОбъект.ДатаСинхронизации =
			МоментСинхронизации;

		Попытка
			ЧатОбъект.Записать();
		Исключение
			// Порция откатывается целиком, ранее зафиксированные - остаются.
			ОтменитьТранзакцию();
			ПорцияОткрыта = Ложь;
			ВызватьИсключение;
		КонецПопытки;

		Количество = Количество + 1;
		ЗаписаноВПорции = ЗаписаноВПорции + 1;

		Если ЗаписаноВПорции >= РазмерПорции Тогда
			ЗафиксироватьТранзакцию();
			ПорцияОткрыта = Ложь;
		КонецЕсли;
	КонецЦикла;

	Если ПорцияОткрыта Тогда
		ЗафиксироватьТранзакцию();
	КонецЕсли;

	Возврат Количество;

КонецФункции

Процедура ЗаполнитьКонтактныеДанныеЧата(
		ЧатОбъект,
		Знач ДанныеЧата,
		Знач Контакт)

	ТелефонАПИ = ЗначениеСвойства(
		ДанныеЧата,
		"phoneNumber",
		Неопределено);
	Если ТелефонАПИ <> Неопределено Тогда
		Телефон = НормализоватьТелефон(Строка(ТелефонАПИ));
		Если Не ПустаяСтрока(Телефон) Тогда
			ЧатОбъект.Телефон = Лев(Телефон, 30);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Если Контакт <> Неопределено Тогда
		ТелефонКонтакта = НормализоватьТелефон(
			Строка(
				ЗначениеСвойства(
					Контакт,
					"phoneNumber",
					"")));
		Если Не ПустаяСтрока(ТелефонКонтакта) Тогда
			ЧатОбъект.Телефон = Лев(ТелефонКонтакта, 30);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьИмяПользователяЧата(ЧатОбъект, Знач ДанныеЧата, Знач Контакт)

	ИмяПользователя = СокрЛП(Строка(ЗначениеСвойства(ДанныеЧата, "userName", "")));
	Если ПустаяСтрока(ИмяПользователя)
		И Контакт <> Неопределено Тогда
		ИмяПользователя = СокрЛП(Строка(ЗначениеСвойства(Контакт, "userName", "")));
	КонецЕсли;
	Если Не ПустаяСтрока(ИмяПользователя) Тогда
		ЧатОбъект.ИмяПользователя = Лев(ИмяПользователя, 150);
	КонецЕсли;

КонецПроцедуры

Функция СформироватьНавигационнуюСсылкуЧата(
		Знач ИдентификаторКомпании,
		Знач Провайдер,
		Знач ИдентификаторУчетнойЗаписи,
		Знач ИдентификаторЧата)

	ИдентификаторКомпании = СокрЛП(Строка(ИдентификаторКомпании));
	ИдентификаторУчетнойЗаписи = СокрЛП(Строка(ИдентификаторУчетнойЗаписи));
	ИдентификаторЧата = СокрЛП(Строка(ИдентификаторЧата));
	Если ПустаяСтрока(ИдентификаторКомпании)
		Или ПустаяСтрока(ИдентификаторУчетнойЗаписи)
		Или ПустаяСтрока(ИдентификаторЧата) Тогда
		Возврат "";
	КонецЕсли;

	Если ЗначениеЗаполнено(Провайдер) Тогда
		ИмяПровайдера = НРег(XMLСтрока(Провайдер));
	Иначе
		ИмяПровайдера = "";
	КонецЕсли;
	Возврат "#companyId=" + КодироватьСтрокуДляURL(ИдентификаторКомпании)
		+ "&provider=" + КодироватьСтрокуДляURL(ИмяПровайдера)
		+ "&accountId=" + КодироватьСтрокуДляURL(ИдентификаторУчетнойЗаписи)
		+ "&chatId=" + КодироватьСтрокуДляURL(ИдентификаторЧата);

КонецФункции

Функция КодироватьСтрокуДляURL(Знач Значение)

	Возврат КодироватьСтроку(Строка(Значение), СпособКодированияСтроки.КодировкаURL);

КонецФункции

Функция ПолучитьКонтактЛичногоЧата(
		Знач Провайдер,
		Знач ИдентификаторКомпании,
		Знач ИдентификаторУчетнойЗаписи,
		Знач ДанныеЧата)

	ИдентификаторЧата = СокрЛП(
		Строка(
			ЗначениеСвойства(
				ДанныеЧата,
				"id",
				"")));
	Если ПустаяСтрока(ИдентификаторЧата) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Ответ = EBC_КлиентАПИ.ПолучитьУчастниковЧата(
		Провайдер,
		ИдентификаторКомпании,
		ИдентификаторУчетнойЗаписи,
		ИдентификаторЧата);
	Если Не Ответ.Успех
		Или ТипЗнч(Ответ.Данные) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Участники = Новый Массив;
	Для Каждого Участник Из Ответ.Данные Цикл
		Если ТипЗнч(Участник) = Тип("Структура") Тогда
			Участники.Добавить(Участник);
		КонецЕсли;
	КонецЦикла;

	ИмяПользователяЧата = НРег(СокрЛП(
		Строка(
			ЗначениеСвойства(
				ДанныеЧата,
				"userName",
				""))));
	КоличествоСовпаденийПоИмени = 0;
	Если Не ПустаяСтрока(ИмяПользователяЧата) Тогда
		Совпадения = Новый Массив;
		Для Каждого Участник Из Участники Цикл
			ИмяПользователяУчастника = НРег(СокрЛП(
				Строка(
					ЗначениеСвойства(
						Участник,
						"userName",
						""))));
			Если ИмяПользователяУчастника = ИмяПользователяЧата Тогда
				Совпадения.Добавить(Участник);
			КонецЕсли;
		КонецЦикла;
		Если Совпадения.Количество() = 1 Тогда
			Возврат Совпадения[0];
		ИначеЕсли Совпадения.Количество() > 1 Тогда
			КоличествоСовпаденийПоИмени = Совпадения.Количество();
		КонецЕсли;
	КонецЕсли;

	Совпадения = Новый Массив;
	Для Каждого Участник Из Участники Цикл
		ИдентификаторУчастника = СокрЛП(
			Строка(
				ЗначениеСвойства(
					Участник,
					"id",
					"")));
		Если ИдентификаторУчастника = ИдентификаторЧата Тогда
			Совпадения.Добавить(Участник);
		КонецЕсли;
	КонецЦикла;
	Если Совпадения.Количество() = 1 Тогда
		Возврат Совпадения[0];
	ИначеЕсли Совпадения.Количество() > 1 Тогда
		ЗаписатьНеоднозначностьУчастниковЧата(
			"id",
			Совпадения.Количество());
		Возврат Неопределено;
	КонецЕсли;
	Если КоличествоСовпаденийПоИмени > 1 Тогда
		ЗаписатьНеоднозначностьУчастниковЧата(
			"userName",
			КоличествоСовпаденийПоИмени);
		Возврат Неопределено;
	КонецЕсли;

	Если Участники.Количество() = 1 Тогда
		Возврат Участники[0];
	КонецЕсли;
	Если Участники.Количество() > 1 Тогда
		ЗаписатьНеоднозначностьУчастниковЧата(
			"единственный участник",
			Участники.Количество());
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Процедура ЗаписатьНеоднозначностьУчастниковЧата(
		Знач Критерий,
		Знач КоличествоКандидатов)

	ЗаписьЖурналаРегистрации(
		"EBC_Ядро.СинхронизацияЧатов.Участники",
		УровеньЖурналаРегистрации.Предупреждение,
		Справочники.EBC_Чаты.ПустаяСсылка().Метаданные(),
		,
		СтрШаблон(
			"Не удалось однозначно выбрать контакт чата. Критерий: %1, кандидатов: %2.",
			Критерий,
			КоличествоКандидатов));

КонецПроцедуры

Функция ЗначениеСвойства(
		Знач Данные,
		Знач ИмяСвойства,
		Знач ЗначениеПоУмолчанию = Неопределено)

	Значение = Неопределено;
	Если Данные <> Неопределено
		И Данные.Свойство(
			ИмяСвойства,
			Значение)
		И Значение <> Неопределено Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

Функция ДатаИзUnixМиллисекунд(Знач Значение)

	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Миллисекунды = Число(Значение);
		Если Миллисекунды <= 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		// API отдаёт Unix-метку в UTC, а хранить нужно местное время:
		// с ним же сравниваются даты, записанные push-уведомлениями.
		Возврат МестноеВремя(
			Дата(1970, 1, 1) + Цел(Миллисекунды / 1000),
			ЧасовойПоясДанных());
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция ТипЧатаИзAPI(Знач Значение)

	Если Значение = Неопределено Тогда
		Возврат Перечисления.EBC_ТипыЧатов.ПустаяСсылка();
	КонецЕсли;

	ИмяТипа = Строка(Значение);
	ПозицияРазделителя = Найти(ИмяТипа, " = ");
	Если ПозицияРазделителя > 0 Тогда
		ИмяТипа = Лев(
			ИмяТипа,
			ПозицияРазделителя - 1);
	КонецЕсли;

	// Имена значений перечисления русские, имена ChatType в API английские,
	// поэтому соответствие задаётся явно.
	ИмяТипа = ВРег(СокрЛП(ИмяТипа));
	Если ИмяТипа = "USER" Тогда
		Возврат Перечисления.EBC_ТипыЧатов.Личный;
	ИначеЕсли ИмяТипа = "GROUP" Тогда
		Возврат Перечисления.EBC_ТипыЧатов.Группа;
	ИначеЕсли ИмяТипа = "CHANNEL" Тогда
		Возврат Перечисления.EBC_ТипыЧатов.Канал;
	ИначеЕсли ИмяТипа = "BOT" Тогда
		Возврат Перечисления.EBC_ТипыЧатов.Бот;
	ИначеЕсли ИмяТипа = "POST" Тогда
		Возврат Перечисления.EBC_ТипыЧатов.Пост;
	КонецЕсли;

	Возврат Перечисления.EBC_ТипыЧатов.ПустаяСсылка();

КонецФункции

// Результат массовой загрузки из API.
//
// Поля КоличествоИсточников и КоличествоОшибок позволяют отличить полный отказ
// от частичного: если из десяти учётных записей ответила девять, работа
// сделана, и регламентное задание не должно падать с ошибкой (иначе один
// постоянно недоступный источник держал бы задание "красным" всегда).
//
// Параметры:
//  Успех                - Булево - ни одной ошибки.
//  Ошибка               - Строка - текст для пользователя.
//  Количество           - Число  - сколько объектов записано.
//  КоличествоИсточников - Число  - сколько источников (учётных записей,
//                         компаний) обработано; 0 означает, что до загрузки
//                         дело не дошло.
//  КоличествоОшибок     - Число  - сколько источников ответило ошибкой.
//
Функция РезультатЗагрузки(
		Знач Успех,
		Знач Ошибка,
		Знач Количество,
		Знач КоличествоИсточников = 0,
		Знач КоличествоОшибок = 0)

	Возврат Новый Структура(
		"Успех,Ошибка,Количество,КоличествоИсточников,КоличествоОшибок",
		Успех,
		Ошибка,
		Количество,
		КоличествоИсточников,
		КоличествоОшибок);

КонецФункции

Процедура ЗаписатьОшибкуЗагрузкиЧатов(
		Знач НаименованиеКомпании,
		Знач ИдентификаторУчетнойЗаписи,
		Знач Ошибка)

	ЗаписьЖурналаРегистрации(
		"EBC_Ядро.ЗагрузитьЧатыЗаПериод",
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		СтрШаблон(
			"Компания %1, учётная запись %2: %3",
			НаименованиеКомпании,
			ИдентификаторУчетнойЗаписи,
			Ошибка));

КонецПроцедуры

Процедура ЗаписатьОшибкуЗагрузкиНепрочитанныхЧатов(
		Знач Компания,
		Знач Ответ,
		Знач ТекстДиагностики = "")

	СтатусКод = ЗначениеСвойства(Ответ, "СтатусКод", 0);
	КодОшибки = СокрЛП(Строка(ЗначениеСвойства(Ответ, "КодОшибки", "")));
	ТекстОшибки = СокрЛП(Строка(ЗначениеСвойства(Ответ, "ТекстОшибки", "")));
	Если ПустаяСтрока(КодОшибки) Тогда
		КодОшибки = "UnreadChatsLoadFailed";
	КонецЕсли;
	Если Не ПустаяСтрока(ТекстДиагностики) Тогда
		Если ПустаяСтрока(ТекстОшибки) Тогда
			ТекстОшибки = ТекстДиагностики;
		Иначе
			ТекстОшибки = ТекстДиагностики + " " + ТекстОшибки;
		КонецЕсли;
	КонецЕсли;
	Если ПустаяСтрока(ТекстОшибки) Тогда
		ТекстОшибки = "Не удалось получить список непрочитанных чатов.";
	КонецЕсли;

	EBC_КлиентАПИ.ЗаписатьДиагностику(
		Перечисления.EBC_УровниЖурнала.Ошибка,
		"GET /chats/v1/{consoleCompanyId}/chats",
		Компания,
		СтатусКод,
		КодОшибки,
		ТекстОшибки,
		"ЗагрузкаНепрочитанныхЧатов");

КонецПроцедуры

Процедура ЗаписатьОшибкуЗагрузкиПользователей(
		Знач НаименованиеКомпании,
		Знач Ошибка)

	ЗаписьЖурналаРегистрации(
		"EBC_Ядро.ЗагрузитьПользователей",
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		СтрШаблон(
			"Компания %1: %2",
			НаименованиеКомпании,
			Ошибка));

КонецПроцедуры

Процедура ДобавитьДанныеПользователей(
		ПользователиПоИдентификатору,
		Знач Компания,
		Знач ДанныеПользователей)

	Для Каждого ДанныеПользователя Из ДанныеПользователей Цикл
		Если ТипЗнч(ДанныеПользователя) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		Идентификатор = СокрЛП(Строка(ЗначениеСвойства(
			ДанныеПользователя,
			"id",
			"")));
		Если ПустаяСтрока(Идентификатор) Тогда
			Продолжить;
		КонецЕсли;

		ДанныеПользователяСинхронизации = ПользователиПоИдентификатору.Получить(
			Идентификатор);
		Если ДанныеПользователяСинхронизации = Неопределено Тогда
			ДанныеПользователяСинхронизации = Новый Структура(
				"Данные,Компании",
				ДанныеПользователя,
				Новый Массив);
			ПользователиПоИдентификатору.Вставить(
				Идентификатор,
				ДанныеПользователяСинхронизации);
		КонецЕсли;

		ЕстьКомпания = Ложь;
		Для Каждого ДанныеКомпании Из ДанныеПользователяСинхронизации.Компании Цикл
			Если ДанныеКомпании.Компания = Компания Тогда
				ЕстьКомпания = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если Не ЕстьКомпания Тогда
			ДанныеПользователяСинхронизации.Компании.Добавить(
				Новый Структура("Компания", Компания));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ЗаписатьПользователей(Знач ПользователиПоИдентификатору)

	Идентификаторы = Новый Массив;
	Для Каждого КлючИЗначение Из ПользователиПоИдентификатору Цикл
		Идентификаторы.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;

	Если Идентификаторы.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	СуществующиеПользователи = ПолучитьСуществующихПользователей(
		Идентификаторы);
	Количество = 0;
	Для Каждого КлючИЗначение Из ПользователиПоИдентификатору Цикл
		Идентификатор = КлючИЗначение.Ключ;
		ДанныеПользователя = КлючИЗначение.Значение;
		СсылкаПользователя = СуществующиеПользователи.Получить(
			Идентификатор);

		Если СсылкаПользователя = Неопределено Тогда
			ПользовательОбъект = Справочники.EBC_Пользователи.СоздатьЭлемент();
		Иначе
			ПользовательОбъект = СсылкаПользователя.ПолучитьОбъект();
		КонецЕсли;

		Имя = СокрЛП(Строка(ЗначениеСвойства(
			ДанныеПользователя.Данные,
			"name",
			"")));
		ЭлПочта = СокрЛП(Строка(ЗначениеСвойства(
			ДанныеПользователя.Данные,
			"email",
			"")));
		Если ПустаяСтрока(Имя) Тогда
			Имя = ЭлПочта;
		КонецЕсли;
		Если ПустаяСтрока(Имя) Тогда
			Имя = Идентификатор;
		КонецЕсли;

		ПользовательОбъект.Наименование = Лев(Имя, 100);
		ПользовательОбъект.ИдентификаторEBC = Лев(Идентификатор, 64);
		ПользовательОбъект.ЭлПочта = Лев(ЭлПочта, 254);
		ЗаполнитьКомпанииПользователя(
			ПользовательОбъект,
			ДанныеПользователя.Компании);
		ПользовательОбъект.Записать();

		СуществующиеПользователи.Вставить(
			Идентификатор,
			ПользовательОбъект.Ссылка);
		Количество = Количество + 1;
	КонецЦикла;

	Возврат Количество;

КонецФункции

Функция ПолучитьСуществующихПользователей(Знач Идентификаторы)

	Результат = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| Пользователи.Ссылка КАК Ссылка,
		| Пользователи.ИдентификаторEBC КАК ИдентификаторEBC
		|ИЗ
		| Справочник.EBC_Пользователи КАК Пользователи
		|ГДЕ
		| Пользователи.ИдентификаторEBC В (&Идентификаторы)";
	Запрос.УстановитьПараметр(
		"Идентификаторы",
		Идентификаторы);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(
			Выборка.ИдентификаторEBC,
			Выборка.Ссылка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ЗаполнитьКомпанииПользователя(
		ПользовательОбъект,
		Знач КомпанииПользователя)

	СуществующиеКомпании = Новый Соответствие;
	Для Каждого СтрокаКомпании Из ПользовательОбъект.Компании Цикл
		Если Не ЗначениеЗаполнено(СтрокаКомпании.Компания) Тогда
			Продолжить;
		КонецЕсли;

		СуществующиеКомпании.Вставить(
			СтрокаКомпании.Компания,
			Новый Структура(
				"Роль,Активен",
				СтрокаКомпании.Роль,
				СтрокаКомпании.Активен));
	КонецЦикла;

	ПользовательОбъект.Компании.Очистить();
	Для Каждого ДанныеКомпании Из КомпанииПользователя Цикл
		Если Не ЗначениеЗаполнено(ДанныеКомпании.Компания) Тогда
			Продолжить;
		КонецЕсли;

		СтрокаКомпании = ПользовательОбъект.Компании.Добавить();
		СтрокаКомпании.Компания = ДанныеКомпании.Компания;
		СуществующаяКомпания = СуществующиеКомпании.Получить(
			ДанныеКомпании.Компания);
		Если СуществующаяКомпания = Неопределено Тогда
			СтрокаКомпании.Роль = Перечисления.EBC_РолиПользователей.Оператор;
			СтрокаКомпании.Активен = Истина;
		Иначе
			СтрокаКомпании.Роль = СуществующаяКомпания.Роль;
			СтрокаКомпании.Активен = СуществующаяКомпания.Активен;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ВыполнитьСинхронизациюСтруктурыКомпаний()

	ОтветКомпаний = EBC_КлиентАПИ.ПолучитьКомпании();
	Если Не ОтветКомпаний.Успех Тогда
		Возврат РезультатСинхронизацииСОшибкой(
			ОтветКомпаний.Ошибка);
	КонецЕсли;

	Если ОтветКомпаний.Данные = Неопределено
		Или ТипЗнч(ОтветКомпаний.Данные) <> Тип("Массив") Тогда
		Возврат РезультатСинхронизацииСОшибкой(
			НСтр(
				"ru = 'API вернул некорректный список компаний.';
				|uk = 'API повернув некоректний список компаній.'"));
	КонецЕсли;

	ДанныеКомпаний = ПодготовитьДанныеКомпаний(
		ОтветКомпаний.Данные);
	СинхронизированныеКомпании = Новый Массив;
	КомпанииПоИдентификатору = ЗаписатьКомпании(
		ДанныеКомпаний,
		СинхронизированныеКомпании);

	СсылкиКомпаний = Новый Массив;
	Для Каждого КлючИЗначение Из КомпанииПоИдентификатору Цикл
		СсылкиКомпаний.Добавить(КлючИЗначение.Значение);
	КонецЦикла;

	// Сначала получаем и проверяем полные снимки. Ошибка одной компании
	// не должна отключать учётные записи по частично полученным данным.
	Снимки = Новый Массив;
	ИменаПровайдеров = Новый Массив;
	Для Каждого ЗначениеПеречисления Из Метаданные.Перечисления.EBC_Провайдеры.ЗначенияПеречисления Цикл
		ИменаПровайдеров.Добавить(НРег(ЗначениеПеречисления.Имя));
	КонецЦикла;
	Для Каждого ДанныеКомпании Из ДанныеКомпаний Цикл
		Компания = КомпанииПоИдентификатору.Получить(ДанныеКомпании.Идентификатор);
		Если Компания = Неопределено Тогда Продолжить; КонецЕсли;
		ОтветПровайдеров = EBC_КлиентАПИ.ПолучитьПровайдеров(Компания);
		Если Не ОтветПровайдеров.Успех Тогда
			Возврат РезультатСинхронизацииСОшибкой(ОтветПровайдеров.Ошибка);
		КонецЕсли;
		ОшибкаСнимка = ПроверитьСнимокУчетныхЗаписей(ОтветПровайдеров.Данные, ИменаПровайдеров);
		Если Не ПустаяСтрока(ОшибкаСнимка) Тогда
			Возврат РезультатСинхронизацииСОшибкой(ОшибкаСнимка);
		КонецЕсли;
		Снимки.Добавить(Новый Структура("Компания,Данные", Компания, ОтветПровайдеров.Данные));
	КонецЦикла;

	СинхронизированныеУчетныеЗаписи = Новый Массив;
	КоличествоОтключенных = 0;
	НачатьТранзакцию();
	Попытка
		// Тот же ресурс блокируется в ПередЗаписью учётки. HTTP уже завершён.
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Справочник.EBC_Компании");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		УчетныеЗаписиПоКомпании = ПолучитьСуществующиеУчетныеЗаписи(СсылкиКомпаний);
		Для Каждого Снимок Из Снимки Цикл
			СуществующиеУчетныеЗаписи = УчетныеЗаписиПоКомпании.Получить(Снимок.Компания);
			ЗаписатьУчетныеЗаписиКомпании(Снимок.Компания, Снимок.Данные,
				СуществующиеУчетныеЗаписи, СинхронизированныеУчетныеЗаписи);
		КонецЦикла;
		Отсутствующие = ОтсутствующиеУчетныеЗаписи(УчетныеЗаписиПоКомпании, СинхронизированныеУчетныеЗаписи);
		Для Каждого УчетнаяЗапись Из Отсутствующие Цикл
			ОбъектУчетнойЗаписи = УчетнаяЗапись.ПолучитьОбъект();
			Если ОбъектУчетнойЗаписи.Активна Тогда
				ОбъектУчетнойЗаписи.Активна = Ложь;
				ОбъектУчетнойЗаписи.Записать();
				КоличествоОтключенных = КоличествоОтключенных + 1;
			КонецЕсли;
		КонецЦикла;
		МоментСинхронизации = ТекущаяДатаСеанса();
		ЗафиксироватьУспешнуюСинхронизацию(СинхронизированныеКомпании,
			СинхронизированныеУчетныеЗаписи, МоментСинхронизации);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Результат = НовыйРезультатСинхронизации();
	Результат.Успех = Истина;
	Результат.Вставить("КоличествоОтключенныхУчетныхЗаписей", КоличествоОтключенных);
	Результат.КоличествоКомпаний =
		СинхронизированныеКомпании.Количество();
	Результат.КоличествоУчетныхЗаписей =
		СинхронизированныеУчетныеЗаписи.Количество();
	Результат.Количество =
		Результат.КоличествоКомпаний
		+ Результат.КоличествоУчетныхЗаписей;

	Возврат Результат;

КонецФункции

Функция ПодготовитьДанныеКомпаний(Знач ДанныеАПИ)

	Результат = Новый Массив;
	Идентификаторы = Новый Соответствие;
	Для Каждого ДанныеКомпанииАПИ Из ДанныеАПИ Цикл
		Идентификатор = "";
		ДанныеКомпанииАПИ.Свойство(
			"id",
			Идентификатор);
		Идентификатор = СокрЛП(Строка(Идентификатор));
		Если ПустаяСтрока(Идентификатор)
			Или Идентификаторы.Получить(Идентификатор) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ИмяКомпании = "Company " + Идентификатор;
		ИмяКомпанииАПИ = Неопределено;
		Если ДанныеКомпанииАПИ.Свойство("name", ИмяКомпанииАПИ)
			И ИмяКомпанииАПИ <> Неопределено
			И Не ПустаяСтрока(СокрЛП(Строка(ИмяКомпанииАПИ))) Тогда
			ИмяКомпании = Строка(ИмяКомпанииАПИ);
		КонецЕсли;

		Результат.Добавить(Новый Структура(
			"Идентификатор,Наименование",
			Идентификатор,
			Лев(ИмяКомпании, 150)));
		Идентификаторы.Вставить(Идентификатор, Истина);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЗаписатьКомпании(
		Знач ДанныеКомпаний,
		СинхронизированныеКомпании)

	Идентификаторы = Новый Массив;
	Для Каждого ДанныеКомпании Из ДанныеКомпаний Цикл
		Идентификаторы.Добавить(ДанныеКомпании.Идентификатор);
	КонецЦикла;

	КомпанииПоИдентификатору = ПолучитьСуществующиеКомпании(
		Идентификаторы);
	Для Каждого ДанныеКомпании Из ДанныеКомпаний Цикл
		СсылкаКомпании = КомпанииПоИдентификатору.Получить(
			ДанныеКомпании.Идентификатор);
		Если СсылкаКомпании = Неопределено Тогда
			ОбъектКомпании = Справочники.EBC_Компании.СоздатьЭлемент();
			ОбъектКомпании.ИдентификаторEBC =
				ДанныеКомпании.Идентификатор;
		Иначе
			ОбъектКомпании = СсылкаКомпании.ПолучитьОбъект();
		КонецЕсли;

		ОбъектКомпании.Наименование = ДанныеКомпании.Наименование;
		ОбъектКомпании.Записать();
		СсылкаКомпании = ОбъектКомпании.Ссылка;
		КомпанииПоИдентификатору.Вставить(
			ДанныеКомпании.Идентификатор,
			СсылкаКомпании);
		СинхронизированныеКомпании.Добавить(СсылкаКомпании);
	КонецЦикла;

	Возврат КомпанииПоИдентификатору;

КонецФункции

Функция ПолучитьСуществующиеКомпании(Знач Идентификаторы)

	Результат = Новый Соответствие;
	Если Идентификаторы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| Компании.Ссылка КАК Ссылка,
		| Компании.ИдентификаторEBC КАК ИдентификаторEBC
		|ИЗ
		| Справочник.EBC_Компании КАК Компании
		|ГДЕ
		| Компании.ИдентификаторEBC В (&Идентификаторы)";
	Запрос.УстановитьПараметр(
		"Идентификаторы",
		Идентификаторы);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(
			Выборка.ИдентификаторEBC,
			Выборка.Ссылка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Компания является внешним ключом соответствия; внутри неё ключ включает
// провайдера и API id. identifier (телефон/имя канала) не определяет идентичность.
Функция КлючУчетнойЗаписи(Знач Провайдер, Знач Идентификатор)
	Возврат НРег(XMLСтрока(Провайдер)) + "|" + НРег(СокрЛП(Идентификатор));
КонецФункции

// Пустой массив — корректный полный снимок. null, пропущенные accounts,
// неизвестный провайдер и дубли — ошибка, а не сигнал отключить каналы.
Функция ПроверитьСнимокУчетныхЗаписей(Знач Данные, Знач ИменаПровайдеров, Знач Язык = "")
	ОшибкаСнимка = НСтр("ru = 'API вернул неполный или некорректный список учётных записей (проверьте провайдеры, ID и дубли). Состояние учётных записей сохранено. Повторите синхронизацию позже.';
		|uk = 'API повернув неповний або некоректний список облікових записів (перевірте провайдерів, ID та дублікати). Стан облікових записів збережено. Повторіть синхронізацію пізніше.'", Язык);
	Если ТипЗнч(Данные) <> Тип("Массив") Тогда Возврат ОшибкаСнимка; КонецЕсли;
	Провайдеры = Новый Соответствие;
	Ключи = Новый Соответствие;
	Для Каждого ДанныеПровайдера Из Данные Цикл
		Если ТипЗнч(ДанныеПровайдера) <> Тип("Структура") Тогда Возврат ОшибкаСнимка; КонецЕсли;
		Провайдер = Неопределено;
		ДанныеПровайдера.Свойство("provider", Провайдер);
		Если ТипЗнч(Провайдер) <> Тип("Строка") Тогда Возврат ОшибкаСнимка; КонецЕсли;
		Провайдер = НРег(СокрЛП(Провайдер));
		Если ИменаПровайдеров.Найти(Провайдер) = Неопределено
			Или Провайдеры.Получить(Провайдер) <> Неопределено Тогда Возврат ОшибкаСнимка; КонецЕсли;
		Провайдеры.Вставить(Провайдер, Истина);
		Аккаунты = Неопределено;
		ДанныеПровайдера.Свойство("accounts", Аккаунты);
		Если ТипЗнч(Аккаунты) <> Тип("Массив") Тогда Возврат ОшибкаСнимка; КонецЕсли;
		Для Каждого Аккаунт Из Аккаунты Цикл
			Если ТипЗнч(Аккаунт) <> Тип("Структура") Тогда Возврат ОшибкаСнимка; КонецЕсли;
			Идентификатор = Неопределено;
			Аккаунт.Свойство("id", Идентификатор);
			Если ТипЗнч(Идентификатор) <> Тип("Строка") Тогда Возврат ОшибкаСнимка; КонецЕсли;
			Если ПустаяСтрока(Идентификатор) Тогда Возврат ОшибкаСнимка; КонецЕсли;
			Ключ = КлючУчетнойЗаписи(Провайдер, Идентификатор);
			Если Ключи.Получить(Ключ) <> Неопределено Тогда Возврат ОшибкаСнимка; КонецЕсли;
			Ключи.Вставить(Ключ, Истина);
		КонецЦикла;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ОтсутствующиеУчетныеЗаписи(Знач УчетныеЗаписиПоКомпании, Знач ПолученныеСсылки)
	Полученные = Новый Соответствие;
	Для Каждого Ссылка Из ПолученныеСсылки Цикл Полученные.Вставить(Ссылка, Истина); КонецЦикла;
	Результат = Новый Массив;
	Для Каждого ЗаписиКомпании Из УчетныеЗаписиПоКомпании Цикл
		Для Каждого Запись Из ЗаписиКомпании.Значение Цикл
			Если Полученные.Получить(Запись.Значение) = Неопределено Тогда
				Результат.Добавить(Запись.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПолучитьСуществующиеУчетныеЗаписи(Знач СсылкиКомпаний)

	Результат = Новый Соответствие;
	Для Каждого Компания Из СсылкиКомпаний Цикл
		Результат.Вставить(Компания, Новый Соответствие);
	КонецЦикла;

	Если СсылкиКомпаний.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| УчетныеЗаписи.Владелец КАК Компания,
		| УчетныеЗаписи.Ссылка КАК Ссылка,
		| УчетныеЗаписи.Провайдер КАК Провайдер,
		| УчетныеЗаписи.ИдентификаторEBC КАК ИдентификаторEBC
		|ИЗ
		| Справочник.EBC_УчетныеЗаписи КАК УчетныеЗаписи
		|ГДЕ
		| УчетныеЗаписи.Владелец В (&СсылкиКомпаний)
		| И УчетныеЗаписи.ИдентификаторEBC <> """"";
	Запрос.УстановитьПараметр(
		"СсылкиКомпаний",
		СсылкиКомпаний);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		УчетныеЗаписиКомпании = Результат.Получить(
			Выборка.Компания);
		Ключ = КлючУчетнойЗаписи(Выборка.Провайдер, Выборка.ИдентификаторEBC);
		Если УчетныеЗаписиКомпании.Получить(Ключ) <> Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Найдены дубли учётных записей с одинаковыми компанией, провайдером и API ID. Обратитесь к администратору для объединения связей.';
				|uk = 'Знайдено дублікати облікових записів з однаковими компанією, провайдером та API ID. Зверніться до адміністратора для об’єднання зв’язків.'");
		КонецЕсли;
		УчетныеЗаписиКомпании.Вставить(
			Ключ,
			Выборка.Ссылка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ЗаписатьУчетныеЗаписиКомпании(
		Знач Компания,
		Знач ДанныеПровайдеров,
		СуществующиеУчетныеЗаписи,
		СинхронизированныеУчетныеЗаписи)

	Для Каждого ДанныеПровайдера Из ДанныеПровайдеров Цикл
		ИмяПровайдера = "";
		ДанныеПровайдера.Свойство(
			"provider",
			ИмяПровайдера);
		Провайдер = ИмяПровайдераВПеречисление(
			ИмяПровайдера);
		Если Не ЗначениеЗаполнено(Провайдер) Тогда
			ЗаписатьНеизвестногоПровайдера(
				Компания,
				ИмяПровайдера);
			Продолжить;
		КонецЕсли;

		УчетныеЗаписиАПИ = Неопределено;
		Если Не ДанныеПровайдера.Свойство(
			"accounts",
			УчетныеЗаписиАПИ)
			Или УчетныеЗаписиАПИ = Неопределено
			Или ТипЗнч(УчетныеЗаписиАПИ) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;

		// Признаки acceptedFileTypes, canCreateChat и canReplyToMessage
		// приходят на уровне провайдера и относятся ко всем его учётным записям.
		ПризнакиПровайдера = ПризнакиПровайдераИзДанныхАПИ(ДанныеПровайдера);

		Для Каждого ДанныеУчетнойЗаписи Из УчетныеЗаписиАПИ Цикл
			ЗаписатьУчетнуюЗапись(
				Компания,
				Провайдер,
				ДанныеУчетнойЗаписи,
				ПризнакиПровайдера,
				СуществующиеУчетныеЗаписи,
				СинхронизированныеУчетныеЗаписи);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция ПризнакиПровайдераИзДанныхАПИ(Знач ДанныеПровайдера)

	Признаки = Новый Структура(
		"ДопустимыеТипыФайлов,МожноСоздаватьЧат,МожноОтвечатьНаСообщение",
		"",
		Ложь,
		Ложь);

	ТипыФайлов = Неопределено;
	Если ДанныеПровайдера.Свойство("acceptedFileTypes", ТипыФайлов)
		И ТипЗнч(ТипыФайлов) = Тип("Массив") Тогда
		ЭлементыСписка = Новый Массив;
		Для Каждого ТипФайла Из ТипыФайлов Цикл
			ЗначениеТипа = СокрЛП(Строка(ТипФайла));
			Если Не ПустаяСтрока(ЗначениеТипа) Тогда
				ЭлементыСписка.Добавить(ЗначениеТипа);
			КонецЕсли;
		КонецЦикла;
		Признаки.ДопустимыеТипыФайлов = Лев(
			СтрСоединить(ЭлементыСписка, ","),
			250);
	КонецЕсли;

	ЗначениеПризнака = Неопределено;
	Если ДанныеПровайдера.Свойство("canCreateChat", ЗначениеПризнака)
		И ТипЗнч(ЗначениеПризнака) = Тип("Булево") Тогда
		Признаки.МожноСоздаватьЧат = ЗначениеПризнака;
	КонецЕсли;

	ЗначениеПризнака = Неопределено;
	Если ДанныеПровайдера.Свойство("canReplyToMessage", ЗначениеПризнака)
		И ТипЗнч(ЗначениеПризнака) = Тип("Булево") Тогда
		Признаки.МожноОтвечатьНаСообщение = ЗначениеПризнака;
	КонецЕсли;

	Возврат Признаки;

КонецФункции

Процедура ЗаписатьУчетнуюЗапись(
		Знач Компания,
		Знач Провайдер,
		Знач ДанныеУчетнойЗаписи,
		Знач ПризнакиПровайдера,
		СуществующиеУчетныеЗаписи,
		СинхронизированныеУчетныеЗаписи)

	Идентификатор = "";
	ДанныеУчетнойЗаписи.Свойство(
		"id",
		Идентификатор);
	Идентификатор = НРег(СокрЛП(Строка(Идентификатор)));
	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	Ключ = КлючУчетнойЗаписи(Провайдер, Идентификатор);
	СсылкаУчетнойЗаписи = СуществующиеУчетныеЗаписи.Получить(Ключ);
	Если СсылкаУчетнойЗаписи = Неопределено Тогда
		ОбъектУчетнойЗаписи =
			Справочники.EBC_УчетныеЗаписи.СоздатьЭлемент();
		ОбъектУчетнойЗаписи.Владелец = Компания;
		ОбъектУчетнойЗаписи.ИдентификаторEBC = Идентификатор;
	Иначе
		ОбъектУчетнойЗаписи = СсылкаУчетнойЗаписи.ПолучитьОбъект();
	КонецЕсли;

	ОбъектУчетнойЗаписи.Наименование =
		ИмяУчетнойЗаписиИзДанныхАПИ(
			ДанныеУчетнойЗаписи,
			Идентификатор);
	ОбъектУчетнойЗаписи.Провайдер = Провайдер;
	ОбъектУчетнойЗаписи.Идентификатор =
		ИдентификаторКаналаИзДанныхАПИ(
			ДанныеУчетнойЗаписи);
	ОбъектУчетнойЗаписи.ДопустимыеТипыФайлов =
		ПризнакиПровайдера.ДопустимыеТипыФайлов;
	ОбъектУчетнойЗаписи.МожноСоздаватьЧат =
		ПризнакиПровайдера.МожноСоздаватьЧат;
	ОбъектУчетнойЗаписи.МожноОтвечатьНаСообщение =
		ПризнакиПровайдера.МожноОтвечатьНаСообщение;
	ОбъектУчетнойЗаписи.Записать();

	СсылкаУчетнойЗаписи = ОбъектУчетнойЗаписи.Ссылка;
	СуществующиеУчетныеЗаписи.Вставить(
		Ключ,
		СсылкаУчетнойЗаписи);
	Если СинхронизированныеУчетныеЗаписи.Найти(
		СсылкаУчетнойЗаписи) = Неопределено Тогда
		СинхронизированныеУчетныеЗаписи.Добавить(
			СсылкаУчетнойЗаписи);
	КонецЕсли;

КонецПроцедуры

Функция ИмяПровайдераВПеречисление(Знач ИмяАПИ)

	Если ИмяАПИ = Неопределено
		Или ПустаяСтрока(СокрЛП(Строка(ИмяАПИ))) Тогда
		Возврат Перечисления.EBC_Провайдеры.ПустаяСсылка();
	КонецЕсли;

	// Имена значений перечисления EBC_Провайдеры намеренно совпадают
	// с ChatProviderSource API, поэтому частные случаи не нужны.
	Попытка
		Возврат Перечисления.EBC_Провайдеры[СокрЛП(Строка(ИмяАПИ))];
	Исключение
		Возврат Перечисления.EBC_Провайдеры.ПустаяСсылка();
	КонецПопытки;

КонецФункции

Функция ИмяУчетнойЗаписиИзДанныхАПИ(
		Знач ДанныеУчетнойЗаписи,
		Знач Идентификатор)

	Результат = "Account " + Идентификатор;
	ИмяАПИ = Неопределено;
	Если ДанныеУчетнойЗаписи.Свойство("name", ИмяАПИ)
		И ИмяАПИ <> Неопределено
		И Не ПустаяСтрока(СокрЛП(Строка(ИмяАПИ))) Тогда
		Результат = Строка(ИмяАПИ);
	КонецЕсли;

	Возврат Лев(Результат, 150);

КонецФункции

Функция ИдентификаторКаналаИзДанныхАПИ(Знач ДанныеУчетнойЗаписи)

	Результат = "";
	ИдентификаторАПИ = Неопределено;
	Если ДанныеУчетнойЗаписи.Свойство(
		"identifier",
		ИдентификаторАПИ)
		И ИдентификаторАПИ <> Неопределено Тогда
		Результат = Лев(Строка(ИдентификаторАПИ), 50);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Процедура ЗафиксироватьУспешнуюСинхронизацию(
		Знач Компании,
		Знач УчетныеЗаписи,
		Знач МоментСинхронизации)

	// Вызывается в транзакции применения проверенных снимков.
	Для Каждого Компания Из Компании Цикл
		ОбъектКомпании = Компания.ПолучитьОбъект();
		ОбъектКомпании.ДатаСинхронизации =
			МоментСинхронизации;
		ОбъектКомпании.Записать();
	КонецЦикла;

	Для Каждого УчетнаяЗапись Из УчетныеЗаписи Цикл
		ОбъектУчетнойЗаписи = УчетнаяЗапись.ПолучитьОбъект();
		ОбъектУчетнойЗаписи.Активна = Не ОбъектУчетнойЗаписи.ПометкаУдаления;
		ОбъектУчетнойЗаписи.ДатаСинхронизации =
			МоментСинхронизации;
		ОбъектУчетнойЗаписи.Записать();
	КонецЦикла;


КонецПроцедуры

Функция НовыйРезультатСинхронизации()

	Возврат Новый Структура(
		"Успех,Ошибка,Количество,КоличествоКомпаний,КоличествоУчетныхЗаписей",
		Ложь,
		"",
		0,
		0,
		0);

КонецФункции

Функция РезультатСинхронизацииСОшибкой(Знач ТекстОшибки)

	Результат = НовыйРезультатСинхронизации();
	Результат.Ошибка = ТекстОшибки;
	Возврат Результат;

КонецФункции

Процедура ЗаблокироватьСостояниеСинхронизации(
		Знач Компания,
		Знач ВидОперации)

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить(
		"РегистрСведений.EBC_СостояниеСинхронизации");
	ЭлементБлокировки.УстановитьЗначение(
		"Компания",
		Компания);
	ЭлементБлокировки.УстановитьЗначение(
		"ВидОперации",
		ВидОперации);
	Блокировка.Заблокировать();

КонецПроцедуры

Функция ПолучитьСостояниеСинхронизации(
		Знач Компания,
		Знач ВидОперации)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| Состояние.ИдентификаторСеанса КАК ИдентификаторСеанса,
		| Состояние.Истекает КАК Истекает
		|ИЗ
		| РегистрСведений.EBC_СостояниеСинхронизации КАК Состояние
		|ГДЕ
		| Состояние.Компания = &Компания
		| И Состояние.ВидОперации = &ВидОперации";
	Запрос.УстановитьПараметр("Компания", Компания);
	Запрос.УстановитьПараметр("ВидОперации", ВидОперации);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Новый Структура(
			"ИдентификаторСеанса,Истекает",
			Выборка.ИдентификаторСеанса,
			Выборка.Истекает);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ИмяТекущегоПользователяИБ()

	Попытка
		ПользовательИБ =
			ПользователиИнформационнойБазы.ТекущийПользователь();
		Возврат Лев(ПользовательИБ.Имя, 150);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

Процедура ЗаписатьНеизвестногоПровайдера(
		Знач Компания,
		Знач ИмяПровайдера)

	ЗаписьЖурналаРегистрации(
