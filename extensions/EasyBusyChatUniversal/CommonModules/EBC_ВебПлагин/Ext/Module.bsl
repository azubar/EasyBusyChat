#Область ОписаниеПеременных


#КонецОбласти

#Область ПрограммныйИнтерфейс

// Признак того, что текущее клиентское приложение поддерживает веб-плагин.
//
// Компонента Easy Busy Chat - внешняя компонента Native API, которая загружает
// DLL из макета во временный каталог и управляет отдельным процессом браузера.
// Работает это только в тонком и толстом клиенте, поэтому веб-клиент и любые
// другие контексты (например, мобильный клиент) исключаются.
//
// Проверка выполняется инструкциями препроцессора: ветка неподдерживаемого
// клиента не просто пропускается при выполнении, а не попадает в
// скомпилированный модуль.
//
Функция ПоддерживаетсяТекущийКлиент() Экспорт

#Если ТонкийКлиент Или ТолстыйКлиентУправляемоеПриложение Или ТолстыйКлиентОбычноеПриложение Тогда
	Возврат Истина;
#Иначе
	Возврат Ложь;
#КонецЕсли

КонецФункции

// Текст предупреждения о клиентском приложении, в котором компонента не работает.
//
Функция ТекстНеподдерживаемогоКлиента() Экспорт

	Возврат НСтр(
		"ru = 'Easy Busy Chat не работает в веб-клиенте.
		|Для работы компоненты запустите программу в тонком или толстом клиенте 1С:Предприятия.';
		|uk = 'Easy Busy Chat не працює у веб-клієнті.
		|Для роботи компоненти запустіть програму в тонкому або товстому клієнті 1С:Підприємства.'");

КонецФункции

// Проверяет клиентское приложение перед действием, которому нужна компонента,
// и показывает предупреждение, если компонента в нём не работает.
//
// Возвращаемое значение:
//  Булево - Ложь, если действие выполнять нельзя.
//
Функция ПроверитьПоддержкуКлиента() Экспорт

	Если ПоддерживаетсяТекущийКлиент() Тогда
		Возврат Истина;
	КонецЕсли;

	ПоказатьПредупреждение(, ТекстНеподдерживаемогоКлиента());

	Возврат Ложь;

КонецФункции

Функция ПодключитьКомпоненту(АктивнаяКомпонента = Неопределено) Экспорт

#Если ТонкийКлиент Или ТолстыйКлиентУправляемоеПриложение Или ТолстыйКлиентОбычноеПриложение Тогда

	Если АктивнаяКомпонента <> Неопределено Тогда
		Возврат АктивнаяКомпонента;
	КонецЕсли;

	// После hostClosed объект уничтожается, но Native API может оставаться зарегистрированным
	// в текущем клиентском сеансе. Сначала пробуем создать объект без повторной загрузки DLL.
	Попытка
		Возврат Новый("AddIn.EB.EasyBusyChatAddIn");
	Исключение
	КонецПопытки;

	// Имя макета вычисляется всегда: оно нужно и в тексте ошибки подключения,
	// когда файл компоненты уже выгружен во временный каталог.
	СистемнаяИнформацияКлиента = Новый СистемнаяИнформация;
	ИмяМакета = "EasyBusyChat_x32";
	Если СистемнаяИнформацияКлиента.ТипПлатформы =
		ТипПлатформы.Windows_x86_64 Тогда
		ИмяМакета = "EasyBusyChat_x64";
	КонецЕсли;

	// Файл живёт до конца сеанса и намеренно не удаляется: загруженную DLL
	// платформа держит открытой, а путь к ней нужен при повторном подключении.
	// Временный каталог клиента чистится штатными средствами.
	Если ПустаяСтрока(глПутьКФайлуКомпонентыEBC)
		Или НайтиФайлы(глПутьКФайлуКомпонентыEBC).Количество() = 0 Тогда
		ДанныеМакета = EBC_ЧатВызовСервера.ПолучитьМакетКомпоненты(
			ИмяМакета);
		глПутьКФайлуКомпонентыEBC = ПолучитьИмяВременногоФайла("dll");
		ДанныеМакета.Записать(глПутьКФайлуКомпонентыEBC);
	КонецЕсли;

	УспешноПодключено = ПодключитьВнешнююКомпоненту(
		глПутьКФайлуКомпонентыEBC,
		"EB",
		ТипВнешнейКомпоненты.Native);
	Если Не УспешноПодключено Тогда
		ТекстОшибки = СтрШаблон(
			НСтр(
				"ru = 'Не удалось подключить компоненту Easy Busy Chat из макета %1.';
				|uk = 'Не вдалося підключити компоненту Easy Busy Chat з макета %1.'"),
			ИмяМакета);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;

	Попытка
		АктивнаяКомпонента = Новый("AddIn.EB.EasyBusyChatAddIn");
	Исключение
		ТекстОшибки = НСтр(
			"ru = 'Не удалось создать объект Native API Easy Busy Chat.';
			|uk = 'Не вдалося створити об’єкт Native API Easy Busy Chat.'");
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;

	Возврат АктивнаяКомпонента;

#Иначе

	// Последний рубеж: сюда попадают только вызовы в обход ПроверитьПоддержкуКлиента.
	ВызватьИсключение ТекстНеподдерживаемогоКлиента();

#КонецЕсли

КонецФункции

// Признак того, что компонента уже инициализирована и её окно работает.
//
// Проверяется по самой компоненте: свойство Подключено отражает состояние
// IPC-канала к процессу браузера. Оно становится Истина после успешного
// Открыть() и сбрасывается, когда окно закрыто, поэтому отдельный флаг
// состояния в расширении не нужен.
//
Функция КомпонентаГотова(Знач Компонента) Экспорт

	Если Компонента = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Возврат Компонента.Подключено = Истина;
	Исключение
		// Объект Native API уничтожен вместе с процессом браузера.
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Готовит компоненту к работе и возвращает результат операции.
//
// Если окно чата уже открыто, повторная инициализация не выполняется: не будет
// ни серверного вызова за токеном, ни повторного Открыть(). Компонента
// передаётся по ссылке и обновляется на месте - вызывающему коду достаточно
// хранить её в глобальной переменной глКомпонентаEBC.
//
Функция ПодготовитьКомпоненту(
	Компонента,
	Знач КомпанияEBC = Неопределено,
	Знач ИдентификаторАккаунта = "",
	Знач Провайдер = "") Экспорт

	РезультатПроверки = ПроверитьУчетнуюЗаписьДляОткрытия(
		КомпанияEBC, ИдентификаторАккаунта, Провайдер);
	Если Не РезультатПроверки.Успех Тогда
		Возврат РезультатПроверки;
	КонецЕсли;

	Если КомпонентаГотова(Компонента) Тогда
		Возврат РезультатОперации(Истина, "");
	КонецЕсли;

	// Общий заслон для всех сценариев подключения: даже если вызывающий код не
	// проверил клиента сам, компонента в веб-клиенте не подключается, а причина
	// возвращается обычным результатом операции.
	Если Не ПоддерживаетсяТекущийКлиент() Тогда
		Возврат РезультатОперации(Ложь, ТекстНеподдерживаемогоКлиента());
	КонецЕсли;

	Компонента = ПодключитьКомпоненту(Компонента);

	Возврат ИнициализироватьИОткрыть(Компонента, КомпанияEBC);

КонецФункции

Функция ИнициализироватьИОткрыть(
	Знач Компонента,
	Знач КомпанияEBC = Неопределено) Экспорт

	Если Компонента = Неопределено Тогда
		Возврат РезультатОперации(
			Ложь,
			НСтр(
				"ru = 'Компонента Easy Busy Chat не подключена.';
				|uk = 'Компоненту Easy Busy Chat не підключено.'"));
	КонецЕсли;

	// Серверный вызов выполняется непосредственно перед Init. Структура и локальная
	// переменная с токеном очищаются после любой попытки обращения к компоненте.
	ДанныеИнициализации = EBC_ЧатВызовСервера.ДанныеИнициализации(
		КомпанияEBC);
	ТокенДоступа = "";
	БазовыйАдресАпи = "";
	ИдентификаторКомпании = "";
	ЕстьТокен = Ложь;
	УспешноИнициализировано = Ложь;
	ОшибкаИнициализации = "";

	Попытка
		ЕстьТокен = ДанныеИнициализации.Свойство(
			"AccessToken",
			ТокенДоступа)
			И Не ПустаяСтрока(ТокенДоступа);
		ДанныеИнициализации.Свойство(
			"ApiBaseUrl",
			БазовыйАдресАпи);
		ДанныеИнициализации.Свойство(
			"CompanyId",
			ИдентификаторКомпании);

		Если ЕстьТокен Тогда
			УспешноИнициализировано = Компонента.Инициализация(
				БазовыйАдресАпи,
				ИдентификаторКомпании,
				ТокенДоступа);
		КонецЕсли;
	Исключение
		ОшибкаИнициализации = НСтр(
			"ru = 'Ошибка вызова Init Native API Easy Busy Chat.';
			|uk = 'Помилка виклику Init Native API Easy Busy Chat.'");
	КонецПопытки;

	ОчиститьТранзитныеДанные(
		ДанныеИнициализации,
		ТокенДоступа);

	Если Не ЕстьТокен Тогда
		Если Не ПустаяСтрока(ОшибкаИнициализации) Тогда
			Возврат РезультатОперации(
				Ложь,
				ОшибкаИнициализации);
		КонецЕсли;
		Возврат РезультатОперации(
			Ложь,
			НСтр(
				"ru = 'Не настроен токен доступа Easy Busy Chat.';
				|uk = 'Не налаштовано токен доступу Easy Busy Chat.'"));
	КонецЕсли;

	Если Не УспешноИнициализировано Тогда
		Если ПустаяСтрока(ОшибкаИнициализации) Тогда
			ОшибкаИнициализации = БезопаснаяПоследняяОшибка(
				Компонента,
				НСтр(
					"ru = 'Не удалось инициализировать Easy Busy Chat.';
					|uk = 'Не вдалося ініціалізувати Easy Busy Chat.'"));
		КонецЕсли;
		Возврат РезультатОперации(
			Ложь,
			ОшибкаИнициализации);
	КонецЕсли;

	Попытка
		УспешноНастроеноМеню = Компонента.УстановитьМенюДействийЧата(
			НастройкиМенюДействийЧатаJSON());
	Исключение
		УспешноНастроеноМеню = Ложь;
	КонецПопытки;

	Если Не УспешноНастроеноМеню Тогда
		Возврат РезультатОперации(
			Ложь,
			БезопаснаяПоследняяОшибка(
				Компонента,
				НСтр(
					"ru = 'Не удалось настроить меню действий Easy Busy Chat до открытия окна.';
					|uk = 'Не вдалося налаштувати меню дій Easy Busy Chat до відкриття вікна.'")));
	КонецЕсли;

	Попытка
		Компонента.УстановитьPushСобытия(Истина);
	Исключение
		Возврат РезультатОперации(
			Ложь,
			НСтр(
				"ru = 'Не удалось включить push-события Easy Busy Chat.';
				|uk = 'Не вдалося увімкнути push-події Easy Busy Chat.'"));
	КонецПопытки;

	УспешноОткрыто = Ложь;
	Попытка
		УспешноОткрыто = Компонента.Открыть();
	Исключение
		Возврат РезультатОперации(
			Ложь,
			НСтр(
				"ru = 'Ошибка открытия окна Easy Busy Chat.';
				|uk = 'Помилка відкриття вікна Easy Busy Chat.'"));
	КонецПопытки;

	Если Не УспешноОткрыто Тогда
		Возврат РезультатОперации(
			Ложь,
			БезопаснаяПоследняяОшибка(
				Компонента,
				НСтр(
					"ru = 'Не удалось открыть окно Easy Busy Chat.';
					|uk = 'Не вдалося відкрити вікно Easy Busy Chat.'")));
	КонецЕсли;

	Возврат РезультатОперации(Истина, "");

КонецФункции

Функция ОткрытьЧат(
	Знач Компонента,
	Знач ИдентификаторАккаунта,
	Знач Провайдер,
	Знач ИдентификаторЧата,
	Знач КомпанияEBC = Неопределено) Экспорт

	РезультатПроверки = ПроверитьУчетнуюЗаписьДляОткрытия(
		КомпанияEBC, ИдентификаторАккаунта, Провайдер);
	Если Не РезультатПроверки.Успех Тогда
		Возврат РезультатПроверки;
	КонецЕсли;

	Если Компонента = Неопределено Тогда
		Возврат РезультатОперации(
			Ложь,
			НСтр(
				"ru = 'Компонента Easy Busy Chat не подключена.';
				|uk = 'Компоненту Easy Busy Chat не підключено.'"));
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(ИдентификаторАккаунта)) Тогда
		Возврат РезультатОперации(
			Ложь,
			НСтр(
				"ru = 'Не указан идентификатор аккаунта Easy Busy Chat.';
				|uk = 'Не вказано ідентифікатор акаунта Easy Busy Chat.'"));
	КонецЕсли;

	ЗначениеПровайдера = СокрЛП(Строка(Провайдер));
	Если ПустаяСтрока(ЗначениеПровайдера) Тогда
		Возврат РезультатОперации(
			Ложь,
			НСтр(
				"ru = 'Не указан провайдер Easy Busy Chat.';
				|uk = 'Не вказано провайдера Easy Busy Chat.'"));
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(ИдентификаторЧата)) Тогда
		Возврат РезультатОперации(
			Ложь,
			НСтр(
				"ru = 'Не указан идентификатор чата Easy Busy Chat.';
				|uk = 'Не вказано ідентифікатор чату Easy Busy Chat.'"));
	КонецЕсли;

	УспешноОткрытЧат = Ложь;
	Попытка
		УспешноОткрытЧат = Компонента.ОткрытьЧат(
			СокрЛП(ИдентификаторАккаунта),
			ЗначениеПровайдера,
			СокрЛП(ИдентификаторЧата));
	Исключение
		Возврат РезультатОперации(
			Ложь,
			НСтр(
				"ru = 'Ошибка открытия чата Easy Busy Chat.';
				|uk = 'Помилка відкриття чату Easy Busy Chat.'"));
	КонецПопытки;

	Если Не УспешноОткрытЧат Тогда
		Возврат РезультатОперации(
			Ложь,
			БезопаснаяПоследняяОшибка(
				Компонента,
				НСтр(
					"ru = 'Не удалось открыть выбранный чат.';
					|uk = 'Не вдалося відкрити вибраний чат.'")));
	КонецЕсли;

	Возврат РезультатОперации(Истина, "");

КонецФункции

Функция НачатьОткрытиеЧатаПоКонтакту(
	Знач Компонента,
	Знач ИдентификаторАккаунта,
	Знач Провайдер,
	Знач ИдентификаторКонтакта,
	Знач ИмяКонтакта = "",
	Знач ТипЧата = 0,
	Знач КомпанияEBC = Неопределено) Экспорт

	РезультатПроверки = ПроверитьУчетнуюЗаписьДляОткрытия(
		КомпанияEBC, ИдентификаторАккаунта, Провайдер);
	Если Не РезультатПроверки.Успех Тогда
		Возврат РезультатПроверки;
	КонецЕсли;

	Если Компонента = Неопределено Тогда
		Возврат РезультатОперации(
			Ложь,
			НСтр(
				"ru = 'Компонента Easy Busy Chat не подключена.';
				|uk = 'Компоненту Easy Busy Chat не підключено.'"));
	КонецЕсли;

	ИдентификаторАккаунта = СокрЛП(Строка(ИдентификаторАккаунта));
	ЗначениеПровайдера = СокрЛП(Строка(Провайдер));
	ИдентификаторКонтакта = СокрЛП(Строка(ИдентификаторКонтакта));
	ИмяКонтакта = СокрЛП(Строка(ИмяКонтакта));
	Если ПустаяСтрока(ИдентификаторАккаунта) Тогда
		Возврат РезультатОперации(
			Ложь,
			НСтр(
				"ru = 'Не указан идентификатор аккаунта Easy Busy Chat.';
				|uk = 'Не вказано ідентифікатор акаунта Easy Busy Chat.'"));
	КонецЕсли;
	Если ПустаяСтрока(ЗначениеПровайдера) Тогда
		Возврат РезультатОперации(
			Ложь,
			НСтр(
				"ru = 'Не указан провайдер Easy Busy Chat.';
				|uk = 'Не вказано провайдера Easy Busy Chat.'"));
	КонецЕсли;
	Если ПустаяСтрока(ИдентификаторКонтакта) Тогда
		Возврат РезультатОперации(
			Ложь,
			НСтр(
				"ru = 'Не указан идентификатор контакта Easy Busy Chat.';
				|uk = 'Не вказано ідентифікатор контакту Easy Busy Chat.'"));
	КонецЕсли;

	Если ТипЧата <> 0 Тогда
		Возврат РезультатОперации(
			Ложь,
			НСтр(
				"ru = 'Указан неподдерживаемый тип чата Easy Busy Chat.';
				|uk = 'Вказано непідтримуваний тип чату Easy Busy Chat.'"));
	КонецЕсли;

	ИдентификаторОперации = "";
	Попытка
		ИдентификаторОперации = СокрЛП(Строка(
			Компонента.НачатьОткрытиеЧатаПоКонтакту(
				ЗначениеПровайдера,
				ИдентификаторАккаунта,
				ИдентификаторКонтакта,
				ИмяКонтакта,
				ТипЧата)));
	Исключение
		Возврат РезультатОперации(
			Ложь,
			НСтр(
				"ru = 'Не удалось начать открытие чата Easy Busy Chat.';
				|uk = 'Не вдалося розпочати відкриття чату Easy Busy Chat.'"));
	КонецПопытки;

	Если ПустаяСтрока(ИдентификаторОперации) Тогда
		Возврат РезультатОперации(
			Ложь,
			НСтр(
				"ru = 'Не удалось начать открытие чата Easy Busy Chat.';
				|uk = 'Не вдалося розпочати відкриття чату Easy Busy Chat.'"));
	КонецЕсли;

	Попытка
		СтатусОперации = ПрочитатьОбъектJSON(
			Компонента.ПолучитьСтатусОперации(ИдентификаторОперации));
		Если ПолучитьСтроковоеСвойство(СтатусОперации, "state") = "failed" Тогда
			Возврат РезультатОперации(
				Ложь,
				НСтр(
					"ru = 'Не удалось открыть чат Easy Busy Chat.';
					|uk = 'Не вдалося відкрити чат Easy Busy Chat.'"),
				ИдентификаторОперации);
		КонецЕсли;
	Исключение
		// Уже принятая компонентой операция продолжает выполняться независимо от статуса.
	КонецПопытки;

	Возврат РезультатОперации(Истина, "", ИдентификаторОперации);

КонецФункции

Процедура ОбработатьВнешнееСобытие(
	Знач Источник,
	Знач Событие,
	Знач Данные,
	Компонента,
	Знач Форма = Неопределено) Экспорт

	Если Источник <> "EasyBusyChat" Тогда
		Возврат;
	КонецЕсли;

	Если Событие = "browserReady" Или Событие = "reactReady" Тогда
		ПоказатьОповещение(
			НСтр(
				"ru = 'Интерфейс чата готов к работе.';
				|uk = 'Інтерфейс чату готовий до роботи.'"));
	ИначеЕсли Событие = "chat_action" Тогда
		ОбработатьДействиеЧата(
			Данные,
			Компонента,
			Форма);
	ИначеЕсли Событие = "operation" Тогда
		ОбработатьСобытиеОперации(Данные);
	ИначеЕсли Событие = "notification" Тогда
		Оповестить("EBC_ПолученоУведомлениеЧата", Данные);
	ИначеЕсли Событие = "hostClosed" Тогда
		// Повторное открытие должно создать новый объект Native API.
		Компонента = Неопределено;
	ИначеЕсли Событие = "warning" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр(
				"ru = 'Easy Busy Chat сообщил предупреждение.';
				|uk = 'Easy Busy Chat повідомив попередження.'"));
	ИначеЕсли Событие = "error" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр(
				"ru = 'Произошла ошибка веб-интерфейса Easy Busy Chat.';
				|uk = 'Сталася помилка веб-інтерфейсу Easy Busy Chat.'"));
	КонецЕсли;

КонецПроцедуры

Процедура ЗакрытьКомпоненту(Компонента) Экспорт

	Если Компонента <> Неопределено Тогда
		Попытка
			Компонента.Закрыть();
		Исключение
			// Ошибка вспомогательного процесса не должна завершать клиент 1С.
		КонецПопытки;
		Компонента = Неопределено;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Всплывающее оповещение Easy Busy Chat, если они не выключены в настройках.
//
// Флаг спрашивается у сервера при каждом оповещении, а не один раз за сеанс:
// сеансовый кэш означал бы, что выключенная настройка начинает действовать
// только после перезапуска. Оповещений здесь единицы за открытие окна чата,
// а на сервере значение всё равно кэшируется модулем повторного использования.
//
Процедура ПоказатьОповещение(Знач Текст)

	Показывать = Истина;
	Попытка
		Показывать = EBC_НастройкиВызовСервера.ПоказыватьОповещения();
	Исключение
		// Нет прав на настройки либо сервер недоступен - оповещения нужнее
		// молчания: они единственный признак, что компонента ожила.
		Показывать = Истина;
	КонецПопытки;

	Если Не Показывать Тогда
		Возврат;
	КонецЕсли;

	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Easy Busy Chat'; uk = 'Easy Busy Chat'"),
		,
		Текст);

КонецПроцедуры

Процедура ОбработатьСобытиеОперации(Знач Данные)

	ОбъектСобытия = ПрочитатьОбъектJSON(Данные);
	Если ОбъектСобытия = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ПолучитьСтроковоеСвойство(ОбъектСобытия, "action")
		<> "openChatByIdentity" Тогда
		Возврат;
	КонецЕсли;

	СостояниеОперации = ПолучитьСтроковоеСвойство(
		ОбъектСобытия,
		"state");
	Если СостояниеОперации <> "failed"
		И СостояниеОперации <> "timed_out"
		И СостояниеОперации <> "cancelled" Тогда
		Возврат;
	КонецЕсли;

	ОбщегоНазначенияКлиент.СообщитьПользователю(
		НСтр(
			"ru = 'Не удалось открыть чат Easy Busy Chat.';
			|uk = 'Не вдалося відкрити чат Easy Busy Chat.'"));

КонецПроцедуры

Процедура ОбработатьДействиеЧата(
	Знач Данные,
	Знач Компонента,
	Знач Форма)

	ИдентификаторЗапроса = "";
	Успех = Ложь;
	ТекстОшибкиПоУмолчанию = НСтр(
		"ru = 'Не удалось обработать действие Easy Busy Chat.';
		|uk = 'Не вдалося обробити дію Easy Busy Chat.'");
	ТекстОшибки = ТекстОшибкиПоУмолчанию;

	Попытка
		ОбъектСобытия = ПрочитатьОбъектJSON(Данные);
		Если ОбъектСобытия = Неопределено Тогда
			ТекстОшибки = НСтр(
				"ru = 'Некорректный JSON события.';
				|uk = 'Некоректний JSON події.'");
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;

		ОбъектСобытия.Свойство(
			"reqId",
			ИдентификаторЗапроса);

		// В v0.3.2 ExternalEvent получает плоский payload с reqId.
		// Вложенный payload оставлен для совместимости с прежней компонентой.
		ДанныеДействия = ОбъектСобытия;
		ВложенныеДанныеДействия = Неопределено;
		Если ОбъектСобытия.Свойство(
			"payload",
			ВложенныеДанныеДействия)
			И ВложенныеДанныеДействия <> Неопределено Тогда
			ДанныеДействия = ВложенныеДанныеДействия;
		КонецЕсли;

		Если ПустаяСтрока(СокрЛП(Строка(ИдентификаторЗапроса))) Тогда
			ДанныеДействия.Свойство(
				"reqId",
				ИдентификаторЗапроса);
		КонецЕсли;

		ИдентификаторДействия = "";
		ДанныеДействия.Свойство(
			"actionId",
			ИдентификаторДействия);

		Если ИдентификаторДействия = "open_chat" Тогда
			ИдентификаторЧата = ПолучитьИдентификаторЧата(
				ДанныеДействия);
			Если ПустаяСтрока(ИдентификаторЧата) Тогда
				ТекстОшибки = НСтр(
					"ru = 'В действии отсутствует идентификатор чата.';
					|uk = 'У дії відсутній ідентифікатор чату.'");
				ВызватьИсключение ТекстОшибки;
			КонецЕсли;

			Компонента.ОтправитьСообщение(
				EBC_ЧатВызовСервера.ПолучитьДействияДляЧата(
					ИдентификаторЧата,
					ИдентификаторЗапроса));
			Успех = Истина;
			ТекстОшибки = "";

		ИначеЕсли ИдентификаторДействия = "view_contact"
			Или ИдентификаторДействия = "create_opportunity" Тогда

			ИдентификаторЧата = ПолучитьИдентификаторЧата(
				ДанныеДействия);
			Если ПустаяСтрока(ИдентификаторЧата) Тогда
				ТекстОшибки = НСтр(
					"ru = 'В действии отсутствует идентификатор чата.';
					|uk = 'У дії відсутній ідентифікатор чату.'");
				ВызватьИсключение ТекстОшибки;
			КонецЕсли;

			// Открывать нужно тот объект, который к чату действительно привязан:
			// подменять контрагента его партнёром пользователь не просил.
			// Создание документа развернёт этот объект в пару партнёр/контрагент
			// самостоятельно.
			СвязанныйКонтакт = EBC_ЧатВызовСервера.ПолучитьКонтрагентаЧата(
				ИдентификаторЧата,
				ПолучитьСтроковоеСвойство(ДанныеДействия, "accountId"),
				ПолучитьСтроковоеСвойство(ДанныеДействия, "provider"));

			Если Не ЗначениеЗаполнено(СвязанныйКонтакт) Тогда
				// Рабочего места контакт-центра в универсальной сборке нет:
				// связывать чат с объектом нужно из формы самого объекта.
				ОбщегоНазначенияКлиент.СообщитьПользователю(
					НСтр(
						"ru = 'Чат ни с чем не связан. Свяжите его из формы нужного объекта.';
						|uk = 'Чат ні з чим не пов''язаний. Пов''яжіть його з форми потрібного об''єкта.'"));
			ИначеЕсли ИдентификаторДействия = "view_contact" Тогда
				EBC_АдаптерКонфигурации.ОткрытьОбъект(
					СвязанныйКонтакт,
					Форма);
			Иначе
				// Действие называется "создать заказ", поэтому и документ ищется
				// целевой - заказ покупателя или заказ клиента, смотря что есть
				// в конфигурации. Первый документ из общего списка настроек тут
				// не годится: после смены порядка это мог оказаться счёт.
				Заказ = EBC_ЧатВызовСервера.ДокументЗаказаДляСоздания();
				Если ПустаяСтрока(Заказ.Имя) Тогда
					ОбщегоНазначенияКлиент.СообщитьПользователю(
						СообщениеОНедоступномЗаказе(Заказ.Причина));
				Иначе
					// Форма открывается без ключа документа: он ещё не записан.
					EBC_АдаптерКонфигурации.СоздатьДокумент(
						Заказ.Имя,
						СвязанныйКонтакт,
						Новый Структура,
						Форма);
				КонецЕсли;
			КонецЕсли;

			Успех = Истина;
			ТекстОшибки = "";

		ИначеЕсли ИдентификаторДействия = "link_contact" Тогда
			ИдентификаторЧата = ПолучитьИдентификаторЧата(
				ДанныеДействия);
			Если ПустаяСтрока(ИдентификаторЧата) Тогда
				ТекстОшибки = НСтр(
					"ru = 'В действии отсутствует идентификатор чата.';
					|uk = 'У дії відсутній ідентифікатор чату.'");
				ВызватьИсключение ТекстОшибки;
			КонецЕсли;

			// Связывать чат с объектом в универсальной сборке нужно из формы
			// самого объекта: рабочего места со списком контрагентов здесь нет.
			ОбщегоНазначенияКлиент.СообщитьПользователю(
				НСтр(
					"ru = 'Откройте нужный объект и свяжите чат командой Easy-Busy Chat.';
					|uk = 'Відкрийте потрібний об''єкт і пов''яжіть чат командою Easy-Busy Chat.'"));
			Успех = Истина;
			ТекстОшибки = "";
		Иначе
			ТекстОшибки = НСтр(
				"ru = 'Действие Easy Busy Chat не поддерживается.';
				|uk = 'Дія Easy Busy Chat не підтримується.'");
		КонецЕсли;
	Исключение
		Успех = Ложь;
		ТекстОшибки = КраткоеПредставлениеОшибки(
			ИнформацияОбОшибке());
		Если ПустаяСтрока(ТекстОшибки) Тогда
			ТекстОшибки = ТекстОшибкиПоУмолчанию;
		КонецЕсли;
	КонецПопытки;

	// Для любого chat_action отправляется action_result с исходным reqId.
	ОтправитьРезультатДействия(
		Компонента,
		ИдентификаторЗапроса,
		Успех,
		ТекстОшибки);

КонецПроцедуры

Процедура ОтправитьРезультатДействия(
	Знач Компонента,
	Знач ИдентификаторЗапроса,
	Знач Успех,
	Знач ТекстОшибки)

	Если Компонента = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Ответ = Новый Структура;
	Ответ.Вставить("event", "action_result");
	Ответ.Вставить("reqId", ИдентификаторЗапроса);
	Ответ.Вставить("success", Успех);
	Ответ.Вставить("error", ТекстОшибки);
	Ответ.Вставить("payload", Новый Структура);

	Попытка
		Компонента.ОтправитьСообщение(
			ЗаписатьОбъектJSON(Ответ));
	Исключение
		// Ошибка обратного канала не должна завершать клиент 1С.
	КонецПопытки;

КонецПроцедуры

Функция ПолучитьИдентификаторЧата(Знач ДанныеДействия)

	ИдентификаторЧата = ПолучитьСтроковоеСвойство(
		ДанныеДействия,
		"chatId");
	Если Не ПустаяСтрока(ИдентификаторЧата) Тогда
		Возврат ИдентификаторЧата;
	КонецЕсли;

	ДанныеЧата = Неопределено;
	Если ДанныеДействия.Свойство("chat", ДанныеЧата)
		И ДанныеЧата <> Неопределено Тогда
		ДанныеЧата.Свойство("id", ИдентификаторЧата);
	КонецЕсли;

	Возврат СокрЛП(Строка(ИдентификаторЧата));

КонецФункции

Функция ПолучитьСтроковоеСвойство(Знач Данные, Знач ИмяСвойства)

	ЗначениеСвойства = "";
	Если Данные = Неопределено Тогда
		Возврат ЗначениеСвойства;
	КонецЕсли;

	Попытка
		Данные.Свойство(ИмяСвойства, ЗначениеСвойства);
	Исключение
		Возврат "";
	КонецПопытки;

	Если ЗначениеСвойства = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(Строка(ЗначениеСвойства));

КонецФункции

// Глобальные ПрочитатьJSON и ЗаписатьJSON в веб-клиенте недоступны, и модуль
// из-за них не компилировался ЦЕЛИКОМ: в веб-клиенте падал даже вызов
// ПроверитьПоддержкуКлиента, то есть та самая проверка, которая должна была
// показать понятное предупреждение вместо ошибки.
//
// Тела обёрнуты той же директивой препроцессора, что и ПоддерживаетсяТекущийКлиент:
// в веб-клиенте эти строки в модуль не попадают. Вызвать их оттуда всё равно
// некому - компонента там не работает, - но модуль компилируется, и
// предупреждение доходит до пользователя.
//
Функция ПрочитатьОбъектJSON(Знач СтрокаJSON)

#Если ТонкийКлиент Или ТолстыйКлиентУправляемоеПриложение Или ТолстыйКлиентОбычноеПриложение Тогда
	ЧтениеJSON = Новый ЧтениеJSON;
	Попытка
		ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
		Результат = ПрочитатьJSON(ЧтениеJSON);
	Исключение
		Результат = Неопределено;
	КонецПопытки;
	ЧтениеJSON.Закрыть();

	Возврат Результат;
#Иначе
	Возврат Неопределено;
#КонецЕсли

КонецФункции

Функция ЗаписатьОбъектJSON(Знач ОбъектJSON)

#Если ТонкийКлиент Или ТолстыйКлиентУправляемоеПриложение Или ТолстыйКлиентОбычноеПриложение Тогда
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ОбъектJSON);
	Возврат ЗаписьJSON.Закрыть();
#Иначе
	Возврат "";
#КонецЕсли

КонецФункции

// Текст, объясняющий, почему заказ создать нельзя.
//
// Причины разные по смыслу: одно дело - в конфигурации нет такого документа,
// другое - администратор выключил его в настройках. Общее "документ не найден"
// заставляло бы искать проблему не там.
//
Функция СообщениеОНедоступномЗаказе(Знач Причина)

	Если Причина = "НеВключенВНастройках" Тогда
		Возврат НСтр(
			"ru = 'Документ заказа не включён в настройках Easy-Busy Chat.';
			|uk = 'Документ замовлення не увімкнено в налаштуваннях Easy-Busy Chat.'");
	КонецЕсли;

	Если Причина = "НетПрав" Тогда
		Возврат НСтр(
			"ru = 'Недостаточно прав для создания заказа.';
			|uk = 'Недостатньо прав для створення замовлення.'");
	КонецЕсли;

	Возврат НСтр(
		"ru = 'В этой конфигурации нет документа заказа.';
		|uk = 'У цій конфігурації немає документа замовлення.'");

КонецФункции

Функция НастройкиМенюДействийЧатаJSON()

	Настройки = Новый Массив;
	Настройки.Добавить(Новый Структура("id", "view_contact"));
	Настройки.Добавить(Новый Структура(
		"id,label",
		"create_opportunity",
		"Створити замовлення"));

	Возврат ЗаписатьОбъектJSON(Настройки);

КонецФункции

Процедура ОчиститьТранзитныеДанные(
	ДанныеИнициализации,
	ТокенДоступа)

	Если ТипЗнч(ДанныеИнициализации) = Тип("Структура") Тогда
		ДанныеИнициализации.Удалить("AccessToken");
	КонецЕсли;
	ТокенДоступа = "";
	ДанныеИнициализации = Неопределено;

КонецПроцедуры

Функция БезопаснаяПоследняяОшибка(
	Знач Компонента,
	Знач ТекстПоУмолчанию)

	ТекстОшибки = "";
	Попытка
		ТекстОшибки = СокрЛП(Строка(Компонента.ПоследняяОшибка));
	Исключение
	КонецПопытки;

	Если ПустаяСтрока(ТекстОшибки) Тогда
		Возврат ТекстПоУмолчанию;
	КонецЕсли;

	ТекстОшибкиВНижнемРегистре = НРег(ТекстОшибки);
	Если Найти(ТекстОшибкиВНижнемРегистре, "token") > 0
		Или Найти(ТекстОшибкиВНижнемРегистре, "bearer") > 0
		Или Найти(
			ТекстОшибкиВНижнемРегистре,
			"authorization") > 0 Тогда
		Возврат ТекстПоУмолчанию;
	КонецЕсли;

	Если СтрДлина(ТекстОшибки) > 500 Тогда
		ТекстОшибки = Лев(ТекстОшибки, 500);
	КонецЕсли;

	Возврат ТекстОшибки;

КонецФункции

// Не кэшируем результат даже при уже открытом окне компоненты.
Функция ПроверитьУчетнуюЗаписьДляОткрытия(
	Знач КомпанияEBC, Знач ИдентификаторАккаунта, Знач Провайдер)

	Попытка
		ОшибкаОткрытия = EBC_ЧатВызовСервера.ОшибкаОткрытияПоУчетнойЗаписи(
			КомпанияEBC, ИдентификаторАккаунта, Провайдер);
	Исключение
		ОшибкаОткрытия = НСтр("ru = 'Не удалось проверить активность учётной записи. Открытие веб-плагина отменено. Повторите попытку.';
			|uk = 'Не вдалося перевірити активність облікового запису. Відкриття вебплагіна скасовано. Повторіть спробу.'");
	КонецПопытки;
	Возврат РезультатОперации(ПустаяСтрока(ОшибкаОткрытия), ОшибкаОткрытия);

КонецФункции

Функция РезультатОперации(
	Знач Успех,
	Знач ТекстОшибки,
	Знач ИдентификаторОперации = "")
	Возврат Новый Структура(
		"Успех,Ошибка,ИдентификаторОперации",
		Успех,
		ТекстОшибки,
		ИдентификаторОперации);
КонецФункции

#КонецОбласти
