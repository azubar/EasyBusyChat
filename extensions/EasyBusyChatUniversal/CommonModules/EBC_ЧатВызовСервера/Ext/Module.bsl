#Область ПрограммныйИнтерфейс

// Читается при каждой попытке открытия: состояние в открытой форме может устареть.
Функция ОшибкаОткрытияПоУчетнойЗаписи(
	Знач КомпанияEBC,
	Знач ИдентификаторАккаунта,
	Знач ИмяПровайдера) Экспорт

	Провайдер = ПровайдерИзИмениАПИ(СокрЛП(Строка(ИмяПровайдера)));
	ИдентификаторАккаунта = НРег(СокрЛП(Строка(ИдентификаторАккаунта)));
	Если Не ЗначениеЗаполнено(КомпанияEBC)
		Или Не ЗначениеЗаполнено(Провайдер)
		Или ПустаяСтрока(ИдентификаторАккаунта) Тогда
		Возврат НСтр("ru = 'Не указаны компания, провайдер или API ID учётной записи для открытия веб-плагина.';
			|uk = 'Не вказано компанію, провайдера або API ID облікового запису для відкриття вебплагіна.'");
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 2
		| УчетныеЗаписи.Активна КАК Активна,
		| УчетныеЗаписи.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ Справочник.EBC_УчетныеЗаписи КАК УчетныеЗаписи
		|ГДЕ УчетныеЗаписи.Владелец = &Компания
		| И УчетныеЗаписи.Провайдер = &Провайдер
		| И УчетныеЗаписи.ИдентификаторEBC = &ИдентификаторАккаунта";
	Запрос.УстановитьПараметр("Компания", КомпанияEBC);
	Запрос.УстановитьПараметр("Провайдер", Провайдер);
	Запрос.УстановитьПараметр("ИдентификаторАккаунта", ИдентификаторАккаунта);
	Возврат ОшибкаПоСостояниюУчетнойЗаписиДляОткрытия(Запрос.Выполнить().Выгрузить());

КонецФункции

Функция ОшибкаПоСостояниюУчетнойЗаписиДляОткрытия(Знач УчетныеЗаписи, Знач Язык = "")

	Если УчетныеЗаписи.Количество() = 0 Тогда
		Возврат НСтр("ru = 'Учётная запись не найдена. Обновите список учётных записей перед открытием веб-плагина.';
			|uk = 'Обліковий запис не знайдено. Оновіть список облікових записів перед відкриттям вебплагіна.'", Язык);
	КонецЕсли;
	Если УчетныеЗаписи.Количество() > 1 Тогда
		Возврат НСтр("ru = 'Найдено несколько учётных записей с одинаковыми компанией, провайдером и API ID. Устраните дубликаты перед открытием веб-плагина.';
			|uk = 'Знайдено кілька облікових записів з однаковими компанією, провайдером та API ID. Усуньте дублікати перед відкриттям вебплагіна.'", Язык);
	КонецЕсли;
	Если Не УчетныеЗаписи[0].Активна Или УчетныеЗаписи[0].ПометкаУдаления Тогда
		Возврат НСтр("ru = 'Учётная запись неактивна. Открыть веб-плагин для неё нельзя.';
			|uk = 'Обліковий запис неактивний. Відкрити вебплагін для нього неможливо.'", Язык);
	КонецЕсли;
	Возврат "";

КонецФункции

// Возвращает одноразовые данные для инициализации веб-плагина.
Функция ДанныеИнициализации(Знач КомпанияEBC = Неопределено) Экспорт

	Настройки = EBC_НастройкиПовтИсп.ТекущиеНастройки();
	ТокенДоступа = EBC_НастройкиСервер.ПолучитьТокенДоступа();

	ИдентификаторКомпании = "";
	Если ЗначениеЗаполнено(КомпанияEBC) Тогда
		ИдентификаторКомпании = СокрЛП(Строка(
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
				КомпанияEBC,
				"ИдентификаторEBC")));
	КонецЕсли;

	// Структура не кэшируется и используется клиентом только перед Init.
	Возврат Новый Структура(
		"ApiBaseUrl,CompanyId,AccessToken",
		Настройки.БазовыйАдресАпи,
		ИдентификаторКомпании,
		ТокенДоступа);

КонецФункции

// Возвращает действия BAS для выбранного чата.
Функция ПолучитьДействияДляЧата(
		Знач ИдентификаторEBC_Чата,
		Знач ReqId) Экспорт

	СвязиЧата = ПолучитьСвязиЧата(ИдентификаторEBC_Чата);
	МассивДействий = Новый Массив;

	Для Каждого СвязьЧата Из СвязиЧата Цикл
		Действие = ДействиеПросмотраОбъекта(СвязьЧата);
		Если Действие <> Неопределено Тогда
			МассивДействий.Добавить(Действие);
		КонецЕсли;
	КонецЦикла;

	Если МассивДействий.Количество() = 0 Тогда
		МассивДействий.Добавить(ДействиеПривязкиКлиента());
	КонецЕсли;

	Ответ = Новый Структура(
		"event,reqId,actions",
		"action_list_response",
		ReqId,
		МассивДействий);

	Возврат ЗаписатьОбъектJSON(Ответ);

КонецФункции

Функция ПолучитьМакетКомпоненты(Знач ИмяМакета) Экспорт
	Возврат ПолучитьОбщийМакет(ИмяМакета);
КонецФункции

// Контакт, связанный с чатом, вместе с разрешённой парой партнёр/контрагент.
//
// Отбор идёт по точным именам контактных справочников, а не по шаблону
// "Справочник.%": под шаблон попадала любая настроенная привязка, и контактом
// чата мог стать элемент номенклатуры, организация или проект.
//
// Приоритет между партнёром и контрагентом искусственно не вводится: какая
// связь главнее, решают ОсновнаяСвязь и дата установки. Пользователь ожидает
// увидеть тот объект, который к чату действительно привязали.
//
// Если прямой связи с контактным справочником нет, субъект восстанавливается
// из связанного документа по его реквизитам.
//
// Параметры:
//  ИдентификаторEBC_Чата - Строка;
//  ИдентификаторАккаунта - Строка - пусто: любой аккаунт;
//  ИмяПровайдера         - Строка - пусто: любой провайдер.
//
// Возвращаемое значение:
//  Структура - см. EBC_Ядро.ПараКонтакта. При отсутствии связей все поля пустые.
//
Функция КонтактЧата(
		Знач ИдентификаторEBC_Чата,
		Знач ИдентификаторАккаунта = "",
		Знач ИмяПровайдера = "") Экспорт

	Пустая = EBC_Ядро.ПараКонтакта(Неопределено);

	ИдентификаторEBC_Чата = СокрЛП(ИдентификаторEBC_Чата);
	Если ПустаяСтрока(ИдентификаторEBC_Чата) Тогда
		Возврат Пустая;
	КонецЕсли;

	КонтактныеСправочники = EBC_АдаптерКонфигурации.КонтактныеСправочники();
	Если КонтактныеСправочники.Количество() = 0 Тогда
		Возврат Пустая;
	КонецЕсли;

	Провайдер = ПровайдерИзИмениАПИ(ИмяПровайдера);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| Связи.ТипОбъекта КАК ТипОбъекта,
		| Связи.ИдентификаторОбъекта КАК ИдентификаторОбъекта
		|ИЗ
		| РегистрСведений.EBC_СвязиОбъектов КАК Связи
		|ГДЕ
		| Связи.Чат.ИдентификаторEBC = &ИдентификаторЧата
		| И Связи.ТипОбъекта В (&КонтактныеСправочники)
		| И (&ВсеАккаунты
		|  ИЛИ Связи.Чат.Владелец.ИдентификаторEBC = &ИдентификаторАккаунта)
		| И (&ВсеПровайдеры
		|  ИЛИ Связи.Чат.Владелец.Провайдер = &Провайдер)
		|УПОРЯДОЧИТЬ ПО
		| Связи.ОсновнаяСвязь УБЫВ,
		| Связи.ДатаУстановки УБЫВ";
	УстановитьОбщиеПараметрыОтбораЧата(
		Запрос,
		ИдентификаторEBC_Чата,
		ИдентификаторАккаунта,
		Провайдер);
	Запрос.УстановитьПараметр("КонтактныеСправочники", КонтактныеСправочники);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СвязанныйОбъект = EBC_АдаптерКонфигурации.ПолучитьСсылкуОбъекта(
			Выборка.ТипОбъекта,
			Выборка.ИдентификаторОбъекта);
		Если ЗначениеЗаполнено(СвязанныйОбъект) Тогда
			Возврат EBC_Ядро.ПараКонтакта(СвязанныйОбъект);
		КонецЕсли;
	КонецЕсли;

	// Прямой связи нет - пробуем восстановить контакт из связанного документа.
	Возврат КонтактПоСвязаннымДокументам(
		ИдентификаторEBC_Чата,
		ИдентификаторАккаунта,
		Провайдер,
		Пустая);

КонецФункции

// Контрагент, связанный с чатом.
//
// Устарела: возвращает непосредственно привязанный контакт, которым в УТ и КУП
// может быть партнёр. Новый код использует КонтактЧата и берёт нужное поле
// пары явно. Оставлена ради внешних обработок.
//
Функция ПолучитьКонтрагентаЧата(
		Знач ИдентификаторEBC_Чата,
		Знач ИдентификаторАккаунта = "",
		Знач ИмяПровайдера = "") Экспорт

	Контакт = КонтактЧата(ИдентификаторEBC_Чата, ИдентификаторАккаунта, ИмяПровайдера);

	Возврат Контакт.СвязанныйКонтакт;

КонецФункции

// Субъект контакта по документам, привязанным к чату.
//
// Запасной путь: накладную или заказ к чату привязывают чаще, чем сам
// справочник, и реквизиты документа знают, с кем идёт работа.
//
Функция КонтактПоСвязаннымДокументам(
		Знач ИдентификаторEBC_Чата,
		Знач ИдентификаторАккаунта,
		Знач Провайдер,
		Знач Пустая)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 5
		| Связи.ТипОбъекта КАК ТипОбъекта,
		| Связи.ИдентификаторОбъекта КАК ИдентификаторОбъекта
		|ИЗ
		| РегистрСведений.EBC_СвязиОбъектов КАК Связи
		|ГДЕ
		| Связи.Чат.ИдентификаторEBC = &ИдентификаторЧата
		| И Связи.ТипОбъекта ПОДОБНО &ШаблонДокумента
		| И (&ВсеАккаунты
		|  ИЛИ Связи.Чат.Владелец.ИдентификаторEBC = &ИдентификаторАккаунта)
		| И (&ВсеПровайдеры
		|  ИЛИ Связи.Чат.Владелец.Провайдер = &Провайдер)
		|УПОРЯДОЧИТЬ ПО
		| Связи.ОсновнаяСвязь УБЫВ,
		| Связи.ДатаУстановки УБЫВ";
	УстановитьОбщиеПараметрыОтбораЧата(
		Запрос,
		ИдентификаторEBC_Чата,
		ИдентификаторАккаунта,
		Провайдер);
	Запрос.УстановитьПараметр("ШаблонДокумента", "Документ.%");

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Документ = EBC_АдаптерКонфигурации.ПолучитьСсылкуОбъекта(
			Выборка.ТипОбъекта,
			Выборка.ИдентификаторОбъекта);
		Если Не ЗначениеЗаполнено(Документ) Тогда
			Продолжить;
		КонецЕсли;

		Пара = EBC_Ядро.ПараКонтакта(Документ);
		Если Пара.СвязанныйКонтакт <> Неопределено Тогда
			Возврат Пара;
		КонецЕсли;
	КонецЦикла;

	Возврат Пустая;

КонецФункции

// Параметры отбора связей чата, общие для нескольких запросов.
Процедура УстановитьОбщиеПараметрыОтбораЧата(
		Запрос,
		Знач ИдентификаторEBC_Чата,
		Знач ИдентификаторАккаунта,
		Знач Провайдер)

	Запрос.УстановитьПараметр("ИдентификаторЧата", ИдентификаторEBC_Чата);
	Запрос.УстановитьПараметр(
		"ВсеАккаунты",
		ПустаяСтрока(СокрЛП(ИдентификаторАккаунта)));
	Запрос.УстановитьПараметр(
		"ИдентификаторАккаунта",
		СокрЛП(ИдентификаторАккаунта));
	Запрос.УстановитьПараметр(
		"ВсеПровайдеры",
		Не ЗначениеЗаполнено(Провайдер));
	Запрос.УстановитьПараметр("Провайдер", Провайдер);

КонецПроцедуры

// Обновляет локальные данные чата по push-уведомлению NewMessage и возвращает
// ссылку обновленного чата. Остальные типы уведомлений игнорируются.
Функция ОбновитьЧатПоУведомлению(Знач ДанныеУведомленияJSON) Экспорт

	ДанныеУведомления = ПрочитатьОбъектJSON(
		ДанныеУведомленияJSON);
	Если ДанныеУведомления = Неопределено
		Или ПолучитьСтроковоеСвойство(
			ДанныеУведомления,
			"eventType") <> "NewMessage" Тогда
		Возврат Справочники.EBC_Чаты.ПустаяСсылка();
	КонецЕсли;

	Чат = НайтиЧат(
		ПолучитьСтроковоеСвойство(ДанныеУведомления, "chatId"),
		ПолучитьСтроковоеСвойство(ДанныеУведомления, "accountId"),
		ПолучитьСтроковоеСвойство(ДанныеУведомления, "provider"));
	Если Не ЗначениеЗаполнено(Чат) Тогда
		Возврат Справочники.EBC_Чаты.ПустаяСсылка();
	КонецЕсли;

	ОбъектЧата = Чат.ПолучитьОбъект();
	// В карточке чата копится несколько последних сообщений, пока их общая
	// длина укладывается в лимит реквизита.
	// Текст берётся не через ПолучитьСтроковоеСвойство: в уведомлениях о
	// вложениях "text" приходит объектом, и Строка() от него давала в карточке
	// чата слово "Структура".
	ТекстСообщения = "";
	ДанныеУведомления.Свойство("text", ТекстСообщения);
	ОбъектЧата.ТекстПоследнегоСообщения = EBC_Ядро.ДополнитьТекстПоследнихСообщений(
		ОбъектЧата.ТекстПоследнегоСообщения,
		EBC_Ядро.ТекстСообщенияИзДанныхAPI(ТекстСообщения));
	// Даты пишутся в часовом поясе данных: тот же пояс использует синхронизация,
	// иначе сортировка чатов смешивает две шкалы времени.
	МоментСобытия = EBC_Ядро.ТекущаяДатаДанных();
	ОбъектЧата.ДатаПоследнегоСообщения = МоментСобытия;
	ОбъектЧата.ЕстьНепрочитанные = Истина;
	ОбъектЧата.ДатаСинхронизации = МоментСобытия;
	ОбъектЧата.Записать();

	Возврат ОбъектЧата.Ссылка;

КонецФункции

// Всё, что подключаемым командам нужно знать об объекте, одним вызовом.
//
// Команды выполняются на клиенте, а данные лежат на сервере, поэтому серверный
// вызов делается один раз и сразу на все три команды: отдельные вызовы за чатом,
// за количеством связей и за типом объекта - это три обращения к серверу на одно
// нажатие кнопки.
//
// Правило выбора чата - EBC_Ядро.ЧатОбъектаИлиКонтрагента: сначала чат самого
// объекта (основная связь, при её отсутствии последняя по времени установки),
// затем тем же правилом чат его контрагента. Накладную отдельно к чату обычно
// не привязывают - переписка идёт с контрагентом, и открывать нужно её.
//
// Параметры:
//  Объект - ссылка на объект учётной системы.
//
// Возвращаемое значение:
//  Структура:
//   * Доступен             - Булево - объект задан и права на данные расширения есть;
//   * ЕстьЧат              - Булево - чат найден у объекта либо у его контрагента;
//   * Чат                  - СправочникСсылка.EBC_Чаты - чат для открытия и отправки;
//   * ЧатКонтрагента       - Булево - чат взят у контрагента, а не у самого объекта;
//   * Контрагент           - ссылка - контрагент объекта либо Неопределено;
//   * ИдентификаторАккаунта - Строка - для веб-плагина;
//   * ЧатID                - Строка - для веб-плагина;
//   * Провайдер            - Строка - для веб-плагина;
//   * КомпанияEBC          - СправочникСсылка.EBC_Компании;
//   * ТипОбъекта           - Строка - имя таблицы, измерение регистра связей;
//   * ИдентификаторОбъекта - УникальныйИдентификатор - измерение регистра связей;
//   * ЭтоДокумент          - Булево - можно ли передать объект в форму отправки
//                                     как документ;
//   * КоличествоСвязей     - Число.
//
Функция ДанныеОбъектаДляКоманд(Знач Объект) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Доступен", Ложь);
	Результат.Вставить("ЕстьЧат", Ложь);
	Результат.Вставить("Чат", Справочники.EBC_Чаты.ПустаяСсылка());
	Результат.Вставить("ЧатКонтрагента", Ложь);
	Результат.Вставить("Контрагент", Неопределено);
	// Нейтральные поля: в УТ и КУП субъектом контакта обычно оказывается
	// партнёр. Старые "Контрагент" и "ЧатКонтрагента" сохранены как алиасы -
	// структура уходит на клиент в подключаемые команды и может читаться
	// внешними обработками.
	Результат.Вставить("СубъектКонтакта", Неопределено);
	Результат.Вставить("ТипСубъекта", "");
	Результат.Вставить("ЧатСубъекта", Ложь);
	Результат.Вставить("ИдентификаторАккаунта", "");
	Результат.Вставить("ЧатID", "");
	Результат.Вставить("Провайдер", "");
	Результат.Вставить("КомпанияEBC", Справочники.EBC_Компании.ПустаяСсылка());
	Результат.Вставить("ТипОбъекта", "");
	Результат.Вставить("ИдентификаторОбъекта", Новый УникальныйИдентификатор(
		"00000000-0000-0000-0000-000000000000"));
	Результат.Вставить("ЭтоДокумент", Ложь);
	Результат.Вставить("КоличествоСвязей", 0);

	Если Не ЗначениеЗаполнено(Объект) Тогда
		Возврат Результат;
	КонецЕсли;

	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.EBC_СвязиОбъектов) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Доступен = Истина;
	Результат.ТипОбъекта = EBC_Ядро.ИмяТаблицыПоСсылке(Объект);
	Результат.ИдентификаторОбъекта = Объект.УникальныйИдентификатор();
	Результат.ЭтоДокумент = Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Объект));

	Результат.КоличествоСвязей = EBC_Ядро.ЧатыОбъекта(Объект).Количество();

	Субъект = Неопределено;
	Чат = EBC_Ядро.ЧатОбъектаИлиСубъекта(Объект, Субъект);

	Пара = EBC_Ядро.ПараКонтакта(Объект);
	Результат.СубъектКонтакта = Пара.СвязанныйКонтакт;
	Результат.ТипСубъекта = Пара.ТипСвязанногоКонтакта;
	// Алиас: раньше здесь был только контрагент, теперь может быть и партнёр.
	Результат.Контрагент = Пара.СвязанныйКонтакт;

	Если Не ЗначениеЗаполнено(Чат) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Чат = Чат;
	Результат.ЕстьЧат = Истина;
	Результат.ЧатСубъекта = Результат.КоличествоСвязей = 0;
	Результат.ЧатКонтрагента = Результат.ЧатСубъекта;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| Чаты.ИдентификаторEBC КАК ЧатID,
		| Чаты.Владелец.ИдентификаторEBC КАК ИдентификаторАккаунта,
		| Чаты.Владелец.Провайдер КАК Провайдер,
		| Чаты.Владелец.Владелец КАК КомпанияEBC
		|ИЗ
		| Справочник.EBC_Чаты КАК Чаты
		|ГДЕ
		| Чаты.Ссылка = &Чат";
	Запрос.УстановитьПараметр("Чат", Чат);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.ИдентификаторАккаунта = Выборка.ИдентификаторАккаунта;
	Результат.ЧатID = Выборка.ЧатID;
	Результат.Провайдер = XMLСтрока(Выборка.Провайдер);
	Результат.КомпанияEBC = Выборка.КомпанияEBC;

	Возврат Результат;

КонецФункции

// Документ заказа, который расширение создаст по действию веб-плагина.
//
// Действие называется "Створити замовлення", поэтому и создавать оно должно
// именно заказ. Раньше здесь брался первый документ из общего списка настроек:
// после того как администратор менял порядок, по кнопке "заказ" открывался
// счёт или накладная.
//
// Кандидаты перечислены точными именами и проверены по трём конфигурациям.
// Поиск по синониму или подстроке "Заказ" применять нельзя: в конфигурациях
// есть ЗаказПоставщику, ЗаказПереработчику, ЗаказНаПеремещение и другие
// документы совсем другого назначения.
//
// Настройку администратора действие не обходит: если заказ есть в
// конфигурации, но выключен в настройках, это осознанное решение, и молча
// создавать документ мимо настроек неправильно.
//
// Возвращаемое значение:
//  Структура:
//   * Имя     - Строка - полное имя документа либо пустая строка;
//   * Причина - Строка - почему документа нет: "НетВКонфигурации",
//               "НеВключенВНастройках", "НетПрав" либо "" при успехе.
//
Функция ДокументЗаказаДляСоздания() Экспорт

	Результат = Новый Структура("Имя,Причина", "", "НетВКонфигурации");

	Кандидаты = Новый Массив;
	Кандидаты.Добавить("Документ.ЗаказПокупателя");
	Кандидаты.Добавить("Документ.ЗаказКлиента");

	НастроенныеТипы = РегистрыСведений.EBC_ТипыОбъектовПривязки.НастроенныеТипы(Истина);

	Для Каждого ПолноеИмя Из Кандидаты Цикл
		МетаданныеДокумента = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
		Если МетаданныеДокумента = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// Документ в конфигурации есть - дальше причина отказа уточняется.
		Если НастроенныеТипы.Найти(ПолноеИмя, "ПолноеИмя") = Неопределено Тогда
			Результат.Причина = "НеВключенВНастройках";
			Продолжить;
		КонецЕсли;

		Если Не ПравоДоступа("Добавление", МетаданныеДокумента) Тогда
			Результат.Причина = "НетПрав";
			Продолжить;
		КонецЕсли;

		Результат.Имя = ПолноеИмя;
		Результат.Причина = "";
		Возврат Результат;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Первый настроенный документ - вид, который расширение предложит создать.
//
// Устарела: действие "создать заказ" использует ДокументЗаказаДляСоздания.
// Оставлена ради внешних обработок, которые могли на неё ссылаться.
//
// Возвращаемое значение:
//  Строка - полное имя документа либо пустая строка, если документы
//           в настройках не заданы.
//
Функция ПервыйДокументДляСоздания() Экспорт

	Операции = EBC_АдаптерКонфигурации.ПолучитьДоступныеОперацииСоздания();
	Если Операции.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Операции[0].Имя;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьСвязиЧата(Знач ИдентификаторEBC_Чата)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| Связи.ТипОбъекта КАК ТипОбъекта,
		| Связи.ИдентификаторОбъекта КАК ИдентификаторОбъекта,
		| Связи.ПредставлениеОбъекта КАК ПредставлениеОбъекта,
		| Связи.НавигационнаяСсылка КАК НавигационнаяСсылка
		|ИЗ
		| РегистрСведений.EBC_СвязиОбъектов КАК Связи
		|ГДЕ
		| Связи.Чат.ИдентификаторEBC = &ИдентификаторEBC
		|УПОРЯДОЧИТЬ ПО
		| Связи.ОсновнаяСвязь УБЫВ,
		| Связи.ДатаУстановки УБЫВ";
	Запрос.УстановитьПараметр(
		"ИдентификаторEBC",
		ИдентификаторEBC_Чата);

	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса.Выгрузить();

КонецФункции

Функция НайтиЧат(
		Знач ИдентификаторEBC_Чата,
		Знач ИдентификаторАккаунта,
		Знач ИмяПровайдера)

	ИдентификаторEBC_Чата = СокрЛП(ИдентификаторEBC_Чата);
	Если ПустаяСтрока(ИдентификаторEBC_Чата) Тогда
		Возврат Справочники.EBC_Чаты.ПустаяСсылка();
	КонецЕсли;

	Провайдер = ПровайдерИзИмениАПИ(ИмяПровайдера);
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| Чаты.Ссылка КАК Ссылка
		|ИЗ
		| Справочник.EBC_Чаты КАК Чаты
		|ГДЕ
		| Чаты.ИдентификаторEBC = &ИдентификаторЧата
		| И НЕ Чаты.ПометкаУдаления
		| И НЕ Чаты.Владелец.Игнорировать
		| И (&ВсеАккаунты
		|  ИЛИ Чаты.Владелец.ИдентификаторEBC = &ИдентификаторАккаунта)
		| И (&ВсеПровайдеры
		|  ИЛИ Чаты.Владелец.Провайдер = &Провайдер)
		|УПОРЯДОЧИТЬ ПО
		| Чаты.ДатаСинхронизации УБЫВ";
	Запрос.УстановитьПараметр(
		"ИдентификаторЧата",
		ИдентификаторEBC_Чата);
	Запрос.УстановитьПараметр(
		"ВсеАккаунты",
		ПустаяСтрока(СокрЛП(ИдентификаторАккаунта)));
	Запрос.УстановитьПараметр(
		"ИдентификаторАккаунта",
		СокрЛП(ИдентификаторАккаунта));
	Запрос.УстановитьПараметр(
		"ВсеПровайдеры",
		Не ЗначениеЗаполнено(Провайдер));
	Запрос.УстановитьПараметр("Провайдер", Провайдер);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.EBC_Чаты.ПустаяСсылка();

КонецФункции

Функция ПровайдерИзИмениАПИ(Знач ИмяПровайдера)

	Если ПустаяСтрока(СокрЛП(ИмяПровайдера)) Тогда
		Возврат Перечисления.EBC_Провайдеры.ПустаяСсылка();
	КонецЕсли;

	Попытка
		Возврат Перечисления.EBC_Провайдеры[СокрЛП(ИмяПровайдера)];
	Исключение
		Возврат Перечисления.EBC_Провайдеры.ПустаяСсылка();
	КонецПопытки;

КонецФункции

Функция ПолучитьСтроковоеСвойство(Знач Данные, Знач ИмяСвойства)

	ЗначениеСвойства = "";
	Если Данные = Неопределено Тогда
		Возврат ЗначениеСвойства;
	КонецЕсли;

	Попытка
		Данные.Свойство(ИмяСвойства, ЗначениеСвойства);
	Исключение
		Возврат "";
	КонецПопытки;

	Если ЗначениеСвойства = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(Строка(ЗначениеСвойства));

КонецФункции

Функция ПрочитатьОбъектJSON(Знач СтрокаJSON)

	ЧтениеJSON = Новый ЧтениеJSON;
	Попытка
		ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
		Результат = ПрочитатьJSON(ЧтениеJSON);
	Исключение
		Результат = Неопределено;
	КонецПопытки;
	ЧтениеJSON.Закрыть();

	Возврат Результат;

КонецФункции

Функция ДействиеПросмотраОбъекта(Знач СвязьЧата)

	НавигационнаяСсылка = СокрЛП(СвязьЧата.НавигационнаяСсылка);
	Если ПустаяСтрока(НавигационнаяСсылка) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПредставлениеОбъекта = СокрЛП(СвязьЧата.ПредставлениеОбъекта);
	Если ПустаяСтрока(ПредставлениеОбъекта) Тогда
		ПредставлениеОбъекта = СтрШаблон(
			"%1: %2",
			СвязьЧата.ТипОбъекта,
			СвязьЧата.ИдентификаторОбъекта);
	КонецЕсли;

	Действие = Новый Структура;
	Действие.Вставить("id", "view_contact");
	Действие.Вставить(
		"label",
		СтрШаблон(
			НСтр(
				"ru = 'Открыть карточку BAS (%1)';
				|uk = 'Відкрити картку BAS (%1)'"),
			ПредставлениеОбъекта));

	Состояние = Новый Структура;
	Состояние.Вставить("linkState", "linked");
	Состояние.Вставить("refString", НавигационнаяСсылка);
	Действие.Вставить("serverState", Состояние);

	Возврат Действие;

КонецФункции

Функция ДействиеПривязкиКлиента()

	Действие = Новый Структура;
	Действие.Вставить("id", "link_contact");
	Действие.Вставить(
		"label",
		НСтр(
			"ru = 'Привязать клиента в BAS';
			|uk = 'Прив’язати клієнта в BAS'"));
	Действие.Вставить(
		"serverState",
		Новый Структура("linkState", "unlinked"));

	Возврат Действие;

КонецФункции

Функция ЗаписатьОбъектJSON(Знач ОбъектJSON)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ОбъектJSON);
	Возврат ЗаписьJSON.Закрыть();

КонецФункции

#КонецОбласти
