// Модуль EBC_КлиентАПИ
// Низкоуровневый HTTP-транспорт для работы с EasyBusy API.

#Область ПрограммныйИнтерфейс

// Выполняет произвольный JSON HTTP-запрос к API EasyBusy.
Функция ВыполнитьЗапрос(
		Знач Метод,
		Знач Ресурс,
		Параметры = Неопределено,
		Тело = Неопределено,
		ПутьТехническогоЛога = Неопределено) Экспорт

	Настройки = EBC_НастройкиПовтИсп.ТекущиеНастройки();
	БазовыйАдресAPI = Настройки.БазовыйАдресАпи;
	ТокенДоступа = EBC_НастройкиСервер.ПолучитьТокенДоступа();

	Если ПустаяСтрока(ТокенДоступа) Тогда
		Результат = НовыйРезультатЗапроса();
		Результат.КодОшибки = "НеНастроенаАвторизация";
		Результат.ТекстОшибки = НСтр(
			"ru = 'Не настроена авторизация Easy Busy Chat.';
			|uk = 'Не налаштовано авторизацію Easy Busy Chat.'");
		Результат.Ошибка = Результат.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;

	ПараметрыСоединения = РазобратьURL(БазовыйАдресAPI);

	ЗакодированныеПараметры = КодироватьПараметрыЗапроса(Параметры);
	ПолныйПуть = ПараметрыСоединения.ПрефиксПути
		+ Ресурс
		+ ЗакодированныеПараметры;
	Если ПутьТехническогоЛога = Неопределено Тогда
		ПутьТехническогоЛога = Ресурс;
	КонецЕсли;

	HTTPСоединение = СоздатьСоединение(
		ПараметрыСоединения,
		Настройки.ТаймаутСоединенияСек);

	HTTPЗапрос = Новый HTTPЗапрос(ПолныйПуть);
	HTTPЗапрос.Заголовки.Вставить(
		"Authorization",
		"Bearer " + ТокенДоступа);
	HTTPЗапрос.Заголовки.Вставить(
		"Content-Type",
		"application/json; charset=utf-8");

	ТелоЗапроса = "";
	Если Тело <> Неопределено Тогда
		Если ТипЗнч(Тело) = Тип("Строка") Тогда
			ТелоЗапроса = Тело;
		Иначе
			ТелоЗапроса = СериализоватьJSON(Тело);
		КонецЕсли;
		HTTPЗапрос.УстановитьТелоИзСтроки(
			ТелоЗапроса,
			КодировкаТекста.UTF8,
			ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;

	Результат = НовыйРезультатЗапроса();
	МаксимальноеКоличествоПопыток = ПолучитьМаксимальноеКоличествоПопыток(
		Метод,
		Настройки.КоличествоПовторов);

	// Один идентификатор на всё обращение, включая повторы: по нему в журнале
	// собирается история одной операции. Тот же идентификатор уходит на сервер
	// заголовком, поэтому инцидент можно сопоставить с логом API.
	HTTPЗапрос.Заголовки.Вставить(
		"X-Correlation-Id",
		Результат.КорреляционныйИдентификатор);

	КонтекстЛога = КонтекстЛогаЗапроса(
		Метод,
		ПутьТехническогоЛога,
		Результат.КорреляционныйИдентификатор,
		СтрДлина(ТелоЗапроса));

	// Повторов может быть несколько: события копятся и пишутся одним набором.
	ЖурналЗапроса = EBC_Логирование.НовыйБуфер();

	Для НомерПопытки = 1 По МаксимальноеКоличествоПопыток Цикл
		Результат.КоличествоПопыток = НомерПопытки;
		НачалоПопытки = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Попытка
			HTTPОтвет = HTTPСоединение.ВызватьHTTPМетод(Метод, HTTPЗапрос);
			ЗаполнитьРезультатПоHTTPОтвету(Результат, HTTPОтвет);

			Если Результат.Успех Тогда
				ДобавитьСобытиеЗапроса(
					ЖурналЗапроса,
					Перечисления.EBC_УровниЖурнала.Информация,
					КонтекстЛога,
					Результат,
					НомерПопытки,
					НачалоПопытки,
					Результат.СтатусКод);
				Прервать;
			КонецЕсли;

			БудетПовтор = НомерПопытки < МаксимальноеКоличествоПопыток
				И ЭтоПовторяемыйСтатус(Результат.СтатусКод);

			ДобавитьСобытиеЗапроса(
				ЖурналЗапроса,
				?(БудетПовтор,
					Перечисления.EBC_УровниЖурнала.Предупреждение,
					Перечисления.EBC_УровниЖурнала.Ошибка),
				КонтекстЛога,
				Результат,
				НомерПопытки,
				НачалоПопытки,
				Результат.СтатусКод);

			Если БудетПовтор Тогда
				Продолжить;
			КонецЕсли;
			Прервать;
		Исключение
			Результат.КодОшибки = "СетеваяОшибка";
			Если Метод <> "GET" И Метод <> "HEAD" Тогда Результат.СтатусОтправки = "Unknown"; КонецЕсли;
			Результат.Успех = Ложь;
			Результат.ТехническиеДетали = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Результат.ТекстОшибки = ?(Метод = "GET" Или Метод = "HEAD",
				НСтр("ru = 'Не удалось получить ответ Easy Busy Chat. Проверьте подключение к сети.'; uk = 'Не вдалося отримати відповідь Easy Busy Chat. Перевірте підключення до мережі.'"),
				ТекстНеизвестногоРезультата());
			Результат.Ошибка = Результат.ТекстОшибки;
			// Ответа не было: размер от предыдущей попытки вводил бы в заблуждение.
			Результат.РазмерОтвета = 0;

			БудетПовтор = НомерПопытки < МаксимальноеКоличествоПопыток;

			// Статус-кода нет: соединение не состоялось.
			ДобавитьСобытиеЗапроса(
				ЖурналЗапроса,
				?(БудетПовтор,
					Перечисления.EBC_УровниЖурнала.Предупреждение,
					Перечисления.EBC_УровниЖурнала.Ошибка),
				КонтекстЛога,
				Результат,
				НомерПопытки,
				НачалоПопытки,
				0);

			Если БудетПовтор Тогда
				Продолжить;
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;

	EBC_Логирование.ЗаписатьБуфер(ЖурналЗапроса);

	Возврат Результат;

КонецФункции

Функция ПолучитьКомпании() Экспорт
	Возврат ВыполнитьЗапрос("GET", "/chats/v1/companies");
КонецФункции

Функция ПолучитьПользователей(
		Знач КомпанияEBC,
		ПараметрыФильтра = Неопределено) Экспорт

	КомпанияEBC_ID = ЗначениеРеквизита(
		КомпанияEBC,
		"ИдентификаторEBC");
	Если ПустаяСтрока(КомпанияEBC_ID) Тогда
		Возврат РезультатСОшибкой(
			"НеЗаполненИдентификаторКомпании",
			НСтр(
				"ru = 'Не заполнен идентификатор компании.';
				|uk = 'Не заповнено ідентифікатор компанії.'"));
	КонецЕсли;

	Ресурс = "/chats/v1/" + КомпанияEBC_ID + "/users";
	Возврат ВыполнитьЗапрос(
		"GET",
		Ресурс,
		ПараметрыФильтра);

КонецФункции

Функция ПолучитьЧаты(
		Знач КомпанияEBC,
		ПараметрыФильтра = Неопределено) Экспорт

	КомпанияEBC_ID = ЗначениеРеквизита(
		КомпанияEBC,
		"ИдентификаторEBC");
	Если ПустаяСтрока(КомпанияEBC_ID) Тогда
		Возврат РезультатСОшибкой(
			"НеЗаполненИдентификаторКомпании",
			"Не заполнен ID компании.");
	КонецЕсли;

	Ресурс = "/chats/v1/" + КомпанияEBC_ID + "/chats";
	Возврат ВыполнитьЗапрос("GET", Ресурс, ПараметрыФильтра);

КонецФункции

Функция ПолучитьУчастниковЧата(
		Знач Провайдер,
		Знач КомпанияEBC_ID,
		Знач УчетнаяЗаписьEBC_ID,
		Знач ИдентификаторЧата) Экспорт

	Если ТипЗнч(Провайдер) = Тип("Строка") Тогда
		СтрокаПровайдера = НРег(СокрЛП(Провайдер));
	Иначе
		СтрокаПровайдера = ИмяПровайдераДляAPI(Провайдер);
	КонецЕсли;

	Если ПустаяСтрока(СтрокаПровайдера) Тогда
		Возврат РезультатСОшибкой(
			"НеизвестныйПровайдер",
			"Не определен провайдер чата.");
	КонецЕсли;

	ИдентификаторКомпании = СокрЛП(Строка(КомпанияEBC_ID));
	ИдентификаторУчетнойЗаписи = СокрЛП(Строка(УчетнаяЗаписьEBC_ID));
	ИдентификаторЧатаСтрокой = СокрЛП(Строка(ИдентификаторЧата));
	Если ПустаяСтрока(ИдентификаторКомпании)
		Или ПустаяСтрока(ИдентификаторУчетнойЗаписи)
		Или ПустаяСтрока(ИдентификаторЧатаСтрокой) Тогда
		Возврат РезультатСОшибкой(
			"НеполнаяАдресацияЧата",
			"Не заполнены ID компании, учетной записи или чата.");
	КонецЕсли;

	Ресурс = "/chats/v1/" + СтрокаПровайдера
		+ "/" + ИдентификаторКомпании
		+ "/account/" + ИдентификаторУчетнойЗаписи
		+ "/chat/" + ИдентификаторЧатаСтрокой
		+ "/members";

	Возврат ВыполнитьЗапрос(
		"GET",
		Ресурс,
		Неопределено,
		Неопределено,
		"/chats/v1/{provider}/{company}/account/{account}/chat/{chat}/members");

КонецФункции

Функция ПолучитьПровайдеров(Знач КомпанияEBC) Экспорт

	КомпанияEBC_ID = ЗначениеРеквизита(
		КомпанияEBC,
		"ИдентификаторEBC");
	Если ПустаяСтрока(КомпанияEBC_ID) Тогда
		Возврат РезультатСОшибкой(
			"НеЗаполненИдентификаторКомпании",
			"Не заполнен ID компании.");
	КонецЕсли;

	Ресурс = "/chats/v1/" + КомпанияEBC_ID + "/providers";
	Возврат ВыполнитьЗапрос("GET", Ресурс);

КонецФункции

Функция ОтправитьСообщение(
		Знач ИдентификаторEBC,
		Знач Текст) Экспорт

	ДанныеАдресации = ПолучитьДанныеАдресацииЧатаПоИдентификатору(
		ИдентификаторEBC);
	Возврат ОтправитьСообщениеПоАдресации(
		ДанныеАдресации,
		Текст);

КонецФункции

// Отправляет сообщение по уже известной ссылке чата без повторного поиска по ID.
Функция ОтправитьСообщениеВЧат(
		Знач Чат,
		Знач Текст) Экспорт

	ДанныеАдресации = ПолучитьДанныеАдресацииЧата(Чат);
	Возврат ОтправитьСообщениеПоАдресации(
		ДанныеАдресации,
		Текст);

КонецФункции

Функция ОтправитьСообщениеПоАдресации(
		Знач ДанныеАдресации,
		Знач Текст)

	Если Не ДанныеАдресации.Успех Тогда
		Возврат ДанныеАдресации;
	КонецЕсли;
	Если Не ДанныеАдресации.Данные.АккаунтАктивен Тогда
		Возврат РезультатСОшибкой("НеактивнаяУчетнаяЗапись", НСтр(
			"ru = 'Учётная запись отключена или отсутствует в компании. Синхронизируйте аккаунты либо выберите другой чат.';
			|uk = 'Обліковий запис вимкнено або відсутній у компанії. Синхронізуйте акаунти або виберіть інший чат.'"));
	КонецЕсли;

	Ресурс = РесурсЧата(ДанныеАдресации.Данные) + "/message";
	Тело = Новый Структура("text", Текст);
	Результат = ВыполнитьЗапрос("POST", Ресурс, Неопределено, Тело);
	УточнитьРезультатОтправки(Результат);
	Возврат Результат;

КонецФункции

// Отправляет файл непосредственно в переданный локальный чат.
// Файл не повторяется автоматически, чтобы исключить дублирование отправки.
Функция ОтправитьФайлВЧат(
		Знач Чат,
		Знач ДанныеФайла,
		Знач ИмяФайла,
		Знач Заголовок = "",
		Знач ТипФайла = "Document",
		Знач ТипСодержимого = "application/pdf",
		Знач РасширениеПоУмолчанию = "pdf") Экспорт

	Если Не ЗначениеЗаполнено(Чат) Тогда
		Возврат РезультатСОшибкой(
			"НеВыбранЧат",
			НСтр("ru = 'Не выбран чат для отправки файла.'; uk = 'Не вибрано чат для надсилання файлу.'"));
	КонецЕсли;
	Если ТипЗнч(ДанныеФайла) <> Тип("ДвоичныеДанные") Тогда
		Возврат РезультатСОшибкой(
			"НекорректныеДанныеФайла",
			НСтр("ru = 'Данные файла имеют неподдерживаемый тип.'; uk = 'Дані файлу мають непідтримуваний тип.'"));
	КонецЕсли;
	Если ДанныеФайла.Размер() = 0 Тогда
		Возврат РезультатСОшибкой(
			"ПустойФайл",
			НСтр("ru = 'Файл пуст.'; uk = 'Файл порожній.'"));
	КонецЕсли;

	Настройки = EBC_НастройкиПовтИсп.ТекущиеНастройки();
	МаксимальныйРазмерБайт =
		Настройки.МаксимальныйРазмерФайлаМБ * 1024 * 1024;
	Если МаксимальныйРазмерБайт > 0
		И ДанныеФайла.Размер() > МаксимальныйРазмерБайт Тогда
		Возврат РезультатСОшибкой(
			"ПревышенРазмерФайла",
			СтрШаблон(
				НСтр("ru = 'Размер файла превышает допустимые %1 МБ.'; uk = 'Розмір файлу перевищує допустимі %1 МБ.'"),
				Настройки.МаксимальныйРазмерФайлаМБ));
	КонецЕсли;

	ДанныеАдресации = ПолучитьДанныеАдресацииЧата(Чат);
	Если Не ДанныеАдресации.Успех Тогда
		Возврат ДанныеАдресации;
	КонецЕсли;
	Если Не ДанныеАдресации.Данные.АккаунтАктивен Тогда
		Возврат РезультатСОшибкой("НеактивнаяУчетнаяЗапись", НСтр(
			"ru = 'Учётная запись отключена или отсутствует в компании. Синхронизируйте аккаунты либо выберите другой чат.';
			|uk = 'Обліковий запис вимкнено або відсутній у компанії. Синхронізуйте акаунти або виберіть інший чат.'"));
	КонецЕсли;

	ПроверкаФайла = ПроверитьТипФайла(ТипФайла, ТипСодержимого,
		ДанныеАдресации.Данные.ДопустимыеТипыФайлов);
	Если Не ПроверкаФайла.Успех Тогда Возврат ПроверкаФайла; КонецЕсли;
	ТипФайла = ПроверкаФайла.Данные.ТипФайла;
	ТипСодержимого = ПроверкаФайла.Данные.MIME;

	ТокенДоступа = EBC_НастройкиСервер.ПолучитьТокенДоступа();
	Если ПустаяСтрока(ТокенДоступа) Тогда
		Возврат РезультатСОшибкой(
			"НеНастроенаАвторизация",
			НСтр("ru = 'Не настроена авторизация Easy Busy Chat.'; uk = 'Не налаштовано авторизацію Easy Busy Chat.'"));
	КонецЕсли;

	ПараметрыСоединения = РазобратьURL(Настройки.БазовыйАдресАпи);
	HTTPСоединение = СоздатьСоединение(
		ПараметрыСоединения,
		Настройки.ТаймаутСоединенияСек);

	Разделитель = "EBC" + СтрЗаменить(
		Строка(Новый УникальныйИдентификатор()),
		"-",
		"");
	ТелоЗапроса = СформироватьMultipartФайла(
		Разделитель,
		БезопасноеИмяФайла(ИмяФайла, РасширениеПоУмолчанию),
		Заголовок,
		ДанныеФайла,
		ТипФайла,
		ТипСодержимого);

	Ресурс = РесурсЧата(ДанныеАдресации.Данные) + "/file";
	HTTPЗапрос = Новый HTTPЗапрос(
		ПараметрыСоединения.ПрефиксПути + Ресурс);
	HTTPЗапрос.Заголовки.Вставить(
		"Authorization",
		"Bearer " + ТокенДоступа);
	HTTPЗапрос.Заголовки.Вставить("Accept", "application/json");
	HTTPЗапрос.Заголовки.Вставить(
		"Content-Type",
		"multipart/form-data; boundary=" + Разделитель);
	HTTPЗапрос.УстановитьТелоИзДвоичныхДанных(ТелоЗапроса);

	Результат = НовыйРезультатЗапроса();
	Результат.КоличествоПопыток = 1;
	HTTPЗапрос.Заголовки.Вставить(
		"X-Correlation-Id",
		Результат.КорреляционныйИдентификатор);

	КонтекстЛога = КонтекстЛогаЗапроса(
		"POST",
		Ресурс,
		Результат.КорреляционныйИдентификатор,
		ДанныеФайла.Размер());
	КонтекстЛога.Детали = СтрШаблон(
		"%1, байт: %2",
		ТипФайла,
		ДанныеФайла.Размер());

	ЖурналЗапроса = EBC_Логирование.НовыйБуфер();
	НачалоОтправки = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		HTTPОтвет = HTTPСоединение.ВызватьHTTPМетод("POST", HTTPЗапрос);
		ЗаполнитьРезультатПоHTTPОтвету(Результат, HTTPОтвет);
		УточнитьРезультатОтправки(Результат);
		ДобавитьСобытиеЗапроса(
			ЖурналЗапроса,
			?(Результат.Успех,
				Перечисления.EBC_УровниЖурнала.Информация,
				Перечисления.EBC_УровниЖурнала.Ошибка),
			КонтекстЛога,
			Результат,
			1,
			НачалоОтправки,
			Результат.СтатусКод);
	Исключение
		Результат.КодОшибки = "СетеваяОшибка";
		Результат.Успех = Ложь;
		Результат.СтатусОтправки = "Unknown";
		Результат.ТехническиеДетали = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Результат.ТекстОшибки = ТекстНеизвестногоРезультата();
		Результат.Ошибка = Результат.ТекстОшибки;
		ДобавитьСобытиеЗапроса(
			ЖурналЗапроса,
			Перечисления.EBC_УровниЖурнала.Ошибка,
			КонтекстЛога,
			Результат,
			1,
			НачалоОтправки,
			0);
	КонецПопытки;

	EBC_Логирование.ЗаписатьБуфер(ЖурналЗапроса);

	Возврат Результат;

КонецФункции

// Записывает диагностическое событие, не связанное с конкретным HTTP-вызовом
// этого модуля: результат уже получен вызывающим кодом.
//
// Параметры:
//  Уровень    - ПеречислениеСсылка.EBC_УровниЖурнала
//  МетодИПуть - Строка - например "GET /chats/v1/{id}/chats"; строка запроса
//               отбрасывается при записи.
//  Событие    - Строка - имя операции для отбора в журнале.
//
Процедура ЗаписатьДиагностику(
		Знач Уровень,
		Знач МетодИПуть,
		Знач Компания = Неопределено,
		Знач СтатусКод = 0,
		Знач КодОшибки = "",
		Знач ТекстОшибки = "",
		Знач Событие = "Диагностика") Экспорт

	АдресЗапроса = EBC_Логирование.РазобратьМетодИПуть(МетодИПуть);

	ОписаниеСобытия = EBC_Логирование.НовоеСобытие(Уровень, Событие);
	ОписаниеСобытия.Метод = АдресЗапроса.Метод;
	ОписаниеСобытия.Путь = АдресЗапроса.Путь;
	ОписаниеСобытия.СтатусКод = СтатусКод;
	ОписаниеСобытия.КодОшибки = КодОшибки;
	ОписаниеСобытия.ТекстОшибки = ТекстОшибки;
	Если ЗначениеЗаполнено(Компания) Тогда
		ОписаниеСобытия.Компания = Компания;
	КонецЕсли;

	EBC_Логирование.Записать(ОписаниеСобытия);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверка выполняется до создания multipart и HTTP-запроса. Возможности берутся
// из acceptedFileTypes выбранной учётной записи, а не из имени мессенджера.
Функция ПроверитьТипФайла(Знач ТипФайла, Знач MIME, Знач ДопустимыеТипы, Знач Язык = "")

	Результат = НовыйРезультатЗапроса();
	Если ТипЗнч(ТипФайла) <> Тип("Строка") Тогда ТипФайла = ""; КонецЕсли;
	Если ТипЗнч(MIME) <> Тип("Строка") Тогда MIME = ""; КонецЕсли;
	ТипФайла = НРег(СокрЛП(ТипФайла));
	MIME = НРег(СокрЛП(MIME));
	Типы = Новый Соответствие;
	Типы.Вставить("image", "Photo"); // Совместимость с прежними внешними вызовами.
	Типы.Вставить("photo", "Photo");
	Типы.Вставить("document", "Document");
	Типы.Вставить("video", "Video");
	Типы.Вставить("audio", "Audio");
	КаноническийТип = Типы.Получить(ТипФайла);
	ЧастиMIME = СтрРазделить(MIME, "/", Истина);
	КорректныйMIME = ЧастиMIME.Количество() = 2;
	Если КорректныйMIME Тогда
		КорректныйMIME = Не ПустаяСтрока(ЧастиMIME[0]) И Не ПустаяСтрока(ЧастиMIME[1]);
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(MIME) Цикл
		Если СтрНайти("abcdefghijklmnopqrstuvwxyz0123456789!#$&^_.+-/", Сред(MIME, Индекс, 1)) = 0 Тогда
			КорректныйMIME = Ложь;
		КонецЕсли;
	КонецЦикла;
	Если КаноническийТип = Неопределено Или Не КорректныйMIME Тогда
		Возврат РезультатСОшибкой("НекорректныйТипФайла", НСтр(
			"ru = 'Не удалось определить допустимый тип файла. Выберите другой файл.';
			|uk = 'Не вдалося визначити допустимий тип файлу. Виберіть інший файл.'", Язык));
	КонецЕсли;
	Если (КаноническийТип = "Photo" И Не СтрНачинаетсяС(MIME, "image/"))
		Или (КаноническийТип = "Video" И Не СтрНачинаетсяС(MIME, "video/"))
		Или (КаноническийТип = "Audio" И Не СтрНачинаетсяС(MIME, "audio/")) Тогда
		Возврат РезультатСОшибкой("НесоответствиеТипаФайла", НСтр(
			"ru = 'Тип вложения не соответствует формату файла. Выберите файл заново.';
			|uk = 'Тип вкладення не відповідає формату файлу. Виберіть файл знову.'", Язык));
	КонецЕсли;
	Если ТипЗнч(ДопустимыеТипы) <> Тип("Строка") Тогда ДопустимыеТипы = ""; КонецЕсли;
	Если ПустаяСтрока(ДопустимыеТипы) Тогда
		Возврат РезультатСОшибкой("НеизвестныТипыФайлов", НСтр(
			"ru = 'Для выбранного аккаунта не получен список допустимых файлов. Выполните синхронизацию аккаунтов и выберите чат заново.';
			|uk = 'Для вибраного акаунта не отримано список допустимих файлів. Виконайте синхронізацію акаунтів і виберіть чат знову.'", Язык));
	КонецЕсли;
	Для Каждого Маска Из СтрРазделить(НРег(ДопустимыеТипы), ",", Ложь) Цикл
		Маска = СокрЛП(Маска);
		Если Маска = "*" Или Маска = "*/*" Или Маска = MIME
			Или (Маска = ЧастиMIME[0] + "/*") Тогда
			Результат.Успех = Истина;
			Результат.Данные = Новый Структура("ТипФайла,MIME", КаноническийТип, MIME);
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	Возврат РезультатСОшибкой("НедопустимыйТипФайла", СтрШаблон(НСтр(
		"ru = 'Выбранный канал не принимает файлы %1. Допустимые типы: %2. Для печатной формы используйте отправку картинкой или выберите другой чат.';
		|uk = 'Вибраний канал не приймає файли %1. Допустимі типи: %2. Для друкованої форми використайте надсилання картинкою або виберіть інший чат.'", Язык),
		MIME, ДопустимыеТипы));

КонецФункции

Функция СтроковоеПолеОтвета(Знач Данные, Знач Имя)
	Значение = Неопределено;
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Данные.Свойство(Имя, Значение);
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") Или ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат СокрЛП(Строка(Значение));
	КонецЕсли;
	Возврат "";
КонецФункции

// Технический текст API сохраняется отдельно и не выводится пользователю.
Функция ТекстОшибкиСервиса(Знач КодHTTP, Знач Данные, Знач Язык = "")
	Код = НРег(СтроковоеПолеОтвета(Данные, "code"));
	Деталь = НРег(СтроковоеПолеОтвета(Данные, "detailCode"));
	Сообщение = НРег(СтроковоеПолеОтвета(Данные, "message"));
	Если СтрНайти(Сообщение, "outside of allowed window") > 0 Тогда
		Возврат НСтр("ru = 'Канал отклонил отправку: разрешённое окно переписки закрыто. Дождитесь нового сообщения получателя и повторите отправку после открытия окна.';
			|uk = 'Канал відхилив надсилання: дозволене вікно листування закрито. Дочекайтеся нового повідомлення одержувача та повторіть надсилання після відкриття вікна.'", Язык);
	ИначеЕсли Деталь = "sessionnotready" Или Код = "invalidsession" Тогда
		Возврат НСтр("ru = 'Сессия канала не готова. Проверьте подключение аккаунта в Easy Busy Chat.';
			|uk = 'Сесія каналу не готова. Перевірте підключення акаунта в Easy Busy Chat.'", Язык);
	ИначеЕсли Деталь = "undefinedcompanyaccount" Или Деталь = "companyisnotready" Тогда
		Возврат НСтр("ru = 'Аккаунт или компания не готовы к работе. Проверьте настройки и синхронизируйте аккаунты.';
			|uk = 'Акаунт або компанія не готові до роботи. Перевірте налаштування та синхронізуйте акаунти.'", Язык);
	ИначеЕсли КодHTTP = 401 Или КодHTTP = 403 Тогда
		Возврат НСтр("ru = 'Easy Busy Chat отказал в доступе. Проверьте авторизацию и права доступа к аккаунту.';
			|uk = 'Easy Busy Chat відмовив у доступі. Перевірте авторизацію та права доступу до акаунта.'", Язык);
	ИначеЕсли КодHTTP = 402 Или Код = "payment" Тогда
		Возврат НСтр("ru = 'Операция недоступна по условиям оплаты. Проверьте тариф и баланс Easy Busy Chat.';
			|uk = 'Операція недоступна за умовами оплати. Перевірте тариф і баланс Easy Busy Chat.'", Язык);
	ИначеЕсли КодHTTP = 404 Тогда
		Возврат НСтр("ru = 'Чат или аккаунт не найден. Синхронизируйте данные и выберите чат заново.';
			|uk = 'Чат або акаунт не знайдено. Синхронізуйте дані та виберіть чат знову.'", Язык);
	ИначеЕсли КодHTTP = 413 Тогда
		Возврат НСтр("ru = 'Канал отклонил файл из-за размера. Уменьшите файл и повторите отправку.';
			|uk = 'Канал відхилив файл через розмір. Зменште файл і повторіть надсилання.'", Язык);
	ИначеЕсли КодHTTP = 415 Тогда
		Возврат НСтр("ru = 'Канал не поддерживает формат файла. Выберите другой формат или чат.';
			|uk = 'Канал не підтримує формат файлу. Виберіть інший формат або чат.'", Язык);
	ИначеЕсли КодHTTP = 429 Или Код = "requestlimit" Тогда
		Возврат НСтр("ru = 'Превышен лимит запросов Easy Busy Chat. Подождите перед следующей попыткой.';
			|uk = 'Перевищено ліміт запитів Easy Busy Chat. Зачекайте перед наступною спробою.'", Язык);
	ИначеЕсли КодHTTP >= 500 Тогда
		Возврат НСтр("ru = 'Сбой сервиса Easy Busy Chat. Если выполнялась отправка, проверьте историю чата перед повтором, чтобы не создать дубликат.';
			|uk = 'Збій сервісу Easy Busy Chat. Якщо виконувалося надсилання, перевірте історію чату перед повтором, щоб не створити дублікат.'", Язык);
	ИначеЕсли КодHTTP = 400 Или КодHTTP = 409 Тогда
		Возврат НСтр("ru = 'Easy Busy Chat отклонил запрос. Проверьте выбранный чат, содержимое сообщения и формат вложения.';
			|uk = 'Easy Busy Chat відхилив запит. Перевірте вибраний чат, вміст повідомлення та формат вкладення.'", Язык);
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = 'Easy Busy Chat вернул ошибку (HTTP %1). Обратитесь к администратору с кодом ошибки.';
		|uk = 'Easy Busy Chat повернув помилку (HTTP %1). Зверніться до адміністратора з кодом помилки.'", Язык), КодHTTP);
КонецФункции

Функция ТекстНеизвестногоРезультата(Знач Язык = "")
	Возврат НСтр("ru = 'Результат отправки не подтверждён. Проверьте историю чата перед повтором, чтобы не отправить сообщение дважды.';
		|uk = 'Результат надсилання не підтверджено. Перевірте історію чату перед повтором, щоб не надіслати повідомлення двічі.'", Язык);
КонецФункции

Процедура УточнитьРезультатОтправки(Результат, Знач Язык = "")
	Если Не Результат.Успех Тогда Возврат; КонецЕсли;
	Статус = НРег(СтроковоеПолеОтвета(Результат.Данные, "status"));
	ОписаниеСтатуса = НРег(СтроковоеПолеОтвета(Результат.Данные, "statusMessage"));
	Результат.ИдентификаторСообщения = СтроковоеПолеОтвета(Результат.Данные, "messageId");
	Если Статус = "failed" Или Статус = "error" Или ОписаниеСтатуса = "failed" Тогда
		Результат.Успех = Ложь;
		Результат.СтатусОтправки = "Failed";
		Результат.КодОшибки = "ОшибкаОтправки";
		Результат.ТекстОшибки = НСтр("ru = 'Канал сообщил об ошибке отправки. Проверьте состояние аккаунта и историю чата.';
			|uk = 'Канал повідомив про помилку надсилання. Перевірте стан акаунта та історію чату.'", Язык);
		Результат.Ошибка = Результат.ТекстОшибки;
	ИначеЕсли ОписаниеСтатуса = "queued" Или Статус = "queued" Тогда
		Результат.ПринятоВОчередь = Истина;
		Результат.СтатусОтправки = "Queued";
		Результат.ТекстРезультата = НСтр("ru = 'Сообщение принято в очередь. Отправка и доставка пока не подтверждены. Проверьте историю чата позже.';
			|uk = 'Повідомлення прийнято в чергу. Надсилання та доставку поки не підтверджено. Перевірте історію чату пізніше.'", Язык);
	ИначеЕсли Не ПустаяСтрока(Результат.ИдентификаторСообщения) Тогда
		Результат.СтатусОтправки = "Accepted";
		Результат.ТекстРезультата = НСтр("ru = 'Сообщение принято сервисом. Доставку получателю проверяйте в истории чата.';
			|uk = 'Повідомлення прийнято сервісом. Доставку одержувачу перевіряйте в історії чату.'", Язык);
	Иначе
		Результат.Успех = Ложь;
		Результат.СтатусОтправки = "Unknown";
		Результат.КодОшибки = "НеизвестныйРезультатОтправки";
		Результат.ТекстОшибки = ТекстНеизвестногоРезультата(Язык);
		Результат.Ошибка = Результат.ТекстОшибки;
	КонецЕсли;
КонецПроцедуры

Функция НовыйРезультатЗапроса()

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("СтатусКод", 0);
	Результат.Вставить("КодОтвета", 0);
	Результат.Вставить("Данные", Неопределено);
	Результат.Вставить("КодОшибки", "");
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("Ошибка", "");
	Результат.Вставить(
		"КорреляционныйИдентификатор",
		Строка(Новый УникальныйИдентификатор()));
	Результат.Вставить("КоличествоПопыток", 0);
	Результат.Вставить("РазмерОтвета", 0);
	Результат.Вставить("ПринятоВОчередь", Ложь);
	Результат.Вставить("СтатусОтправки", "");
	Результат.Вставить("ИдентификаторСообщения", "");
	Результат.Вставить("ТекстРезультата", "");
	Результат.Вставить("ТехническиеДетали", "");
	Результат.Вставить("КодДетализации", "");
	Возврат Результат;

КонецФункции

Функция РезультатСОшибкой(Знач КодОшибки, Знач ТекстОшибки)
	Результат = НовыйРезультатЗапроса();
	Результат.КодОшибки = КодОшибки;
	Результат.ТекстОшибки = ТекстОшибки;
	Результат.Ошибка = ТекстОшибки;
	Возврат Результат;
КонецФункции

Процедура ЗаполнитьРезультатПоHTTPОтвету(Результат, Знач HTTPОтвет)
	СтрокаОтвета = "";
	Попытка
		СтрокаОтвета = HTTPОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Исключение
		СтрокаОтвета = "";
	КонецПопытки;
	ЗаполнитьРезультатПоОтвету(Результат, HTTPОтвет.КодСостояния, СтрокаОтвета);
КонецПроцедуры

// Отдельно от транспорта: одинаковая обработка JSON, HTML и пустого ответа.
Процедура ЗаполнитьРезультатПоОтвету(Результат, Знач КодHTTP, Знач СтрокаОтвета, Знач Язык = "")
	Результат.Успех = Ложь;
	Результат.Данные = Неопределено;
	Результат.КодОшибки = "";
	Результат.ТекстОшибки = "";
	Результат.Ошибка = "";
	Результат.ТехническиеДетали = "";
	Результат.КодДетализации = "";
	Результат.СтатусКод = КодHTTP;
	Результат.КодОтвета = КодHTTP;
	Результат.РазмерОтвета = СтрДлина(СтрокаОтвета);
	Результат.ПринятоВОчередь = Ложь;
	Результат.СтатусОтправки = "";
	Результат.ИдентификаторСообщения = "";
	Результат.ТекстРезультата = "";
	Если КодHTTP >= 200 И КодHTTP < 300 Тогда
		Результат.Успех = Истина;
		Результат.Данные = ДесериализоватьJSON(СтрокаОтвета);
		Возврат;
	КонецЕсли;
	ДанныеОшибки = ДесериализоватьJSON(СтрокаОтвета);
	Результат.КодОшибки = СтроковоеПолеОтвета(ДанныеОшибки, "code");
	Если ПустаяСтрока(Результат.КодОшибки) Тогда
		Результат.КодОшибки = "HTTP" + Строка(КодHTTP);
	КонецЕсли;
	Результат.КодДетализации = СтроковоеПолеОтвета(ДанныеОшибки, "detailCode");
	Результат.ТехническиеДетали = Лев(СтрокаОтвета, 4000);
	Результат.ТекстОшибки = ТекстОшибкиСервиса(КодHTTP, ДанныеОшибки, Язык);
	Результат.Ошибка = Результат.ТекстОшибки;
КонецПроцедуры

Функция ПолучитьДанныеАдресацииЧата(Знач Чат)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 2
		| Чат.ИдентификаторEBC КАК ЧатID,
		| УчетнаяЗапись.ИдентификаторEBC КАК АккаунтID,
		| УчетнаяЗапись.Провайдер КАК Провайдер,
		| ЕСТЬNULL(УчетнаяЗапись.ДопустимыеТипыФайлов, """") КАК ДопустимыеТипыФайлов,
		| ЕСТЬNULL(УчетнаяЗапись.Активна, ЛОЖЬ)
		|  И НЕ ЕСТЬNULL(УчетнаяЗапись.ПометкаУдаления, ИСТИНА) КАК АккаунтАктивен,
		| Компания.ИдентификаторEBC КАК КомпанияID
		|ИЗ
		| Справочник.EBC_Чаты КАК Чат
		|  ЛЕВОЕ СОЕДИНЕНИЕ Справочник.EBC_УчетныеЗаписи КАК УчетнаяЗапись
		|  ПО Чат.Владелец = УчетнаяЗапись.Ссылка
		|  ЛЕВОЕ СОЕДИНЕНИЕ Справочник.EBC_Компании КАК Компания
		|  ПО УчетнаяЗапись.Владелец = Компания.Ссылка
		|ГДЕ
		| Чат.Ссылка = &Чат";
	Запрос.УстановитьПараметр("Чат", Чат);
	РезультатЗапроса = Запрос.Выполнить();
	Возврат ДанныеАдресацииИзРезультатаЗапроса(РезультатЗапроса);

КонецФункции

Функция ПолучитьДанныеАдресацииЧатаПоИдентификатору(
		Знач ИдентификаторEBC)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 2
		| Чат.ИдентификаторEBC КАК ЧатID,
		| УчетнаяЗапись.ИдентификаторEBC КАК АккаунтID,
		| УчетнаяЗапись.Провайдер КАК Провайдер,
		| ЕСТЬNULL(УчетнаяЗапись.ДопустимыеТипыФайлов, """") КАК ДопустимыеТипыФайлов,
		| ЕСТЬNULL(УчетнаяЗапись.Активна, ЛОЖЬ)
		|  И НЕ ЕСТЬNULL(УчетнаяЗапись.ПометкаУдаления, ИСТИНА) КАК АккаунтАктивен,
		| Компания.ИдентификаторEBC КАК КомпанияID
		|ИЗ
		| Справочник.EBC_Чаты КАК Чат
		|  ЛЕВОЕ СОЕДИНЕНИЕ Справочник.EBC_УчетныеЗаписи КАК УчетнаяЗапись
		|  ПО Чат.Владелец = УчетнаяЗапись.Ссылка
		|  ЛЕВОЕ СОЕДИНЕНИЕ Справочник.EBC_Компании КАК Компания
		|  ПО УчетнаяЗапись.Владелец = Компания.Ссылка
		|ГДЕ
		| Чат.ИдентификаторEBC = &ИдентификаторEBC";
	Запрос.УстановитьПараметр(
		"ИдентификаторEBC",
		ИдентификаторEBC);
	РезультатЗапроса = Запрос.Выполнить();
	Возврат ДанныеАдресацииИзРезультатаЗапроса(РезультатЗапроса);

КонецФункции

Функция ДанныеАдресацииИзРезультатаЗапроса(Знач РезультатЗапроса)

	Если РезультатЗапроса.Пустой() Тогда
		Возврат РезультатСОшибкой(
			"ЧатНеНайден",
			НСтр("ru = 'Чат не найден.'; uk = 'Чат не знайдено.'"));
	КонецЕсли;

	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	Данные = Новый Структура(
		"ЧатID,АккаунтID,Провайдер,КомпанияID,ДопустимыеТипыФайлов,АккаунтАктивен",
		Выборка.ЧатID,
		Выборка.АккаунтID,
		Выборка.Провайдер,
		Выборка.КомпанияID,
		Выборка.ДопустимыеТипыФайлов,
		Выборка.АккаунтАктивен);

	Если Выборка.Следующий() Тогда
		Возврат РезультатСОшибкой(
			"НеоднозначныйЧат",
			НСтр("ru = 'Найдено несколько вариантов адресации чата.'; uk = 'Знайдено кілька варіантів адресації чату.'"));
	КонецЕсли;
	Если ПустаяСтрока(Данные.ЧатID)
		Или ПустаяСтрока(Данные.КомпанияID)
		Или ПустаяСтрока(Данные.АккаунтID) Тогда
		Возврат РезультатСОшибкой(
			"НеполнаяАдресацияЧата",
			НСтр("ru = 'Не заполнены ID компании, аккаунта или чата.'; uk = 'Не заповнено ID компанії, акаунта або чату.'"));
	КонецЕсли;

	СтрокаПровайдера = ИмяПровайдераДляAPI(Данные.Провайдер);
	Если ПустаяСтрока(СтрокаПровайдера) Тогда
		Возврат РезультатСОшибкой(
			"НеизвестныйПровайдер",
			НСтр("ru = 'Не определён провайдер выбранного чата.'; uk = 'Не визначено провайдера вибраного чату.'"));
	КонецЕсли;
	Данные.Провайдер = СтрокаПровайдера;

	Результат = НовыйРезультатЗапроса();
	Результат.Успех = Истина;
	Результат.Данные = Данные;
	Возврат Результат;

КонецФункции

Функция РесурсЧата(Знач ДанныеАдресации)
	Возврат "/chats/v1/" + ДанныеАдресации.Провайдер
		+ "/" + ДанныеАдресации.КомпанияID
		+ "/account/" + ДанныеАдресации.АккаунтID
		+ "/chat/" + ДанныеАдресации.ЧатID;
КонецФункции

Функция СформироватьMultipartФайла(
		Знач Разделитель,
		Знач ИмяФайла,
		Знач Заголовок,
		Знач ДанныеФайла,
		Знач ТипФайла,
		Знач ТипСодержимого)

	Поток = Новый ПотокВПамяти();
	// CRLF задаётся явно; конвертация отключена, чтобы не получить CRCRLF.
	Запись = Новый ЗаписьДанных(Поток, КодировкаТекста.UTF8, , Символы.ВК + Символы.ПС, "", Ложь);
	ЗаписатьПолеMultipart(Запись, Разделитель, "Type", ТипФайла);
	ЗаписатьПолеMultipart(Запись, Разделитель, "Caption", Заголовок);

	Запись.ЗаписатьСтроку("--" + Разделитель);
	Запись.ЗаписатьСтроку(
		"Content-Disposition: form-data; name=""File""; filename="""
		+ ИмяФайла
		+ """");
	Запись.ЗаписатьСтроку("Content-Type: " + ТипСодержимого);
	Запись.ЗаписатьСтроку("");
	Запись.Записать(ДанныеФайла);
	Запись.ЗаписатьСтроку("");
	Запись.ЗаписатьСтроку("--" + Разделитель + "--");
	Запись.Закрыть();

	Возврат Поток.ЗакрытьИПолучитьДвоичныеДанные();

КонецФункции

Процедура ЗаписатьПолеMultipart(
		Запись,
		Знач Разделитель,
		Знач ИмяПоля,
		Знач ЗначениеПоля)

	Запись.ЗаписатьСтроку("--" + Разделитель);
	Запись.ЗаписатьСтроку(
		"Content-Disposition: form-data; name="""
		+ ИмяПоля
		+ """");
	Запись.ЗаписатьСтроку("");
	Запись.ЗаписатьСтроку(Строка(ЗначениеПоля));

КонецПроцедуры

Функция БезопасноеИмяФайла(Знач ИмяФайла, Знач РасширениеПоУмолчанию = "pdf")

	Результат = СокрЛП(Строка(ИмяФайла));
	Расширение = НРег(СокрЛП(Строка(РасширениеПоУмолчанию)));
	Расширение = СтрЗаменить(Расширение, ".", "");
	Расширение = СтрЗаменить(Расширение, "/", "");
	Расширение = СтрЗаменить(Расширение, "\", "");
	Если ПустаяСтрока(Расширение) Тогда
		Расширение = "pdf";
	КонецЕсли;
	ТребуемоеРасширение = "." + Расширение;

	Результат = СтрЗаменить(Результат, Символы.ПС, "_");
	Результат = СтрЗаменить(Результат, Символы.ВК, "_");
	Результат = СтрЗаменить(Результат, """", "_");
	Результат = СтрЗаменить(Результат, "/", "_");
	Результат = СтрЗаменить(Результат, "\", "_");
	Если ПустаяСтрока(Результат) Тогда
		Результат = "document" + ТребуемоеРасширение;
	КонецЕсли;
	Если НРег(Прав(Результат, СтрДлина(ТребуемоеРасширение))) <> ТребуемоеРасширение Тогда
		МаксимальнаяДлинаОсновы = 180 - СтрДлина(ТребуемоеРасширение);
		Результат = Лев(Результат, МаксимальнаяДлинаОсновы) + ТребуемоеРасширение;
	КонецЕсли;
	Возврат Лев(Результат, 180);

КонецФункции

Функция РазобратьURL(Знач URL)

	URLСтрокой = СокрЛП(Строка(URL));
	Хост = "";
	ПрефиксПути = "";
	Порт = 80;
	ЭтоHTTPS = Лев(НРег(URLСтрокой), 8) = "https://";

	Если ЭтоHTTPS Тогда
		АдресБезПротокола = Сред(URLСтрокой, 9);
		Порт = 443;
	ИначеЕсли Лев(НРег(URLСтрокой), 7) = "http://" Тогда
		АдресБезПротокола = Сред(URLСтрокой, 8);
	Иначе
		АдресБезПротокола = URLСтрокой;
	КонецЕсли;

	ПозицияСлеша = Найти(АдресБезПротокола, "/");
	Если ПозицияСлеша = 0 Тогда
		Хост = АдресБезПротокола;
	Иначе
		Хост = Лев(АдресБезПротокола, ПозицияСлеша - 1);
		ПрефиксПути = Сред(АдресБезПротокола, ПозицияСлеша);
	КонецЕсли;

	ПозицияДвоеточия = Найти(Хост, ":");
	Если ПозицияДвоеточия > 0 Тогда
		ПортСтрокой = Сред(Хост, ПозицияДвоеточия + 1);
		Хост = Лев(Хост, ПозицияДвоеточия - 1);
		Попытка
			Порт = Число(ПортСтрокой);
		Исключение
			Если ЭтоHTTPS Тогда
				Порт = 443;
			Иначе
				Порт = 80;
			КонецЕсли;
		КонецПопытки;
	КонецЕсли;

	Возврат Новый Структура(
		"Хост,ПрефиксПути,Порт,ЭтоHTTPS",
		Хост,
		ПрефиксПути,
		Порт,
		ЭтоHTTPS);

КонецФункции

Функция СоздатьСоединение(
		Знач ПараметрыСоединения,
		Знач ТаймаутСоединенияСек)

	ЗащищенноеСоединение = Неопределено;
	Если ПараметрыСоединения.ЭтоHTTPS Тогда
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
	КонецЕсли;

	Если ТаймаутСоединенияСек <= 0 Тогда
		ТаймаутСоединенияСек = 30;
	КонецЕсли;

	Возврат Новый HTTPСоединение(
		ПараметрыСоединения.Хост,
		ПараметрыСоединения.Порт,
		,
		,
		,
		ТаймаутСоединенияСек,
		ЗащищенноеСоединение);

КонецФункции

Функция ПолучитьМаксимальноеКоличествоПопыток(
		Знач Метод,
		Знач КоличествоПовторов)

	Результат = 1;
	Если Не ЭтоБезопасныйМетодДляПовтора(Метод) Тогда
		Возврат Результат;
	КонецЕсли;

	Повторы = 0;
	Если ЗначениеЗаполнено(КоличествоПовторов) Тогда
		Повторы = КоличествоПовторов;
	КонецЕсли;
	Если Повторы < 0 Тогда
		Повторы = 0;
	КонецЕсли;
	Результат = 1 + Мин(Цел(Повторы), 3);
	Возврат Результат;

КонецФункции

Функция ЭтоБезопасныйМетодДляПовтора(Знач Метод)
	НормализованныйМетод = НРег(СокрЛП(Строка(Метод)));
	Возврат НормализованныйМетод = "get"
		Или НормализованныйМетод = "head";
КонецФункции

Функция ЭтоПовторяемыйСтатус(Знач КодСостояния)
	Возврат КодСостояния = 408
		Или КодСостояния = 429
		Или КодСостояния >= 500 И КодСостояния <= 599;
КонецФункции

Функция КодироватьПараметрыЗапроса(Знач Параметры)

	Если Параметры = Неопределено
		Или Параметры.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Результат = "";
	Для Каждого КлючЗначение Из Параметры Цикл
		Если Не ПустаяСтрока(Результат) Тогда
			Результат = Результат + "&";
		КонецЕсли;
		Если ТипЗнч(КлючЗначение.Значение) = Тип("Булево") Тогда
			Если КлючЗначение.Значение Тогда
				ЗначениеПараметра = "true";
			Иначе
				ЗначениеПараметра = "false";
			КонецЕсли;
		Иначе
			ЗначениеПараметра = Строка(КлючЗначение.Значение);
		КонецЕсли;
		КлючСтрокой = КодироватьСтроку(
			Строка(КлючЗначение.Ключ),
			СпособКодированияСтроки.КодировкаURL);
		ЗначениеСтрокой = КодироватьСтроку(
			ЗначениеПараметра,
			СпособКодированияСтроки.КодировкаURL);
		Результат = Результат
			+ КлючСтрокой
			+ "="
			+ ЗначениеСтрокой;
	КонецЦикла;

	Возврат "?" + Результат;

КонецФункции

Функция ДесериализоватьJSON(Знач СтрокаJSON)

	Если ПустаяСтрока(СтрокаJSON) Тогда
		Возврат Новый Структура;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СтрокаJSON);
	Попытка
		Результат = ПрочитатьJSON(Чтение);
	Исключение
		Результат = Неопределено;
	КонецПопытки;
	Чтение.Закрыть();
	Возврат Результат;

КонецФункции

Функция СериализоватьJSON(Знач Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции

Функция ЗначениеРеквизита(Ссылка, ИмяРеквизита)

	Если Ссылка = Неопределено Или Ссылка.Пустая() Тогда
		Возврат Неопределено;
	КонецЕсли;

	МетаданныеСсылки = Ссылка.Метаданные();
	ИмяТаблицы = МетаданныеСсылки.ПолноеИмя();
	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ
		| Таблица.%1 КАК Результат
		|ИЗ
		| %2 КАК Таблица
		|ГДЕ
		| Таблица.Ссылка = &Ссылка",
		ИмяРеквизита,
		ИмяТаблицы);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Результат;

КонецФункции

Функция ИмяПровайдераДляAPI(Провайдер)
	Если Не ЗначениеЗаполнено(Провайдер) Тогда
		Возврат "";
	КонецЕсли;
	Возврат НРег(XMLСтрока(Провайдер));
КонецФункции

// Контекст HTTP-вызова, общий для всех попыток: заполняется один раз,
// а событие журнала строится из него и результата конкретной попытки.
Функция КонтекстЛогаЗапроса(
		Знач Метод,
		Знач Путь,
		Знач КорреляционныйИдентификатор,
		Знач РазмерЗапроса)

	Контекст = Новый Структура;
	Контекст.Вставить("Метод", Лев(Строка(Метод), 10));
	Контекст.Вставить("Путь", EBC_Логирование.БезопасныйПуть(Путь));
	Контекст.Вставить(
		"КорреляционныйИдентификатор",
		КорреляционныйИдентификатор);
	Контекст.Вставить("РазмерЗапроса", РазмерЗапроса);
	Контекст.Вставить("Детали", "");

	Возврат Контекст;

КонецФункции

Процедура ДобавитьСобытиеЗапроса(
		Буфер,
		Знач Уровень,
		Знач Контекст,
		Знач Результат,
		Знач НомерПопытки,
		Знач НачалоПопытки,
		Знач СтатусКод)

	Событие = EBC_Логирование.НовоеСобытие(Уровень, "ЗапросAPI");
	Событие.Метод = Контекст.Метод;
	Событие.Путь = Контекст.Путь;
	Событие.КорреляционныйИдентификатор =
		Контекст.КорреляционныйИдентификатор;
	Событие.Детали = Контекст.Детали;
	Событие.СтатусКод = СтатусКод;
	Событие.КодОшибки = Результат.КодОшибки;
	Событие.ТекстОшибки = Результат.ТекстОшибки;
	Событие.КоличествоПопыток = НомерПопытки;
	Событие.ДлительностьМс =
		ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоПопытки;
	Событие.РазмерЗапроса = Контекст.РазмерЗапроса;
	Событие.РазмерОтвета = Результат.РазмерОтвета;

	EBC_Логирование.Добавить(Буфер, Событие);

КонецПроцедуры

#КонецОбласти
