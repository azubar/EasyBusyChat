// Модуль EBC_ПодключаемыеКоманды
//
// Подменю "Easy-Busy Chat" в командной панели форм тех объектов, которые
// администратор настроил в регистре EBC_ТипыОбъектовПривязки.
//
// Это единственный способ добавить команду к произвольному объекту, не зная
// заранее его имени: общая команда требует типа параметра в XML, а он в
// расширении фиксирован. Подключаемые команды БСП принимают ОписаниеТипов
// во время выполнения - его и отдаёт EBC_НастройкиПовтИсп.ТипыОбъектовПривязки.
//
// Обе экспортные процедуры вызываются из заимствованного
// ПодключаемыеКомандыПереопределяемый для КАЖДОЙ формы объекта конфигурации,
// в том числе у пользователя без ролей расширения. Поэтому обе целиком под
// Попытка: ошибка здесь означала бы сломанную командную панель во всей
// конфигурации, а не только у нас.
//
// Результат кэшируется БСП в разрезе имён форм, поэтому после изменения
// настроек нужен ОбновитьПовторноИспользуемыеЗначения() и переоткрытие формы -
// про это написано прямо в форме настроек.

#Область ПрограммныйИнтерфейс

// Имя вида подключаемых команд. Должно удовлетворять требованиям именования
// переменных и не совпадать с видами других подсистем и расширений.
//
Функция ИмяВидаКоманд() Экспорт

	Возврат "EBC_EasyBusyChat";

КонецФункции

// Регистрирует вид команд - подменю "Easy-Busy Chat".
//
// Вид регистрируется всегда, независимо от настроек: БСП пропускает вид,
// для которого не добавлено ни одной команды (ПодключаемыеКоманды.ВывестиКоманды),
// поэтому пустое подменю в форме не появится.
//
// Параметры:
//  ВидыПодключаемыхКоманд - ТаблицаЗначений - см. ПодключаемыеКомандыПереопределяемый.
//
Процедура ДобавитьВидКоманд(ВидыПодключаемыхКоманд) Экспорт

	Вид = Неопределено;

	Попытка
		Вид = ВидыПодключаемыхКоманд.Добавить();
		Вид.Имя = ИмяВидаКоманд();
		Вид.ИмяПодменю = "EBC_ПодменюEasyBusyChat";
		Вид.Заголовок = НСтр("ru = 'Easy-Busy Chat'; uk = 'Easy-Busy Chat'");
		// Печать - 40, Отчёты - 50. 45 ставит подменю сразу за "Печатью".
		Вид.Порядок = 45;
		Вид.Картинка = БиблиотекаКартинок.EBC_EasyBusyChat16;
		Вид.Отображение = ОтображениеКнопки.Картинка;
	Исключение
		// Недозаполненная строка сломала бы вывод команд всех подсистем:
		// ПодключаемыеКоманды проверяет имя каждого вида и падает на пустом.
		Если Вид <> Неопределено Тогда
			ВидыПодключаемыхКоманд.Удалить(Вид);
		КонецЕсли;
		ЗаписатьОшибку(
			"EBC_ПодключаемыеКоманды.ДобавитьВидКоманд",
			ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

// Добавляет три команды подменю к формам настроенных объектов.
//
// Отбор форм делает сама БСП по ТипПараметра: команда, ни один тип которой не
// встретился среди источников формы, из списка удаляется. Поэтому здесь типы
// достаточно задать один раз, а перечислять объекты не нужно.
//
// Параметры:
//  НастройкиФормы - Структура      - сведения о форме, см. ПодключаемыеКомандыПереопределяемый.
//  Источники      - ДеревоЗначений - поставщики команд формы.
//  Команды        - ТаблицаЗначений - куда добавляются команды.
//
Процедура ДобавитьКоманды(НастройкиФормы, Источники, Команды) Экспорт

	Попытка
		ДобавитьКомандыБезЗащиты(Команды);
	Исключение
		ЗаписатьОшибку(
			"EBC_ПодключаемыеКоманды.ДобавитьКоманды",
			ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьКомандыБезЗащиты(Команды)

	// Нет права - нет и надобности: команда пользователю не нужна, а чтение
	// настроек у него упало бы.
	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.EBC_Настройки)
		Или Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.EBC_СвязиОбъектов)
		Или Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.EBC_ТипыОбъектовПривязки) Тогда
		Возврат;
	КонецЕсли;

	Если Не EBC_НастройкиПовтИсп.ТекущиеНастройки().Активен Тогда
		Возврат;
	КонецЕсли;

	ТипыОбъектов = EBC_НастройкиПовтИсп.ТипыОбъектовПривязки();

	// Пустое ОписаниеТипов БСП считает "тип не задан" и отбор по типам не
	// выполняет - команда появилась бы во всех формах конфигурации.
	// Поэтому при пустом списке настроенных типов команд быть не должно.
	Если ТипыОбъектов.Типы().Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ДобавитьКоманду(
		Команды,
		ТипыОбъектов,
		"EBC_ОткрытьЧат",
		НСтр("ru = 'Открыть чат'; uk = 'Відкрити чат'"),
		"EBC_ПодключаемыеКомандыКлиент.ОткрытьЧат",
		1,
		"Важное");

	ДобавитьКоманду(
		Команды,
		ТипыОбъектов,
		"EBC_ПривязанныеЧаты",
		НСтр("ru = 'Привязанные чаты'; uk = 'Прив''язані чати'"),
		"EBC_ПодключаемыеКомандыКлиент.ПривязанныеЧаты",
		2,
		"Обычное");

	ДобавитьКоманду(
		Команды,
		ТипыОбъектов,
		"EBC_ОтправитьСообщение",
		НСтр("ru = 'Отправить сообщение'; uk = 'Надіслати повідомлення'"),
		"EBC_ПодключаемыеКомандыКлиент.ОтправитьСообщение",
		3,
		"Обычное");

КонецПроцедуры

Процедура ДобавитьКоманду(
		Команды,
		Знач ТипыОбъектов,
		Знач Идентификатор,
		Знач Представление,
		Знач Обработчик,
		Знач Порядок,
		Знач Важность)

	Команда = Команды.Добавить();
	Команда.Вид = ИмяВидаКоманд();
	Команда.Идентификатор = Идентификатор;
	Команда.Представление = Представление;
	Команда.Важность = Важность;
	Команда.Порядок = Порядок;
	Команда.ТипПараметра = ТипыОбъектов;

	// Команда работает с одним объектом: чат открывается для конкретной
	// накладной, а не для выделенных в списке.
	Команда.МножественныйВыбор = Ложь;

	// У нового объекта нет ссылки, а без ссылки нечего искать в связях.
	// "ЗаписыватьТолькоНовые" запишет его с подтверждением пользователя,
	// а уже существующий изменённый объект трогать не станет: открытие чата
	// не повод записывать чужие правки.
	Команда.РежимЗаписи = "ЗаписыватьТолькоНовые";

	// Команды ничего не меняют в самом объекте, поэтому доступны и тому,
	// у кого нет права на его изменение.
	Команда.ИзменяетВыбранныеОбъекты = Ложь;

	Команда.Обработчик = Обработчик;

КонецПроцедуры

// Ошибки пишутся в журнал регистрации, а не в EBC_Лог: код выполняется в
// форме любого объекта конфигурации, в том числе у пользователя без прав
// на регистры расширения.
//
Процедура ЗаписатьОшибку(Знач Событие, Знач ИнформацияОбОшибке)

	ЗаписьЖурналаРегистрации(
		Событие,
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));

КонецПроцедуры

#КонецОбласти
