// Модуль EBC_НастройкиПовтИсп
//
// Значения кэшируются на время сеанса. Все места, где настройки изменяются,
// обязаны вызывать ОбновитьПовторноИспользуемыеЗначения().

#Область ПрограммныйИнтерфейс

// Настройки текущего пользователя: персональная запись регистра, если она есть,
// иначе общая запись (с незаполненным ПользовательИБ), иначе значения по умолчанию.
//
Функция ТекущиеНастройки() Экспорт

	EBC_НастройкиСервер.ОбеспечитьМиграциюНастроекЛогирования();

	Настройки = НастройкиПользователя(
		EBC_НастройкиСервер.ТекущийПользовательИБ());
	Если Настройки <> Неопределено Тогда
		Возврат Настройки;
	КонецЕсли;

	Настройки = НастройкиПользователя(
		Справочники.Пользователи.ПустаяСсылка());
	Если Настройки <> Неопределено Тогда
		Возврат Настройки;
	КонецЕсли;

	Возврат ПолучитьНастройкиПоУмолчанию();

КонецФункции

// Общие настройки расширения: запись регистра с незаполненным ПользовательИБ.
// Персональные записи здесь не учитываются - значения нужны фоновым процессам,
// которые работают вне контекста конкретного пользователя.
//
Функция ОбщиеНастройки() Экспорт

	EBC_НастройкиСервер.ОбеспечитьМиграциюНастроекЛогирования();

	Настройки = НастройкиПользователя(
		Справочники.Пользователи.ПустаяСсылка());
	Если Настройки <> Неопределено Тогда
		Возврат Настройки;
	КонецЕсли;

	Возврат ПолучитьНастройкиПоУмолчанию();

КонецФункции

// Типы объектов, с которыми можно связывать чаты, в виде описания типов.
//
// Значение подставляется в ТипПараметра подключаемых команд - именно оно делает
// расширение независимым от состава объектов конкретной конфигурации: список
// задаёт администратор в настройках, а не разработчик в XML команды.
//
// Кэшируется, потому что вызывается при построении команд каждой формы объекта.
// После изменения настроек нужен ОбновитьПовторноИспользуемыеЗначения().
//
// Из результата исключаются типы, которых нет в конфигурации, выключенные
// флажком и те, на которые у текущего пользователя нет права чтения: команда
// для недоступного объекта не должна появляться вовсе.
//
// Возвращаемое значение:
//  ОписаниеТипов - пустое, если подходящих типов нет.
//
Функция ТипыОбъектовПривязки() Экспорт

	Типы = Новый Массив;

	Настроенные = РегистрыСведений.EBC_ТипыОбъектовПривязки.НастроенныеТипы(Истина);
	Для Каждого Строка Из Настроенные Цикл
		Если Не Строка.Существует Или Не Строка.ЕстьПраво Тогда
			Продолжить;
		КонецЕсли;
		Тип = ТипСсылкиПоПолномуИмени(Строка.ПолноеИмя);
		Если Тип <> Неопределено Тогда
			Типы.Добавить(Тип);
		КонецЕсли;
	КонецЦикла;

	Возврат Новый ОписаниеТипов(Типы);

КонецФункции

// Часовой пояс, в котором расширение хранит даты чатов и сообщений.
//
// Приоритет: часовой пояс области данных основной конфигурации, затем часовой
// пояс сеанса. Значение кэшируется: оно нужно на каждый разбор даты из API,
// а меняется не чаще, чем настройки области данных.
//
Функция ЧасовойПоясДанных() Экспорт

	ИмяЧасовогоПояса = EBC_АдаптерКонфигурации.ЧасовойПоясОбластиДанных();
	Если Не ПустаяСтрока(ИмяЧасовогоПояса) Тогда
		Попытка
			// Неизвестное имя пояса приводит к исключению, поэтому проверяем его
			// до того, как пояс будет применён к реальным датам.
			МестноеВремя(Дата(2001, 1, 1), ИмяЧасовогоПояса);
			Возврат ИмяЧасовогоПояса;
		Исключение
			ЗаписьЖурналаРегистрации(
				"EBC_Настройки.ЧасовойПоясДанных",
				УровеньЖурналаРегистрации.Предупреждение,
				,
				,
				СтрШаблон(
					"Часовой пояс области данных ""%1"" не распознан, используется часовой пояс сеанса.",
					ИмяЧасовогоПояса));
		КонецПопытки;
	КонецЕсли;

	Возврат ЧасовойПоясСеанса();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выбираются все ресурсы, входящие в структуру настроек.
//
// Недостающий в выборке ресурс не приводит к ошибке: структура собирается
// из умолчаний, а ЗаполнитьЗначенияСвойств просто не находит для него
// источник и оставляет умолчание. Настройка молча перестаёт действовать -
// именно так вели себя масштаб картинки и флаг оповещений.
//
// ТокенДоступа в выборку не входит намеренно: его читает
// EBC_НастройкиСервер.ПолучитьТокенДоступа, и в кэшируемой структуре
// настроек ему не место.
//
Функция НастройкиПользователя(Знач ПользовательИБ)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| Настройки.БазовыйАдресАпи КАК БазовыйАдресАпи,
		| Настройки.КомпанияEBC КАК КомпанияEBC,
		| Настройки.Пользователь КАК Пользователь,
		| Настройки.Активен КАК Активен,
		| Настройки.ХранитьЛогДней КАК ХранитьЛогДней,
		| Настройки.ЛогироватьТехническиеСобытия КАК ЛогироватьТехническиеСобытия,
		| Настройки.ЛогироватьДействияПользователей КАК ЛогироватьДействияПользователей,
		| Настройки.УровеньЛогирования КАК УровеньЛогирования,
		| Настройки.ТаймаутСоединенияСек КАК ТаймаутСоединенияСек,
		| Настройки.КоличествоПовторов КАК КоличествоПовторов,
		| Настройки.МаксимальныйРазмерФайлаМБ КАК МаксимальныйРазмерФайлаМБ,
		| Настройки.МасштабКартинкиПечатнойФормы КАК МасштабКартинкиПечатнойФормы,
		| Настройки.ПоказыватьОповещенияВебПлагина КАК ПоказыватьОповещенияВебПлагина
		|ИЗ
		| РегистрСведений.EBC_Настройки КАК Настройки
		|ГДЕ
		| Настройки.ПользовательИБ = &ПользовательИБ";
	Запрос.УстановитьПараметр("ПользовательИБ", ПользовательИБ);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ПолучитьСтруктуруНастроек(Выборка);

КонецФункции

Функция ПолучитьСтруктуруНастроек(Знач ЗаписьНастроек)

	Настройки = ПолучитьНастройкиПоУмолчанию();
	ЗаполнитьЗначенияСвойств(Настройки, ЗаписьНастроек);

	// Незаполненные числовые настройки заменяются значениями по умолчанию:
	// нулевой таймаут или нулевой срок хранения лога рабочими не являются.
	ЗначенияПоУмолчанию = ПолучитьНастройкиПоУмолчанию();
	Для Каждого ИмяЧисловойНастройки Из ЧисловыеНастройки() Цикл
		Если Настройки[ИмяЧисловойНастройки] <= 0 Тогда
			Настройки[ИмяЧисловойНастройки] =
				ЗначенияПоУмолчанию[ИмяЧисловойНастройки];
		КонецЕсли;
	КонецЦикла;

	Если ПустаяСтрока(Настройки.БазовыйАдресАпи) Тогда
		Настройки.БазовыйАдресАпи = ЗначенияПоУмолчанию.БазовыйАдресАпи;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Настройки.УровеньЛогирования) Тогда
		Настройки.УровеньЛогирования = ЗначенияПоУмолчанию.УровеньЛогирования;
	КонецЕсли;

	Возврат Настройки;

КонецФункции

Функция ЧисловыеНастройки()

	Результат = Новый Массив;
	Результат.Добавить("ХранитьЛогДней");
	Результат.Добавить("ТаймаутСоединенияСек");
	Результат.Добавить("КоличествоПовторов");
	Результат.Добавить("МаксимальныйРазмерФайлаМБ");
	Результат.Добавить("МасштабКартинкиПечатнойФормы");

	Возврат Результат;

КонецФункции

Функция ПолучитьНастройкиПоУмолчанию()

	Настройки = Новый Структура;
	Настройки.Вставить(
		"БазовыйАдресАпи",
		EBC_НастройкиСервер.БазовыйАдресАпиПоУмолчанию());
	Настройки.Вставить(
		"КомпанияEBC",
		Справочники.EBC_Компании.ПустаяСсылка());
	Настройки.Вставить(
		"Пользователь",
		Справочники.EBC_Пользователи.ПустаяСсылка());
	Настройки.Вставить("Активен", Ложь);
	Настройки.Вставить("ЛогироватьТехническиеСобытия", Истина);
	Настройки.Вставить("ЛогироватьДействияПользователей", Истина);
	// Всплывающие оповещения по умолчанию включены: они подтверждают, что
	// компонента поднялась и сообщение ушло.
	Настройки.Вставить("ПоказыватьОповещенияВебПлагина", Истина);
	Настройки.Вставить(
		"ХранитьЛогДней",
		EBC_НастройкиСервер.ГлубинаХраненияЛоговПоУмолчанию());
	Настройки.Вставить(
		"УровеньЛогирования",
		Перечисления.EBC_УровниЖурнала.Информация);
	Настройки.Вставить("ТаймаутСоединенияСек", 30);
	Настройки.Вставить("КоличествоПовторов", 3);
	Настройки.Вставить("МаксимальныйРазмерФайлаМБ", 20);
	Настройки.Вставить(
		"МасштабКартинкиПечатнойФормы",
		EBC_НастройкиСервер.МасштабКартинкиПечатнойФормыПоУмолчанию());

	Возврат Настройки;

КонецФункции

// Тип ссылки объекта по полному имени метаданных, без литералов в коде.
//
// Параметры:
//  ПолноеИмя - Строка - например "Справочник.Контрагенты".
//
// Возвращаемое значение:
//  Тип        - тип ссылки объекта;
//  Неопределено - объекта в конфигурации нет либо у него нет менеджера с пустой
//                 ссылкой (например, у константы или регистра).
//
Функция ТипСсылкиПоПолномуИмени(Знач ПолноеИмя)

	Если Метаданные.НайтиПоПолномуИмени(ПолноеИмя) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя);
		Возврат ТипЗнч(Менеджер.ПустаяСсылка());
	Исключение
		// Не у всякого объекта метаданных есть ссылочный тип - это не ошибка,
		// такой тип просто не попадёт в список.
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти
