// Модуль EBC_РегламентныеЗаданияВызовСервера
//
// Серверная часть команд подсистемы "Администрирование": расписание заданий
// синхронизации и запуск синхронизации вручную.
//
// Про права. Расписание регламентного задания платформа отдаёт только
// администратору ("получение возможно только для администратора" у
// МенеджерРегламентныхЗаданий.НайтиПредопределенное), а БСП дополнительно
// проверяет полноправность в РегламентныеЗаданияСервер. Обойти это можно только
// привилегированным режимом, недоступным расширению в текущем режиме
// совместимости. Поэтому команды расписания видны обладателю EBC_Администратор,
// но работают лишь у того, кто вдобавок полноправный пользователь; остальным
// возвращается понятный текст вместо "Нарушение прав доступа".
//
// Запуск синхронизации вручную прав администрирования не требует: это обычный
// код расширения, работающий под правами текущего пользователя.

#Область ПрограммныйИнтерфейс

// Возвращает расписание и состояние задания синхронизации.
//
// Параметры:
//  ИмяЗадания - Строка - имя регламентного задания расширения.
//
// Возвращаемое значение:
//  Структура:
//   * Успех        - Булево - данные получены.
//   * Ошибка       - Строка - причина отказа или пустая строка.
//   * Расписание   - Структура - расписание в виде, пригодном для передачи на клиент.
//   * Использование - Булево - включено ли задание.
//   * Заголовок    - Строка - представление задания для сообщений пользователю.
//
Функция ДанныеРасписания(Знач ИмяЗадания) Экспорт

	Результат = Новый Структура(
		"Успех, Ошибка, Расписание, Использование, Заголовок",
		Ложь,
		"",
		Неопределено,
		Ложь,
		"");

	ЗаданиеМетаданные = ЗаданиеПоИмени(ИмяЗадания);
	Если ЗаданиеМетаданные = Неопределено Тогда
		Результат.Ошибка = ТекстНеизвестногоЗадания();
		Возврат Результат;
	КонецЕсли;

	Результат.Заголовок = ЗаданиеМетаданные.Синоним;

	Попытка
		Результат.Расписание = ОбщегоНазначенияКлиентСервер.РасписаниеВСтруктуру(
			РегламентныеЗаданияСервер.РасписаниеРегламентногоЗадания(
				ЗаданиеМетаданные));
		Результат.Использование =
			РегламентныеЗаданияСервер.РегламентноеЗаданиеИспользуется(
				ЗаданиеМетаданные);
		Результат.Успех = Истина;
	Исключение
		Результат.Ошибка = ТекстНедостаточноПрав();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Сохраняет расписание задания синхронизации.
//
// Параметры:
//  ИмяЗадания          - Строка - имя регламентного задания расширения.
//  СтруктураРасписания - Структура - результат диалога расписания.
//
// Возвращаемое значение:
//  Структура:
//   * Успех         - Булево - расписание сохранено.
//   * Ошибка        - Строка - причина отказа или пустая строка.
//   * Использование - Булево - включено ли задание; выключенное не запустится
//                     ни по какому расписанию, и об этом стоит предупредить.
//
Функция УстановитьРасписание(Знач ИмяЗадания, Знач СтруктураРасписания) Экспорт

	Результат = Новый Структура(
		"Успех, Ошибка, Использование",
		Ложь,
		"",
		Ложь);

	ЗаданиеМетаданные = ЗаданиеПоИмени(ИмяЗадания);
	Если ЗаданиеМетаданные = Неопределено Тогда
		Результат.Ошибка = ТекстНеизвестногоЗадания();
		Возврат Результат;
	КонецЕсли;

	Попытка
		РегламентныеЗаданияСервер.УстановитьРасписаниеРегламентногоЗадания(
			ЗаданиеМетаданные,
			ОбщегоНазначенияКлиентСервер.СтруктураВРасписание(
				СтруктураРасписания));
		Результат.Использование =
			РегламентныеЗаданияСервер.РегламентноеЗаданиеИспользуется(
				ЗаданиеМетаданные);
		Результат.Успех = Истина;
	Исключение
		Результат.Ошибка = ТекстНедостаточноПрав();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Выполняет синхронизацию немедленно, не дожидаясь расписания.
//
// Параметры:
//  ИмяЗадания - Строка - имя регламентного задания расширения.
//
// Возвращаемое значение:
//  Структура - см. EBC_РегламентныеЗадания.СинхронизироватьСправочники.
//
Функция ВыполнитьСинхронизацию(Знач ИмяЗадания) Экспорт

	Если ИмяЗадания = ИмяЗаданияСправочников() Тогда
		Возврат EBC_РегламентныеЗадания.СинхронизироватьСправочники();
	КонецЕсли;

	Если ИмяЗадания = ИмяЗаданияЧатов() Тогда
		Возврат EBC_РегламентныеЗадания.СинхронизироватьЧаты();
	КонецЕсли;

	Возврат Новый Структура(
		"Успех, Ошибка, Количество",
		Ложь,
		ТекстНеизвестногоЗадания(),
		0);

КонецФункции

Функция ИмяЗаданияСправочников() Экспорт
	Возврат "EBC_СинхронизацияСправочников";
КонецФункции

Функция ИмяЗаданияЧатов() Экспорт
	Возврат "EBC_СинхронизацияЧатов";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗаданиеПоИмени(Знач ИмяЗадания)

	Если ИмяЗадания <> ИмяЗаданияСправочников()
		И ИмяЗадания <> ИмяЗаданияЧатов() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Метаданные.РегламентныеЗадания.Найти(ИмяЗадания);

КонецФункции

Функция ТекстНеизвестногоЗадания()

	Возврат НСтр(
		"ru = 'Регламентное задание синхронизации не найдено в расширении.';
		|uk = 'Регламентне завдання синхронізації не знайдено в розширенні.'");

КонецФункции

Функция ТекстНедостаточноПрав()

	Возврат НСтр(
		"ru = 'Расписание регламентных заданий доступно только пользователю с правом администрирования.
		|Синхронизацию можно запустить вручную соседней командой.';
		|uk = 'Розклад регламентних завдань доступний лише користувачу з правом адміністрування.
		|Синхронізацію можна запустити вручну сусідньою командою.'");

КонецФункции

#КонецОбласти
