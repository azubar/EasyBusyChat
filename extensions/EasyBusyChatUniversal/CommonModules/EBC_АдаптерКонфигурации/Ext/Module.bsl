// Публичный интерфейс конфигурационно-зависимых операций EasyBusyChat.
//
// Универсальная сборка: имён объектов конкретной конфигурации здесь нет.
// Всё, что нужно знать о прикладных объектах, берётся из метаданных во время
// выполнения либо из настроенных типов привязки.
//
// Единственное допущение - конфигурация построена на БСП: используются
// ОбщегоНазначения, ЗначенияРеквизитовОбъекта и константа часового пояса.

#Если Клиент Тогда

// Открывает форму нового документа заданного вида.
//
// Параметры:
//  ВидОперации - Строка - полное имя документа, например "Документ.ЗаказПокупателя".
//                Список видов задаёт администратор в настройках расширения,
//                поэтому имя формы собирается из него.
//
Процедура СоздатьДокумент(Знач ВидОперации, Знач Основание, Знач ДанныеЧата, ВладелецФормы = Неопределено, ОбработчикЗавершения = Неопределено) Экспорт

	Если ПустаяСтрока(ВидОперации) Тогда
		ВызватьИсключение НСтр(
			"ru = 'Не указан вид документа';
			|uk = 'Не вказано вид документа'");
	КонецЕсли;

	// Метаданных на клиенте нет, поэтому параметры формы собирает сервер -
	// одним вызовом, чтобы не ходить отдельно за реквизитами и за парой
	// партнёр/контрагент.
	ПараметрыФормы = EBC_АдаптерКонфигурацииВызовСервера.ПараметрыНовогоДокумента(
		ВидОперации,
		Основание);

	ОткрытьФорму(
		СокрЛП(ВидОперации) + ".ФормаОбъекта",
		ПараметрыФормы,
		ВладелецФормы,
		,
		,
		,
		ОбработчикЗавершения);

КонецПроцедуры

Процедура ОткрытьОбъект(Знач СсылкаНаОбъект, ВладелецФормы = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Возврат;
	КонецЕсли;

	// Модальные вызовы в конфигурациях на БСП запрещены, поэтому значение
	// открывается неблокирующим методом платформы.
	ПоказатьЗначение(Неопределено, СсылкаНаОбъект);

КонецПроцедуры

#КонецЕсли

#Если Сервер Тогда

#Область ВозможностиКонфигурации

// Возможности конфигурации в части контактных объектов.
//
// Расширение ставится и туда, где партнёров нет вовсе (SmallBusiness), и туда,
// где партнёр - основной контактный объект, а контрагент лишь юридическое лицо
// (УТ, КУП). Определяется это по метаданным, а не по имени конфигурации: то же
// правило сработает в любой другой конфигурации с такими же объектами.
//
// Характеристики независимы. Наличие справочника решает, можно ли вообще
// связывать чаты с партнёрами. Функциональная опция решает только то, ведётся
// ли контрагент отдельно от партнёра в пользовательских сценариях.
//
// Результат намеренно не кэшируется: функциональную опцию администратор
// переключает без перезапуска сеанса, а сами проверки - обращения к метаданным
// в памяти, они дешёвые.
//
// Возвращаемое значение:
//  Структура:
//   * ЕстьПартнеры               - Булево - есть Справочник.Партнеры и право на чтение;
//   * ЕстьКонтрагенты            - Булево - то же про Справочник.Контрагенты;
//   * НезависимоеВедение         - Булево - ФО "ИспользоватьПартнеровИКонтрагентов";
//   * ПартнерыКакКонтрагенты     - Булево - ФО "ИспользоватьПартнеровКакКонтрагентов";
//   * ЕстьТиповойМодульПартнеров - Булево - доступен ОбщийМодуль.ПартнерыИКонтрагенты.
//
Функция ВозможностиКонтактов() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("ЕстьПартнеры", Ложь);
	Результат.Вставить("ЕстьКонтрагенты", Ложь);
	Результат.Вставить("НезависимоеВедение", Ложь);
	Результат.Вставить("ПартнерыКакКонтрагенты", Ложь);
	Результат.Вставить("ЕстьТиповойМодульПартнеров", Ложь);

	Результат.ЕстьПартнеры = СправочникДоступен("Партнеры");
	Результат.ЕстьКонтрагенты = СправочникДоступен("Контрагенты");

	Если Не Результат.ЕстьПартнеры Тогда
		// В конфигурации без партнёров функциональных опций про них тоже нет,
		// и спрашивать их у платформы незачем.
		Возврат Результат;
	КонецЕсли;

	Результат.НезависимоеВедение = ЗначениеФункциональнойОпцииБезопасно(
		"ИспользоватьПартнеровИКонтрагентов");
	Результат.ПартнерыКакКонтрагенты = ЗначениеФункциональнойОпцииБезопасно(
		"ИспользоватьПартнеровКакКонтрагентов");
	Результат.ЕстьТиповойМодульПартнеров =
		Метаданные.ОбщиеМодули.Найти("ПартнерыИКонтрагенты") <> Неопределено;

	Возврат Результат;

КонецФункции

// Полные имена справочников, которые расширение считает контактными.
//
// Нужны запросам по регистру связей: там тип объекта хранится строкой, и
// отбирать связи следует по точному списку, а не по шаблону "Справочник.%" -
// иначе контактом становится номенклатура или организация.
//
// Порядок соответствует бизнес-значимости, но приоритет между партнёром и
// контрагентом внутри запроса не используется: какая связь главнее, решают
// ОсновнаяСвязь и дата установки.
//
// Возвращаемое значение:
//  Массив из Строка - может быть пустым, если ни одного справочника нет.
//
Функция КонтактныеСправочники(Знач Возможности = Неопределено) Экспорт

	Если Возможности = Неопределено Тогда
		Возможности = ВозможностиКонтактов();
	КонецЕсли;

	Результат = Новый Массив;
	Если Возможности.ЕстьПартнеры Тогда
		Результат.Добавить("Справочник.Партнеры");
	КонецЕсли;
	Если Возможности.ЕстьКонтрагенты Тогда
		Результат.Добавить("Справочник.Контрагенты");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Значение функциональной опции, которой может не быть в конфигурации.
//
// ПолучитьФункциональнуюОпцию по несуществующему имени выбрасывает исключение,
// поэтому имя сначала ищется в метаданных. Ошибку прав трактуем как "опция
// выключена": недоступная возможность лучше, чем прерванная форма объекта.
//
Функция ЗначениеФункциональнойОпцииБезопасно(Знач ИмяОпции)

	Если Метаданные.ФункциональныеОпции.Найти(ИмяОпции) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Возврат ПолучитьФункциональнуюОпцию(ИмяОпции) = Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Справочник есть в конфигурации и текущий пользователь может его читать.
//
// Право проверяется вместе с существованием: справочник, закрытый ролями,
// для расширения такая же недоступная возможность, как отсутствующий.
//
Функция СправочникДоступен(Знач ИмяСправочника)

	МетаданныеСправочника = Метаданные.Справочники.Найти(ИмяСправочника);
	Если МетаданныеСправочника = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ПравоДоступа("Чтение", МетаданныеСправочника);

КонецФункции

#КонецОбласти

// Имя часового пояса области данных.
//
// Пустая строка означает, что конфигурация пояс не задаёт и его нужно
// определить средствами платформы.
//
Функция ЧасовойПоясОбластиДанных() Экспорт

	Попытка
		Возврат СокрЛП(Строка(Константы.ЧасовойПоясОбластиДанных.Получить()));
	Исключение
		// Константы нет в конфигурации либо нет прав на чтение.
		Возврат "";
	КонецПопытки;

КонецФункции

// Текст сообщения по документу: вид, номер и сумма, если документ её хранит.
//
// Вид документа - синоним из метаданных: перечислять известные документы
// расширение не может, их состав задаёт администратор.
//
Функция ТекстСообщенияПоДокументу(Знач СсылкаНаДокумент) Экспорт

	Если Не ЗначениеЗаполнено(СсылкаНаДокумент) Тогда
		Возврат "";
	КонецЕсли;

	МетаданныеДокумента = СсылкаНаДокумент.Метаданные();
	ВидДокумента = СокрЛП(МетаданныеДокумента.Синоним);
	Если ПустаяСтрока(ВидДокумента) Тогда
		ВидДокумента = МетаданныеДокумента.Имя;
	КонецЕсли;

	ЕстьСумма = МетаданныеДокумента.Реквизиты.Найти("СуммаДокумента") <> Неопределено;
	ЕстьВалюта = МетаданныеДокумента.Реквизиты.Найти("ВалютаДокумента") <> Неопределено;

	Если Не ЕстьСумма Тогда
		// Документ без суммы описывается только видом и номером.
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаДокумент, "Номер");
		Возврат СтрШаблон("%1 №%2", ВидДокумента, СокрЛП(Реквизиты.Номер));
	КонецЕсли;

	ИменаРеквизитов = "Номер,СуммаДокумента" + ?(ЕстьВалюта, ",ВалютаДокумента", "");
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		СсылкаНаДокумент,
		ИменаРеквизитов);

	Валюта = ?(ЕстьВалюта, СокрЛП(Строка(Реквизиты.ВалютаДокумента)), "");

	Возврат СокрЛП(СтрШаблон(
		НСтр("ru = '%1 №%2  Сумма: %3 %4'; uk = '%1 №%2  Сума: %3 %4'"),
		ВидДокумента,
		СокрЛП(Реквизиты.Номер),
		Формат(Реквизиты.СуммаДокумента, "ЧДЦ=2; ЧН=0; ЧРГ=' '"),
		Валюта));

КонецФункции

// Виды документов, которые можно создать из расширения.
//
// Список строится из настроенных типов объектов привязки: администратор задаёт
// состав документов в настройках, и заводить второй список в коде незачем.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Имя           - Строка - полное имя документа;
//   * Представление - Строка - синоним документа.
//
Функция ПолучитьДоступныеОперацииСоздания(Знач Основание = Неопределено) Экспорт

	Результат = Новый Массив;

	Настроенные = РегистрыСведений.EBC_ТипыОбъектовПривязки.НастроенныеТипы(Истина);
	Для Каждого Строка Из Настроенные Цикл
		Если Строка.Вид <> "Документ" Или Не Строка.Существует Тогда
			Продолжить;
		КонецЕсли;

		МетаданныеДокумента = Метаданные.НайтиПоПолномуИмени(Строка.ПолноеИмя);
		Если МетаданныеДокумента = Неопределено
			Или Не ПравоДоступа("Добавление", МетаданныеДокумента) Тогда
			Продолжить;
		КонецЕсли;

		Поддержка = ПоддержкаДокумента(МетаданныеДокумента);

		Операция = Новый Структура(
			"Имя,Представление",
			Строка.ПолноеИмя,
			?(ПустаяСтрока(Строка.Представление),
				МетаданныеДокумента.Имя,
				Строка.Представление));

		// Флаги нужны будущему меню выбора документа: сейчас несовместимые
		// операции не отсекаются - меню в универсальной сборке нет, а молча
		// прятать настроенный администратором документ неправильно.
		Операция.Вставить("ПоддерживаетПартнера", Поддержка.ПоддерживаетПартнера);
		Операция.Вставить("ПоддерживаетКонтрагента", Поддержка.ПоддерживаетКонтрагента);

		Результат.Добавить(Операция);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Параметры формы нового документа: основание и значения заполнения.
//
// Механизм намеренно двухуровневый, и оба уровня обязательны - это проверено
// на живой базе КУП (docs/EasyBusyChatUniversal_План_доработки_Партнеры_
// Контрагенты.md, раздел 4A):
//
//  * "Основание" запускает типовую ОбработкаЗаполнения. Для ЗаказКлиента УТ и
//    КУП она по партнёру заполняет 23 реквизита из 71 - соглашение, валюту,
//    склад, банковские счета - и сама подбирает согласованного контрагента.
//    Собрать это вручную расширение не может и не должно;
//  * "ЗначенияЗаполнения" - страховка для документов, которые основание не
//    понимают вовсе (СчетНаОплатуКлиенту, РеализацияТоваровУслуг): без него у
//    них не заполнится даже контрагент.
//
// Платформа принимает оба параметра вместе, приоритет у основания: типовая
// логика конфигурации перекрывает наши подстановки, и это правильно.
//
// Лишний ключ в ЗначенияЗаполнения платформа игнорирует молча, а значение
// неподходящего типа тихо обнуляет - поэтому структура собирается строго по
// метаданным конкретного документа.
//
// Параметры:
//  ВидОперации - Строка - полное имя документа.
//  Основание   - ссылка - партнёр, контрагент либо иной объект.
//
// Возвращаемое значение:
//  Структура - параметры для ОткрытьФорму; пустые ключи не добавляются.
//
Функция ПараметрыНовогоДокумента(Знач ВидОперации, Знач Основание) Экспорт

	ПараметрыФормы = Новый Структура;

	МетаданныеДокумента = Метаданные.НайтиПоПолномуИмени(СокрЛП(Строка(ВидОперации)));
	Если МетаданныеДокумента = Неопределено
		Или Не Метаданные.Документы.Содержит(МетаданныеДокумента)
		Или Не ЗначениеЗаполнено(Основание) Тогда
		Возврат ПараметрыФормы;
	КонецЕсли;

	Пара = EBC_Ядро.ПараКонтакта(Основание);

	// В основание идёт партнёр как общая сторона взаимодействия, а где
	// партнёров нет - контрагент. Документ, который такого основания не
	// понимает, просто ничего по нему не заполнит.
	ОснованиеФормы = ?(Пара.Партнер <> Неопределено, Пара.Партнер, Пара.Контрагент);
	Если ОснованиеФормы = Неопределено Тогда
		// Объект не контактный: передаём как есть - вдруг документ умеет
		// заполняться по нему сам.
		ОснованиеФормы = Основание;
	КонецЕсли;
	ПараметрыФормы.Вставить("Основание", ОснованиеФормы);

	ЗначенияЗаполнения = ЗначенияЗаполненияДокумента(МетаданныеДокумента, Пара);
	Если ЗначенияЗаполнения.Количество() > 0 Тогда
		ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	КонецЕсли;

	Возврат ПараметрыФормы;

КонецФункции

// Значения заполнения документа по разрешённой паре партнёр/контрагент.
//
// Реквизит попадает в структуру, только если он есть у документа, значение
// заполнено и подходит ему по типу. Несогласованная пара не передаётся вовсе:
// партнёр и контрагент из разных сделок в одном документе хуже, чем пустые
// поля.
//
// Параметры:
//  МетаданныеДокумента - ОбъектМетаданных;
//  Пара                - Структура - см. EBC_Ядро.ПараКонтакта.
//
// Возвращаемое значение:
//  Структура - может быть пустой.
//
Функция ЗначенияЗаполненияДокумента(Знач МетаданныеДокумента, Знач Пара) Экспорт

	Результат = Новый Структура;

	Если Не Пара.Согласована Тогда
		Возврат Результат;
	КонецЕсли;

	ДобавитьЗначениеЗаполнения(Результат, МетаданныеДокумента, "Партнер", Пара.Партнер);
	ДобавитьЗначениеЗаполнения(Результат, МетаданныеДокумента, "Контрагент", Пара.Контрагент);

	Возврат Результат;

КонецФункции

// Что документ умеет принимать из пары партнёр/контрагент.
//
// Возвращаемое значение:
//  Структура:
//   * ПоддерживаетПартнера    - Булево;
//   * ПоддерживаетКонтрагента - Булево.
//
Функция ПоддержкаДокумента(Знач МетаданныеДокумента) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("ПоддерживаетПартнера", Ложь);
	Результат.Вставить("ПоддерживаетКонтрагента", Ложь);

	Если МетаданныеДокумента = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Возможности = ВозможностиКонтактов();
	Результат.ПоддерживаетПартнера = Возможности.ЕстьПартнеры
		И РеквизитПринимаетСправочник(МетаданныеДокумента, "Партнер", "Партнеры");
	Результат.ПоддерживаетКонтрагента = Возможности.ЕстьКонтрагенты
		И РеквизитПринимаетСправочник(МетаданныеДокумента, "Контрагент", "Контрагенты");

	Возврат Результат;

КонецФункции

// Создаёт новый документ заданного вида.
//
// Использует ту же пару партнёр/контрагент, что и клиентское открытие формы:
// два расходящихся алгоритма заполнения - источник расхождений между тем, что
// видит пользователь, и тем, что пишет фоновый код.
//
// Параметры:
//  ВидОперации - Строка - полное имя документа.
//  Основание   - ссылка - партнёр, контрагент либо иной объект.
//
Функция СоздатьОбъектДокумента(Знач ВидОперации, Знач Основание, Знач ДанныеЧата) Экспорт

	МетаданныеДокумента = Метаданные.НайтиПоПолномуИмени(ВидОперации);
	Если МетаданныеДокумента = Неопределено
		Или Не Метаданные.Документы.Содержит(МетаданныеДокумента) Тогда
		ВызватьИсключение НСтр(
			"ru = 'Неподдерживаемый вид документа';
			|uk = 'Непідтримуваний вид документа'");
	КонецЕсли;

	Если Не ПравоДоступа("Добавление", МетаданныеДокумента) Тогда
		ВызватьИсключение НСтр(
			"ru = 'Недостаточно прав для создания документа';
			|uk = 'Недостатньо прав для створення документа'");
	КонецЕсли;

	МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ВидОперации);
	НовыйДокумент = МенеджерДокумента.СоздатьДокумент();

	Если Не ЗначениеЗаполнено(Основание) Тогда
		Возврат НовыйДокумент;
	КонецЕсли;

	Пара = EBC_Ядро.ПараКонтакта(Основание);

	// Сначала типовое заполнение по основанию: оно знает про соглашения,
	// валюту и прочие связанные реквизиты.
	ОснованиеЗаполнения = ?(Пара.Партнер <> Неопределено, Пара.Партнер, Пара.Контрагент);
	Если ОснованиеЗаполнения <> Неопределено Тогда
		Попытка
			НовыйДокумент.Заполнить(ОснованиеЗаполнения);
		Исключение
			// Документ не умеет заполняться по такому основанию - ниже
			// подставим реквизиты напрямую.
		КонецПопытки;
	КонецЕсли;

	// Затем то, что типовая обработка не заполнила.
	ЗначенияЗаполнения = ЗначенияЗаполненияДокумента(МетаданныеДокумента, Пара);
	Для Каждого КлючЗначение Из ЗначенияЗаполнения Цикл
		Если Не ЗначениеЗаполнено(НовыйДокумент[КлючЗначение.Ключ]) Тогда
			НовыйДокумент[КлючЗначение.Ключ] = КлючЗначение.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат НовыйДокумент;

КонецФункции

// Добавляет реквизит в структуру заполнения, если документ его примет.
Процедура ДобавитьЗначениеЗаполнения(Результат, Знач МетаданныеДокумента, Знач ИмяРеквизита, Знач Значение)

	Если Значение = Неопределено Или Не ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;

	РеквизитМетаданных = МетаданныеДокумента.Реквизиты.Найти(ИмяРеквизита);
	Если РеквизитМетаданных = Неопределено
		Или Не РеквизитМетаданных.Тип.СодержитТип(ТипЗнч(Значение)) Тогда
		Возврат;
	КонецЕсли;

	Результат.Вставить(ИмяРеквизита, Значение);

КонецПроцедуры

// Реквизит документа существует и принимает ссылки указанного справочника.
Функция РеквизитПринимаетСправочник(Знач МетаданныеДокумента, Знач ИмяРеквизита, Знач ИмяСправочника)

	РеквизитМетаданных = МетаданныеДокумента.Реквизиты.Найти(ИмяРеквизита);
	Если РеквизитМетаданных = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		// Тип собирается строкой: статической ссылки на Партнеры в расширении
		// быть не должно - в SmallBusiness такого справочника нет.
		Возврат РеквизитМетаданных.Тип.СодержитТип(Тип("СправочникСсылка." + ИмяСправочника));
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Преобразует табличный документ в JPEG внешней компонентой SpreadSheet.
//
// Масштаб берётся из настроек: 100 % дают нечитаемую на телефоне картинку,
// а получатель здесь всегда мессенджер.
//
Функция КартинкаТабличногоДокумента(Знач ТабличныйДокумент) Экспорт

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("mxl");
	Попытка
		ТабличныйДокумент.Записать(
			ИмяВременногоФайла,
			ТипФайлаТабличногоДокумента.MXL);

		Если Не ПодключитьВнешнююКомпоненту(
			"ОбщийМакет.EBC_SpreadSheet",
			"SS",
			ТипВнешнейКомпоненты.Native) Тогда
			ВызватьИсключение НСтр(
				"ru = 'Не удалось подключить компоненту SpreadSheet';
				|uk = 'Не вдалося підключити компоненту SpreadSheet'");
		КонецЕсли;

		Компонента = Новый("AddIn.SS.SpreadSheet");
		Компонента.Качество = 85;
		// Номер страницы намеренно не задаётся: с НомерСтраницы = 0 компонента
		// отдавала только первую страницу, а печатная форма бывает длиннее.
		Компонента.Масштаб = МасштабКартинкиПечатнойФормы();
		ДвоичныеДанные = Компонента.ПолучитьКартинку(ИмяВременногоФайла, "JPEG");

		Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
			ВызватьИсключение НСтр(
				"ru = 'Компонента SpreadSheet вернула данные неподдерживаемого типа';
				|uk = 'Компонента SpreadSheet повернула дані непідтримуваного типу'");
		КонецЕсли;
		Если ДвоичныеДанные.Размер() = 0 Тогда
			ВызватьИсключение НСтр(
				"ru = 'Компонента SpreadSheet вернула пустое изображение';
				|uk = 'Компонента SpreadSheet повернула порожнє зображення'");
		КонецЕсли;

		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Попытка
			УдалитьФайлы(ИмяВременногоФайла);
		Исключение
		КонецПопытки;
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;

	Возврат ДвоичныеДанные;

КонецФункции

// Ссылка на объект по полному имени таблицы и идентификатору.
//
// Так связи чатов хранят объект: полным именем и UUID, без ссылочного
// реквизита - иначе регистр знал бы состав объектов конфигурации.
//
Функция ПолучитьСсылкуОбъекта(Знач ТипОбъекта, Знач ИдентификаторОбъекта) Экспорт

	Если ПустаяСтрока(ТипОбъекта) Или Не ЗначениеЗаполнено(ИдентификаторОбъекта) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Метаданные.НайтиПоПолномуИмени(ТипОбъекта) = Неопределено Тогда
		// Объект есть в связях, но не в этой конфигурации.
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ТипОбъекта);
		СсылкаНаОбъект = МенеджерОбъекта.ПолучитьСсылку(ИдентификаторОбъекта);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если Не ПравоДоступа("Просмотр", СсылкаНаОбъект.Метаданные()) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат СсылкаНаОбъект;

КонецФункции

// Данные объекта для записи связи: тип, идентификатор, представление и ссылка.
Функция ПолучитьДанныеИдентификацииОбъекта(Знач СсылкаНаОбъект) Экспорт

	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Возврат Неопределено;
	КонецЕсли;

	МетаданныеОбъекта = СсылкаНаОбъект.Метаданные();
	Если Не ПравоДоступа("Просмотр", МетаданныеОбъекта) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура(
		"ТипОбъекта,ИдентификаторОбъекта,ПредставлениеОбъекта,НавигационнаяСсылка",
		Строка(МетаданныеОбъекта.ПолноеИмя()),
		СсылкаНаОбъект.УникальныйИдентификатор(),
		Строка(СсылкаНаОбъект),
		ПолучитьНавигационнуюСсылку(СсылкаНаОбъект));

КонецФункции

// Масштаб картинки печатной формы в процентах из настроек расширения.
Функция МасштабКартинкиПечатнойФормы()

	Настройки = EBC_НастройкиПовтИсп.ОбщиеНастройки();

	Масштаб = 0;
	Если Настройки.Свойство("МасштабКартинкиПечатнойФормы", Масштаб)
		И Масштаб > 0 Тогда
		Возврат Масштаб;
	КонецЕсли;

	Возврат EBC_НастройкиСервер.МасштабКартинкиПечатнойФормыПоУмолчанию();

КонецФункции

#КонецЕсли
