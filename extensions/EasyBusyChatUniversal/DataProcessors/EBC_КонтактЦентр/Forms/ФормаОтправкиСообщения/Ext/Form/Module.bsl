// Форма отправки сообщения в чат Easy-Busy Chat.
//
// Открывается командой подменю в форме объекта, а на этапе 6 - ещё и из формы
// печати, и тогда несёт вложение. Режим окна - БлокироватьОкноВладельца:
// форма работает как диалог.
//
// Параметры формы (все необязательные):
//  Объект        - ссылка на объект учётной системы, из формы которого вызвана
//                  отправка. По нему определяются контрагент и список чатов.
//  Чат           - СправочникСсылка.EBC_Чаты - подставить этот чат. Если не
//                  задан, берётся первый чат объекта по приоритету -
//                  см. EBC_Ядро.ЧатыОбъектаПоПриоритету.
//  Документ      - ссылка на документ для текста по умолчанию. Если не задан,
//                  берётся Объект, когда он документ.
//  Сообщение     - Строка - готовый текст. Если не задан, собирается по документу.
//  АдресВложения - Строка - адрес двоичных данных во временном хранилище.
//  ИмяВложения   - Строка - имя файла вложения вместе с расширением.
//  ТипСодержимогоВложения - Строка - MIME-тип, например "application/pdf".

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Параметры.Свойство("Объект", ОбъектСсылка);

	ЗначениеЧата = Неопределено;
	Если Параметры.Свойство("Чат", ЗначениеЧата) И ЗначениеЗаполнено(ЗначениеЧата) Тогда
		Чат = ЗначениеЧата;
	КонецЕсли;

	// Список строится один раз при создании формы: он же даёт и чат по
	// умолчанию - первый по приоритету.
	ПервыйЧат = ЗаполнитьСписокЧатов();

	Если Не ЗначениеЗаполнено(Чат) Тогда
		Чат = ПервыйЧат;
	КонецЕсли;

	// Список отдаётся самому полю: кнопку выпадающего списка платформа
	// обрабатывает сама и показывает список поля. Обработчик события до неё
	// не доходит, поэтому пункт "Выбрать из всех чатов" должен лежать
	// прямо в этом списке.
	Элементы.Чат.СписокВыбора.ЗагрузитьЗначения(СписокЧатов.ВыгрузитьЗначения());
	Для Индекс = 0 По СписокЧатов.Количество() - 1 Цикл
		Элементы.Чат.СписокВыбора[Индекс].Представление = СписокЧатов[Индекс].Представление;
	КонецЦикла;

	ПредыдущийЧат = Чат;

	ПрочитатьВложение();
	ЗаполнитьКонтрагента();

	ТекстСообщения = "";
	Если Параметры.Свойство("Сообщение") Тогда
		ТекстСообщения = Строка(Параметры.Сообщение);
	КонецЕсли;

	Если ПустаяСтрока(ТекстСообщения) Тогда
		ТекстСообщения = EBC_АдаптерКонфигурации.ТекстСообщенияПоДокументу(
			ДокументДляТекста());
	КонецЕсли;

	Сообщение = ТекстСообщения;

	ОбновитьВидимость();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

// Кнопка выбора («…») открывает форму выбора из всех чатов: короткий список
// уже висит на кнопке выпадающего списка, дублировать его незачем.
&НаКлиенте
Процедура ЧатНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьВыборИзВсехЧатов();

КонецПроцедуры

// Пункт «Выбрать из всех чатов» лежит в списке поля пустой ссылкой:
// платформа присваивает её полю, а форма выбора открывается уже отсюда.
&НаКлиенте
Процедура ЧатПриИзменении(Элемент)

	Если Чат = ВыбратьИзВсехЧатовЗначение() Тогда
		Чат = ПредыдущийЧат;
		ОткрытьВыборИзВсехЧатов();
		Возврат;
	КонецЕсли;

	ПредыдущийЧат = Чат;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Отправить(Команда)

	Если Не ЗначениеЗаполнено(Чат) Тогда
		ПоказатьПредупреждение(
			,
			НСтр(
				"ru = 'Не выбран чат для отправки сообщения.';
				|uk = 'Не вибрано чат для надсилання повідомлення.'"));
		Возврат;
	КонецЕсли;

	// Пустой текст допустим только вместе с вложением: отправлять в чат пустоту
	// незачем, а вот файл без подписи - обычное дело.
	Если ПустаяСтрока(СокрЛП(Сообщение)) И ПустаяСтрока(АдресВложения) Тогда
		ПоказатьПредупреждение(
			,
			НСтр(
				"ru = 'Введите текст сообщения.';
				|uk = 'Введіть текст повідомлення.'"));
		Возврат;
	КонецЕсли;

	РезультатОтправки = ОтправитьНаСервере();
	Если Не РезультатОтправки.Успех Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатОтправки.ТекстОшибки);
		Возврат;
	КонецЕсли;

	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Отправка сообщения'; uk = 'Надсилання повідомлення'"),
		,
		РезультатОтправки.ТекстРезультата);

	Модифицированность = Ложь;
	Закрыть(Истина);

КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)

	// Форма закрывается без отправки, введённый текст не сохраняется.
	Модифицированность = Ложь;
	Закрыть();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Признак пункта «Выбрать из всех чатов» в списке выбора чата.
//
// Пустая ссылка, а не строка: список выбора у поля типизирован ссылкой на
// чат, и строку платформа при выборе присвоить не смогла бы. Заодно этот
// же признак понятен и на сервере, и на клиенте.
&НаКлиентеНаСервереБезКонтекста
Функция ВыбратьИзВсехЧатовЗначение()

	Возврат ПредопределенноеЗначение("Справочник.EBC_Чаты.ПустаяСсылка");

КонецФункции

&НаКлиенте
Процедура ОткрытьВыборИзВсехЧатов()

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Объект", ОбъектСсылка);
	ПараметрыФормы.Вставить("РежимВыбора", Истина);

	Оповещение = Новый ОписаниеОповещения("ВыборИзВсехЧатовЗавершение", ЭтотОбъект);

	ОткрытьФорму(
		"Обработка.EBC_КонтактЦентр.Форма.ФормаПривязанныеЧаты",
		ПараметрыФормы,
		ЭтотОбъект,
		,
		,
		,
		Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ВыборИзВсехЧатовЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;

	Чат = Результат;

КонецПроцедуры

// Наибольшее число чатов в выпадающем списке.
//
// Пять - это ровно та длина, которую видно целиком, не листая. Всё остальное
// достаётся пунктом "Выбрать из всех чатов".
&НаСервере
Функция МаксимумЧатовВСписке()

	Возврат 5;

КонецФункции

// Собирает выпадающий список чатов и возвращает чат по умолчанию.
//
// Порядок задаёт EBC_Ядро.ЧатыОбъектаПоПриоритету: основная связь объекта,
// остальные связи объекта свежими вперёд, затем то же у контрагента. Первый
// элемент списка и есть чат по умолчанию.
//
// Возвращаемое значение:
//  СправочникСсылка.EBC_Чаты - пустая ссылка, если чатов у объекта нет.
//
&НаСервере
Функция ЗаполнитьСписокЧатов()

	СписокЧатов.Очистить();
	ПервыйЧат = Справочники.EBC_Чаты.ПустаяСсылка();

	Приоритет = EBC_Ядро.ЧатыОбъектаПоПриоритету(ОбъектСсылка);

	Чаты = Новый Массив;
	Для Каждого Элемент Из Приоритет Цикл
		Чаты.Добавить(Элемент.Чат);
		Если Чаты.Количество() >= МаксимумЧатовВСписке() Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Чаты.Количество() > 0 Тогда
		ПервыйЧат = Чаты[0];
	КонецЕсли;

	Представления = ПредставленияЧатов(Чаты);

	Для Индекс = 0 По Чаты.Количество() - 1 Цикл
		Элемент = Приоритет[Индекс];
		Представление = Представления.Получить(Элемент.Чат);

		Если Элемент.ОсновнаяСвязь Тогда
			Представление = Представление + "  "
				+ НСтр("ru = '(основной)'; uk = '(основний)'");
		КонецЕсли;
		Если Элемент.ЧатКонтрагента Тогда
			Представление = Представление + "  "
				+ НСтр("ru = '(контрагента)'; uk = '(контрагента)'");
		КонецЕсли;

		СписокЧатов.Добавить(Элемент.Чат, Представление);
	КонецЦикла;

	СписокЧатов.Добавить(
		ВыбратьИзВсехЧатовЗначение(),
		НСтр(
			"ru = 'Выбрать из всех чатов…';
			|uk = 'Вибрати з усіх чатів…'"));

	Возврат ПервыйЧат;

КонецФункции

// "Наименование чата  ·  учётная запись" для каждого чата одним запросом.
&НаСервереБезКонтекста
Функция ПредставленияЧатов(Знач Чаты)

	Результат = Новый Соответствие;
	Если Чаты.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Чаты.Ссылка КАК Ссылка,
		|	Чаты.Наименование КАК Наименование,
		|	Чаты.Владелец.Наименование КАК УчетнаяЗапись
		|ИЗ
		|	Справочник.EBC_Чаты КАК Чаты
		|ГДЕ
		|	Чаты.Ссылка В (&Чаты)";
	Запрос.УстановитьПараметр("Чаты", Чаты);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Представление = СокрЛП(Строка(Выборка.Наименование));
		Если Не ПустаяСтрока(Выборка.УчетнаяЗапись) Тогда
			Представление = Представление + "  ·  " + СокрЛП(Строка(Выборка.УчетнаяЗапись));
		КонецЕсли;
		Результат.Вставить(Выборка.Ссылка, Представление);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Субъект контакта определяется по трём источникам, в порядке убывания
// надёжности:
//  1) сам объект либо его реквизиты "Партнер"/"Контрагент" - точнее нет;
//  2) сам объект, если он и есть контактный справочник: из формы партнёра
//     субъект контакта - это он;
//  3) связи чата: основная связь с контактным справочником, а при нескольких
//     таких - последняя по дате установки.
//
// Реквизиты формы намеренно сохранили прежние имена: значение тут только
// показывается подписью, а переименование сбросило бы пользовательские
// настройки формы без всякой пользы.
//
&НаСервере
Процедура ЗаполнитьКонтрагента()

	Контрагент = Неопределено;

	Если ЗначениеЗаполнено(ОбъектСсылка) Тогда
		Контрагент = EBC_Ядро.ПараКонтакта(ОбъектСсылка).СвязанныйКонтакт;
	КонецЕсли;

	Если Контрагент = Неопределено И ЗначениеЗаполнено(Чат) Тогда
		Контрагент = КонтрагентПоСвязямЧата(Чат);
	КонецЕсли;

	ПредставлениеКонтрагента = ?(
		Контрагент = Неопределено,
		"",
		Строка(Контрагент));

	// Подпись называет вещи своими именами: в УТ и КУП это чаще партнёр.
	Элементы.ПредставлениеКонтрагента.Заголовок = ЗаголовокСубъекта(Контрагент);

КонецПроцедуры

// Заголовок подписи по фактическому типу субъекта.
&НаСервереБезКонтекста
Функция ЗаголовокСубъекта(Знач Субъект)

	Если Субъект <> Неопределено
		И EBC_Ядро.ИмяТаблицыПоСсылке(Субъект) = "Справочник.Партнеры" Тогда
		Возврат НСтр("ru = 'Партнер'; uk = 'Партнер'");
	КонецЕсли;

	Возврат НСтр("ru = 'Контрагент'; uk = 'Контрагент'");

КонецФункции

&НаСервереБезКонтекста
Функция КонтрагентПоСвязямЧата(Знач Чат)

	// Контактными считаются только партнёры и контрагенты. Раньше сюда
	// проходил любой справочник, и подписью "Контрагент" формы могла
	// оказаться номенклатура или организация.
	КонтактныеСправочники = EBC_АдаптерКонфигурации.КонтактныеСправочники();
	Если КонтактныеСправочники.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Связи.ТипОбъекта КАК ТипОбъекта,
		|	Связи.ИдентификаторОбъекта КАК ИдентификаторОбъекта
		|ИЗ
		|	РегистрСведений.EBC_СвязиОбъектов КАК Связи
		|ГДЕ
		|	Связи.Чат = &Чат
		|	И Связи.ТипОбъекта В (&КонтактныеСправочники)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Связи.ОсновнаяСвязь УБЫВ,
		|	Связи.ДатаУстановки УБЫВ";
	Запрос.УстановитьПараметр("Чат", Чат);
	Запрос.УстановитьПараметр("КонтактныеСправочники", КонтактныеСправочники);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ссылка = EBC_АдаптерКонфигурации.ПолучитьСсылкуОбъекта(
			Выборка.ТипОбъекта,
			Выборка.ИдентификаторОбъекта);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Возврат Ссылка;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Документ, по которому собирается текст по умолчанию.
&НаСервере
Функция ДокументДляТекста()

	Документ = Неопределено;
	Если Параметры.Свойство("Документ", Документ) И ЗначениеЗаполнено(Документ) Тогда
		Возврат Документ;
	КонецЕсли;

	Если ЗначениеЗаполнено(ОбъектСсылка)
		И Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(ОбъектСсылка)) Тогда
		Возврат ОбъектСсылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

&НаСервере
Процедура ПрочитатьВложение()

	Параметры.Свойство("АдресВложения", АдресВложения);
	Параметры.Свойство("ИмяВложения", ИмяВложения);
	Параметры.Свойство("ТипСодержимогоВложения", ТипСодержимогоВложения);

	Если ПустаяСтрока(АдресВложения) Тогда
		ПредставлениеВложения = "";
		Возврат;
	КонецЕсли;

	// Данные вложения остаются во временном хранилище до отправки: класть
	// двоичные данные в реквизит формы значило бы гонять их на клиент и обратно.
	Размер = 0;
	Попытка
		ДанныеВложения = ПолучитьИзВременногоХранилища(АдресВложения);
		Если ТипЗнч(ДанныеВложения) = Тип("ДвоичныеДанные") Тогда
			Размер = ДанныеВложения.Размер();
		КонецЕсли;
	Исключение
		// Хранилище могло быть очищено - вложение просто не показывается.
		АдресВложения = "";
		ПредставлениеВложения = "";
		Возврат;
	КонецПопытки;

	ПредставлениеВложения = СокрЛП(ИмяВложения);
	Если Размер > 0 Тогда
		ПредставлениеВложения = ПредставлениеВложения + "  ·  "
			+ ПредставлениеРазмера(Размер);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПредставлениеРазмера(Знач Размер)

	Если Размер < 1024 Тогда
		Возврат СтрШаблон(НСтр("ru = '%1 Б'; uk = '%1 Б'"), Формат(Размер, "ЧН=0; ЧГ="));
	ИначеЕсли Размер < 1024 * 1024 Тогда
		Возврат СтрШаблон(
			НСтр("ru = '%1 КБ'; uk = '%1 КБ'"),
			Формат(Размер / 1024, "ЧН=0; ЧГ=; ЧДЦ=0"));
	КонецЕсли;

	Возврат СтрШаблон(
		НСтр("ru = '%1 МБ'; uk = '%1 МБ'"),
		Формат(Размер / 1024 / 1024, "ЧН=0; ЧГ=; ЧДЦ=1"));

КонецФункции

&НаСервере
Процедура ОбновитьВидимость()

	Элементы.ПредставлениеКонтрагента.Видимость = Не ПустаяСтрока(ПредставлениеКонтрагента);
	Элементы.ПредставлениеВложения.Видимость = Не ПустаяСтрока(ПредставлениеВложения);

КонецПроцедуры

&НаСервере
Функция ОтправитьНаСервере()

	Результат = Новый Структура("Успех,ТекстОшибки", Ложь, "");
	Текст = СокрЛП(Сообщение);

	Попытка
		Если ПустаяСтрока(АдресВложения) Тогда
			РезультатОтправки = EBC_Ядро.ОтправитьСообщениеВЧат(Чат, Текст);
		Иначе
			// Текст уходит подписью к файлу: отдельным сообщением он пришёл бы
			// в чат вторым, и получатель увидел бы файл раньше пояснения.
			РезультатОтправки = EBC_Ядро.ОтправитьФайлВЧат(
				Чат,
				ПолучитьИзВременногоХранилища(АдресВложения),
				ИмяВложения,
				Текст,
				ТипФайлаВложения(),
				ТипСодержимогоВложения,
				РасширениеВложения());
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации(
			"EBC_КонтактЦентр.ОтправитьСообщение",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Результат.ТекстОшибки = НСтр(
			"ru = 'Не удалось отправить сообщение в чат.';
			|uk = 'Не вдалося надіслати повідомлення в чат.'");
		Возврат Результат;
	КонецПопытки;

	Результат.Успех = РезультатОтправки.Успех;
	Результат.Вставить("ТекстРезультата", "");
	Если Результат.Успех Тогда Результат.ТекстРезультата = РезультатОтправки.ТекстРезультата; КонецЕсли;
	Если Не Результат.Успех Тогда
		Результат.ТекстОшибки = НСтр(
			"ru = 'Easy Busy Chat не принял сообщение.';
			|uk = 'Easy Busy Chat не прийняв повідомлення.'");
		Если РезультатОтправки.Свойство("Ошибка")
			И Не ПустаяСтрока(РезультатОтправки.Ошибка) Тогда
			Результат.ТекстОшибки = РезультатОтправки.Ошибка;
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ТипФайлаВложения()
	MIME = НРег(СокрЛП(ТипСодержимогоВложения));
	Если СтрНачинаетсяС(MIME, "image/") Тогда Возврат "Photo"; КонецЕсли;
	Если СтрНачинаетсяС(MIME, "video/") Тогда Возврат "Video"; КонецЕсли;
	Если СтрНачинаетсяС(MIME, "audio/") Тогда Возврат "Audio"; КонецЕсли;
	Возврат "Document";
КонецФункции

&НаСервере
Функция РасширениеВложения()

	Точка = СтрНайти(ИмяВложения, ".", НаправлениеПоиска.СКонца);
	Если Точка = 0 Тогда
		Возврат "pdf";
	КонецЕсли;

	Возврат НРег(Сред(ИмяВложения, Точка + 1));

КонецФункции

#КонецОбласти
