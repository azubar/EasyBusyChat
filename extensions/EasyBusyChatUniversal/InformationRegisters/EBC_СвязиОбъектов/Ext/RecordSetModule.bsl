Перем СнимокСвязейДо;
Перем ИдентификаторКорреляции;

Процедура ПередЗаписью(Отказ, Замещение)

#Если Сервер Тогда
	СнимокСвязейДо = ПолучитьСнимокСвязей();
	ИдентификаторКорреляции = Строка(Новый УникальныйИдентификатор());
#КонецЕсли

КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)

#Если Сервер Тогда
	Если Отказ Тогда Возврат; КонецЕсли;

	СнимокПосле = ПолучитьСнимокСвязей();
	Буфер = EBC_Логирование.НовыйБуфер();

	Для Каждого СтрокаДо Из СнимокСвязейДо Цикл
		СтрокиПосле = СнимокПосле.НайтиСтроки(КлючСвязи(СтрокаДо));
		Если СтрокиПосле.Количество() = 0 Тогда
			ДобавитьСобытиеСвязи(Буфер, "ПривязкаЧатаУдалена", СтрокаДо, Неопределено);
		ИначеЕсли СвязьИзменилась(СтрокаДо, СтрокиПосле[0]) Тогда
			ДобавитьСобытиеСвязи(Буфер, "ПривязкаЧатаИзменена", СтрокиПосле[0], СтрокаДо);
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаПосле Из СнимокПосле Цикл
		Если СнимокСвязейДо.НайтиСтроки(КлючСвязи(СтрокаПосле)).Количество() = 0 Тогда
			ДобавитьСобытиеСвязи(Буфер, "ПривязкаЧатаУстановлена", СтрокаПосле, Неопределено);
		КонецЕсли;
	КонецЦикла;

	EBC_Логирование.ЗаписатьБуфер(Буфер);
#КонецЕсли

КонецПроцедуры

Функция ПолучитьСнимокСвязей()

	Запрос = Новый Запрос;
	Условия = Новый Массив;
	Если Отбор.Чат.Использование Тогда
		Условия.Добавить("Связи.Чат = &Чат");
		Запрос.УстановитьПараметр("Чат", Отбор.Чат.Значение);
	КонецЕсли;
	Если Отбор.ТипОбъекта.Использование Тогда
		Условия.Добавить("Связи.ТипОбъекта = &ТипОбъекта");
		Запрос.УстановитьПараметр("ТипОбъекта", Отбор.ТипОбъекта.Значение);
	КонецЕсли;
	Если Отбор.ИдентификаторОбъекта.Использование Тогда
		Условия.Добавить("Связи.ИдентификаторОбъекта = &ИдентификаторОбъекта");
		Запрос.УстановитьПараметр("ИдентификаторОбъекта", Отбор.ИдентификаторОбъекта.Значение);
	КонецЕсли;

	Запрос.Текст =
		"ВЫБРАТЬ
		| Связи.Чат КАК Чат,
		| Связи.ТипОбъекта КАК ТипОбъекта,
		| Связи.ИдентификаторОбъекта КАК ИдентификаторОбъекта,
		| Связи.ОсновнаяСвязь КАК ОсновнаяСвязь,
		| Связи.ИсточникСвязи КАК ИсточникСвязи,
		| Связи.ПредставлениеОбъекта КАК ПредставлениеОбъекта,
		| Связи.НавигационнаяСсылка КАК НавигационнаяСсылка
		|ИЗ
		| РегистрСведений.EBC_СвязиОбъектов КАК Связи"
		+ ?(Условия.Количество() = 0, "", Символы.ПС + "ГДЕ " + СтрСоединить(Условия, Символы.ПС + " И "));

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция КлючСвязи(Знач СтрокаСвязи)
	Возврат Новый Структура(
		"Чат,ТипОбъекта,ИдентификаторОбъекта",
		СтрокаСвязи.Чат,
		СтрокаСвязи.ТипОбъекта,
		СтрокаСвязи.ИдентификаторОбъекта);
КонецФункции

Функция СвязьИзменилась(Знач До, Знач После)
	Возврат До.ОсновнаяСвязь <> После.ОсновнаяСвязь
		Или До.ИсточникСвязи <> После.ИсточникСвязи;
КонецФункции

Процедура ДобавитьСобытиеСвязи(Буфер, Знач ИмяСобытия, Знач Связь, Знач СвязьДо)

#Если Сервер Тогда
	Событие = EBC_Логирование.НовоеСобытиеДействияПользователя(ИмяСобытия);
	Событие.КорреляционныйИдентификатор = ИдентификаторКорреляции;
	Событие.РезультатДействия = "Успех";
	EBC_Логирование.ЗаполнитьДанныеЧата(Событие, Связь.Чат);

	ОписаниеОбъекта = Новый Структура(
		"ТипОбъекта,ИдентификаторОбъекта,ПредставлениеОбъекта,НавигационнаяСсылка",
		Связь.ТипОбъекта,
		Связь.ИдентификаторОбъекта,
		Связь.ПредставлениеОбъекта,
		Связь.НавигационнаяСсылка);
	EBC_Логирование.ЗаполнитьДанныеОбъекта(Событие, ОписаниеОбъекта);

	Если СвязьДо = Неопределено Тогда
		Событие.Детали = СтрШаблон("Основная=%1; Источник=%2", Связь.ОсновнаяСвязь, Связь.ИсточникСвязи);
	Иначе
		Событие.Детали = СтрШаблон(
			"Основная:%1->%2; Источник:%3->%4",
			СвязьДо.ОсновнаяСвязь, Связь.ОсновнаяСвязь,
			СвязьДо.ИсточникСвязи, Связь.ИсточникСвязи);
	КонецЕсли;

	EBC_Логирование.Добавить(Буфер, Событие);
#КонецЕсли

КонецПроцедуры
