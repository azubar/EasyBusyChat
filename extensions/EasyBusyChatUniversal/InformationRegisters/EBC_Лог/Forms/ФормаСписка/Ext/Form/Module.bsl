// Форма списка регистра EBC_Лог.
//
// Отборы задаются элементами отбора динамического списка, а не условиями вида
// "(&БезОтбора ИЛИ поле = &Значение)" в тексте запроса: такое условие не даёт
// использовать индекс и превращает любой отбор в сканирование таблицы.
//
// Период отбирается по индексируемому ресурсу ДатаНачала, который хранит
// фактическое время начала события.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// По умолчанию показываются текущие сутки: журнал технический, и открывать
	// его сразу на всём объёме незачем.
	ТекущийДень = НачалоДня(EBC_Ядро.ТекущаяДатаДанных());
	ПериодНачало = ТекущийДень;
	ПериодОкончание = ТекущийДень;

	УстановитьОтборыСписка();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьПериод(Команда)

	Диалог = Новый ДиалогРедактированияСтандартногоПериода;
	Диалог.Период = Новый СтандартныйПериод;
	Если ЗначениеЗаполнено(ПериодНачало) Тогда
		Диалог.Период.ДатаНачала = НачалоДня(ПериодНачало);
	КонецЕсли;
	Если ЗначениеЗаполнено(ПериодОкончание) Тогда
		Диалог.Период.ДатаОкончания = КонецДня(ПериодОкончание);
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения(
		"ВыбратьПериодЗавершение", ЭтотОбъект);
	Диалог.Показать(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписок(Команда)

	Элементы.Список.Обновить();

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьОтборы(Команда)

	Если ЗначениеЗаполнено(ПериодНачало)
		И ЗначениеЗаполнено(ПериодОкончание)
		И ПериодНачало > ПериодОкончание Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр(
				"ru = 'Начало периода не может быть позже окончания.';
				|uk = 'Початок періоду не може бути пізніше за його закінчення.'"));
		Возврат;
	КонецЕсли;

	УстановитьОтборыСписка();
	Элементы.Список.Обновить();

КонецПроцедуры

&НаКлиенте
Процедура СброситьОтборы(Команда)

	ПериодНачало = '00010101';
	ПериодОкончание = '00010101';
	ПользовательИБФильтр = ПредопределенноеЗначение(
		"Справочник.Пользователи.ПустаяСсылка");
	УровеньФильтр = ПредопределенноеЗначение(
		"Перечисление.EBC_УровниЖурнала.ПустаяСсылка");
	КатегорияФильтр = ПредопределенноеЗначение(
		"Перечисление.EBC_КатегорииЖурнала.ПустаяСсылка");
	СобытиеФильтр = "";
	ЧатФильтр = ПредопределенноеЗначение("Справочник.EBC_Чаты.ПустаяСсылка");
	ТипОбъектаФильтр = "";

	УстановитьОтборыСписка();
	Элементы.Список.Обновить();

КонецПроцедуры

&НаКлиенте
Процедура УдалитьВыбранныеЗаписи(Команда)

	ВыбранныеЗаписи = ПолучитьВыбранныеЗаписи();
	Если ВыбранныеЗаписи.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр(
				"ru = 'Выберите записи журнала для удаления.';
				|uk = 'Виберіть записи журналу для видалення.'"));
		Возврат;
	КонецЕсли;

	// Удаление необратимо, поэтому подтверждается явно, а кнопка по умолчанию - "Нет".
	ТекстВопроса = СтрШаблон(
		НСтр(
			"ru = 'Действительно удалить выбранные записи журнала (количество записей: %1)?';
			|uk = 'Дійсно видалити вибрані записи журналу (кількість записів: %1)?'"),
		ВыбранныеЗаписи.Количество());
	Обработчик = Новый ОписаниеОповещения(
		"УдалитьВыбранныеЗаписиЗавершение",
		ЭтотОбъект,
		ВыбранныеЗаписи);
	ПоказатьВопрос(
		Обработчик,
		ТекстВопроса,
		РежимДиалогаВопрос.ДаНет,
		,
		КодВозвратаДиалога.Нет);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

&НаКлиенте
Процедура ВыбратьПериодЗавершение(ВыбранныйПериод, ДополнительныеПараметры) Экспорт

	Если ВыбранныйПериод = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПериодНачало = ВыбранныйПериод.ДатаНачала;
	ПериодОкончание = ВыбранныйПериод.ДатаОкончания;
	УстановитьОтборыСписка();
	Элементы.Список.Обновить();

КонецПроцедуры

&НаКлиенте
Процедура УдалитьВыбранныеЗаписиЗавершение(Ответ, ВыбранныеЗаписи) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Результат = УдалитьВыбранныеЗаписиНаСервере(ВыбранныеЗаписи);

	Элементы.Список.Обновить();

	Если Результат.Успех Тогда
		ПоказатьОповещениеПользователя(
			НСтр(
				"ru = 'Журнал Easy Busy Chat';
				|uk = 'Журнал Easy Busy Chat'"),
			,
			СтрШаблон(
				НСтр(
					"ru = 'Удалено записей: %1';
					|uk = 'Видалено записів: %1'"),
				Результат.Количество));
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			СтрШаблон(
				НСтр(
					"ru = 'Не удалось удалить записи журнала. %1';
					|uk = 'Не вдалося видалити записи журналу. %1'"),
				Результат.Ошибка));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Идентификаторами строк динамического списка по регистру сведений служат ключи
// записей: у периодического регистра ключ состоит из периода и измерений.
//
&НаКлиенте
Функция ПолучитьВыбранныеЗаписи()

	Результат = Новый Массив;
	Для Каждого КлючЗаписи Из Элементы.Список.ВыделенныеСтроки Цикл
		Если ТипЗнч(КлючЗаписи) = Тип("РегистрСведенийКлючЗаписи.EBC_Лог") Тогда
			Результат.Добавить(КлючЗаписи);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Записи удаляются менеджерами записи поштучно: набор записей отбирается только
// по равенству периода и удалил бы сутки целиком, а не выбранные строки.
// Массовая очистка по срокам выполняется ротацией - EBC_Ядро.ВыполнитьРотациюЛогов.
//
&НаСервереБезКонтекста
Функция УдалитьВыбранныеЗаписиНаСервере(Знач ВыбранныеЗаписи)

	Результат = Новый Структура("Успех, Количество, Ошибка", Ложь, 0, "");

	Если ТипЗнч(ВыбранныеЗаписи) <> Тип("Массив")
		Или ВыбранныеЗаписи.Количество() = 0 Тогда
		Результат.Ошибка = НСтр(
			"ru = 'Не передан список записей для удаления.';
			|uk = 'Не передано список записів для видалення.'");
		Возврат Результат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Для Каждого КлючЗаписи Из ВыбранныеЗаписи Цикл
			Если ТипЗнч(КлючЗаписи) <> Тип("РегистрСведенийКлючЗаписи.EBC_Лог") Тогда
				Продолжить;
			КонецЕсли;

			МенеджерЗаписи = РегистрыСведений.EBC_Лог.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Период = КлючЗаписи.Период;
			МенеджерЗаписи.ИдентификаторЗаписи = КлючЗаписи.ИдентификаторЗаписи;
			МенеджерЗаписи.Удалить();

			Результат.Количество = Результат.Количество + 1;
		КонецЦикла;

		ЗафиксироватьТранзакцию();
		Результат.Успех = Истина;
	Исключение
		ОтменитьТранзакцию();
		Результат.Количество = 0;
		Результат.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

&НаСервере
Процедура УстановитьОтборыСписка()

	УстановитьОтборПоПериоду(ПериодНачало, ПериодОкончание);

	УстановитьЭлементОтбора(
		"ПользовательИБ",
		ПользовательИБФильтр,
		ВидСравненияКомпоновкиДанных.Равно,
		ЗначениеЗаполнено(ПользовательИБФильтр));

	// Отбор по уровню включает все более важные события: выбрав
	// "Предупреждение", оператор должен видеть и ошибки.
	УстановитьЭлементОтбора(
		"Уровень",
		УровниНеНижеУказанного(УровеньФильтр),
		ВидСравненияКомпоновкиДанных.ВСписке,
		ЗначениеЗаполнено(УровеньФильтр));

	УстановитьЭлементОтбора("Категория", КатегорияФильтр,
		ВидСравненияКомпоновкиДанных.Равно, ЗначениеЗаполнено(КатегорияФильтр));
	УстановитьЭлементОтбора("Событие", СобытиеФильтр,
		ВидСравненияКомпоновкиДанных.Равно, Не ПустаяСтрока(СобытиеФильтр));
	УстановитьЭлементОтбора("Чат", ЧатФильтр,
		ВидСравненияКомпоновкиДанных.Равно, ЗначениеЗаполнено(ЧатФильтр));
	УстановитьЭлементОтбора("ТипОбъекта", ТипОбъектаФильтр,
		ВидСравненияКомпоновкиДанных.Равно, Не ПустаяСтрока(ТипОбъектаФильтр));

КонецПроцедуры

&НаСервере
Процедура УстановитьОтборПоПериоду(Знач НачалоПериода, Знач КонецПериода)

	ПредставлениеГруппыОтбора = НСтр(
		"ru = 'Период журнала'; uk = 'Період журналу'");

	ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(
		Список,
		Неопределено,
		ПредставлениеГруппыОтбора);

	Если Не ЗначениеЗаполнено(НачалоПериода)
		Или Не ЗначениеЗаполнено(КонецПериода) Тогда
		Возврат;
	КонецЕсли;

	ГруппаОтбора = Список.Отбор.Элементы.Добавить(
		Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора.Использование = Истина;
	ГруппаОтбора.ТипГруппы =
		ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	ГруппаОтбора.Представление = ПредставлениеГруппыОтбора;

	ПолеОтбора = Новый ПолеКомпоновкиДанных("ДатаНачала");

	ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(
		Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.ЛевоеЗначение = ПолеОтбора;
	ЭлементОтбора.ВидСравнения =
		ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
	ЭлементОтбора.ПравоеЗначение = НачалоДня(НачалоПериода);
	ЭлементОтбора.Представление = НСтр(
		"ru = 'Дата начала периода'; uk = 'Дата початку періоду'");

	ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(
		Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.ЛевоеЗначение = ПолеОтбора;
	ЭлементОтбора.ВидСравнения =
		ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
	ЭлементОтбора.ПравоеЗначение = КонецДня(КонецПериода);
	ЭлементОтбора.Представление = НСтр(
		"ru = 'Дата окончания периода'; uk = 'Дата закінчення періоду'");

КонецПроцедуры

&НаСервере
Процедура УстановитьЭлементОтбора(
		Знач ИмяПоля,
		Знач Значение,
		Знач ВидСравнения,
		Знач Использование)

	Представление = ИмяПоля + " " + Строка(ВидСравнения);

	ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(
		Список,
		ИмяПоля);

	Если Не Использование Тогда
		Возврат;
	КонецЕсли;

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список,
		ИмяПоля,
		Значение,
		ВидСравнения,
		Представление,
		Истина);

КонецПроцедуры

&НаСервереБезКонтекста
Функция УровниНеНижеУказанного(Знач Уровень)

	Порог = EBC_Логирование.ПриоритетУровня(Уровень);

	Результат = Новый Массив;
	Для Каждого ЗначениеУровня Из Перечисления.EBC_УровниЖурнала Цикл
		Если EBC_Логирование.ПриоритетУровня(ЗначениеУровня) >= Порог Тогда
			Результат.Добавить(ЗначениеУровня);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ПоказатьСкрытьОтборы(Команда)

	Элементы.ФормаПоказатьСкрытьОтборы.Пометка =
		Не Элементы.ФормаПоказатьСкрытьОтборы.Пометка;
	Элементы.ГруппаОтборов.Видимость =
		Элементы.ФормаПоказатьСкрытьОтборы.Пометка;

КонецПроцедуры

#КонецОбласти
