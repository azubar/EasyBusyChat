#Область ОбработчикиСобытий

&НаКлиенте
Процедура ОбработкаКоманды(
		ПараметрКоманды,
		ПараметрыВыполненияКоманды)

	Результат = СинхронизироватьНаСервере(ПараметрКоманды);
	Если Не Результат.Успех Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			Результат.Ошибка);
		Возврат;
	КонецЕсли;

	ОповеститьОбИзменении(ПараметрКоманды);
	ПоказатьОповещениеПользователя(
		НСтр(
			"ru = 'Синхронизация Easy Busy Chat';
			|uk = 'Синхронізація Easy Busy Chat'"),
		,
		СтрШаблон(
			НСтр(
				"ru = 'Компаний: %1, учетных записей: %2, добавлено пользователю: %3';
				|uk = 'Компаній: %1, облікових записів: %2, додано користувачу: %3'"),
			Результат.КоличествоКомпаний,
			Результат.КоличествоУчетныхЗаписей,
			Результат.ДобавленоКомпаний));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция СинхронизироватьНаСервере(Знач ПользовательEBC)

	Если Не ЗначениеЗаполнено(ПользовательEBC) Тогда
		Возврат РезультатКомандыСОшибкой(
			НСтр(
				"ru = 'Сначала запишите пользователя Easy Busy Chat.';
				|uk = 'Спочатку запишіть користувача Easy Busy Chat.'"));
	КонецЕсли;

	Результат = EBC_Ядро.СинхронизироватьСтруктуруКомпаний();
	Результат.Вставить("ДобавленоКомпаний", 0);
	Если Не Результат.Успех Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Результат.ДобавленоКомпаний =
			ДополнитьКомпанииПользователя(ПользовательEBC);
	Исключение
		Результат.Успех = Ложь;
		Результат.Ошибка = СтрШаблон(
			НСтр(
				"ru = 'Структура синхронизирована, но компании пользователя не обновлены: %1';
				|uk = 'Структуру синхронізовано, але компанії користувача не оновлено: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ДополнитьКомпанииПользователя(Знач ПользовательEBC)

	ОбъектПользователя = ПользовательEBC.ПолучитьОбъект();
	СуществующиеКомпании = Новый Соответствие;
	Для Каждого СтрокаКомпании Из ОбъектПользователя.Компании Цикл
		Если ЗначениеЗаполнено(СтрокаКомпании.Компания) Тогда
			СуществующиеКомпании.Вставить(
				СтрокаКомпании.Компания,
				Истина);
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| Компании.Ссылка КАК Компания
		|ИЗ
		| Справочник.EBC_Компании КАК Компании
		|ГДЕ
		| НЕ Компании.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		| Компании.Наименование";

	ДобавленоКомпаний = 0;
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если СуществующиеКомпании.Получить(
			Выборка.Компания) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = ОбъектПользователя.Компании.Добавить();
		НоваяСтрока.Компания = Выборка.Компания;
		НоваяСтрока.Роль = Перечисления.EBC_РолиПользователей.Оператор;
		НоваяСтрока.Активен = Истина;
		СуществующиеКомпании.Вставить(
			Выборка.Компания,
			Истина);
		ДобавленоКомпаний = ДобавленоКомпаний + 1;
	КонецЦикла;

	Если ДобавленоКомпаний > 0 Тогда
		ОбъектПользователя.Записать();
	КонецЕсли;

	Возврат ДобавленоКомпаний;

КонецФункции

&НаСервере
Функция РезультатКомандыСОшибкой(Знач ТекстОшибки)

	Возврат Новый Структура(
		"Успех,Ошибка,Количество,КоличествоКомпаний,КоличествоУчетныхЗаписей,ДобавленоКомпаний",
		Ложь,
		ТекстОшибки,
		0,
		0,
		0,
		0);

КонецФункции

#КонецОбласти