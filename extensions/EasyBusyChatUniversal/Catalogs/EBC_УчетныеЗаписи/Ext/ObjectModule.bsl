// API id идентифицирует подключение внутри компании и провайдера.
// Проверка действует для синхронизации и ручной записи, включая помеченные
// на удаление элементы: повторное создание не должно терять старые связи.
Процедура ПередЗаписью(Отказ)

	ИдентификаторEBC = НРег(СокрЛП(ИдентификаторEBC));
	Если ПустаяСтрока(ИдентификаторEBC) Тогда Возврат; КонецЕсли;
	Если Не ЗначениеЗаполнено(Владелец) Или Не ЗначениеЗаполнено(Провайдер) Тогда
		ВызватьИсключение НСтр("ru = 'Для учётной записи с API ID необходимо указать компанию и провайдера.';
			|uk = 'Для облікового запису з API ID необхідно вказати компанію та провайдера.'");
	КонецЕсли;

	// ПередЗаписью выполняется в транзакции записи объекта. Блокировка
	// компании сериализует проверку и создание даже при параллельной записи.
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("Справочник.EBC_Компании");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Ссылка", Владелец);
	Блокировка.Заблокировать();

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| УчетныеЗаписи.Ссылка КАК Ссылка
		|ИЗ Справочник.EBC_УчетныеЗаписи КАК УчетныеЗаписи
		|ГДЕ УчетныеЗаписи.Владелец = &Компания
		| И УчетныеЗаписи.Провайдер = &Провайдер
		| И УчетныеЗаписи.ИдентификаторEBC = &Идентификатор
		| И УчетныеЗаписи.Ссылка <> &Ссылка";
	Запрос.УстановитьПараметр("Компания", Владелец);
	Запрос.УстановитьПараметр("Провайдер", Провайдер);
	Запрос.УстановитьПараметр("Идентификатор", ИдентификаторEBC);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Если Не Запрос.Выполнить().Пустой() Тогда
		ВызватьИсключение НСтр("ru = 'Учётная запись с такой компанией, провайдером и API ID уже существует. Используйте существующую запись.';
			|uk = 'Обліковий запис із такою компанією, провайдером та API ID вже існує. Використайте наявний запис.'");
	КонецЕсли;

КонецПроцедуры
